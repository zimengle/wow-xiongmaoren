                    ["Desc"] = "Add an exclamation icon on units with color set in the Npc Colors tab with the \"Only Script\" box selected.",
                    ["PlaterCore"] = 1,
                    ["Time"] = 1615745256,
                    ["LastHookEdited"] = "",
                    ["Name"] = "Npc Colors Icon",
                    ["Icon"] = "Interface\\AddOns\\Plater\\media\\exclamation_64",
                    ["Prio"] = 99,
                    ["HooksTemp"] = {
