                    ["Desc"] = "Adds a pixels perfect border around the cast bar spell icon.",
                    ["PlaterCore"] = 1,
                    ["Time"] = 1658384966,
                    ["LastHookEdited"] = "",
                    ["Name"] = "Cast Icon Border",
                    ["Icon"] = 133004,
                    ["Prio"] = 99,
                    ["HooksTemp"] = {
                    },
                    ["Enabled"] = true,
                    ["Author"] = "Izimode-Azralon",
                    ["OptionsValues"] = {
