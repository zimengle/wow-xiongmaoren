                    ["Desc"] = "Sets the nameplate alpha based on range and occlusion.",
                    ["PlaterCore"] = 1,
                    ["Time"] = 1632047731,
                    ["LastHookEdited"] = "",
                    ["Name"] = "Nameplate Alpha",
                    ["Icon"] = 136243,
                    ["Prio"] = 99,
                    ["HooksTemp"] = {
