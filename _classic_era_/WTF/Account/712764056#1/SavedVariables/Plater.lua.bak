                    },
                    ["Desc"] = "Change the color of the aura timer by it's time left",
                    ["PlaterCore"] = 1,
                    ["Time"] = 1665508108,
                    ["LastHookEdited"] = "",
                    ["Name"] = "Paint Aura Timers",
                    ["Icon"] = "Interface\\Timer\\Challenges-Logo",
                    ["Prio"] = 99,
                    ["HooksTemp"] = {
                    },
