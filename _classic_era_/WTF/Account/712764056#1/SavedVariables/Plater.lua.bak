                        },
                        [12] = {
                            ["Icon"] = "Interface\\AddOns\\Plater\\images\\option_list",
                            ["Name"] = "Timer (Key is SpellId and Value is Time)",
                            ["Type"] = 7,
                            ["Value"] = {
                            },
                            ["Desc"] = "Key is the spellId and value is the amount of time of the Timer",
