                        ["spec"] = {
                            [103] = true,
                            ["Enabled"] = true,
                        },
                        ["map_ids"] = {
                        },
                        ["talent"] = {
                        },
                        ["role"] = {
                        },
                        ["class"] = {
                            ["DRUID"] = true,
                            ["ROGUE"] = true,
                            ["Enabled"] = true,
                        },
                        ["encounter_ids"] = {
