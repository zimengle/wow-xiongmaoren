["Hooks"] = {
["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable, modTable)\n    local targetName = UnitName (unitId .. \"target\")\n    \n    if  targetName  then\n        unitFrame.CurrentTargetFontString.text = targetName or \"\"\n        unitFrame.CurrentTargetFontString.textcolor = RAID_CLASS_COLORS[select(2, UnitClass(unitId .. \"target\"))] or \"white\"\n    else\n        unitFrame.CurrentTargetFontString.text = \"\"\n    end\nend",
["Constructor"] = "function (self, unitId, unitFrame, envTable, modTable)\n    if (not unitFrame.CurrentTargetFontString) then\n        envTable.newLabel = Plater:CreateLabel (unitFrame.healthBar)\n        unitFrame.CurrentTargetFontString = envTable.newLabel\n    end\n    \n    unitFrame.CurrentTargetFontString:SetPoint (\"left\", unitFrame.healthBar, \"right\", -14, 20)\n    unitFrame.CurrentTargetFontString.textsize = 11\n    unitFrame.CurrentTargetFontString.outline = \"OUTLINE\"\nend",
},
