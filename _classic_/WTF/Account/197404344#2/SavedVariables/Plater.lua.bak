["Author"] = "反虚入浑-影之哀伤",
["Desc"] = "定义关注和不关注的目标，以此来扩展姓名版的可见性。Allows you to define units concerned or not which will affect nameplates' visibility.",
["Prio"] = 99,
["Name"] = "!易爆球隐藏血条",
["PlaterCore"] = 1,
["Options"] = {
{
["Type"] = 7,
["Key"] = "_concerned",
