["Leave Combat"] = "function (self, unitId, unitFrame, envTable, modTable)\n    --insert code here\n    if (not unitFrame.AggroIndicatorFrame) then\n        return\n    end\n    \n    for i = 1, #unitFrame.AggroIndicatorFrame do\n        local texture = unitFrame.AggroIndicatorFrame [i]\n        texture:Hide()\n    end\nend\n\n\n\n\n",
["Nameplate Removed"] = "function (self, unitId, unitFrame, envTable, modTable)\n    --insert code here\n    \n    if (not unitFrame.AggroIndicatorFrame) then\n        return\n    end\n    \n    for i = 1, #unitFrame.AggroIndicatorFrame do\n        local texture = unitFrame.AggroIndicatorFrame [i]\n        texture:Hide()\n    end\nend\n\n\n\n",
["Player Logon"] = "function (self, unitId, unitFrame, envTable)\n    \n    --after editing this script, save it and /reload\n    \n    Plater.TargetIndicators  [\"ElvUIArrow\"] = {\n        path = [[Interface\\Addons\\SharedMedia_MyMedia\\media\\Arrow1.tga]],\n        coords = {\n            {0, 1, 0, 1}, \n            {1, 0, 0, 1}\n        },\n        desaturated = false,\n        width = 18,\n        height = 18,\n        x = 22,\n        y = 0,\n        blend = \"ADD\",\n        color = \"white\",\n    }\nend\n\n\n\n",
},
