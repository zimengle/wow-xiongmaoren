["Icon"] = 133938,
["Enabled"] = false,
["Revision"] = 126,
["semver"] = "",
["Author"] = "甜甜奶糖-萨尔",
["Desc"] = "by Pediyzhi@Bilibili",
["Prio"] = 99,
["version"] = -1,
["PlaterCore"] = 1,
