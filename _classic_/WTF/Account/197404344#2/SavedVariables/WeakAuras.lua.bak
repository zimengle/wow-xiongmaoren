["init"] = {
["custom"] = "local size = WeakAuras.InstanceType()\nlocal isHeroic = WeakAuras.InstanceDifficulty() == 'heroic'\n\nif size == 'twentyfive' then\n    aura_env.damage = isHeroic and 9 or 6\nelse\n    aura_env.damage = isHeroic and 4.5 or 3\nend\n\n\n\n",
