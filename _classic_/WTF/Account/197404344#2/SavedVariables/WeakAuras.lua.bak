["custom"] = "function(states, e, _, warning)\n    if e == 'OPTIONS' then\n        states:Update('', {count = 2})\n    end\n    if e == 'MERFIN_WARNING' and warning.ID == 'ImperviousShield' then\n        states:Update('', {count = warning.count})\n    end\nend",
