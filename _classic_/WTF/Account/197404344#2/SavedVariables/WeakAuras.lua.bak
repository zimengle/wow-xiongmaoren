["names"] = {
},
["custom"] = "function(a, e, id, ...)\n    if e == 'ENCOUNTER_START' then\n        a[''] = {\n            show = true,\n            changed = true,\n            active = false,\n            dead = false,\n            whelps = 8,\n        }\n        return true\n    elseif a[''] and id == 4 then\n        if e == 'DRAKE_ACTIVE' then\n            a[''].active = true\n        elseif e == 'DRAKE_DEAD' then\n            local whelps = ...\n            a[''].whelps = whelps\n            if whelps == 0 then\n                a[''].dead = true\n            end\n        end\n        a[''].changed = true\n        return true\n    end\nend",
