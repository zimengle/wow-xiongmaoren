["custom"] = "function(state, event, encounterId, subEvent,_,_,_,_,_,_,_,_,_, spellId)\n    if event == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        \n        if subEvent == 'SPELL_SUMMON' then\n            if spellId == 101614 then\n                state[''] = {\n                    show = true,\n                    changed = true,\n                    progressType = 'timed',\n                    autoHide = true,\n                    duration = 29,\n                    expirationTime = 20 + GetTime(),\n                }\n                return true\n            end\n        elseif subEvent == 'SPELL_AURA_APPLIED' then\n            if spellId == 101602 then\n                state[''] = {\n                    show = false,\n                    changed = true,\n                }\n                return true\n            end\n        end\n    end\nend\n\n\n",
