["custom"] = "function(a, e, unitId)\n    \n    if e == 'UNIT_ENTERED_VEHICLE' then\n        -- Ignoring Tank in Head\n        if WA_GetUnitDebuff(unitId, 89773) then return end \n        local unitName = UnitName(unitId)\n        a[unitName] = {\n            show = true,\n            changed = true,\n            unitName = unitName,\n        }\n        return true\n        \n    elseif e == 'UNIT_EXITED_VEHICLE' then\n        local unitName = UnitName(unitId)\n        a[unitName] = {\n            show = false,\n            changed = true,\n        }\n        return true\n    end\n    \nend",
