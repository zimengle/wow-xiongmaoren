["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(a, e, warning, counter)\n    if e == 'WA_MERFIN_BOSS_WARNING' and warning == 'InvokeLightning' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            duration = 4,\n            expirationTime = 4 + GetTime(),\n            autoHide = true,\n        }\n        return true\n    end\nend",
["spellIds"] = {
},
["events"] = "WA_MERFIN_BOSS_WARNING",
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
},
["untrigger"] = {
