["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(states, e, ...)\n    if e == 'OPTIONS' then\n        for i = 1, 3 do\n            local duration = math.random(3, 10)\n            local newState = {\n                progressType   = 'timed',\n                autoHide       = false,\n                duration       = duration,\n                expirationTime = duration + GetTime(),\n                name           = Merfin:L('Special #2 Cooldown Bar'),\n                nextCount      = math.random(1, 10),\n            }\n            \n            states:Update(i, newState)\n        end\n    end\n    \n    if e == 'MERFIN_CD_HIDE' or e == 'MERFIN_CD_EMPH_SHOW' then\n        local encounterID, cooldown = ...\n        local stateName = encounterID .. cooldown.ID .. (cooldown.GUID or '')\n        states:Remove(stateName)\n        \n    elseif e == 'MERFIN_CD_SHOW_SPECIAL' then\n        local bar, encounterID, cooldown = ...\n        if bar ~= 2 then return end\n        \n        local stateName = encounterID .. cooldown.ID  .. (cooldown.GUID or '')\n        \n        local newState = {\n            progressType   = 'timed',\n            duration       = cooldown.duration,\n            expirationTime = cooldown.expirationTime,\n            autoHide       = cooldown.autoHide,\n            icon           = cooldown.icon,\n            name           = cooldown.name,\n            nextCount      = (cooldown.count or 0) + 1,\n            noCount        = cooldown.noCount,\n            cooldownId     = cooldown.ID,\n            sourceName     = cooldown.sourceName,\n            hasSrcName     = cooldown.sourceName ~= nil,\n        }\n        \n        states:Update(stateName, newState)\n    end\nend",
["events"] = "MERFIN_CD_SHOW_SPECIAL, MERFIN_CD_HIDE, MERFIN_CD_EMPH_SHOW",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    expirationTime = true,\n    cooldownId = {\n        display = 'Cooldown ID',\n        type = 'string',\n    },\n    noCount = {\n        display = 'Missing Counter',\n        type = 'bool'\n    },\n    hasSrcName = {\n        display = 'Has Source Name',\n        type = 'bool',\n    },\n}",
["custom_hide"] = "timed",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["customTriggerLogic"] = "",
["activeTriggerMode"] = 1,
},
