["[DP] [Tsulong] Sunbeam"] = {
["outline"] = "OUTLINE",
["wagoID"] = "H5gs0vTam",
["xOffset"] = 0,
["displayText_format_p_time_dynamic_threshold"] = 60,
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1505'\nlocal ID = 'Sunbeam'\n\nlocal function GetSpellInfoTable(spellID)\n    if WeakAuras.IsRetail() then\n        return C_Spell.GetSpellName(spellID), C_Spell.GetSpellTexture(spellID)\n    else\n        local name, _, icon = GetSpellInfo(spellID)\n        return name, icon\n    end\nend\n\nlocal name, icon = GetSpellInfoTable(122789)\n\nlocal options = {warningText = \"%icon @cffffff80%name@r %icon\"}\n\naura_env.StopCD = function()\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, {ID = ID})\nend\n\naura_env.StartCD = function(duration, autoHide)\n    local data = {\n        show = true,\n        autoHide = autoHide,\n        duration = duration,\n        expirationTime = duration + GetTime(),\n        ID = ID,\n        name = name,\n        icon = icon,\n        count = aura_env.count\n    }\n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function()\n    local data = {ID = ID, name = name, icon = icon, count = aura_env.count}\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "status",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, RAID_BOSS_EMOTE, TSULONG_PHASE",
["names"] = {
},
["check"] = "event",
["spellIds"] = {
},
["custom"] = "function(e, ...)\n    if e == 'RAID_BOSS_EMOTE' then\n        local msg = ...\n        if msg:find(\"spell:122789\") then\n            aura_env.count = aura_env.count + 1\n            aura_env.SendWarning()\n            \n            if GetTime() - aura_env.nightLast < 60 then\n                aura_env.StartCD(41)\n            else\n                aura_env.StopCD()\n            end\n        end\n        \n    elseif e == 'TSULONG_PHASE' then\n        local phaseID = ...\n        \n        if phaseID == 'NightPhase' then\n            aura_env.nightLast = GetTime()\n            \n        elseif phaseID == 'DayPhase' then\n            aura_env.StopCD()\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n        aura_env.StartCD(43)\n    end\nend",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "\n\n",
},
},
["disjunctive"] = "any",
["activeTriggerMode"] = -10,
},
