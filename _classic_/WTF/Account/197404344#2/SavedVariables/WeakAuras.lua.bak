["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local chatFrame = SELECTED_DOCK_FRAME\nlocal inputbox = chatFrame.editBox\nlocal e = aura_env\nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region) \n    e.btn:RegisterForClicks(\"AnyUp\",\"AnyDown\")\n    e.btn:SetScript(\"OnMouseUP\", function(self)\n            TogglePVPFrame()\n            region:SetAlpha(1)\n    end)\n    e.btn:SetScript(\"OnMouseDown\", function(self)\n            region:SetAlpha(0.5)\n    end)\n    e.btn:SetScript(\"OnEnter\",function(self)\n            GameTooltip:SetOwner(self, 'ANCHOR_TOP', 0,1)\n            GameTooltip:AddLine(\"PVP、排战场（H）\")\n            GameTooltip:Show()\n            region:SetScale(1.05)\n    end)\n    e.btn:SetScript(\"OnLeave\",function(self)\n            GameTooltip:Hide()\n            region:SetScale(1)\n    end)\n    e.btn:SetAllPoints(region)\nend\n\n\n\n\n",
},
},
