["custom"] = "local encounterID = '1507'\nlocal icon = 'DungeonSkull'\n\nlocal options = {\n    warningText = '%icon @cffffff80%name@r %icon',\n}\n\nlocal name = {\n    ['EchoForceDied'] = Merfin.GetTitleEJ(6569),\n    ['EchoAttenDied'] = Merfin.GetTitleEJ(6568),\n}\n\naura_env.SendWarning = function(ID)\n    local data = {\n        ID    = ID,\n        count = aura_env.count,\n        name  = name[ID],\n        icon  = icon,\n        isIconAtlas = true,\n    }\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
