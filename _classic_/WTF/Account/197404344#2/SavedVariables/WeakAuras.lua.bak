},
["useName"] = false,
["custom"] = "function(a, e, unitId)\n    \n    if e == 'OPTIONS' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'static',\n            value = math.random(1, 150000),\n            total = 150000,\n            unitName = WeakAuras.me,\n        }\n        return true\n    end\n    \n    if not e == 'UNIT_AURA' then\n        return\n    end\n    \n    if not unitId then\n        return\n    end\n    \n    --[[if not unitId:find('raid') then\n        return\n    end]]--\n    \n    local isDebuffed = WA_GetUnitDebuff(unitId, 105479)\n    \n    if isDebuffed then\n        local absorb = select(17, WA_GetUnitDebuff(unitId, 105479))\n        a[unitId] = {\n            show = true,\n            changed = true,\n            progressType = 'static',\n            value = absorb,\n            total = aura_env.total,\n            unitName = UnitName(unitId),\n        }\n        return true\n    elseif a[unitId] then\n        a[unitId].show = false\n        a[unitId].changed = true\n        return true\n    end\n    \nend",
