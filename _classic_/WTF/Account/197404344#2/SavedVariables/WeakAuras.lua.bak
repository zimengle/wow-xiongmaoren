["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(states, event, ...)\n    if event == 'UNIT_SPELLCAST_SUCCEEDED' then\n        local _,_, spellID = ...\n        \n        if spellID == aura_env.ringID then\n            states:Update('', { ticked = true })\n        end\n        \n    elseif event == 'STORM_STARTED' then\n        states:Update('', { \n                progressType = 'timed',\n                duration = 2,\n                expirationTime = 2 + GetTime(),\n                ticked = false \n        })\n        \n    elseif event == 'STORM_ENDED' then\n        states:Remove('')\n    end\nend",
["events"] = "STORM_STARTED, STORM_ENDED, UNIT_SPELLCAST_SUCCEEDED:boss1:boss2:boss3",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    ticked = {\n        display = 'Ticked',\n        type = 'bool'\n    }\n}",
