["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["finish"] = {
["message"] = "",
["do_message"] = false,
["message_type"] = "PRINT",
},
["init"] = {
["custom"] = "local nef_rp_id = 38625\n\nlocal gossips = {\n    [38625] = true, -- Nefarian\n    [38731] = true, -- Chimaeron 1\n    [38490] = true, -- Chimaeron 2\n    [38023] = true, -- Chimaeron 3\n    [38024] = true, -- Chimaeron 4\n    [38025] = true, -- Chimaeron 5\n}\n\nfunction aura_env.AutoSelect()\n    if IsControlKeyDown() then return end\n    local gossipInfo = C_GossipInfo.GetOptions()\n    local id = gossipInfo[1] and gossipInfo[1].gossipOptionID\n    if id and gossips[id] then \n        C_GossipInfo.SelectOption(id)\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["debuffType"] = "HELPFUL",
["custom"] = "function(e, ...)\n    if e == \"GOSSIP_SHOW\" then\n        aura_env.AutoSelect()\n    elseif e == 'MODIFIER_STATE_CHANGED' then\n        local mod, state = ...\n        if mod == 'LCTRL' or mod == 'RCTRL' then\n            if state == 0 then\n                aura_env.AutoSelect()\n            end\n        end\n    end\nend",
["events"] = "GOSSIP_SHOW, MODIFIER_STATE_CHANGED",
