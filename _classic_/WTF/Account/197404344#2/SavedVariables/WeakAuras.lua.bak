["[ODS] Arcane Annihilator Interrupt"] = {
["outline"] = "OUTLINE",
["wagoID"] = "SqAL2pX1r",
["parent"] = "[Merfin] T11 打断小助手",
["displayText"] = "%counter",
["yOffset"] = 0,
["anchorPoint"] = "LEFT",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "local UnitExists, UnitTarget, UnitGUID = UnitExists, UnitTarget, UnitGUID\nlocal GetNameplates = C_NamePlate.GetNamePlates\nlocal pairs = pairs\nlocal stformat, strfind = string.format, strfind\n\nlocal CONFIG = {\n    [1] = 99,\n    [2] = 1,\n    [3] = 2,\n    [4] = 3,\n}\naura_env.interrupt = CONFIG[aura_env.config.yourInterrupt]\n\nlocal GetGuidCreatureId = function(GUID)\n    local guidType,_, playerdbID,_,_, cid,_ = strsplit(\"-\", GUID or \"\")\n    if cid then\n        return tonumber(cid)\n    end\n    return 0\nend\n\nlocal mobId = 42166\nlocal casts = {}\n\nlocal GetNameplateCreatureId = function() \n    local nameplates = GetNameplates()\n    for _, plateData in pairs(nameplates) do\n        local namePlateNpcId = plateData.namePlateNpcId\n        if namePlateNpcId == mobId then\n            return plateData.UnitFrame.displayedUnit, plateData.namePlateUnitGUID\n        end\n    end\nend\n\naura_env['NAME_PLATE_UNIT_ADDED'] = function(a, nameplateId)\n    local unitGUID = UnitExists(nameplateId) and UnitGUID(nameplateId)\n    if unitGUID and GetGuidCreatureId(unitGUID) == mobId then\n        casts[unitGUID] = casts[unitGUID] or 1\n        a[unitGUID] = {\n            show = true,\n            changed = true,\n            counter = casts[unitGUID],\n            unit = nameplateId,\n        }\n        return true\n    end\nend\n\naura_env['NAME_PLATE_UNIT_REMOVED'] = function(a, nameplateId)\n    local unitGUID = UnitExists(nameplateId) and UnitGUID(nameplateId)\n    if unitGUID and GetGuidCreatureId(unitGUID) == mobId then\n        if a[unitGUID] then\n            a[unitGUID].show = false\n            a[unitGUID].changed = true\n            return true\n        end\n    end\nend\n\naura_env['ARCANE_ANNIHILATOR'] = function(a, destGUID)\n    if not casts[destGUID] then\n        casts[destGUID] = 1\n        if a[destGUID] then\n            a[destGUID].changed = true\n            a[destGUID].counter = casts[destGUID]\n            return true\n        end\n    else\n        if casts[destGUID] == 3 then\n            casts[destGUID] = 0\n        end\n        casts[destGUID] = casts[destGUID] + 1\n        if a[destGUID] then\n            a[destGUID].changed = true\n            a[destGUID].counter = casts[destGUID]\n            return true\n        end\n    end\nend\n\naura_env['OPTIONS'] = function(a)\n    a[''] = {\n        show = true,\n        changed = true,\n        counter = 2,\n    }\n    return true\nend\n\naura_env['STATUS'] = function(a)  \n    local nameplateId, nameplateGUID = GetNameplateCreatureId()\n    if not nameplateId then return end\n    casts[nameplateGUID] = casts[nameplateGUID] or 1\n    a[nameplateGUID] = {\n        show = true,\n        changed = true,\n        counter = casts[nameplateGUID],\n        unit = nameplateId,\n    }\n    return true\nend",
["do_custom"] = true,
},
},
