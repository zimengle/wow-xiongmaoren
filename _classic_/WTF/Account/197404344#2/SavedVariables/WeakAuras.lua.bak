["custom"] = "aura_env.ShowFrame = function(a, d)\n    a[''] = {\n        show = true,\n        autoHide = true,\n        changed = true,\n        progressType = 'timed',\n        duration = d,\n        expirationTime = d + GetTime()\n    }\n    return true\nend\n\naura_env.HideFrame = function(a)\n    if not a[''] then return end\n    a[''] = {\n        show = false,\n        autohide = true, \n    }\n    return true\nend\n\n",
