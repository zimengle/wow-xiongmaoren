["value"] = "function()\n    if WeakAuras.IsOptionsOpen() then return end\n    if not aura_env.last or GetTime() - aura_env.last > 3 then\n        aura_env.last = GetTime()\n        SendChatMessage('{rt8}', 'SAY')\n    end\nend\n\n\n\n",
