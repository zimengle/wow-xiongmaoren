["parent"] = "[Widget] Elegon Soaks",
["config"] = {
},
["anchorFrameFrame"] = "WeakAuras:[Anchor] Icon Widgets",
["regionType"] = "icon",
["animation"] = {
["start"] = {
["easeStrength"] = 3,
["type"] = "none",
["duration_type"] = "seconds",
["easeType"] = "none",
},
["main"] = {
