    [138898] = 0,\n    [140380] = 17,\n    [138759] = 10,\n    [138895] = 0,\n    [138973] = 30,\n    [138870] = 0,\n    \n    [146218] = 115,\n    [146296] = 115,\n    [146312] = 115,\n    \n    [125488] = 60,\n    [125489] = 60,\n    [125487] = 55,\n}\n\nDATA.EXTRA_PROCS = { \n}\n\nDATA.PPM = DATA.PPM or {}\n\nDATA.PPM.ITEMS = {\n    -- Kardris' Toxic Totem\n    [105540] = 0.92,\n    [104544] = 0.92,\n    [105291] = 0.92,\n    [102300] = 0.92,\n    [104793] = 0.92,\n    [105042] = 0.92,\n}\n\nDATA.PPM.ENCHANTS = {\n    [104993] = 2.2,   -- Jade Spirit\n    [142535] = 2.2,   -- Spirit of Conquest\n    [120032] = 2.53,  -- Dancing Steel\n    [142530] = 2.53,  -- Bloody Dancing Steel\n    [116660] = 3.67,  -- River's Song\n}\n\nDATA.PPM.META_GEMS = {\n    [137593] = 2.57,                         -- Indomitable Primal Diamond\n    [137590] = {                             -- Sinister Primal Diamond\n        MAGE    = {0.761, 0.302, 1.387},\n        WARLOCK = {0.625, 0.598, 0.509},\n        SHAMAN  = {1.891, 1, 1},\n        DRUID   = {1.872, 1, 1, 1},\n        PRIEST  = {1, 1, 0.933},\n        OTHER   = 1,\n        BASE    = 1.35\n    },\n    --[myClass == 'MONK' and 137331]    = 1.61, -- Courageous Primal Diamond\n    --[myClass == 'DRUID' and 137247]   = 1.61, -- Courageous Primal Diamond\n    --[myClass == 'PALADIN' and 137288] = 1.61, -- Courageous Primal Diamond\n    --[myClass == 'PRIEST' and 137323]  = 1.61, -- Courageous Primal Diamond\n    --[myClass == 'SHAMAN' and 137326]  = 1.61, -- Courageous Primal Diamond\n}\n\n-- [procId] = true (f.e. Balance Idols)\nDATA.NO_COOLDOWN_ITEMS = {\n    [104423] = true,\n    [104510] = true,\n    [104509] = true,\n    [120032] = true,\n    [118335] = true,\n    [118334] = true,\n    [142530] = true,\n    [116631] = true,\n    [116660] = true, \n    [53365]  = true,\n    [109085] = true,  \n}\n\nlocal INVALID_EVENTS = {\n    SPELL_DISPEL            = true,\n    SPELL_DISPEL_FAILED     = true,\n    SPELL_STOLEN            = true,\n    SPELL_AURA_BROKEN       = true,\n    SPELL_AURA_BROKEN_SPELL = true,\n    SPELL_CAST_FAILED       = true,\n    SPELL_PERIODIC_HEAL     = true,\n    SPELL_CAST_SUCCESS      = true,\n}\n\nlocal debug = function(...)\n    if not aura_env.config.debug then return end\n    print(...)\nend\n\n--> Putting Global functions to local scope\nlocal tinsert, stformat, substr = table.insert, string.format, string.sub\n\n\n--> Setting constants\nlocal WA_MAIN_EVENT = 'WA_MERFIN_EQUIPPED_ITEMS'\nlocal HEX_NO_GUID = \"0x0000000000000000\"\nlocal MY_GUID = UnitGUID(\"player\")\n\naura_env.schedulers = {}\n\nlocal backend = aura_env\n\n-- Main Table with full info about item (keyed by equipment slot)\nbackend.items = {}\nbackend.equipmentSlots = {}\nbackend.procs = {}\nbackend.extraProcs = {}\n\n--> :Base[Druid] helpful funcs\n\nlocal SendEvent = function(event, ...)\n    WeakAuras.ScanEvents(WA_MAIN_EVENT, event, ...)\nend\n\nlocal GetValuesTable = function(value)\n    local t = {}\n    if type(value) == \"table\" then\n        for _, v in pairs(value) do\n            tinsert(t, v)\n        end\n    else\n        tinsert(t, value)\n    end\n    return t\nend\n\nlocal GetSlotItemInfo = function(slotID)\n    local itemLink = GetInventoryItemLink(\"player\", slotID)\n    if itemLink then\n        local itemString = string.match(itemLink, \"item:([%-?%d:]+)\")\n        if itemString then\n            local itemComponents = {strsplit(\":\", itemString)}\n            local itemID   = tonumber(itemComponents[1])\n            local enchantID= tonumber(itemComponents[2])\n            local metaGemID= tonumber(itemComponents[3])\n            local tinkerId = tonumber(itemComponents[10])\n            return itemID, enchantID, metaGemID, tinkerId\n        end\n    end\n    return nil, nil, nil\nend\n\n-- HARD CLEAR of everything tied to this slot (scheduler, maps, state)\nlocal ClearSlot = function(equipmentSlot)\n    -- cancel PPM ticker (используем тот же способ, что и в твоём коде ниже)\n    local scheduler = aura_env.schedulers[equipmentSlot]\n    if scheduler then\n        WeakAuras.timer:CancelTimer(scheduler)\n        aura_env.schedulers[equipmentSlot] = nil\n    end\n    \n    -- drop spellId -> slot map\n    for pid, slots in pairs(backend.procs) do\n        if slots[equipmentSlot] then\n            slots[equipmentSlot] = nil\n            if not next(slots) then backend.procs[pid] = nil end\n        end\n    end\n    \n    -- drop extraProcId -> slot map\n    for eid, slots in pairs(backend.extraProcs) do\n        if slots[equipmentSlot] then\n            slots[equipmentSlot] = nil\n            if not next(slots) then backend.extraProcs[eid] = nil end\n        end\n    end\n    \n    backend.items[equipmentSlot] = nil\n    backend.equipmentSlots[equipmentSlot] = nil\nend\n\n-- @returns string (\"NO_CD\",\"ON_USE\",\"INTERNAL\",\"PPM\"), number cooldown? \nlocal GetCooldownInfo = function(equipmentSlot, procId, itemId)\n    local _,_, enable = GetInventoryItemCooldown(\"player\", equipmentSlot)\n    \n    if DATA.PPM.ITEMS[itemId] then\n        return 'PPM'\n    end \n    if DATA.PPM.ENCHANTS[procId] then\n        return 'PPM'\n    end\n    if DATA.PPM.META_GEMS[procId] then\n        return 'PPM'\n    end\n    \n    if enable == 1 and not DATA.COOLDOWNS[procId] then\n        return \"ON_USE\", nil\n    end\n    \n    if enable == 0 or DATA.COOLDOWNS[procId] then\n        local noCd = DATA.NO_COOLDOWN_ITEMS[procId]\n        if noCd then\n            return \"NO_CD\", 0\n        end\n        return \"INTERNAL\", DATA.COOLDOWNS[procId] or 45\n    end\nend\n\nlocal OnUse = function(equipmentSlot, itemId)\n    local startTime, duration = GetInventoryItemCooldown(\"player\", equipmentSlot)\n    if duration > 0 then\n        local expirationTime = startTime + duration\n        if expirationTime > (backend.items[equipmentSlot].expirationTime or 0) then\n            backend.items[equipmentSlot].duration = duration\n            backend.items[equipmentSlot].expirationTime = expirationTime\n            return true\n        end\n    end\nend\n\nlocal OnExtraProc = function(equipmentSlot, extraProcId)\n    local aura = C_UnitAuras.GetPlayerAuraBySpellID(extraProcId)\n    backend.items[equipmentSlot].stacks = aura and aura.applications or 0\nend\n\nlocal OnProc = function(equipmentSlot, itemId, spellId)\n    local buff = C_UnitAuras.GetPlayerAuraBySpellID(spellId)\n    local type = backend.items[equipmentSlot].type\n    \n    if type == \"INTERNAL\" and buff and buff.expirationTime then        \n        local cooldown = backend.items[equipmentSlot].cooldown\n        backend.items[equipmentSlot].duration = cooldown\n        backend.items[equipmentSlot].expirationTime = buff.expirationTime - buff.duration + cooldown\n    elseif type == 'PPM' then\n        backend.items[equipmentSlot].lastProcTime = GetTime()\n    end\n    \n    backend.items[equipmentSlot].isProc = true\n    backend.items[equipmentSlot].procTexture = buff and buff.icon or backend.items[equipmentSlot].procTexture\n    backend.items[equipmentSlot].procDuration = buff and buff.duration or 0\n    backend.items[equipmentSlot].procExpirationTime = buff and buff.expirationTime or GetTime()\n    backend.items[equipmentSlot].stacks = (buff and buff.applications) or 0\n    SendEvent('ITEM_CHANGED', equipmentSlot)\nend\n\nlocal PPMOnUpdate = function(equipmentSlot)\n    local data = backend.items[equipmentSlot]\n    if not data or not data.basePPM or not data.lastProcTime then return end\n    \n    local basePPM = data.basePPM\n    local rppm = basePPM\n    local timeSinceLastProc = GetTime() - data.lastProcTime\n    local expectedInterval = 60 / basePPM\n    \n    local multiples = math.max(1, 1 + ((math.min(120, timeSinceLastProc) / expectedInterval) - 1.5) * 3)\n    local ppm\n    local rate = rppm * 10 / 60\n    if rate * multiples >= 1 then\n        ppm = 'max'\n    else\n        ppm = rppm * multiples\n    end\n    \n    if ppm ~= data.ppm then\n        data.ppm = ppm\n        SendEvent('ITEM_CHANGED', equipmentSlot)\n    end\nend\n\nlocal StartPPM = function(equipmentSlot, itemId)\n    if aura_env.schedulers[equipmentSlot] then return end\n    aura_env.schedulers[equipmentSlot] = C_Timer.NewTicker(0.1, function()\n            PPMOnUpdate(equipmentSlot)\n    end)\nend\n\nlocal InitEquipmentSlot = function(equipmentSlot)\n    local itemId, enchantId, metaGem = GetSlotItemInfo(equipmentSlot)\n    \n    if itemId then\n        local procId = DATA.ITEMS[itemId] or DATA.ENCHANTS[enchantId] or DATA.GEMS[metaGem]\n        if procId or select(3, GetInventoryItemCooldown(\"player\", equipmentSlot)) == 1 then\n            -- полная очистка слота перед перерегистрацией (важно при свапах)\n            ClearSlot(equipmentSlot)\n            \n            backend.equipmentSlots[equipmentSlot] = itemId\n            local anyProcId = procId and (type(procId) == 'table' and procId[1] or procId)\n            backend.items[equipmentSlot] = {\n                itemId         = itemId,\n                procs          = {},\n                extraProc      = DATA.EXTRA_PROCS[itemId],\n                itemTexture    = C_Item.GetItemIconByID(itemId),\n                procTexture    = anyProcId and C_Spell.GetSpellTexture(anyProcId),\n                expirationTime = GetTime(),\n                equipmentSlot  = equipmentSlot,\n                isEnchant      = DATA.ENCHANTS[enchantId] ~= nil,\n                isGem          = DATA.GEMS[metaGem] ~= nil\n            }\n            \n            if not procId then\n                backend.items[equipmentSlot].type = \"ON_USE\"\n                return true\n            end\n            \n            local p = GetValuesTable(procId)\n            for _, pid in pairs(p) do\n                tinsert(backend.items[equipmentSlot].procs, pid)\n                backend.procs[pid] = backend.procs[pid] or {}\n                backend.procs[pid][equipmentSlot] = true\n                \n                if not backend.items[equipmentSlot].type then\n                    local itemType, cooldown = GetCooldownInfo(equipmentSlot, pid, itemId)\n                    backend.items[equipmentSlot].type = itemType\n                    if itemType == \"INTERNAL\" then\n                        backend.items[equipmentSlot].cooldown = cooldown\n                    elseif itemType == 'PPM' then\n                        local ppmData = DATA.PPM.ITEMS[itemId] or DATA.PPM.ENCHANTS[pid] or DATA.PPM.META_GEMS[pid]\n                        local ppm\n                        if type(ppmData) == 'table' then\n                            local spec = C_SpecializationInfo.GetSpecialization()\n                            if ppmData[myClass] and ppmData[myClass][spec] then\n                                ppm = ppmData[myClass][spec] * ppmData.BASE\n                            else\n                                ppm = ppmData.OTHER * ppmData.BASE\n                            end\n                        else\n                            ppm = ppmData\n                        end\n                        backend.items[equipmentSlot].basePPM = ppm\n                        backend.items[equipmentSlot].lastProcTime = GetTime()\n                    end\n                end\n            end\n            \n            local extraProcId = DATA.EXTRA_PROCS[itemId]\n            if extraProcId then\n                backend.extraProcs[extraProcId] = backend.extraProcs[extraProcId] or {}\n                backend.extraProcs[extraProcId][equipmentSlot] = true\n            end\n            if enchantId then backend.items[equipmentSlot].enchantId = enchantId end\n            if metaGem then backend.items[equipmentSlot].metaGem = metaGem end\n            \n            return true\n        end\n    end\n    \n    -- нет предмета/механики — подчистить следы слота\n    ClearSlot(equipmentSlot)\nend\n\n--> Frontend Initialize\n\nlocal frontend = {}\n\nfrontend.GetConfig = function(link_to_frontend)\n    local config = link_to_frontend.config\n    local settings = {}\n    \n    local displayOpt = config.display\n    settings.showAlways = displayOpt.showAlways\n    settings.showProc = displayOpt.showProc\n    settings.showCd = displayOpt.showCd\n    settings.itemTextureAlways = displayOpt.itemTextureAlways\n    settings.glowReadyToUse = displayOpt.glowReadyToUse\n    settings.glowProc = displayOpt.glowProc\n    settings.disableGlowNoCd = displayOpt.disableGlowNoC\n    settings.registerAnyOnUse = displayOpt.registerAnyOnUse\n    \n    settings.showICD = displayOpt.showICD\n    settings.showUSE = displayOpt.showUSE\n    settings.showNOCD = displayOpt.showNOCD\n    settings.showPPM = displayOpt.showPPM\n    \n    for id, enabled in ipairs(displayOpt.equipmentSlots) do\n        if enabled then\n            settings.equipmentSlots = settings.equipmentSlots or {}\n            settings.equipmentSlots[id] = true\n        end\n    end\n    \n    settings.enchants = {}\n    for id, enabled in pairs(displayOpt.enchants) do\n        if enabled then\n            local idn = tonumber(id)\n            settings.enchants[idn] = true\n        end\n    end\n    \n    settings.gems = {}\n    for id, enabled in pairs(displayOpt.validMetaGems) do\n        if enabled then\n            local idn = tonumber(id)\n            settings.gems[idn] = true\n        end\n    end\n    \n    settings.orders = {}\n    for slotIdStr, index in pairs(displayOpt.order) do\n        local slotId = tonumber(slotIdStr)\n        settings.orders[slotId] = index\n    end\n    \n    local advancedOpt = config.advanced\n    settings.disabledItems = {}\n    settings.disabledGlows = {}\n    for _, data in ipairs(advancedOpt) do\n        local itemId = data.itemId\n        if data.disable then\n            settings.disabledItems[itemId] = true\n        end\n        if data.disableGlow then\n            settings.disabledGlows[itemId] = true\n        end\n    end\n    \n    local whitelist = config.whitelist \n    settings.whitelistEnable = config.whitelistEnable\n    settings.whitelistItems = {}\n    for _, data in pairs(whitelist) do\n        local itemId = data.itemId\n        if data.enable then\n            settings.whitelistItems[itemId] = true\n        end\n    end\n    \n    link_to_frontend.settings = settings\n    return true\nend \n\nfrontend.Register = function(link_to_frontend)\n    if frontend.GetConfig(link_to_frontend) then\n        return true\n    end\nend\n\nbackend.Init = function()\n    local anyEquipmentSlot = false\n    for equipmentSlot = 1, 18 do\n        if InitEquipmentSlot(equipmentSlot) then\n            anyEquipmentSlot = true\n        end\n    end\n    if anyEquipmentSlot then\n        for equipmentSlot, itemId in pairs(backend.equipmentSlots) do\n            local isBuffed = false\n            for _, procId in ipairs(backend.items[equipmentSlot].procs) do\n                if WA_GetUnitBuff(\"player\", procId) then\n                    isBuffed = true\n                    OnProc(equipmentSlot, itemId, procId)\n                    if backend.items[equipmentSlot].extraProc then\n                        OnExtraProc(equipmentSlot, backend.items[equipmentSlot].extraProc)\n                    end\n                    break\n                end\n            end\n            if not isBuffed then\n                local itemData = backend.items[equipmentSlot]\n                itemData.isProc = false\n                itemData.stacks = 0\n                \n                if itemData.type == \"ON_USE\" then\n                    OnUse(equipmentSlot, itemData.itemId)\n                elseif itemData.type == 'PPM' then\n                    StartPPM(equipmentSlot, itemData.itemId)\n                end\n            end\n        end\n    end\n    \n    backend.initialized = true\n    SendEvent('BACKEND_INITIALIZED', backend)\nend\n\n--> Events Handler\n\nlocal OnEvent = {}\n\nOnEvent['OPTIONS'] = function()\n    backend.initialized = false\n    for equipmentSlot, scheduler in pairs(aura_env.schedulers) do\n        if scheduler then\n            scheduler:Cancel()\n            aura_env.schedulers[equipmentSlot] = nil\n        end\n    end\nend\n\nOnEvent['STATUS'] = function() end\n\nOnEvent['COMBAT_LOG_EVENT_UNFILTERED'] = function(_, subEvent, _, sourceGUID, _,_,_, destGUID, _,_,_, spellId)\n    if not subEvent or INVALID_EVENTS[subEvent] then return end\n    if destGUID ~= MY_GUID and sourceGUID ~= MY_GUID then return end\n    \n    local slotsMap = backend.procs[spellId]\n    if slotsMap then\n        if spellId == 89091 and subEvent == 'SPELL_DAMAGE' then return end\n        \n        for equipmentSlot in pairs(slotsMap) do\n            local itemId = backend.equipmentSlots[equipmentSlot]\n            if itemId and GetInventoryItemID(\"player\", equipmentSlot) == itemId then\n                local type = backend.items[equipmentSlot].type\n                if subEvent == \"SPELL_AURA_APPLIED\"\n                or subEvent == \"SPELL_AURA_REFRESH\"\n                or subEvent == \"SPELL_AURA_APPLIED_DOSE\"\n                or subEvent == \"SPELL_AURA_REMOVED_DOSE\" then\n                    OnProc(equipmentSlot, itemId, spellId)\n                elseif subEvent == \"SPELL_AURA_REMOVED\" then\n                    backend.items[equipmentSlot].isProc = false\n                    backend.items[equipmentSlot].stacks = 0\n                    if type == \"ON_USE\" then\n                        OnUse(equipmentSlot, itemId)\n                    elseif type == \"NO_CD\" then\n                        backend.items[equipmentSlot].duration = 0\n                        backend.items[equipmentSlot].expirationTime = GetTime()\n                    elseif type == 'PPM' then\n                        StartPPM(equipmentSlot, itemId)\n                    end\n                elseif type == \"INTERNAL\" then\n                    backend.items[equipmentSlot].isProc = false\n                    backend.items[equipmentSlot].duration = backend.items[equipmentSlot].cooldown\n                    backend.items[equipmentSlot].expirationTime = backend.items[equipmentSlot].duration + GetTime()\n                end\n                SendEvent('ITEM_CHANGED', equipmentSlot)\n            end\n        end\n        return true\n    end\n    \n    local extraMap = backend.extraProcs[spellId]\n    if extraMap then\n        if subEvent == \"SPELL_AURA_APPLIED\"\n        or subEvent == \"SPELL_AURA_REFRESH\"\n        or subEvent == \"SPELL_AURA_APPLIED_DOSE\"\n        or subEvent == \"SPELL_AURA_REMOVED_DOSE\"\n        or subEvent == \"SPELL_AURA_REMOVED\" then\n            for equipmentSlot in pairs(extraMap) do\n                OnExtraProc(equipmentSlot, spellId)\n                SendEvent('ITEM_CHANGED', equipmentSlot)\n            end\n            return true\n        end\n    end\n    \n    if spellId == 110909 and subEvent == 'SPELL_AURA_REMOVED' then\n        backend.Init()\n    end\nend\n\nOnEvent['PLAYER_EQUIPMENT_CHANGED'] = function(equipmentSlot, isEmpty)\n    local timestamp = GetTime()\n    \n    -- полная очистка текущего слота (чтобы свапы не оставляли старые ссылки)\n    ClearSlot(equipmentSlot)\n    \n    if not isEmpty and InitEquipmentSlot(equipmentSlot) then\n        local itemId2 = backend.equipmentSlots[equipmentSlot]\n        local type2 = backend.items[equipmentSlot].type\n        \n        backend.items[equipmentSlot].icon = backend.items[equipmentSlot].itemTexture\n        backend.items[equipmentSlot].stacks = 0\n        backend.items[equipmentSlot].isProc = false\n        \n        if type2 == \"ON_USE\" then\n            OnUse(equipmentSlot, itemId2)\n        elseif type2 == \"INTERNAL\" and equipmentSlot ~= 15 then\n            local currentCooldown = (backend.items[equipmentSlot].expirationTime or 0) - timestamp\n            if currentCooldown > 30 or currentCooldown < (backend.items[equipmentSlot].cooldown or 0) then\n                backend.items[equipmentSlot].duration = backend.items[equipmentSlot].cooldown\n                backend.items[equipmentSlot].expirationTime = timestamp + (backend.items[equipmentSlot].cooldown or 0)\n            end\n        elseif type2 == \"NO_CD\" then\n            if equipmentSlot ~= 18 then\n                backend.items[equipmentSlot].duration = 30\n                backend.items[equipmentSlot].expirationTime = timestamp + 30\n            end\n        elseif type2 == 'PPM' then\n            StartPPM(equipmentSlot, itemId2)\n        end\n    end\n    \n    SendEvent('ITEM_CHANGED', equipmentSlot)\nend\n\nOnEvent['BAG_UPDATE_COOLDOWN'] = function()\n    for equipmentSlot, itemId in pairs(backend.equipmentSlots) do\n        if GetInventoryItemID(\"player\", equipmentSlot) == itemId\n        and backend.items[equipmentSlot]\n        and backend.items[equipmentSlot].type == \"ON_USE\"\n        and OnUse(equipmentSlot, itemId) then\n            backend.items[equipmentSlot].stacks = 0\n            SendEvent('ITEM_CHANGED', equipmentSlot)\n        end\n    end\nend\n\nOnEvent['PLAYER_LEAVING_WORLD'] = function() end\n\nOnEvent['PLAYER_ENTERING_WORLD'] = function()\n    if backend.saved then\n        backend.saved[WeakAuras.me] = nil\n    end\nend\n\nOnEvent['PLAYER_SPECIALIZATION_CHANGED'] = function()\n    backend.Init()\nend\n\nOnEvent[WA_MAIN_EVENT] = function(subEvent, ...)\n    if subEvent == 'REGISTER_FRONTEND' then\n        local link_to_frontend = ...\n        if frontend.Register(link_to_frontend) then\n            SendEvent('REGISTER_FRONTEND_FINISHED', link_to_frontend.id)\n        end\n    end\nend\n\nbackend.OnBackendEvent = function(e, ...)\n    if e == 'STATUS' then\n        backend.Init()\n    elseif e == WA_MAIN_EVENT or backend.initialized then\n        return OnEvent[e](...)\n    end\nend\n\nlocal BuildState = function(settings, itemData, itemId)\n    if not settings then return end\n    \n    local isValidItemType = (itemData.type == 'INTERNAL' and settings.showICD)\n    or (itemData.type == 'ON_USE' and settings.showUSE)\n    or (itemData.type == 'NO_CD'  and settings.showNOCD)\n    or (itemData.type == 'PPM'    and settings.showPPM)\n    if not isValidItemType then return { show = false, changed = true } end\n    \n    local isValidWhitelist = not settings.whitelistEnable or settings.whitelistItems[itemId]\n    if not isValidWhitelist then return { show = false, changed = true } end\n    \n    local isValidItem = settings.equipmentSlots[itemData.equipmentSlot]\n    and (not itemData.enchantId or not DATA.ENCHANTS[itemData.enchantId] or settings.enchants[itemData.enchantId])\n    and (not itemData.metaGem   or not DATA.GEMS[itemData.metaGem]       or settings.gems[itemData.metaGem])\n    and not settings.disabledItems[itemId]\n    if not isValidItem then return { show = false, changed = true } end\n    \n    local registerAnyOnUse = (itemData.enchantId and DATA.ENCHANTS[itemData.enchantId] and settings.enchants[itemData.enchantId])\n    or (itemData.metaGem and DATA.GEMS[itemData.metaGem] and settings.gems[itemData.metaGem])\n    or DATA.ITEMS[itemId]\n    or (settings.registerAnyOnUse and itemData.type == 'ON_USE')\n    if not registerAnyOnUse then return { show = false, changed = true } end\n    \n    local isProc = itemData.isProc\n    local show = settings.showAlways\n    or (settings.showCd and (GetTime() < (itemData.expirationTime or 0) or (settings.showProc and isProc)))\n    or (settings.showProc and isProc)\n    if not show then return { show = false, changed = true } end\n    \n    local forcedProcTexture = itemData.isEnchant or itemData.isGem\n    local icon\n    if forcedProcTexture or (isProc and settings.showProc and not settings.itemTextureAlways) then\n        icon = itemData.procTexture\n    else\n        icon = itemData.itemTexture\n    end\n    \n    return {\n        show            = true,\n        progressType    = 'timed',\n        changed         = true,\n        autoHide        = not settings.showAlways,\n        duration        = (isProc and settings.showProc) and (itemData.procDuration or 0) or (itemData.duration or 0),\n        expirationTime  = (isProc and settings.showProc) and (itemData.procExpirationTime or GetTime()) or (itemData.expirationTime or GetTime()),\n        icon            = icon,\n        stacks          = (isProc and settings.showProc) and (itemData.stacks or 0) or 0,\n        isEnchant       = itemData.isEnchant,\n        itemType        = itemData.type,\n        itemId          = itemId,\n        isProc          = isProc,\n        equipmentSlot   = itemData.equipmentSlot,\n        showProc        = settings.showProc,\n        disableGlowNoCd = settings.disableGlowNoCd,\n        disabledGlow    = settings.disabledGlows[itemId],\n        index           = settings.orders[itemData.equipmentSlot],\n        ppm             = itemData.ppm,\n    }\nend\n\nbackend.OnFrontendEvent = function(a, subEvent, link_to_frontend, ...)\n    local settings = link_to_frontend.settings\n    \n    if subEvent == 'REGISTER_FRONTEND_FINISHED' then \n        local frontendId = ...\n        if frontendId == link_to_frontend.id then\n            local anyState = false\n            for equipmentSlot, itemId in pairs(backend.equipmentSlots) do\n                if settings.equipmentSlots[equipmentSlot] then\n                    local itemData = backend.items[equipmentSlot]\n                    local state = BuildState(settings, itemData, itemId)\n                    a[equipmentSlot] = state\n                    anyState = true\n                end\n            end\n            return anyState\n        end\n    elseif subEvent == 'ITEM_CHANGED' then\n        local equipmentSlot = ...\n        if not backend.equipmentSlots[equipmentSlot] then\n            if a[equipmentSlot] then\n                a[equipmentSlot].show = false\n                a[equipmentSlot].changed = true\n                return true\n            end\n        else\n            local itemId = backend.equipmentSlots[equipmentSlot]\n            local itemData = backend.items[equipmentSlot]\n            local state = BuildState(settings, itemData, itemId)\n            a[equipmentSlot] = state\n            return true\n        end\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
