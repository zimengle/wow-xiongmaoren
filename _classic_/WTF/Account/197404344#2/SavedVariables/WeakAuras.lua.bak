["sparkHeight"] = 30,
["texture"] = "Solid",
["anchorFrameType"] = "SCREEN",
["sparkTexture"] = "Interface\\AddOns\\WeakAuras\\Media\\Textures\\Square_FullWhite",
["spark"] = false,
["tocversion"] = 50501,
["sparkHidden"] = "NEVER",
["semver"] = "1.3.2",
