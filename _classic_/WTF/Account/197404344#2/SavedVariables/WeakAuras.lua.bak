["exrtLastSync"] = 1751209613,
["uid"] = "suglFYuoOc6",
["automaticWidth"] = "Auto",
["animation"] = {
["start"] = {
["translateType"] = "bounceDecay",
["scalex"] = 1,
["colorA"] = 1,
["colorG"] = 1,
["use_translate"] = true,
["type"] = "custom",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local prog = (progress * 3.5) % 1\n    local bounce = math.ceil(progress * 3.5)\n    local bounceDistance = math.sin(prog * math.pi) * (bounce / 4)\n    return startX + (bounceDistance * deltaX), startY + (bounceDistance * deltaY)\nend\n",
["preset"] = "bounceDecay",
["alpha"] = 0,
["duration"] = "0.3",
["y"] = 10,
["x"] = 10,
["colorR"] = 1,
["rotate"] = 0,
["scaley"] = 1,
["easeStrength"] = 3,
["duration_type"] = "seconds",
["colorB"] = 1,
},
["main"] = {
["translateType"] = "shake",
["scalex"] = 1,
["colorA"] = 1,
["colorG"] = 1,
["use_translate"] = true,
["type"] = "custom",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local prog\n    if(progress < 0.25) then\n        prog = progress * 4\n    elseif(progress < .75) then\n        prog = 2 - (progress * 4)\n    else\n        prog = (progress - 1) * 4\n    end\n    return startX + (prog * deltaX), startY + (prog * deltaY)\nend\n",
