{
["trigger"] = -1,
["op"] = "FRAME_UPDATE",
["variable"] = "customcheck",
["value"] = "function()\n    if WeakAuras.IsOptionsOpen() then return end\n    if not Merfin or not Merfin.PlaySound then return end\n    local curTime = GetTime()\n    if curTime - (aura_env.last or 0) > 1 then\n        aura_env.last = curTime\n        local remTime = math.ceil(aura_env.states[1].expirationTime - curTime)   \n        if remTime <= 0 then return end\n        remTime = tostring(remTime)\n        local voiceActor = Merfin.L  == 'ruRU' and 'Fondago' or 'Sally'\n        Merfin.PlaySound(voiceActor .. ' - ' .. remTime)\n    end\nend",
},
