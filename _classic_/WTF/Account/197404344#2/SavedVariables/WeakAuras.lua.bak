["sound"] = "Interface\\Addons\\SharedMedia_Rurutia\\Rurutia\\【露露】目标是你.ogg",
["custom"] = "local GetMark = function()\n    local formatted = {\n        ['ruRU'] = '{Череп}'\n    }\n    \n    local L = GetLocale()\n    if formatted[L] then\n        return formatted[L]\n    end\n    return '{rt8}'\nend\n\n\nlocal mark = GetMark()\nSendChatMessage(mark, 'YELL')",
