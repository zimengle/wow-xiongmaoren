["spellIds"] = {
},
["custom"] = "function(states, event, encounterID, cooldown, type)\n    if event == 'MERFIN_PREWARNING_SHOW' then\n        if cooldown.ID ~= 'Annihilate' then return end\n        local newState = {\n            show            = true,\n            changed         = true,\n            progressType    = 'timed',\n            autoHide        = true,\n            duration        = 5,\n            expirationTime  = 5 + GetTime(),\n            name            = cooldown.name,\n            enableCountdown = cooldown.countdown,\n            voiceActorIndex = cooldown.voiceActorIndex,\n        }\n        states:Update('', newState)\n    end\n    \n    \n    if event == 'MERFIN_PREWARNING_HIDE' then\n        if cooldown.ID ~= 'Annihilate' then return end\n        states:Remove('')\n    end\nend",
["type"] = "custom",
