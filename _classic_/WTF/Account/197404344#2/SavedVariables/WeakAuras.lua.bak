["custom"] = "function(a, e)\n    if e == 'OPTIONS' then\n        for i = 1, 3 do\n            a[i] = {\n                show = true,\n                changed = true,\n                progressType = 'timed',\n                duration = 5,\n                expirationTime = 5 + GetTime(),\n                autoHide = true, \n                unitName = WeakAuras.me,\n            }\n        end\n        return true\n    elseif e == 'WA_DELAYED_PLAYER_ENTERING_WORLD' then\n        for i = 1, 3 do\n            a[i] = {\n                show = true,\n                changed = true,\n                progressType = 'timed',\n                duration = 0.1,\n                expirationTime = 0.1 + GetTime(),\n                autoHide = true, \n                unitName = WeakAuras.me,\n            }\n        end\n        return true\n    end\nend",
