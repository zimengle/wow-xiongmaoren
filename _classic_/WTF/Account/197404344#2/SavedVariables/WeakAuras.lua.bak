},
},
["activeTriggerMode"] = -10,
},
["displayText_format_p_time_mod_rate"] = true,
["internalVersion"] = 87,
["selfPoint"] = "BOTTOM",
["desc"] = "在登录时禁用暴雪插件性能分析，可大幅度优化帧数。\n\n更新自定义选项，可以选择是否在聊天信息输出插件工作信息。\n\nby Luckyone，露露汉化+移植WLK可用版。\n\nMade by Luckyone.\n\nContact: https://discord.luckyone.dev\n\nhttps://wago.io/DisableCPUProfiling/2\n",
