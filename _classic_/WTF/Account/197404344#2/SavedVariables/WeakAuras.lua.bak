["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["custom"] = "function(a, e,_, mechanic,_,_,_,_, stacks)\n    if e == 'WA_MERFIN_RAID_HANDLER' \n    and mechanic == 'deep_breath' \n    and stacks and stacks >= 0 then\n        if not a[''] then  \n            a[''] = {\n                show = true,\n                changed = true,\n                progressType = 'static',\n                total = 3,\n            }\n        end\n        a[''].value = stacks\n        a[''].changed = true\n        if stacks == 3 then\n            C_Timer.After(3, function() WeakAuras.ScanEvents('DEEP_BREATH_GONZO') end)\n        end\n        return true\n        \n    elseif e == 'DEEP_BREATH_GONZO' and a[''] then\n        a[''].show = false\n        a[''].changed = true\n        return true\n    elseif e == 'OPTIONS' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'static',\n            value = 1,\n            total = 3,\n        }\n        return true\n    end\nend\n\n\n",
["events"] = "WA_MERFIN_RAID_HANDLER, DEEP_BREATH_GONZO",
["custom_type"] = "stateupdate",
