["message"] = "Throw Totem",
["custom"] = "local GetMark = function()\n    local formatted = {\n        ['ruRU'] = '{Круг}'\n    }\n    \n    local L = GetLocale()\n    if formatted[L] then\n        return formatted[L]\n    end\n    return '{rt2}'\nend\n\n\nlocal mark = GetMark()\nSendChatMessage(mark .. ' Totem on ' .. WeakAuras.me .. ' ' .. mark, 'YELL')\n\n\n\n",
