["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1506'\nlocal ID          = 'AnimatedProtector'\n\nlocal name = C_EncounterJournal.GetSectionInfo(6224).title\nlocal icon = 135862\n\nlocal options = {warningText = \"%icon @cffff8b17%name@r %icon\"}\n\naura_env.SendWarning = function()\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID    = ID,\n            name  = name,\n            icon  = icon,\n            count = aura_env.count,\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "status",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED",
["names"] = {
},
["check"] = "event",
["spellIds"] = {
},
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_AURA_APPLIED' then\n            if spellID == 123250 then -- Protect\n                aura_env.count = aura_env.count + 1\n                aura_env.SendWarning()\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
["debuffType"] = "HELPFUL",
