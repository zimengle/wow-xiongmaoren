["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\nlocal e = aura_env\nlocal region = WeakAuras.GetRegion(e.id)\n\nif not _G[e.id..\"Button\"] then\n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, \"SecureActionButtonTemplate\")\n    e.btn:RegisterForClicks(\"LeftButtonDown\", \"RightButtonUp\", \"RightButtonDown\", \"MiddleButtonUp\", \"MiddleButtonDown\")\n    e.btn:SetAttribute(\"type1\", \"macro\")\n    e.btn:SetAttribute(\"type2\", \"macro\")\n    e.btn:SetAttribute(\"type3\", \"macro\")\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\nbtn:SetAttribute(\"macrotext1\", \"/script SetRaidTarget(\\\"target\\\", 1)\")\nbtn:SetAttribute(\"macrotext2\", \"/wm 5\")\nbtn:SetAttribute(\"macrotext3\", \"/cwm 5\")\n\nbtn:SetScript(\"OnEnter\", function(self)\n        region:SetScale(1.3)\n        GameTooltip:SetOwner(self, \"ANCHOR_BOTTOM\")\n        GameTooltip:SetText(\n            \"|cffffffff左键：|r|cff00ffff标记|r\\n\"..\n        \"|cffffffff右键：|r|cff00ff00光柱|r\\n\")\n        GameTooltip:Show()\nend)\n\nbtn:SetScript(\"OnLeave\", function(self)\n        region:SetScale(1)\n        GameTooltip:Hide()\nend)\n\nbtn:Show()",
},
["finish"] = {
},
},
