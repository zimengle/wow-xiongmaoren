["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\nlocal e = aura_env\nlocal region = WeakAuras.GetRegion(e.id)\n\nif not _G[e.id..\"Button\"] then\n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, \"SecureActionButtonTemplate\")\n    e.btn:RegisterForClicks(\"LeftButtonUp\", \"LeftButtonDown\", \"RightButtonUp\", \"RightButtonDown\")\n    e.btn:SetAttribute(\"type1\", \"macro\")\n    e.btn:SetAttribute(\"type2\", \"macro\")\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\nbtn:SetAttribute(\"macrotext1\", \"/pull 10\")\nbtn:SetAttribute(\"macrotext2\", \"/pull 0\")\n\nbtn:SetScript(\"OnMouseUp\", function(self)\n        region:SetAlpha(1)\nend)\nbtn:SetScript(\"OnMouseDown\", function(self)\n        region:SetAlpha(0.5)\nend)\nbtn:SetScript(\"OnEnter\", function(self)\n        GameTooltip:SetOwner(self, \"ANCHOR_BOTTOM\") \n        GameTooltip:SetText(\n        \"|cffffffff露露的快捷按钮|r\\n|cffffffff左键：|r|cff00ffff倒数（10秒）|r\\n|cffffffff右键：|r|cff00FF00取消倒数|r\")\n        region:SetScale(1)\nend)\nbtn:SetScript(\"OnLeave\", function(self)\n        region:SetScale(1)\n        GameTooltip:Hide()\nend)\n\nbtn:Show()",
},
