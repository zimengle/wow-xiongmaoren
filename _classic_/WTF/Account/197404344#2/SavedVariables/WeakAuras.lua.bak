["debuffType"] = "HELPFUL",
["check"] = "event",
["custom"] = "function(a, _, color, visibility, duration)\n    if not color then\n        return\n    end\n    \n    if color ~= 'RED' then\n        return\n    end\n    \n    if visibility == 'HIDE' and a[''] then\n        a[''].show = false\n        a[''].changed = true\n        return true\n    end\n    \n    if visibility == 'SHOW' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            duration = duration - 5,\n            expirationTime = duration - 5 + GetTime(),\n            autoHide = true,\n        }\n        return true\n    end\n    \nend",
