["custom"] = "local GetTime = GetTime\nlocal UnitClassBase, UnitName, UnitGUID, UnitAffectingCombat, UnitGroupRolesAssigned = UnitClassBase, UnitName, UnitGUID, UnitAffectingCombat, UnitGroupRolesAssigned\n\naura_env.rlConfig = aura_env.rlConfig or {}\naura_env.roster = {}\naura_env.encStart = 0\n\naura_env.GetSpecPriority = function(unitName)\n    local defaultPrio = { [264] = 1, [263] = 2, [262] = 3 }\n    local specID = (aura_env.roster[unitName] and aura_env.roster[unitName].specID) or WeakAuras.SpecForUnit(unitName)\n    local cfg = aura_env.rlConfig or {}\n    return (cfg[specID] or defaultPrio[specID] or 99)\nend\n\naura_env.RefreshRoster = function()\n    for unit in WA_IterateGroupMembers() do\n        if UnitClassBase(unit) == \"SHAMAN\" then\n            local unitName = UnitName(unit)\n            local specID = WeakAuras.SpecForUnit(unit)\n            if aura_env.roster[unitName] then\n                aura_env.roster[unitName].role   = UnitGroupRolesAssigned(unit)\n                aura_env.roster[unitName].specID = specID\n                aura_env.roster[unitName].unit   = unit\n            else\n                aura_env.roster[unitName] = {\n                    unit        = unit,\n                    unitName    = unitName,\n                    role        = UnitGroupRolesAssigned(unit),\n                    specID      = specID,\n                    useTime     = 0,\n                    expTime     = 0,\n                    buffExpTime = 0,\n                }\n            end\n        end\n    end\nend\n\n-- Handlers\n\naura_env['STATUS'] = function(states)\n    aura_env.RefreshRoster()\n    \n    -- Left Units\n    for unitName in pairs(states) do\n        if not (UnitInRaid(unitName) or UnitInParty(unitName) or unitName == WeakAuras.me) then\n            aura_env.roster[unitName] = nil\n            states:Remove(unitName)\n        end\n    end\n    \n    return aura_env.UpdateStates(states)\nend\n\naura_env['OPTIONS'] = function(states)\n    \nend\n\naura_env['STORMLASH_MANAGER_SETTINGS'] = function(states, sender, config)\n    aura_env.rlConfig = config or {}\n    --print('|cff0070de[Merfin Stormlash Manager]|r has received configuration data from » ' .. (sender or 'unknown') .. ' «')\n    if states then\n        aura_env.SortPriorities(states)\n        return true\n    end\nend\n\naura_env['GROUP_ROSTER_UPDATE'] = function(states)\n    aura_env.RefreshRoster()\n    \n    -- Left Units\n    for unitName in pairs(states) do\n        if not (UnitInRaid(unitName) or UnitInParty(unitName) or unitName == WeakAuras.me) then\n            aura_env.roster[unitName] = nil\n            states:Remove(unitName)\n        end\n    end\n    \n    return aura_env.UpdateStates(states)\nend\n\naura_env['STBAN_LIBSPEC_UNIT_UPDATED'] = function(states, unitID)\n    if not unitID then return end\n    if UnitClassBase(unitID) ~= \"SHAMAN\" then return end\n    \n    local unitName = UnitName(unitID)\n    if not unitName or unitName == \"\" then return end\n    \n    local specID = WeakAuras.SpecForUnit(unitID)\n    if aura_env.roster[unitName] then\n        aura_env.roster[unitName].unit   = unitID\n        aura_env.roster[unitName].specID = specID\n        aura_env.roster[unitName].role   = UnitGroupRolesAssigned(unitID)\n    else\n        aura_env.roster[unitName] = {\n            unit        = unitID,\n            unitName    = unitName,\n            role        = UnitGroupRolesAssigned(unitID),\n            specID      = specID,\n            useTime     = 0,\n            expTime     = 0,\n            buffExpTime = 0,\n        }\n    end\n    \n    aura_env.SortPriorities(states)\n    return true\nend\n\naura_env['ENCOUNTER_START'] = function(states)\n    aura_env.encStart = GetTime()\nend\n\naura_env['ENCOUNTER_END'] = function(states)\n    local elapsed = GetTime() - aura_env.encStart\n    if elapsed >= 30 then\n        for _, unitData in pairs(aura_env.roster) do\n            unitData.expTime = 0\n        end\n        \n        return aura_env.UpdateStates(states)\n    end\nend\n\naura_env['SHA_PHASE'] = function(states, phaseN)\n    if phaseN == 2 then\n        for _, unitData in pairs(aura_env.roster) do\n            unitData.expTime = 0\n        end\n        \n        return aura_env.UpdateStates(states)\n    end\nend\n\naura_env['COMBAT_LOG_EVENT_UNFILTERED'] = function(states,_, subEvent,_, sourceGUID, sourceName,_,_,_,_,_,_, spellID)\n    if subEvent ~= 'SPELL_CAST_SUCCESS' then return end\n    if spellID ~= 120668 then return end\n    \n    local unitData = aura_env.roster[sourceName]\n    if not unitData then return end\n    \n    local curTime = GetTime()\n    unitData.useTime     = curTime\n    unitData.expTime     = 300 + curTime\n    unitData.buffExpTime = 10 + curTime\n    \n    C_Timer.After(10 + 0.1, function()\n            WeakAuras.ScanEvents('MERFIN_STORMLASH_UPDATE', sourceName)\n    end)\n    \n    C_Timer.After(300 + 0.1, function()\n            WeakAuras.ScanEvents('MERFIN_STORMLASH_UPDATE', sourceName)\n    end)\n    \n    states[sourceName].duration       = 10\n    states[sourceName].expirationTime = unitData.buffExpTime\n    states[sourceName].active         = true\n    states[sourceName].changed        = true\n    \n    aura_env.SortPriorities(states)\n    \n    return true\nend\n\naura_env['MERFIN_STORMLASH_UPDATE'] = function(states, unitName)\n    if states[unitName] then\n        return aura_env.UpdateStates(states)\n    end\nend\n\n-- State Updater\n\naura_env.SortPriorities = function(states)\n    local sorted = {}\n    \n    for _, state in pairs(states) do\n        if state and state.unitName then\n            table.insert(sorted, state)\n        end\n    end\n    \n    table.sort(sorted, function(a, b)\n            if a.active and not b.active then\n                return true\n            elseif not a.active and b.active then\n                return false\n            elseif a.active and b.active then\n                if (a.expirationTime or math.huge) ~= (b.expirationTime or math.huge) then\n                    return (a.expirationTime or math.huge) < (b.expirationTime or math.huge)\n                end\n            end\n            \n            if not a.onCooldown and b.onCooldown then\n                return true\n            elseif a.onCooldown and not b.onCooldown then\n                return false\n            end\n            \n            local prioA = aura_env.GetSpecPriority(a.unitName)\n            local prioB = aura_env.GetSpecPriority(b.unitName)\n            if prioA ~= prioB then\n                return prioA < prioB\n            end\n            \n            return a.unitName < b.unitName\n    end)\n    \n    local foundNext = false\n    for i, state in ipairs(sorted) do\n        state.index = i\n        state.changed = true\n        \n        if not foundNext and not state.active and not state.onCooldown then\n            state.next = true\n            foundNext = true\n        else\n            state.next = false\n        end\n    end\nend\n\naura_env.UpdateStates = function(states)\n    for unitName in pairs(aura_env.roster) do\n        local curTime = GetTime()\n        \n        local data = aura_env.roster[unitName] or {}\n        local useTime = data.useTime\n        local expTime = data.expTime\n        local sinceUsed = curTime - (useTime or 0)\n        local isActive = sinceUsed < 10\n        \n        states[unitName] = {\n            show           = true,\n            changed        = true,\n            progressType   = 'timed',\n            duration       = (isActive and 10) or 300,\n            expirationTime = (isActive and data.buffExpTime) or data.expTime or 0,\n            autoHide       = false,\n            unitName       = unitName,\n            active         = isActive,\n            onCooldown     = curTime < (expTime or 0)\n        }\n    end\n    \n    aura_env.SortPriorities(states)\n    return true\nend",
["do_custom"] = true,
},
},
},
