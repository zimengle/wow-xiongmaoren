["init"] = {
["custom"] = "local encounterID = '1501'\nlocal ID          = 'Fixate'\n\nlocal name, icon = C_Spell.GetSpellName(125390), C_Spell.GetSpellTexture(125390)\n\nlocal options = {\n    warningText = \"%icon @cffffff80%name@r » %destName %icon\",\n}\n\naura_env.SendWarning = function(destName)\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID       = ID,\n            name     = name,\n            icon     = icon,\n            count    = aura_env.count,\n            destName = WA_ClassColorName(destName),\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
