["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    expirationTime = true,\n}",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["custom"] = "function(state, event, subEvent, warning, amount)\n    if event == 'WA_MERFIN_T13' then\n        if subEvent == 'WARNING' then\n            if warning == 'BallTouched' then\n                WeakAuras.ScanEvents('WA_MERFIN_T13_TTS', amount, 2)\n                state[''] = {\n                    show = true,\n                    changed = true,\n                    amount = amount,\n                }\n                return true\n            end\n            \n            if warning == 'BloodPhase' then\n                state[''] = {\n                    show = false,\n                    changed = true,\n                }\n                return true\n            end\n            \n        end\n    end\nend",
["names"] = {
},
["check"] = "event",
["events"] = "WA_MERFIN_T13",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    expirationTime = true,\n}",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["custom"] = "function(state, event, subEvent, warning, amount)\n    if event ~= 'WA_MERFIN_T13' or subEvent ~= 'WARNING' or warning ~= 'BallTouched' then\n        return\n    end\n    \n    state[''] = {\n        show = true,\n        changed = true,\n        progressType = 'timed',\n        autoHide = true,\n        duration = 4,\n        expirationTime = 4 + GetTime(),\n    }\n    return true\nend",
["names"] = {
},
