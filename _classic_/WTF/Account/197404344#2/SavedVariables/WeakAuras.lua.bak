["displayText_format_c3_time_precision"] = 1,
["tocversion"] = 50502,
["config"] = {
},
["fixedWidth"] = 200,
["displayText_format_c2_pad_mode"] = "left",
["outline"] = "OUTLINE",
["wagoID"] = "SqAL2pX1r",
["parent"] = "[BWD] 警报",
["customText"] = "function()\n    local curTime = aura_env.GetTime()\n    if WeakAuras.IsOptionsOpen() then\n        aura_env.unitName = WeakAuras.me\n        aura_env.duration = '|cff8aff00Beam|r: 3s'\n    elseif not aura_env.last then \n        return\n    elseif curTime - aura_env.throttle > 0.1 then\n        aura_env.throttle = curTime\n        aura_env.duration = curTime - aura_env.last\n    end\n    return '|cff8aff00激光|r', aura_env.unitName, aura_env.duration\nend",
["shadowYOffset"] = -1,
["displayText_format_c2_abbreviate"] = false,
["customTextUpdate"] = "update",
["automaticWidth"] = "Auto",
["displayText_format_c2_color"] = "class",
["displayText_format_p_format"] = "timed",
["internalVersion"] = 87,
["animation"] = {
["start"] = {
["translateType"] = "straightTranslate",
["duration_type"] = "seconds",
["colorB"] = 1,
["colorG"] = 1,
["use_translate"] = true,
["type"] = "none",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    return startX + (progress * deltaX), startY + (progress * deltaY)\nend\n",
["preset"] = "slidebottom",
["alpha"] = 0,
["duration"] = "0.1",
["y"] = -30,
["x"] = 0,
["colorR"] = 1,
["rotate"] = 0,
["scaley"] = 1,
["easeStrength"] = 3,
["scalex"] = 1,
["colorA"] = 1,
},
["main"] = {
["colorR"] = 1,
["duration"] = "1",
["colorB"] = 0.74901962280273,
["colorG"] = 0.74901962280273,
["use_translate"] = false,
["duration_type"] = "seconds",
["scalex"] = 1,
["type"] = "none",
["rotate"] = 0,
["easeType"] = "easeOutIn",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    return startX + (progress * deltaX), startY + (progress * deltaY)\nend\n",
["scaley"] = 1,
["alpha"] = 0,
["colorType"] = "pulseColor",
["y"] = 0,
["x"] = 100,
["translateType"] = "straightTranslate",
["preset"] = "bounce",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return r1 + (newProgress * (r2 - r1)),\n         g1 + (newProgress * (g2 - g1)),\n         b1 + (newProgress * (b2 - b1)),\n         a1 + (newProgress * (a2 - a1))\nend\n",
["easeStrength"] = 2,
["use_color"] = true,
["colorA"] = 1,
},
