["[T11] Backend - Settings"] = {
["outline"] = "OUTLINE",
["wagoID"] = "SqAL2pX1r",
["authorOptions"] = {
{
["text"] = "|TInterface\\AddOns\\MerfinMedia\\icons\\merfinui_logo_icon:14:14:0:0:64:64:4:60:4:60|t Merfin T11",
["type"] = "description",
["fontSize"] = "large",
["width"] = 2,
},
{
["text"] = "|cffcfa3a3You can configure certain options that will affect the auras in raid Tier 11 packs|r",
["type"] = "description",
["fontSize"] = "medium",
["width"] = 2,
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 2,
["useHeight"] = true,
["width"] = 2,
},
{
["type"] = "toggle",
["default"] = true,
["key"] = "showWarnings",
["name"] = "Show Warnings",
["useDesc"] = false,
["width"] = 1,
},
{
["type"] = "toggle",
["default"] = true,
["key"] = "showSpecialWarnings",
["name"] = "Show Speicla Warnings",
["useDesc"] = false,
["width"] = 1,
},
{
["type"] = "toggle",
["default"] = true,
["key"] = "showCooldowns",
["name"] = "Show Cooldown",
["useDesc"] = false,
["width"] = 1,
},
{
["type"] = "toggle",
["default"] = false,
["width"] = 1,
["name"] = "Hold Cooldowns",
["useDesc"] = true,
["key"] = "holdCds",
["desc"] = "Holds Cooldown Bar until it's used",
},
{
["type"] = "toggle",
["default"] = true,
["width"] = 1,
["name"] = "Use Alpha Cooldowns",
["useDesc"] = true,
["key"] = "alphaCd",
["desc"] = "The longer cd is the less alpha the progress bar has",
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 3,
["useHeight"] = true,
["width"] = 2,
},
{
["type"] = "range",
["useDesc"] = false,
["max"] = 10,
["step"] = 0.1,
["width"] = 1,
["min"] = 1,
["key"] = "specialWarningDuration",
["default"] = 3,
["name"] = "Duration: Special Warnings",
},
{
["type"] = "range",
["useDesc"] = false,
["max"] = 10,
["step"] = 0.1,
["width"] = 1,
["min"] = 1,
["key"] = "warningDuration",
["default"] = 5,
["name"] = "Duration: Warnings",
},
{
["type"] = "range",
["useDesc"] = false,
["max"] = 30,
["step"] = 0.1,
["width"] = 1,
["min"] = 1,
["key"] = "preWarningMin",
["default"] = 5,
["name"] = "Pre Warning Minimum",
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 3,
["useHeight"] = true,
["width"] = 2,
},
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "local mainEvent = 'WA_MERFIN_RAID'\nlocal cfg = aura_env.config\n\nlocal settings = {\n    \n    visibility = {\n        WARNING = cfg.showWarnings,\n        SPECIAL_WARNING = cfg.showSpecialWarnings,\n        COOLDOWN = cfg.showCooldowns,\n    },\n    \n    durations = {\n        specialWarning = cfg.specialWarningDuration,\n        warning = cfg.warningDuration,\n        preWarningMin = cfg.preWarningMin,\n    },\n    \n    cooldowns = {\n        hold = cfg.holdCds,\n        alpha = cfg.alphaCd,\n    },\n    \n    sounds = {\n        textToSpeech = {\n            enable = cfg.textToSpeechEnable,\n        },\n    },\n}\n\naura_env.OnInit = function()\n    C_Timer.After(0.05, function() WeakAuras.ScanEvents(mainEvent, 'SETTINGS_CONNECTION', settings) end)\nend",
["do_custom"] = true,
},
},
