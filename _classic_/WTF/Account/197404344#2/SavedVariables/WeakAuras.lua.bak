["trigger"] = {
["type"] = "custom",
["custom_hide"] = "timed",
["custom_type"] = "stateupdate",
["customVariables"] = "{\n    count = \"number\",\n    expirationTime = true,\n    status = \"string\",\n}",
["duration"] = "20",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(state, event,_,_,_,_, GUID)\n    \n    if event == \"OPTIONS\" then\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 27.5,\n            expirationTime = GetTime() + 27.5,\n            autoHide = true,\n            name = '督军佐诺兹'\n        }\n        return true\n        \n    elseif event == \"UNIT_ENTERED_VEHICLE\" then\n        local npcId = select(6, strsplit(\"-\", GUID))\n        \n        if not aura_env.flightTimers[npcId] then\n            return\n        end\n        \n        local duration = aura_env.flightTimers[npcId].duration\n        local name = aura_env.flightTimers[npcId].name\n        \n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = duration,\n            expirationTime = GetTime() + duration,\n            autoHide = true,\n            name = name,\n        }\n        \n        return true\n    end\n    \nend",
["events"] = "UNIT_ENTERED_VEHICLE:player",
