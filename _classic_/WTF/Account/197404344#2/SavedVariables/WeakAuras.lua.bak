["unit"] = "player",
["names"] = {
},
["custom"] = "function(a, e, warning, counter)\n    if e == 'WA_MERFIN_BOSS_WARNING' and warning == 'Phase3' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            duration = 3,\n            expirationTime = 3 + GetTime(),\n            autoHide = true,\n        }\n        return true\n    end\nend",
["events"] = "WA_MERFIN_BOSS_WARNING",
["custom_type"] = "stateupdate",
