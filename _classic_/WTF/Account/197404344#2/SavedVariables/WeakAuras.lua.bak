["[事件依赖] 疯狂的死亡之翼"] = {
["outline"] = "OUTLINE",
["wagoID"] = "r2q5DNxZh",
["parent"] = "[T13] 事件依赖",
["preferToUpdate"] = true,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local tonumber, strsplit, pairs = tonumber, strsplit, pairs\nlocal UnitExists, UnitGUID = UnitExists, UnitGUID\nlocal GetTime = GetTime\nlocal L = GetLocale()\n\naura_env.debug = function(...)\n    print('|cffffff00MerfinDebug T13:|r', ...)\nend\n\nlocal cooldownData = {\n    ['Berserk'] = { name = 'Berserk', icon = 136224 },\n    ['Cataclysm'] = { name = 'Cataclysm', icon = 575535 },\n    ['Impale'] = { name = 'Impale', icon = 132312, roleIcon = 'TANK' },\n    ['ElementiumBolt'] = { name = 'Elementium Bolt', icon = 135821 },\n    ['MutatedCorruption'] = { name = 'Mutated Corruption', icon = 237408 },\n    ['Hemorrhage'] = { name = 'Hemorrhage', icon = 135822 },\n    ['Parasite'] = { name = 'Parasite', icon = 524795 },\n    ['Fragments'] = { name = 'Fragments', icon = 132847 },\n    ['Terror'] = { name = 'Terror', icon = 463567 },\n}\n\nlocal encounterID = '1299'\n\nlocal CREATURE_ID = {\n    MutatedCorruption = 56471,\n    ElementiumTerror  = 56710,\n}\n\nlocal PRE_WARNING = {\n    ['ElementiumBoltSoon'] = true,\n    ['Terror'] = true,\n}\n\nlocal GetGuidCreatureId = function(GUID)\n    local guidType, _, playerdbID, _, _, cid, _ = strsplit(\"-\", GUID or \"\")\n    if guidType and (guidType == \"Creature\" or guidType == \"Vehicle\" or guidType == \"Pet\") then\n        return tonumber(cid)\n    end\n    if guidType and (guidType == \"Player\" or guidType == \"Item\") then\n        return tonumber(playerdbID)\n    end\n    return 0\nend\n\nlocal GetUnitCreatureId = function(unitId)\n    if not UnitExists(unitId) then\n        return 0\n    end\n    local unitGUID = UnitGUID(unitId)\n    return GetGuidCreatureId(unitGUID)\nend\n\naura_env.IsGUID = function(sourceGUID, creature)\n    local creatureId = CREATURE_ID[creature]\n    if not creatureId then \n        return false \n    end\n    local npcId = aura_env.guidCache[sourceGUID] or GetGuidCreatureId(sourceGUID)\n    return npcId == creatureId\nend\n\naura_env.ManageCounter = function(action, mechanicName, value)\n    if action == \"increase\" then\n        aura_env.count[mechanicName] = (aura_env.count[mechanicName] or 0) + 1\n        return aura_env.count[mechanicName]\n    elseif action == \"get\" then\n        return aura_env.count[mechanicName] or 0\n    elseif action == \"set\" then\n        aura_env.count[mechanicName] = value\n        return aura_env.count[mechanicName]\n    else\n        --print(\"Unknown action: \" .. tostring(action))\n    end\nend\n\naura_env.WipeSchedulers = function()\n    if aura_env.schedulers then \n        for schedulerName, scheduler in pairs(aura_env.schedulers) do\n            WeakAuras.timer:CancelTimer(scheduler)\n        end\n    end\nend\n\naura_env.SchedulePrewarning = function(id, duration)\n    aura_env.schedulers = aura_env.schedulers or {}\n    \n    if aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n        WeakAuras.ScanEvents('WA_MERFIN_T13', 'PRE_WARNING', 'HIDE', id)\n    end\n    \n    aura_env.schedulers[id] = WeakAuras.timer:ScheduleTimer(\n        WeakAuras.ScanEvents,\n        duration - 5,\n        'WA_MERFIN_T13',\n        'PRE_WARNING',\n        'SHOW',\n        id\n    )\nend\n\naura_env.ScheduleEvent = function(subEvent, after)\n    aura_env.schedulers = aura_env.schedulers or {}\n    \n    if aura_env.schedulers[subEvent] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[subEvent])\n    end\n    \n    aura_env.schedulers[subEvent] = WeakAuras.timer:ScheduleTimer(\n        WeakAuras.ScanEvents,\n        after,\n        'WA_MERFIN_T13_SCHEDULED',\n        subEvent\n    )\nend\n\naura_env.StopCD = function(id, GUID)\n    aura_env.predict[id] = nil\n    \n    local data = cooldownData[id]\n    \n    if not data then\n        return\n    end\n    \n    local cooldown = {\n        id = id,\n        GUID = GUID,\n    }\n    \n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD_HIDE', encounterID, cooldown)\n    \n    if PRE_WARNING[id] and aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n        WeakAuras.ScanEvents('WA_MERFIN_T13', 'PRE_WARNING', 'HIDE', id)\n    end\nend\n\naura_env.StartCD = function(id, duration, autoHide, isIncrease, GUID)\n    local count = aura_env.ManageCounter(isIncrease and 'increase' or 'get', id)\n    \n    if PRE_WARNING[id] then \n        aura_env.SchedulePrewarning(id, duration)\n    end\n    \n    aura_env.predict[id] = duration + GetTime()\n    \n    local data = cooldownData[id]\n    \n    if not data then return end\n    \n    local cooldown  = {\n        show = true,\n        autoHide = autoHide,\n        duration = duration,\n        expirationTime = duration + GetTime(),\n        name = data.name,\n        id = id,\n        GUID = GUID,\n        icon = data.icon,\n        count = count,\n        roleIcon = data.roleIcon,\n    }\n    \n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD', encounterID, cooldown)\n    \nend\n\naura_env.IsCooldownReadyBefore = function(id, before)\n    local predictedAt = aura_env.predict[id]\n    return predictedAt and (predictedAt - GetTime() > before)\nend\n\naura_env.IsCooldownReady = function(id)\n    local predictedAt = aura_env.predict[id]\n    return predictedAt and (GetTime() > predictedAt)\nend\n\naura_env.Warning = function(warning, ...)\n    WeakAuras.ScanEvents('WA_MERFIN_T13', 'WARNING', warning, ...)\nend\n\naura_env.Antispam = function(id, before)\n    local cur = GetTime()\n    if not aura_env.antispams[id] \n    or cur - aura_env.antispams[id] > before then\n        aura_env.antispams[id] = cur\n        return true\n    end\n    return false\nend\n\naura_env.ClearCache = function()\n    aura_env.IsHeroic = WeakAuras.InstanceDifficulty() == 'heroic'\n    aura_env.size = WeakAuras.InstanceType()\n    \n    aura_env.WipeSchedulers()\n    \n    -- Reset Flags\n    aura_env.firstAspect = true\n    aura_env.parasiteCasted = false\n    \n    -- Clear caches and counters\n    aura_env.guidCache = {}\n    aura_env.count = {}\n    aura_env.predict = {}\n    aura_env.schedulers = {}\n    aura_env.antispams = {}\n    \n    -- Destination Names\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["custom"] = "function(e, msg, subEvent, uSpellId, sourceGUID, sourceName, _, _, destGUID, destName, _, _, spellId, _, _, _, amount)\n    \n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        \n        if subEvent == 'SPELL_CAST_START' then\n            if spellId == 107018 then\n                aura_env.parasiteCasted = false\n                if aura_env.firstAspect then\n                    aura_env.firstAspect = false\n                    aura_env.StartCD('MutatedCorruption', 11, true)\n                    aura_env.StartCD('Impale', 22)\n                    aura_env.StartCD('ElementiumBolt', 45.5, true)\n                    if aura_env.IsHeroic then\n                        aura_env.StartCD('Hemorrhage', 55.5, true)\n                        aura_env.StartCD('Parasite', 11)\n                    else\n                        aura_env.StartCD('Hemorrhage', 85.5, true)\n                    end\n                    aura_env.StartCD('Cataclysm', 115.5+60, true)\n                    return\n                end\n                \n                aura_env.StartCD('MutatedCorruption', 17, true)\n                aura_env.StartCD('Impale', 27.5)\n                aura_env.StartCD('ElementiumBolt', 65.5, true)\n                \n                if aura_env.IsHeroic then\n                    aura_env.StartCD('Hemorrhage', 70.5, true)\n                    aura_env.StartCD('Parasite', 22)\n                else\n                    aura_env.StartCD('Hemorrhage', 100.5, true)\n                end\n                aura_env.StartCD('Cataclysm', 130.5+60)\n                \n            elseif spellId == 106523 then\n                aura_env.StartCD('CataclysmCast', 60)\n            end\n            \n        elseif subEvent == 'SPELL_AURA_APPLIED' then\n            if spellId == 106400 then\n                aura_env.StartCD('Impale', 35, false, true)\n            elseif spellId == 106548 then -- Transition\n                aura_env.StopCD('CataclysmCast')\n                aura_env.StopCD('ElementiumBolt')\n                aura_env.StopCD('Hemorrhage')\n                aura_env.StopCD('Cataclysm')\n            elseif spellId == 106834 then -- Phase 2\n                aura_env.StopCD('Impale')\n                aura_env.StopCD('Parasite')\n                aura_env.StopCD('Hemorrhage')\n                aura_env.StartCD('Fragments', 10.5)\n                aura_env.StartCD('Terror', 35.5)\n                aura_env.Warning('Phase2')\n            elseif spellId == 108649 then\n                if aura_env.parasiteCasted then\n                    return\n                end\n                aura_env.parasiteCasted = true\n                aura_env.StartCD('Parasite', 60, true, true)\n            end\n            \n        elseif subEvent == 'SPELL_CAST_SUCCESS' then\n            if spellId == 105651 then \n                aura_env.ScheduleEvent('WarnElementiumBolt', 7)\n                aura_env.StartCD('ElementiumBoltSoon', 7)\n            end\n        elseif subEvent == 'UNIT_DIED' then\n            if aura_env.IsGUID(destGUID, 'MutatedCorruption') then\n                aura_env.StopCD('Impale')\n            elseif aura_env.IsGUID(destGUID, 'ElementiumTerror') then\n                --aura_env.StopCD('Tenatus')\n            end\n        end\n        \n    elseif e == 'UNIT_SPELLCAST_SUCCEEDED' then\n        if uSpellId == 105863 then \n            aura_env.Warning('Hemorrhage')\n            aura_env.StopCD('Hemorrhage')\n        elseif uSpellId == 105551 then\n            aura_env.Warning('BlisteringTentacle')\n        elseif uSpellId == 106775 then\n            aura_env.Warning('Fragments')\n            aura_env.StartCD('Fragments', 90, false, true)\n        elseif uSpellId == 106765 then\n            aura_env.Warning('Terror')\n            aura_env.StartCD('Terror', 90)\n        elseif uSpellId == 197835 then -- DELETE THIS\n            aura_env.StartCD('MutatedCorruption', 17, true)\n            aura_env.StartCD('Impale', 27.5)\n            aura_env.StartCD('ElementiumBolt', 65.5, true)\n        end\n        \n    elseif e == 'WA_MERFIN_T13_SCHEDULED' then\n        if msg == 'WarnElementiumBolt' then\n            aura_env.Warning('ElementiumBoltSoon')\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.ClearCache()\n        aura_env.StartCD('Berserk', 900)\n        \n    elseif e == 'STATUS' then\n        aura_env.ClearCache()\n        \n    elseif e == 'OPTIONS' and not WeakAuras.IsAuraLoaded(aura_env.id) then\n        aura_env.WipeSchedulers()\n    end\nend",
