["[小工具] [奥卓克希昂] 角色扮演"] = {
["sparkWidth"] = 10,
["sparkOffsetX"] = 0,
["wagoID"] = "r2q5DNxZh",
["parent"] = "[T13] 小型进度条组",
["preferToUpdate"] = true,
