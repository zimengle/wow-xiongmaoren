["names"] = {
},
["custom"] = "function(a, e, ...)\n    if e == 'WA_POWER_GENERATOR_ENEMY' then\n        local bossName, npcId, show = ...\n        a[npcId] = {\n            show = show,\n            changed = true,\n            progressType = 'static',\n            value = 1,\n            total = 1,\n            name = 'Power Generator',\n            bossName = bossName,\n        }\n        return true\n        \n    elseif e == 'WA_ODS_BOSS_DEACTIVATED' then\n        local npcId = ...\n        if a[npcId] then\n            a[npcId] = {\n                show = false,\n                changed = true,\n            }\n            return true\n        end\n    end\n    \nend",
