["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, event, ...)\n    \n    if event == 'DREAD_THRASH_HITS' then\n        local hits = ...\n        states:Update('', { hits = hits })\n    end\n    \n    if event == 'SHA_PHASE' then\n        local phaseN = ...\n        if phaseN == 2 then\n            states:Update('', { hits = 4 })\n        end\n    end\n    \n    if event == 'OPTIONS' then\n        states:Update('', { hits = 3 })\n    end\nend",
