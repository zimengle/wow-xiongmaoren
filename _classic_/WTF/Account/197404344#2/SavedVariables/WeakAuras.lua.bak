["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1498'\nlocal ID          = 'Phase2'\n\nlocal name = Merfin:L('Phase 2')\n\nlocal options = {\n    warningText = string.format(\"@cffe3e3e3» %s «@r\", name:upper()),\n    ttsLine = name\n}\n\naura_env.SendWarning = function()\n    local warning = {\n        ID      = ID,\n        name    = 'Phase 2',\n        noCount = true,\n    }\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, warning, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "status",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, UNIT_HEALTH:boss1:boss2:boss3:boss4:boss5",
["names"] = {
},
["check"] = "event",
["spellIds"] = {
},
["custom"] = "function(e, ...)\n    if e == 'UNIT_HEALTH' and not aura_env.phase2 then\n        local unitID = ...\n        local unitGUID = UnitGUID(unitID)\n        local npcID = Merfin.GetNPCIDFromGUID(unitGUID)\n        \n        if npcID == 62397 then\n            local hp = 100 * UnitHealth(unitID) / UnitHealthMax(unitID)\n            if hp < 75.1 then\n                aura_env.phase2 = true\n                WeakAuras.ScanEvents('MELJARAK_PHASE2')\n                aura_env.SendWarning()\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.phase2 = false\n    end\nend",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "\n\n",
},
},
