["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\nlocal e = aura_env\nif not _G[e.id..\"Button\"] then\n    local region = WeakAuras.GetRegion(e.id)\n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, \"SecureActionButtonTemplate\")\n    e.btn:RegisterForClicks(\"LeftButtonUp\",\"LeftButtonDown\", \"RightButtonUp\", \"RightButtonDown\")\n    e.btn:SetAttribute(\"type1\",\"macro\")\n    e.btn:SetAttribute(\"type2\",\"macro\")\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\nlocal itemID1 = e.config.ItemID1\nlocal itemID2 = e.config.ItemID2\nlocal itemName1 = GetItemInfo(itemID1)\nlocal itemName2 = GetItemInfo(itemID2)\nlocal color1 = e.config.ItemColor1\nlocal color2 = e.config.ItemColor2\n\nbtn:SetAttribute(\"macrotext1\",\"/use item:\"..itemID1)\nbtn:SetAttribute(\"macrotext2\",\"/use item:\"..itemID2)\nbtn:SetScript(\"OnEnter\", function(self)\n        GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\")\n        GameTooltip:SetText(\"|cffffffff露露的快捷按钮\\n左键：|r|cff\"..color1..itemName1..\"|r\")\nend)\nbtn:SetScript(\"OnLeave\", function(self) GameTooltip:Hide() end)\nbtn:Show()",
},
["finish"] = {
},
},
},
["Construct [3] Health"] = {
["sparkWidth"] = 10,
["sparkOffsetX"] = 0,
["wagoID"] = "H5gs0vTam",
["authorOptions"] = {
},
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "TOPRIGHT",
["sparkTexture"] = "Interface\\CastingBar\\UI-CastingBar-Spark",
["sparkRotation"] = 0,
["sparkRotationMode"] = "AUTO",
["url"] = "https://space.bilibili.com/455259",
["backgroundColor"] = {
0,
0,
0,
0.5,
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(states, event, ...)\n    \n    if event == 'UNIT_HEALTH' then\n        local unit = ...\n        local GUID = UnitGUID(unit)\n        \n        if states[GUID] then\n            local health = 100 * (UnitHealth(unit) / UnitHealthMax(unit))\n            states:Update(GUID, { value = health })\n        end\n        \n    elseif event == 'WIDGET_RESHAPE_LIFE' then\n        local show, unitKey, GUID, unitName = ...\n        if unitKey ~= aura_env.unitKey then return end\n        \n        if show then\n            local health = 100 * (UnitHealth(unitName) / UnitHealthMax(unitName))\n            states:Update(GUID, {\n                    progressType = 'static',\n                    unitName = unitName,\n                    value = health,\n                    total = 100,\n                    name = _G['HEALTH']\n            })\n            \n        elseif states[GUID] then\n            states:Remove(GUID)\n        end\n        \n    elseif event == 'OPTIONS' then\n        states:Update('', { \n                progressType = 'static',\n                unitName = WeakAuras.me,\n                value = 90,\n                total = 100,\n                name = _G['HEALTH']\n        })\n    end\nend",
["events"] = "WIDGET_RESHAPE_LIFE, UNIT_HEALTH",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    value = true\n}",
["custom_hide"] = "timed",
