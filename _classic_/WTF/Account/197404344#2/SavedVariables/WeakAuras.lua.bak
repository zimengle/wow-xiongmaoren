["custom"] = "function(state, event, subEvent, visibility, cooldownName)\n    if event ~= 'WA_MERFIN_T13' or subEvent ~= 'PRE_WARNING' or cooldownName ~= 'Roll' then\n        return\n    end\n    \n    if visibility == 'HIDE' and state[''] then\n        state[''].show = false\n        state[''].changed = true\n        return true\n    end\n    \n    if visibility == 'SHOW' then\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = true,\n            duration = 5,\n            expirationTime = 5 + GetTime(),\n        }\n        return true\n    end\nend",
