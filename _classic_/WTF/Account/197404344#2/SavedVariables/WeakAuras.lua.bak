["parent"] = "[CTM5人本] 冷却计时条",
["customText"] = "\n\n",
["sparkRotationMode"] = "AUTO",
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    expirationTime = true\n}",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["custom"] = "function(state, event, encounterId, subEvent,_,_,_,_,_,_,_,_,_, spellId)\n    if event == 'OPTIONS' then\n        local duration = math.random(1, 30)\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = false,\n            duration = duration,\n            expirationTime = duration + GetTime(),\n            count = math.random(1, 10),\n        }\n        return true\n    end\n    \n    if event == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        \n        if subEvent == 'SPELL_CAST_SUCCESS' then\n            if spellId == 103363 then\n                aura_env.count = aura_env.count + 1\n                state[''] = {\n                    show = true,\n                    changed = true,\n                    progressType = 'timed',\n                    autoHide = false,\n                    duration = 46.1,\n                    expirationTime = 46.1 + GetTime(),\n                    count = aura_env.count,\n                }\n                return true\n            elseif spellId == 103754 then\n                aura_env.count = 1\n                state[''] = {\n                    show = true,\n                    changed = true,\n                    progressType = 'timed',\n                    autoHide = false,\n                    duration = 17.0,\n                    expirationTime = 17.0 + GetTime(),\n                    count = aura_env.count,\n                }\n                return true\n            end\n        end\n    end\n    \nend",
["names"] = {
},
["check"] = "event",
