},
["check"] = "event",
["spellIds"] = {
},
["custom"] = "function(e)\n    if e == 'OPTIONS' then\n        aura_env.inProgress = IsEncounterInProgress()\n    end\n    \n    if e == 'STATUS' then\n        -- That basically means the WA options were opened during ENCOUNTER_START\n        if IsEncounterInProgress() and not aura_env.inProgress then\n            WeakAuras.ScanEvents('ENCOUNTER_START')\n        end\n    end\nend",
