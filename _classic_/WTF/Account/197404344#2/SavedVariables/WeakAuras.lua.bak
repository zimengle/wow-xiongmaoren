["parent"] = "[暮光堡垒] 进度条",
["customText"] = "function()\n    local stacks = aura_env.states[2].stacks or 1\n    return stacks * 5\nend",
["sparkRotationMode"] = "AUTO",
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["custom"] = "function(a, e,_, subEvent, _, sourceGUID, sourceName, _,_, destGUID, destName,_,_, ...)\n    \n    if e == 'PHASE_2' and a[''] then\n        a[''].show = false\n        a[''].changed = true\n        return true\n    elseif e == 'OPTIONS' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'static',\n            value = aura_env.total/2,\n            total = aura_env.total,\n        }\n        return true\n    elseif subEvent == 'SPELL_AURA_APPLIED' then\n        local spellId = ...\n        if spellId == 82631 then\n            a[''] = {\n                show = true,\n                changed = true,\n                progressType = 'static',\n                value = aura_env.total,\n                total = aura_env.total,\n            }\n            return true\n        end\n    elseif subEvent == 'SPELL_AURA_REMOVED' then\n        local spellId = ...\n        if spellId == 82631 and a[''] then\n            a[''].show = false\n            a[''].changed = true\n            return true\n        end\n    elseif subEvent == 'SPELL_ABSORBED' then\n        local _,_,_,_,_,_,_, shieldId,_,_, amount = ...\n        -- if spell\n        if amount and shieldId == 82631 then\n            a[''].value = a[''].value - amount\n            a[''].changed = true\n            return true\n        else\n            -- is melee\n            local _,_,_,_, shielId,_,_, amount = ...\n            if shielId == 82631 then\n                a[''].value = a[''].value - (amount or 0)\n                a[''].changed = true\n                return true\n            end\n        end\n    end\nend",
["events"] = "CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED:SPELL_ABSORBED, PHASE_2",
["custom_type"] = "stateupdate",
