["[TTS] [T13] 玩家 & 选项"] = {
["outline"] = "OUTLINE",
["wagoID"] = "r2q5DNxZh",
["parent"] = "[T13] 文本转语音（TTS）",
["preferToUpdate"] = true,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["do_message"] = false,
["message_type"] = "TTS",
},
["init"] = {
["custom"] = "local SpeakText = C_VoiceChat.SpeakText\n\nlocal cfg = aura_env.config\n\nif cfg.testSound then\n    WeakAuras.ScanEvents('WA_MERFIN_T13_TTS', 'Merfin Test Sound')\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "timed",
["spellIds"] = {
},
["events"] = "WA_MERFIN_T13_TTS",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["custom_type"] = "event",
["custom"] = "function(e, text, voiceId, speed, volume)\n    if e ~= 'WA_MERFIN_T13_TTS' then return end\n    local cfg = aura_env.config\n    if not cfg.enable then return end\n    \n    local voiceId = (cfg.applyAll and cfg.voiceId) or voiceId or 1\n    local destination = Enum.VoiceTtsDestination.LocalPlayback\n    local speed = speed or 1\n    local volume = (cfg.applyAll and cfg.volume) or volume or 100\n    \n    C_VoiceChat.SpeakText(voiceId, text, destination, speed, volume)\nend",
["debuffType"] = "HELPFUL",
},
