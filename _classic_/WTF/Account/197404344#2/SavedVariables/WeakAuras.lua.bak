["parent"] = "[SB] Amber-Shaper Un'sok",
["adjustedMin"] = "",
["sparkRotationMode"] = "AUTO",
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, event)\n    \n    if event == 'OPTIONS' then\n        states:Update('', {\n                progressType = 'static',\n                total        = 5,\n                value        = 2.6,\n                prefix       = Merfin:L('Phase') .. ' 2', \n        })\n        return\n    end\n    \n    if not UnitExists('boss1') then return end\n    \n    local hper = aura_env.GetUnitHealthPercent('boss1')\n    \n    for _, range in ipairs(aura_env.ranges) do\n        local offset = aura_env.InRangeOffset(hper, range.min, range.max)\n        if offset then\n            states:Update('', {\n                    progressType = 'static',\n                    total        = 5,\n                    value        = offset,\n                    prefix       = range.prefix,\n            })\n            return\n        end\n    end\n    \n    states:Remove('')\nend",
["spellIds"] = {
},
["events"] = "UNIT_HEALTH:boss1",
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom_type"] = "stateupdate",
