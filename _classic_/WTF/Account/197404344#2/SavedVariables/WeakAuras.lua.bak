["init"] = {
["custom"] = "local GetTotalAbsorbed = function()\n    local _,_, id = GetInstanceInfo()\n    if id == 3 then\n        return 500001  -- '10_NORMAL'\n    elseif id == 4 then\n        return 1500001 -- '25_NORMAL'\n    elseif id == 5 then\n        return 700001  -- '10_HEROIC'\n    elseif id == 6 then\n        return 2000001 -- '25_HEROIC'\n    end\nend\n\naura_env.total = GetTotalAbsorbed() or 2000001",
