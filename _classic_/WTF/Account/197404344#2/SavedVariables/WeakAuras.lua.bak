["cooldown"] = true,
["actions"] = {
["start"] = {
["glow_frame_type"] = "UNITFRAME",
["glow_YOffset"] = 1,
["glow_action"] = "show",
["sound_path"] = "",
["do_custom"] = false,
["use_glow_color"] = true,
["glow_lines"] = 12,
["do_glow"] = false,
["glow_XOffset"] = 1,
["custom"] = "-- Author: 露露緹婭@Bilibili\n-- 获取当前触发的技能ID\nlocal spellId = aura_env.state and aura_env.state.spellId\nif not spellId or not aura_env.RurutiaSoundMap[spellId] then\n    return\nend\n\nlocal currentTime = GetTime()\n\n-- 检查冷却时间\nif aura_env.cooldownConfig[spellId] then\n    local cooldownTime = aura_env.cooldownConfig[spellId]\n    local lastTime = aura_env.lastPlayTime[spellId] or 0\n    if currentTime - lastTime < cooldownTime then\n        return\n    end\n    aura_env.lastPlayTime[spellId] = currentTime\nend\n\n-- 播放音效\nlocal soundFile = aura_env.RurutiaSoundMap[spellId]\nif not soundFile:match(\"^Interface\\\\\") then\n    soundFile = aura_env.RurutiaFilePath .. soundFile\nend\nPlaySoundFile(soundFile, \"Master\")",
["do_sound"] = false,
["glow_color"] = {
0,
0.54117649793625,
1,
1,
},
["glow_type"] = "Pixel",
["sound"] = " custom",
["glow_thickness"] = 4,
},
["init"] = {
["do_custom"] = false,
["custom"] = "-- Author: 露露緹婭@Bilibili\naura_env.RurutiaFilePath = \"Interface\\\\Addons\\\\SharedMedia_Rurutia\\\\Rurutia\\\\\"\n\naura_env.cooldownConfig = {\n    --[61295] = 10, --激流，测试用\n}\n\nif not aura_env.lastPlayTime then\n    aura_env.lastPlayTime = {}\nend\n\naura_env.RurutiaSoundMap = {\n    --恐惧之心\n    [118091] = \"【露露】快躲开.ogg\", -- 大地污染\n    [117235] = \"【露露】获得增益.ogg\", -- 被净化\n    [122789] = \"【露露】Bingo.ogg\", -- 阳光\n    [123716] = \"【露露】获得增益.ogg\", -- 灼日圣光\n    [129189] = \"【露露】获得增益.ogg\", -- 煞能宝珠\n    [120519] = \"【露露】快躲开.ogg\", -- 龙卷水涌\n    \n    --BUFF\n    [118977] = \"【露露】获得增益.ogg\", -- 无畏\n}",
},
