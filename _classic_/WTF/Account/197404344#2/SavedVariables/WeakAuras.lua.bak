["custom"] = "function(state, event,_,_, uSpellID)\n    \n    if event == 'OPTIONS' then\n        local duration = math.random(1, 30)\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = false,\n            duration = duration,\n            expirationTime = duration + GetTime(),\n            count = math.random(1, 10),\n        }\n        return true\n    end\n    \n    if event == 'UNIT_SPELLCAST_SUCCEEDED' and uSpellID == 105341 then\n        aura_env.count = (aura_env.count or 0) + 1\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = true,\n            duration = 48,\n            expirationTime = 48 + GetTime(),\n            count = aura_env.count,\n        }\n        return true\n    end\nend",
