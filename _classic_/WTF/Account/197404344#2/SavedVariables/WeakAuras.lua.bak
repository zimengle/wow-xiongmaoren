["custom"] = "function(state, event, ...)\n    \n    if event == 'OPTIONS' then\n        state[''] = {\n            show = true,\n            changed = true,\n            addsTotal = 14,\n        }\n        return true\n    end\n    \n    if event == 'WA_ZANOZZ_ADD_DEATH' then\n        \n        if not state[''] then\n            return\n        end\n        \n        state[''].addsTotal = state[''].addsTotal - 1\n        state[''].changed = true\n        return true\n        \n    end\n    \n    \n    if event == 'WA_MERFIN_T13' then\n        local subEvent, warning = ...\n        \n        if subEvent ~= 'WARNING' then\n            return\n        end\n        \n        if warning == 'Phase1' then\n            if not state[''] then\n                return\n            end\n            \n            state[''].show = false\n            state[''].changed = true\n            return true\n        end\n        \n        if warning == 'BloodPhase' then\n            state[''] = {\n                show = true,\n                changed = true,\n                addsTotal = 14,\n            }\n            \n            return true\n        end\n    end\n    \nend",
["debuffType"] = "HELPFUL",
},
