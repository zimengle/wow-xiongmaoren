["custom_type"] = "stateupdate",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["custom"] = "function(states, e, _, warning)\n    if e == 'OPTIONS' then\n        states:Update('', {count = 2, destName = WA_ClassColorName(WeakAuras.me)})\n    end\n    if e == 'MERFIN_WARNING' and warning.ID == 'Pillage' then\n        states:Update('', {count = warning.count, destName = warning.destName})\n    end\nend",
