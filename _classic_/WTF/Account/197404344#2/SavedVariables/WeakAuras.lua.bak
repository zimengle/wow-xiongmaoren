["custom"] = "function(a, e, side)\n    \n    if not side then\n        return\n    end\n    \n    if side == 'LEFT' or side == 'RIGHT' then\n        local text = side .. ' ' .. 'Roll'\n        WeakAuras.ScanEvents('WA_MERFIN_T13_TTS', text)\n        a[''] = {\n            show = true,\n            duration = 5,\n            expirationTime = 5 + GetTime(),\n            progressType = 'timed',\n            changed = true,\n            autoHide = true,\n        }\n        return true\n    else\n        a[''] = {\n            show = false,\n            changed = true,\n        }\n        return true\n    end\nend",
