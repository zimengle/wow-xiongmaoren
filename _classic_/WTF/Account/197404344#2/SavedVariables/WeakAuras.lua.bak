["useGroup_count"] = true,
["events"] = "WA_MERFIN_T13",
["custom"] = "function(state, event, subEvent, warning, targets)\n    if event ~= 'WA_MERFIN_T13' or subEvent ~= 'WARNING' or warning ~= 'AnnounceTargetsFading' then\n        return\n    end\n    \n    if not targets then\n        return\n    end\n    \n    local targetNames = table.concat(targets, ', ')\n    \n    state[''] = {\n        show = true,\n        changed = true,\n        progressType = 'timed',\n        autoHide = true,\n        duration = 3,\n        expirationTime = 3 + GetTime(),\n        targetNames = targetNames,\n    }\n    return true\nend",
