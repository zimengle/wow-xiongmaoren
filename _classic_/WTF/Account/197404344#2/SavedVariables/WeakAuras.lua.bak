["use_unit"] = true,
["use_absorbMode"] = true,
["custom"] = "function(a, e, ...)\n    if e == 'ENCOUNTER_START' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'static',\n            value = 18,\n            total = 18,\n        }\n        return true\n    elseif e == 'WA_MERFIN_RAID_HANDLER' then\n        local _, mechanic,_,_,_,_, left = ...\n        if mechanic == 'abberations_left' and left then\n            if a[''] then\n                a[''].value = left\n                a[''].changed = true\n                return true\n            end\n        elseif mechanic == 'phase_2' then\n            if a[''] then\n                a[''].show = false\n                a[''].changed = true\n                return true\n            end\n        end\n    end\nend",
