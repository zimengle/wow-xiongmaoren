["shadowXOffset"] = 0,
["useAdjustededMin"] = false,
["regionType"] = "aurabar",
["texture"] = "Solid",
["sparkTexture"] = "Interface\\CastingBar\\UI-CastingBar-Spark",
["spark"] = false,
["tocversion"] = 50500,
["alpha"] = 1,
["sparkColor"] = {
1,
1,
1,
