["init"] = {
["custom"] = "local UnitHealth, UnitHealthMax = UnitHealth, UnitHealthMax\n\naura_env.GetUnitHealthPercent = function(unit)\n    local health = UnitHealth(unit)\n    local maxHealth = UnitHealthMax(unit)\n    \n    if maxHealth == 0 then\n        return 0\n    end\n    \n    return (health / maxHealth) * 100\nend\n\naura_env.InRangeOffset = function(value, min, max)\n    if value >= min and value < max then\n        return value - min\n    end\n    return nil\nend\n\naura_env.icon = \"|T625906:16:16:0:0:64:64:5:59:5:59|t\"\n\naura_env.ranges = {\n    {min = 75, max = 80, prefix = Merfin:L('Phase') .. ' 2'},\n    {min = 50, max = 55, prefix = Merfin:L('Phase') .. ' 3'},\n    {min = 25, max = 30, prefix = Merfin:L('Phase') .. ' 4'},\n}\n\naura_env.RefreshRanges = function()\n    local diff = WeakAuras.InstanceDifficulty()\n    if diff ~= 'heroic' then\n        aura_env.ranges = {\n            {min = 66, max = 71, prefix = Merfin:L('Phase') .. ' 2'},\n            {min = 33, max = 38, prefix = Merfin:L('Phase') .. ' 3'},\n        }\n    end\nend",
["do_custom"] = true,
