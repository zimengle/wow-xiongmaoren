["unit"] = "player",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["custom"] = "function(state, event, encounterId, subEvent,_,_,_,_,_,_,_,_,_, spellId)\n    if event == 'OPTIONS' then\n        local duration = math.random(1, 30)\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = false,\n            duration = duration,\n            expirationTime = duration + GetTime(),\n            count = math.random(1, 10),\n        }\n        return true\n    end\n    \n    if event == 'ENCOUNTER_START' then\n        aura_env.count = 1\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = false,\n            duration = 10.9,\n            expirationTime = 10.9 + GetTime(),\n            count = aura_env.count,\n        }\n        return true\n    end\n    \n    if event == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        \n        if subEvent == 'SPELL_CAST_SUCCESS' then\n            if spellId == 103558 then\n                aura_env.count = aura_env.count + 1\n                state[''] = {\n                    show = true,\n                    changed = true,\n                    progressType = 'timed',\n                    autoHide = false,\n                    duration = 23.0,\n                    expirationTime = 23.0 + GetTime(),\n                    count = aura_env.count,\n                }\n                return true\n            end\n        end\n    end\n    \nend",
