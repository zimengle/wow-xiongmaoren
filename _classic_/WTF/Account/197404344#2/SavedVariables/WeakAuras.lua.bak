["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1500'\nlocal ID          = 'Overload'\n\nlocal name, icon = C_Spell.GetSpellName(117204), C_Spell.GetSpellTexture(117204)\n\nlocal options = {\n    warningText = \"%icon @cffffff80%name@r @cffff4040+%damage%@r (%count) %icon\",\n}\n\naura_env.SendWarning = function(amount)\n    local data = {\n        ID     = ID,\n        count  = aura_env.count,\n        name   = name,\n        icon   = icon,\n        damage = amount * 20\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "status",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_APPLIED_DOSE",
["names"] = {
},
["check"] = "event",
["spellIds"] = {
},
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_,_,_,_,_, spellID,_,_,_, amount = ...\n        \n        if spellID == 117204 then\n            aura_env.count = aura_env.count + 1\n            aura_env.SendWarning(amount or 1)\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
["debuffType"] = "HELPFUL",
