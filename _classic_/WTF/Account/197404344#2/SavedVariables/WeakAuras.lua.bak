["actions"] = {
["start"] = {
["custom"] = "WeakAuras.ScanEvents('MERFIN_SOUND', 'OozesSpawn')",
["do_custom"] = true,
},
["init"] = {
["custom"] = "local L = {\n    Black  = \"|cFF424242黑|r\",\n    Purple = \"|cFF9932CD紫|r\",\n    Red    = \"|cFFFF0404红|r\",\n    Green  = \"|cFF088A08绿|r\",\n    Blue   = \"|cFF0080FF蓝|r\",\n    Yellow = \"|cFFFFA901黄|r\"\n}\n\nlocal oozesPatternHeroic = {\n    [105420] = { L.Purple, L.Green, L.Black, L.Blue },\n    [105435] = { L.Green, L.Red, L.Blue, L.Black },\n    [105436] = { L.Green, L.Yellow, L.Black, L.Red },\n    [105437] = { L.Blue, L.Purple, L.Green, L.Yellow },\n    [105439] = { L.Blue, L.Black, L.Purple, L.Yellow },\n    [105440] = { L.Purple, L.Red, L.Yellow, L.Black },\n}\n\nlocal oozesPatternNormal = {\n    [105420] = { L.Purple, L.Green, L.Blue },\n    [105435] = { L.Green, L.Red, L.Black },\n    [105436] = { L.Green, L.Yellow, L.Red },\n    [105437] = { L.Purple, L.Blue, L.Yellow },\n    [105439] = { L.Blue, L.Black, L.Yellow },\n    [105440] = { L.Purple, L.Red, L.Black },\n}\n\n\naura_env.oozesString = {}\nlocal tableToPairs = WeakAuras.InstanceDifficulty() == 'heroic' and oozesPatternHeroic or oozesPatternNormal\nfor spellId, colors in pairs(tableToPairs) do\n    aura_env.oozesString[spellId] = table.concat(colors, \" - \")\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["spellId"] = {
103785,
},
["duration"] = "2",
["names"] = {
},
["destUnit"] = "player",
["debuffType"] = "HELPFUL",
["type"] = "custom",
["custom_type"] = "stateupdate",
["unit"] = "player",
["event"] = "Combat Log",
["events"] = "UNIT_SPELLCAST_SUCCEEDED",
["spellIds"] = {
},
["use_spellId"] = true,
["custom"] = "function(a, _,_,_, spellId)\n    local spellId = spellId or (WeakAuras.IsOptionsOpen() and 105420)\n    if aura_env.oozesString[spellId] then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            duration = 5,\n            expirationTime = 5 + GetTime(),\n            autoHide = true,\n            oozesString = aura_env.oozesString[spellId],\n        }\n        return true\n    end\nend",
["subeventSuffix"] = "_DAMAGE",
["check"] = "event",
["use_destUnit"] = true,
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
},
