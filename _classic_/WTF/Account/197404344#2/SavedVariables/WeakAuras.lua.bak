["sound"] = "Interface\\Addons\\MerfinPlus\\Media\\sound\\noloc\\Info.mp3",
["do_sound"] = true,
},
["finish"] = {
},
["init"] = {
["custom"] = "local UnitHealth, UnitHealthMax = UnitHealth, UnitHealthMax\n\naura_env.GetUnitHealthPercent = function(unit)\n    local health = UnitHealth(unit)\n    local maxHealth = UnitHealthMax(unit)\n    \n    if maxHealth == 0 then\n        return 0\n    end\n    \n    return (health / maxHealth) * 100\nend\n\naura_env.InRangeOffset = function(value, min, max)\n    if value >= min and value < max then\n        return value - min\n    end\n    return nil\nend\n\naura_env.icon = \"|T624007:16:16:0:0:64:64:5:59:5:59|t\"\n\naura_env.ranges = {\n    {min = 80, max = 85, prefix = Merfin:L('Platform') .. ' 2'},\n    {min = 60, max = 65, prefix = Merfin:L('Platform') .. ' 3'},\n    {min = 40, max = 45, prefix = Merfin:L('Phase') .. ' 2'},\n}",
["do_custom"] = true,
},
},
["icon_color"] = {
1,
1,
1,
1,
},
["enableGradient"] = false,
["selfPoint"] = "CENTER",
["barColor"] = {
0.23137256503105,
0.23137256503105,
0.23137256503105,
1,
},
