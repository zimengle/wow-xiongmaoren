["[NE] [Zorlok] Nameplates Hider"] = {
["exrtLastSender"] = "Jfkx-ClassicBetaPvE",
["wagoID"] = "H5gs0vTam",
["parent"] = "[NE] Imperial Vizier Zor'lok",
["preferToUpdate"] = true,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["custom"] = "aura_env.ticker = C_Timer.NewTicker(0.016, function()\n        aura_env.HideAllNameplates()   \nend)",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "if aura_env.ticker then\n    aura_env.ticker:Cancel()\nend\n\naura_env.ShowAllNameplates()",
["do_custom"] = true,
},
["init"] = {
["custom"] = "local IsAddOnLoaded = C_AddOns.IsAddOnLoaded\n\naura_env.HideNameplate = function(plate)\n    if not plate then return end\n    \n    if IsAddOnLoaded(\"Plater\") and plate.unitFramePlater then\n        plate.unitFramePlater:Hide()\n        \n    elseif IsAddOnLoaded(\"ElvUI\")\n    and ElvUI[1] and ElvUI[1].NamePlates\n    and ElvUI[1].NamePlates.Initialized\n    and plate.unitFrame then\n        plate.unitFrame:Hide()\n        \n    elseif IsAddOnLoaded(\"NeatPlates\") and plate.carrier then\n        plate.carrier:Hide()\n        \n    elseif IsAddOnLoaded(\"TidyPlates_ThreatPlates\") and plate.TPFrame then\n        plate.TPFrame:Hide()\n        \n    elseif IsAddOnLoaded(\"Kui_Nameplates\") and plate.kui then\n        plate.kui:Hide()\n        \n    elseif plate.UnitFrame then\n        plate.UnitFrame:Hide()\n    end\nend\n\naura_env.ShowNameplate = function(plate)\n    if not plate then return end\n    \n    if IsAddOnLoaded(\"Plater\") and plate.unitFramePlater then\n        plate.unitFramePlater:Show()\n        \n    elseif IsAddOnLoaded(\"ElvUI\")\n    and ElvUI[1] and ElvUI[1].NamePlates\n    and ElvUI[1].NamePlates.Initialized\n    and plate.unitFrame then\n        plate.unitFrame:Show()\n        \n    elseif IsAddOnLoaded(\"NeatPlates\") and plate.carrier then\n        plate.carrier:Show()\n        \n    elseif IsAddOnLoaded(\"TidyPlates_ThreatPlates\") and plate.TPFrame then\n        plate.TPFrame:Show()\n        \n    elseif IsAddOnLoaded(\"Kui_Nameplates\") and plate.kui then\n        plate.kui:Show()\n        \n    elseif plate.UnitFrame then\n        plate.UnitFrame:Show()\n    end\nend\n\n\naura_env.HideAllNameplates = function()\n    local plates = C_NamePlate.GetNamePlates()\n    if not plates then return end\n    \n    for _, plate in ipairs(plates) do\n        aura_env.HideNameplate(plate)\n    end\nend\n\naura_env.ShowAllNameplates = function()\n    local plates = C_NamePlate.GetNamePlates()\n    if not plates then return end\n    \n    for _, plate in ipairs(plates) do\n        aura_env.ShowNameplate(plate)\n    end\nend",
["do_custom"] = true,
},
},
