["custom"] = "function(a, _, color, visibility, duration)\n    if not color then\n        return\n    end\n    \n    if color ~= 'YELLOW' then\n        return\n    end\n    \n    if visibility == 'SHOW' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            duration = 34.5,\n            expirationTime = 34.5 + GetTime(),\n            autoHide = true,\n        }\n        return true\n    end\n    \nend",
["dynamicDuration"] = true,
["custom_hide"] = "timed",
