["[DP] [Mel'jarak] Recklesness"] = {
["outline"] = "OUTLINE",
["wagoID"] = "H5gs0vTam",
["xOffset"] = 0,
["displayText_format_p_time_dynamic_threshold"] = 60,
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1498'\nlocal ID          = 'Recklessness'\n\nlocal name, icon = C_Spell.GetSpellName(125873), C_Spell.GetSpellTexture(125873)\n\nlocal options = {\n    warningText = \"%icon @cffff8b17%name@r %icon\",\n    tssLine = Merfin:L('Burst the boss')\n}\n\naura_env.MRT = function()\n    local event = 'RECKLESNESS_' .. aura_env.count\n    GMRT.F.Note_Timer(event)\nend\n\naura_env.SendWarning = function()\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID    = ID,\n            name  = name,\n            icon  = icon,\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "status",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, UNIT_SPELLCAST_SUCCEEDED:boss1:boss2:boss3:boss4:boss5",
["names"] = {
},
["check"] = "event",
["spellIds"] = {
},
["custom"] = "function(e, ...)\n    if e == 'UNIT_SPELLCAST_SUCCEEDED' then\n        local _,_, spellID = ...\n        \n        if spellID == 125873 then\n            aura_env.count = aura_env.count + 1\n            aura_env.SendWarning()\n            aura_env.MRT()\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
["debuffType"] = "HELPFUL",
},
