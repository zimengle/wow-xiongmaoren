["useName"] = true,
["events"] = "WA_MERFIN_T13",
["spellIds"] = {
},
["custom"] = "function(state, event, subEvent, visibility, cooldownName)\n    \n    if event ~= 'WA_MERFIN_T13' or subEvent ~= 'COOLDOWN' or cooldownName ~= 'Parasite' then\n        return\n    end\n    \n    if (visibility == 'HIDE' or visibility == 'SHOW') and state[''] then\n        state[''].show = false\n        state[''].changed = true\n        return true\n    end\n    \n    if visibility == 'READY' then\n        state[''] = {\n            show = true,\n            changed = true,\n        }\n        return true\n    end\nend",
["check"] = "event",
["unit"] = "group",
["group_countOperator"] = ">",
["auranames"] = {
"99947",
},
},
["untrigger"] = {
},
},
["activeTriggerMode"] = -10,
},
["displayText_format_p_format"] = "timed",
["displayText_format_p_time_legacy_floor"] = false,
["animation"] = {
["start"] = {
["colorR"] = 1,
["duration"] = "0.1",
["colorA"] = 1,
["colorG"] = 1,
["use_translate"] = true,
["colorB"] = 1,
["use_color"] = false,
["type"] = "none",
["easeStrength"] = 1,
["easeType"] = "easeIn",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    return startX + (progress * deltaX), startY + (progress * deltaY)\nend\n",
["scaley"] = 1,
["alpha"] = 0,
["x"] = 0,
["y"] = 50,
["colorType"] = "straightColor",
["preset"] = "fade",
["translateType"] = "straightTranslate",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    return r1 + (progress * (r2 - r1)), g1 + (progress * (g2 - g1)), b1 + (progress * (b2 - b1)), a1 + (progress * (a2 - a1))\nend\n",
["rotate"] = 0,
["scalex"] = 1,
["duration_type"] = "seconds",
},
["main"] = {
["colorR"] = 1,
["scalex"] = 1,
["alphaType"] = "alphaPulse",
["colorA"] = 1,
["colorG"] = 0.74901962280273,
["alphaFunc"] = "function(progress, start, delta)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    return start + (((math.sin(angle) + 1)/2) * delta)\nend\n",
["duration"] = "0.7",
["use_translate"] = false,
["use_alpha"] = false,
["colorB"] = 0.74901962280273,
["type"] = "none",
["easeStrength"] = 1,
["easeType"] = "easeOutIn",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local prog\n    if(progress < 0.25) then\n        prog = progress * 4\n    elseif(progress < .75) then\n        prog = 2 - (progress * 4)\n    else\n        prog = (progress - 1) * 4\n    end\n    return startX + (prog * deltaX), startY + (prog * deltaY)\nend\n",
["use_color"] = false,
["alpha"] = 0.7,
["x"] = 10,
["y"] = 0,
["colorType"] = "pulseColor",
["scaley"] = 1,
["translateType"] = "shake",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return r1 + (newProgress * (r2 - r1)),\n         g1 + (newProgress * (g2 - g1)),\n         b1 + (newProgress * (b2 - b1)),\n         a1 + (newProgress * (a2 - a1))\nend\n",
["rotate"] = 0,
["preset"] = "bounce",
["duration_type"] = "seconds",
},
