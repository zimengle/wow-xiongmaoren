["custom"] = "function(a, e, side)\n    \n    if not side then\n        return\n    end\n    \n    if side == 'LEFT' then\n        a[''] = {\n            show = true,\n            duration = 5,\n            expirationTime = 5 + GetTime(),\n            progressType = 'timed',\n            changed = true,\n            autoHide = true,\n        }\n        return true\n        \n    elseif side == 'RIGHT' then\n        a[''] = {\n            show = false,\n            changed = true,\n        }\n        return true\n        \n    elseif side == 'BALANCED' then\n        a[''] = {\n            show = false,\n            changed = true,\n        }\n        return true\n    end\nend",
