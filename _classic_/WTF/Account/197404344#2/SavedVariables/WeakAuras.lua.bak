["desc"] = "by 露露緹婭@Bilibili。",
["anchorFrameType"] = "SCREEN",
["cooldownSwipe"] = true,
["frameStrata"] = 1,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["glow_color"] = {
