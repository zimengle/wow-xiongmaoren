["custom"] = "function(state, event, subEvent, warning)\n    if event ~= 'WA_MERFIN_T13' or subEvent ~= 'WARNING' or warning ~= 'Phase1' then\n        return\n    end\n    \n    state[''] = {\n        show = true,\n        changed = true,\n        progressType = 'timed',\n        autoHide = true,\n        duration = 3,\n        expirationTime = 3 + GetTime(),\n    }\n    return true\nend",
