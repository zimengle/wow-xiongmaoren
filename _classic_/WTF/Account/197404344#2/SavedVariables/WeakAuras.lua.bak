["[事件依赖] 战争大师黑角"] = {
["outline"] = "OUTLINE",
["wagoID"] = "r2q5DNxZh",
["parent"] = "[T13] 事件依赖",
["preferToUpdate"] = true,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local tonumber, strsplit, pairs = tonumber, strsplit, pairs\nlocal UnitExists, UnitGUID = UnitExists, UnitGUID\nlocal GetTime = GetTime\nlocal L = GetLocale()\n\naura_env.debug = function(...)\n    print('|cffffff00MerfinDebug T13:|r', ...)\nend\n\nlocal cooldownData = {\n    ['Berserk'] = { name = 'Berserk', icon = 136224 },\n    ['Broadside'] = { name = 'Broadside', icon = 425960 },\n    ['TwilightOnslaught'] = { name = 'Twilight Onslaught', icon = 425954 },\n    ['Sapper'] = { name = 'Sapper', icon = 133715 },\n    ['Adds'] = { name = 'Adds', icon = 236421 },\n    ['Harpoon'] = { name = 'Harpoon', icon = 514302 },\n    ['ConsumingShroud'] = { name = 'Consuming Shroud', icon = 135752 },\n    ['TwilightFlames'] = { name = 'TwilightFlames', icon = 425955 },\n    ['DisruptingRoar'] = { name = 'Disrupting Roar', icon = 132352 },\n    ['Shockwave'] = { name = 'Shockwave', icon = 236312 },\n    ['SunderArmor'] = { name = 'Sunder Armor', icon = 132363, roleIcon = 'TANK' },\n}\n\nlocal encounterID = '1298'\n\nlocal CREATURE_ID = {\n    BLACKHORN = 56427,\n}\n\nlocal PRE_WARNING = {\n    ['Sapper'] = true,\n    ['DisruptingRoar'] = true,\n    ['Shockwave'] = true,\n    ['TwilightOnslaught'] = true,\n}\n\nlocal GetGuidCreatureId = function(GUID)\n    local guidType, _, playerdbID, _, _, cid, _ = strsplit(\"-\", GUID or \"\")\n    if guidType and (guidType == \"Creature\" or guidType == \"Vehicle\" or guidType == \"Pet\") then\n        return tonumber(cid)\n    end\n    if guidType and (guidType == \"Player\" or guidType == \"Item\") then\n        return tonumber(playerdbID)\n    end\n    return 0\nend\n\nlocal GetUnitCreatureId = function(unitId)\n    if not UnitExists(unitId) then\n        return 0\n    end\n    local unitGUID = UnitGUID(unitId)\n    return GetGuidCreatureId(unitGUID)\nend\n\naura_env.IsGUID = function(sourceGUID, creature)\n    local creatureId = CREATURE_ID[creature]\n    if not creatureId then \n        return false \n    end\n    local npcId = aura_env.guidCache[sourceGUID] or GetGuidCreatureId(sourceGUID)\n    return npcId == creatureId\nend\n\naura_env.ManageCounter = function(action, mechanicName, value)\n    if action == \"increase\" then\n        aura_env.count[mechanicName] = (aura_env.count[mechanicName] or 0) + 1\n        return aura_env.count[mechanicName]\n    elseif action == \"get\" then\n        return aura_env.count[mechanicName] or 0\n    elseif action == \"set\" then\n        aura_env.count[mechanicName] = value\n        return aura_env.count[mechanicName]\n    else\n        --print(\"Unknown action: \" .. tostring(action))\n    end\nend\n\naura_env.WipeSchedulers = function()\n    if aura_env.schedulers then \n        for schedulerName, scheduler in pairs(aura_env.schedulers) do\n            WeakAuras.timer:CancelTimer(scheduler)\n        end\n    end\nend\n\naura_env.SchedulePrewarning = function(id, duration)\n    aura_env.schedulers = aura_env.schedulers or {}\n    \n    if aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n    end\n    \n    aura_env.schedulers[id] = WeakAuras.timer:ScheduleTimer(\n        WeakAuras.ScanEvents,\n        duration - 5,\n        'WA_MERFIN_T13',\n        'PRE_WARNING',\n        'SHOW',\n        id\n    )\nend\n\naura_env.ScheduleEvent = function(subEvent, after)\n    aura_env.schedulers = aura_env.schedulers or {}\n    \n    if aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n        WeakAuras.ScanEvents('WA_MERFIN_T13', 'PRE_WARNING', 'HIDE', id)\n    end\n    \n    aura_env.schedulers[subEvent] = WeakAuras.timer:ScheduleTimer(\n        WeakAuras.ScanEvents,\n        after,\n        'WA_MERFIN_T13_SCHEDULED',\n        subEvent\n    )\nend\n\naura_env.StopCD = function(id, GUID)\n    aura_env.predict[id] = nil\n    \n    local data = cooldownData[id]\n    \n    if not data then\n        return\n    end\n    \n    local cooldown = {\n        id = id,\n        GUID = GUID,\n    }\n    \n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD_HIDE', encounterID, cooldown)\n    \n    if PRE_WARNING[id] and aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n        WeakAuras.ScanEvents('WA_MERFIN_T13', 'PRE_WARNING', 'HIDE', id)\n    end\nend\n\naura_env.StartCD = function(id, duration, autoHide, isIncrease)\n    local count = aura_env.ManageCounter(isIncrease and 'increase' or 'get', id)\n    \n    aura_env.predict[id] = duration + GetTime()\n    \n    local data = cooldownData[id]\n    \n    if not data then\n        return\n    end\n    \n    local cooldownInfo  = {\n        show = true,\n        name = data.name,\n        id = id,\n        icon = data.icon,\n        autoHide = autoHide,\n        duration = duration,\n        expirationTime = duration + GetTime(),\n        count = count,\n        roleIcon = data.roleIcon,\n    }\n    \n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD', encounterID, cooldownInfo)\n    \n    if not PRE_WARNING[id] then return end\n    \n    aura_env.SchedulePrewarning(id, duration)\nend\n\naura_env.IsCooldownReadyBefore = function(id, before)\n    local predictedAt = aura_env.predict[id]\n    return predictedAt and (predictedAt - GetTime() > before)\nend\n\naura_env.IsCooldownReady = function(id)\n    local predictedAt = aura_env.predict[id]\n    return predictedAt and (GetTime() > predictedAt)\nend\n\naura_env.Warning = function(warning, ...)\n    WeakAuras.ScanEvents('WA_MERFIN_T13', 'WARNING', warning, ...)\nend\n\naura_env.Antispam = function(id, before)\n    local cur = GetTime()\n    if not aura_env.antispams[id] \n    or cur - aura_env.antispams[id] > before then\n        aura_env.antispams[id] = cur\n        return true\n    end\n    return false\nend\n\naura_env.ClearCache = function()\n    aura_env.IsHeroic = WeakAuras.InstanceDifficulty() == 'heroic'\n    aura_env.size = WeakAuras.InstanceType()\n    \n    aura_env.WipeSchedulers()\n    \n    -- Reset Flags\n    aura_env.phase = 1\n    aura_env.addsWave = 0\n    aura_env.lastOnslaughtDamage = 0\n    \n    -- Clear caches and counters\n    aura_env.guidCache = {}\n    aura_env.count = {}\n    aura_env.predict = {}\n    aura_env.schedulers = {}\n    aura_env.antispams = {}\n    aura_env.pulled = true\n    \n    -- Destination Names\nend\n\naura_env.IsEmote = function(initialEmote, compareWith)\n    if not initialEmote then\n        return false\n    end\n    \n    if not aura_env.replicas[L] then\n        return false\n    end\n    \n    local replica = aura_env.replicas[L][compareWith]\n    \n    if not replica then\n        return false\n    end\n    \n    return initialEmote == replica or initialEmote:find(replica)\nend\n\naura_env.replicas = {\n    ['enUS'] = {\n        Sapper = \"A drake swoops down to drop a Twilight Sapper onto the deck!\",\n        GorionaRetreat = \"screeches in pain and retreats into the swirling clouds\",\n    },\n    ['ruRU'] = {\n        Sapper = \"Дракон пикирует на палубу, чтобы сбросить на нее сумеречного сапера!\",\n        GorionaRetreat = \"Гориона издает полный боли визг и скрывается в клубящихся вокруг облаках.\",\n    },\n    ['zhTW'] = {\n        Sapper = \"一頭龍急速飛來，載送一名暮光工兵降落到甲板上!\",\n        GorionaRetreat = \"痛苦嘶吼，躲入旋繞的雲裡。\",\n    },\n    ['koKR'] = {\n        Sapper = \"비룡이 빠르게 날아와 황혼의 폭파병을 갑판에 떨어뜨립니다!\",\n        GorionaRetreat = \"고통에 울부짖으며, 소용돌이치는 구름 속으로 달아납니다.\",\n    },\n    ['itIT'] = {\n        Sapper = \"Un Drago lascia cadere un Geniere sul ponte!\",\n        GorionaRetreat = \"Urla di Dolore e si rivolta nelle nuvole tempestose\",\n    },\n    ['frFR'] = {\n        Sapper = \"Un drake plonge et dépose un sapeur du Crépuscule sur le pont !\",\n        GorionaRetreat = \"None\",\n    },\n    ['esES'] = {\n        Sapper = \"¡Un draco desciende para dejar a un zapador Crepuscular en la cubierta!\",\n        GorionaRetreat = \"grita de dolor y se retira al remolino de nubes.\",\n    },\n    ['esMX'] = {\n        Sapper = \"¡Un draco desciende para dejar a un zapador Crepuscular en la cubierta!\",\n        GorionaRetreat = \"grita de dolor y se retira al remolino de nubes.\",\n    },\n    ['deDE'] = {\n        Sapper = \"Ein Drache stürzt herab, um einen Zwielichtpionier auf dem Deck abzusetzen!\",\n        GorionaRetreat = \"schreit vor Schmerzen auf und zieht sich in die wirbelnden Wolken zurück.\",\n    },\n    ['zhCN'] = {\n        Sapper = \"一条幼龙俯冲下来，往甲板上投放了一个暮光工兵！\",\n        GorionaRetreat = \"痛苦地尖叫并退入了云海的漩涡中\",\n    },\n}\n\naura_env.oldTimers = aura_env.config.oldTimers\n\n",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["custom"] = "function(e, msg, subEvent, uSpellId, sourceGUID, sourceName, _, _, destGUID, destName, _, _, spellId, _, _, _, amount)\n    \n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        \n        if subEvent == 'SPELL_CAST_START' then\n            if spellId == 107588 then\n                aura_env.StartCD('TwilightOnslaught', 35, false, true)\n                \n            elseif spellId == 108046 then\n                aura_env.ScheduleEvent('ShockwaveTarget', 0.2)\n                aura_env.StartCD('Shockwave', 21, false, true)\n            end\n            \n        elseif subEvent == 'SPELL_DAMAGE' then\n            if spellId == 106401 then\n                if not aura_env.Antispam('OnslaughtLanded', 5) then\n                    return\n                end\n                aura_env.lastOnslaughtDamage = curTime\n                aura_env.Warning('OnslaughtLanded')\n            end\n            \n        elseif subEvent == 'SPELL_AURA_APPLIED' then\n            if spellId == 108040 then\n                if aura_env.phase ~= 1 then\n                    return\n                end\n                aura_env.phase = 2\n                aura_env.Warning('Phase2')\n                aura_env.StopCD('TwilightOnslaught')\n                aura_env.StopCD('Broadside')\n                aura_env.ScheduleEvent('Phase2Delayed', 10)\n                \n            elseif spellId == 110214 then\n                aura_env.StartCD('ConsumingShroud', 30)\n            end\n            \n        elseif subEvent == 'SPELL_CAST_SUCCESS' then\n            if spellId == 108044 then\n                aura_env.StartCD('DisruptingRoar', 19.5, false, true)\n            elseif spellId == 108042 then\n                aura_env.StartCD('SunderArmor', 8, false, true)\n            end\n            \n        elseif subEvent == 'SPELL_SUMMON' then\n            if spellId == 108051 then\n                aura_env.StartCD('TwilightFlames', 8, true)\n                aura_env.Warning('TwilightFlames')\n            end\n        end\n        \n    elseif e == 'WA_MERFIN_T13_SCHEDULED' then\n        \n        if msg == 'Adds' then\n            aura_env.Warning('Adds')\n            if aura_env.addsWave < 2 then\n                aura_env.addsWave = aura_env.addsWave + 1\n                local duration = 61\n                -- Autohide True for 3rd Wave\n                aura_env.StartCD('Adds', duration, aura_env.addsWave == 2, true)\n                aura_env.ScheduleEvent('Adds', duration)\n            end\n            aura_env.StartCD('Harpoon', aura_env.addsWave == 1 and 18 or 6.5, true)\n            \n        elseif msg == 'Phase2Delayed' then\n            aura_env.StopCD('Sapper')\n            aura_env.StartCD('DisruptingRoar', 10)\n            aura_env.StartCD('TwilightFlames', 10.5, true)\n            aura_env.StartCD('Shockwave', 13)\n            if aura_env.IsHeroic then\n                aura_env.StartCD('ConsumingShroud', 45)\n            end\n            aura_env.StartCD('Berserk', 240, true)\n        elseif msg == 'ShockwaveTarget' then\n            local unitPool = { 'boss1', 'boss2', 'boss3', 'target' }\n            for _, unitId in ipairs(unitPool) do\n                local guid = UnitGUID(unitId)\n                if aura_env.IsGUID(guid, 'BLACKHORN') then\n                    local targetUnit = unitId .. 'target'\n                    local targetName = UnitName(targetUnit)\n                    WeakAuras.ScanEvents('WA_SHOCK_WAVE_TARGET', targetName)\n                end\n            end\n        end\n        \n    elseif e == 'RAID_BOSS_EMOTE' then\n        if aura_env.IsEmote(msg, 'Sapper') then\n            if aura_env.phase == 2 then\n                aura_env.StopCD('Sapper')\n            end\n            aura_env.StartCD('Sapper', 39.8, false, true)\n            aura_env.Warning('Sapper')\n            \n        elseif msg:find(\"110153\") then\n            aura_env.StartCD('Broadside', 70)\n            \n        elseif aura_env.IsEmote(msg, 'GorionaRetreat') then\n            aura_env.StopCD('TwilightFlames')\n            aura_env.StopCD('ConsumingShroud')\n            aura_env.StopCD('Sapper')\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.StartCD('TwilightOnslaught', 46.9)\n        aura_env.StartCD('Adds', 22.8)\n        aura_env.ScheduleEvent('Adds', 22.8)\n        aura_env.StartCD('Sapper', 70)\n        aura_env.StartCD('Broadside', 57)\n        \n    elseif e == 'STATUS' then\n        aura_env.ClearCache()\n        \n    elseif e == 'OPTIONS' and not WeakAuras.IsAuraLoaded(aura_env.id) then\n        aura_env.WipeSchedulers()\n    end\nend",
["names"] = {
},
