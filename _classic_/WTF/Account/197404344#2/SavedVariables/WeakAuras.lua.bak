["event"] = "Health",
["unit"] = "player",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["custom"] = "function(state, event, subEvent, visibility, cooldownName, duration, autoHide, count)\n    \n    if event ~= 'WA_MERFIN_T13' or subEvent ~= 'COOLDOWN' or cooldownName ~= 'PsychicDrain' then\n        return\n    end\n    \n    if visibility == 'HIDE' and state[''] then\n        state[''].show = false\n        state[''].changed = true\n        return true\n    end\n    \n    if visibility == 'SHOW' then\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = autoHide or false,\n            duration = duration,\n            expirationTime = duration + GetTime(),\n            nextCount = count+1,\n        }\n        return true\n    end\nend",
