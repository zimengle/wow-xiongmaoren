["[DP] [Elegon] Celestial Protector Callback"] = {
["exrtLastSender"] = "Jfkx-ClassicBetaPvE",
["wagoID"] = "H5gs0vTam",
["parent"] = "[DP] [Elegon] Phase 1",
["preferToUpdate"] = true,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.IsSpam = function(before)\n    local cur = GetTime()\n    if not aura_env.antispam or cur - aura_env.antispam > before then\n        aura_env.antispam = cur\n        return false\n    end\n    return true\nend\n\naura_env.Synch = function(GUID)\n    WeakAuras.ScanEvents('MERFIN_SYNCH', 'RAID', nil, 'MERF_NOTE_SYNCH', GUID)\nend\n\naura_env.happenedOnce = {}\naura_env.savedGUIDs = {}",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "custom",
["events"] = "UNIT_HEALTH, MERF_NOTE_SYNCH, ENCOUNTER_START",
["spellIds"] = {
},
["subeventPrefix"] = "SPELL",
["names"] = {
},
["custom_type"] = "event",
["custom"] = "function(event, ...)\n    if event == 'MERF_NOTE_SYNCH' then\n        local guid = ...\n        if not aura_env.savedGUIDs[guid] then\n            aura_env.happenedOnce[guid] = true\n            aura_env.savedGUIDs[guid] = true\n            aura_env.count = (aura_env.count or 0) + 1\n            local event = 'ANNIHILATION_' .. aura_env.count\n            GMRT.F.Note_Timer(event)\n        end\n    end\n    \n    if event == 'ENCOUNTER_START' then\n        aura_env.count = 0\n        aura_env.savedGUIDs = {}\n        aura_env.happenedOnce = {}\n        return\n    end\n    \n    if event ~= 'UNIT_HEALTH' then return end\n    local unit = ...\n    if not unit or not UnitExists(unit) then return end\n    \n    if not unit:find(\"^nameplate\") then return end\n    \n    local guid = UnitGUID(unit)\n    if not guid then return end\n    \n    local type, _, _, _, _, npcID = strsplit(\"-\", guid)\n    npcID = tonumber(npcID)\n    \n    if npcID ~= 60793 then return end\n    \n    aura_env.happenedOnce = aura_env.happenedOnce or {}\n    \n    if aura_env.happenedOnce[guid] then return end\n    \n    local health = UnitHealth(unit)\n    local maxHealth = UnitHealthMax(unit)\n    \n    if maxHealth == 0 then return end\n    \n    local percent = (health / maxHealth) * 100\n    if percent <= 95 then\n        aura_env.happenedOnce[guid] = true\n        aura_env.Synch(guid)\n    end\nend",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["activeTriggerMode"] = -10,
},
