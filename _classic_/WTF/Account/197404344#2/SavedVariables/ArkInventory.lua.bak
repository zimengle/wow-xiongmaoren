},
{
["i"] = false,
["r"] = false,
["d"] = "塞拉赞恩和她的石领主子嗣们统治着土元素位面深岩之洲。在见证了死亡之翼及其追随者对她的国度造成的伤害后，塞拉赞恩对所有外来者都充满了敌意。",
["w"] = false,
["n"] = "塞拉赞恩",
},
{
["i"] = false,
["r"] = false,
["d"] = "这支狂放不羁的兽人氏族曾经在死亡之翼的授意下奴役了红龙军团和红龙女王阿莱克丝塔萨。如今龙喉氏族的数量和实力都已不如往昔，他们在暮光高地上建立了家园。",
["w"] = false,
["n"] = "龙喉氏族",
},
{
["i"] = false,
["r"] = false,
["d"] = "拉穆卡恒的猫形子民是奥丹姆守护者托维尔一族的后裔。尽管他们失去了石头的身体，但保护泰坦秘密的使命仍然留在了他们一成不变的传统中。",
["w"] = false,
["n"] = "拉穆卡恒",
},
{
["i"] = false,
["r"] = false,
["d"] = "蛮锤部族以他们近乎鲁莽的勇气和出类拔萃的狮鹫骑战技艺而闻名。因为黑铁矮人的诅咒，他们失去了在格瑞姆巴托的家园。在那之后，蛮锤矮人们分散地定居在暮光高地上。",
["w"] = false,
["n"] = "蛮锤部族",
},
{
