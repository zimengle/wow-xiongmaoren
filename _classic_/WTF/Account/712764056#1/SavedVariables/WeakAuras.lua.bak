["[BW] [Emperors] Put Pet on Passive"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["parent"] = "[Progress] [T14] Big Warnings",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "function()\n    local icon = '|TInterface\\\\Icons\\\\Ability_Seal:14:14:0:0:64:64:5:59:5:59|t'\n    local message = string.format(Merfin:L('Put Pet on %s Passive'), icon)\n    return message\nend",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/progress_t14/132",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.IsPetOnDefensive = function()\n    if not HasPetUI() then\n        return false\n    end\n    \n    for i = 1, NUM_PET_ACTION_SLOTS do\n        local name,_,_, isToken = GetPetActionInfo(i)\n        if isToken and name == \"PET_MODE_DEFENSIVE\" then\n            return true\n        end\n    end\n    \n    return false\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "unit",
["use_absorbHealMode"] = true,
["subeventSuffix"] = "_CAST_START",
["subzone"] = {
