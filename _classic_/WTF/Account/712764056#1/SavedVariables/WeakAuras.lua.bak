["[DP] [Feng] Flaming Spear"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1390'\nlocal ID          = 'FlamingSpear'\n\nlocal name, icon = C_Spell.GetSpellName(116942), C_Spell.GetSpellTexture(116942)\n\nlocal options = {\n    warningText = '%icon @cffffff80%name@r » %destName (%amount) %icon',\n}\n\naura_env.StopCD = function()\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, { ID = ID })\nend\n\naura_env.StartCD = function(duration, autoHide)\n    local data = {\n        show           = true,\n        autoHide       = autoHide,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        ID             = ID,\n        count          = aura_env.count,\n        name           = name,\n        icon           = icon,\n        roleIcon       = 'TANK'\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function(destName, amount)\n    local data = {\n        ID       = ID,\n        count    = aura_env.count,\n        destName = WA_ClassColorName(destName),\n        amount   = amount,\n        name     = name,\n        icon     = icon,\n        roleIcon = 'TANK'\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "PHASE_CHANGED, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_APPLIED_DOSE",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_, destGUID, destName,_,_, spellID,_,_,_, amount = ...\n        \n        if spellID == 116942 then\n            aura_env.count = aura_env.count + 1\n            if destGUID ~= WeakAuras.myGUID then\n                aura_env.SendWarning(destName, amount or 1)\n            end\n            aura_env.StartCD(8)\n        end\n        \n    elseif e == 'PHASE_CHANGED' then\n        local phase = ...\n        \n        if phase == 'FLAME' then\n            aura_env.count = 0\n            aura_env.StartCD(5.5)\n            \n        elseif phase == 'END' then\n            aura_env.StopCD()\n        end\n    end\nend",
["spellIds"] = {
