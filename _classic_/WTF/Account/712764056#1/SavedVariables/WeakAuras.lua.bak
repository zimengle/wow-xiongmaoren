},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(event, spellID)\n    if event == 'INTERRUPT_SELF_WARNING_START' then\n        aura_env.spellID = spellID\n        return true\n    end\nend",
["events"] = "INTERRUPT_SELF_WARNING_START, INTERRUPT_SELF_WARNING_STOP",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
