["type"] = "custom",
["custom"] = "function(states, e, _, warning)\n    if e == 'OPTIONS' then\n        states:Update('', {count = 2, destName = WA_ClassColorName(WeakAuras.me)})\n    end\n    if e == 'MERFIN_WARNING' and warning.ID == 'Exhale' then\n        states:Update('', {count = warning.count, destName = warning.destName})\n    end\nend",
["custom_type"] = "stateupdate",
["check"] = "event",
["customVariables"] = "{\n    destName = {\n        type    = 'string',\n        display = 'Dest Name'\n    }\n}",
["events"] = "MERFIN_WARNING",
["unit"] = "player",
},
["untrigger"] = {
},
},
