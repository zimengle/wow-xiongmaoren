["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1407'\nlocal ID          = 'FocusedEnergy'\n\nlocal name, icon = C_Spell.GetSpellName(116829), C_Spell.GetSpellTexture(116829)\n\nlocal options = {\n    warningText = \"%icon @cffff4040%name@r » %destName %icon\",\n}\n\naura_env.SendWarning = function(destName)\n    local data = {\n        ID       = ID,\n        count    = aura_env.count,\n        destName = WA_ClassColorName(destName),\n        name     = name,\n        icon     = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_,_, destName,_,_, spellID = ...\n        \n        if spellID == 116829 then\n            aura_env.count = aura_env.count + 1\n            if destGUID ~= WeakAuras.myGUID then\n                aura_env.SendWarning(destName)\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
["spellIds"] = {
},
