["[DP] [SoNT] Trash"] = {
["outline"] = "OUTLINE",
["wagoID"] = "zylhUqLd0",
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/mop_dungeons/73",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local tonumber, strsplit, pairs = tonumber, strsplit, pairs\nlocal UnitExists, UnitGUID = UnitExists, UnitGUID\nlocal GetTime = GetTime\n\nlocal L = GetLocale()\n\naura_env.debug = function(...)\n    print('|cffffff00MerfinDebug T13:|r', ...)\nend\n\nlocal encounterID = 'TrashSoNT'\n\nlocal BuildSpellData = function(id, role)\n    return { \n        name = C_Spell.GetSpellName(id), \n        icon = C_Spell.GetSpellTexture(id),\n        roleIcon = role,\n    }\nend\n\nlocal cooldownData = {\n    ['CommanderAddsWave'] = { name = \"Adds Wave\", icon = 463485 },\n}\n\nlocal warningSounds = {\n    ['ResinShell'] = 'minorAlert1',\n    ['CommanderAddsWave'] = 'minorAlert1',\n    ['CommanderBossStart'] = 'minorAlert2',\n}\n\nlocal CREATURE_ID = { \n}\n\nlocal PRE_WARNING = {\n    ['CommanderAddsWave'] = true,\n}\n\nlocal GetGuidCreatureId = function(GUID)\n    local guidType, _, playerdbID, _, _, cid, _ = strsplit(\"-\", GUID or \"\")\n    if guidType and (guidType == \"Creature\" or guidType == \"Vehicle\" or guidType == \"Pet\") then\n        return tonumber(cid)\n    end\n    if guidType and (guidType == \"Player\" or guidType == \"Item\") then\n        return tonumber(playerdbID)\n    end\n    return 0\nend\n\nlocal GetUnitCreatureId = function(unitId)\n    if not UnitExists(unitId) then return 0 end\n    local unitGUID = UnitGUID(unitId)\n    return GetGuidCreatureId(unitGUID)\nend\n\naura_env.IsGUID = function(sourceGUID, creature)\n    local creatureId = CREATURE_ID[creature]\n    if not creatureId then  return false end\n    local npcId = aura_env.guidCache[sourceGUID] or GetGuidCreatureId(sourceGUID)\n    return npcId == creatureId\nend\n\naura_env.ManageCounter = function(action, mechanicName, value)\n    if action == \"increase\" then\n        aura_env.count[mechanicName] = (aura_env.count[mechanicName] or 0) + 1\n        return aura_env.count[mechanicName]\n    elseif action == \"get\" then\n        return aura_env.count[mechanicName] or 0\n    elseif action == \"set\" then\n        aura_env.count[mechanicName] = value\n        return aura_env.count[mechanicName]\n    else\n        --print(\"Unknown action: \" .. tostring(action))\n    end\nend\n\naura_env.Antispam = function(id, before)\n    local cur = GetTime()\n    if not aura_env.antispams[id] \n    or cur - aura_env.antispams[id] > before then\n        aura_env.antispams[id] = cur\n        return true\n    end\n    return false\nend\n\naura_env.WipeSchedulers = function()\n    if not aura_env.schedulers then return end\n    for schedulerName, scheduler in pairs(aura_env.schedulers) do\n        WeakAuras.timer:CancelTimer(scheduler)\n    end\nend\n\naura_env.ClearCache = function()\n    aura_env.IsHeroic = WeakAuras.InstanceDifficulty() == 'heroic'\n    \n    aura_env.WipeSchedulers()\n    \n    -- Clear caches and counters\n    aura_env.guidCache = {}\n    aura_env.count = {}\n    aura_env.predict = {}\n    aura_env.schedulers = {}\n    aura_env.antispams = {}\nend\n\naura_env.ScheduleEvent = function(id, after, ...)\n    aura_env.schedulers = aura_env.schedulers or {}\n    \n    if aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n    end\n    \n    aura_env.schedulers[id] = WeakAuras.timer:ScheduleTimer(\n        WeakAuras.ScanEvents,\n        after,\n        'WA_MERFIN_DUNGEON_SCHEDULED',\n        id,\n        ...\n    )\nend\n\naura_env.SchedulePrewarning = function(id, duration)\n    aura_env.schedulers = aura_env.schedulers or {}\n    \n    if aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n        WeakAuras.ScanEvents('WA_MERFIN_BOSS_PRE_WARNING', 'HIDE', id)\n    end\n    \n    aura_env.schedulers[id] = WeakAuras.timer:ScheduleTimer(\n        WeakAuras.ScanEvents,\n        duration - 5,\n        'WA_MERFIN_BOSS_PRE_WARNING',\n        'SHOW',\n        id\n    )\nend\n\naura_env.StopCD = function(id, GUID)\n    aura_env.predict[id] = nil\n    \n    if PRE_WARNING[id] and aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n        WeakAuras.ScanEvents('WA_MERFIN_BOSS_PRE_WARNING', 'HIDE', id)\n    end\n    \n    local data = cooldownData[id]\n    if not data then return end\n    \n    local cooldown = {\n        id = id,\n        GUID = GUID,\n    }\n    \n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD_HIDE', encounterID, cooldown)\nend\n\naura_env.StartCD = function(id, duration, isIncrease, autoHide, GUID)\n    local count = aura_env.ManageCounter(isIncrease and 'increase' or 'get', id)\n    aura_env.predict[id] = duration + GetTime()\n    \n    if PRE_WARNING[id] then aura_env.SchedulePrewarning(id, duration) end\n    \n    local data = cooldownData[id]\n    if not data then return end\n    \n    local cooldown  = {\n        show = true,\n        autoHide = autoHide,\n        duration = duration,\n        expirationTime = duration + GetTime(),\n        name = data.name,\n        id = id,\n        GUID = GUID,\n        icon = data.icon,\n        count = count,\n        roleIcon = data.roleIcon,\n        special = data.special,\n    }\n    \n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD', encounterID, cooldown)\nend\n\naura_env.Warning = function(warning, ...)\n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_WARNING', warning, ...)\n    local sound = warningSounds[warning]\n    if sound then aura_env.PlaySound(sound) end\nend\n\naura_env.TTS = function(text, voiceID)\n    local voiceID = voiceID or 2\n    WeakAuras.ScanEvents('WA_MERFIN_DUNGEON_TTS', text, voiceID)\nend\n\naura_env.PlaySound = function(...)\n    WeakAuras.ScanEvents('WA_MERFIN_DUNGEON_SOUND', ...)\nend\n\naura_env.Chat = function(text, chatType)\n    WeakAuras.ScanEvents('WA_MERFIN_DUNGEON_CHAT', text, chatType)\nend\n\naura_env.IsEmote = function(initialEmote, compareWith)\n    local L = GetLocale()\n    if not initialEmote then return false end\n    if not aura_env.replicas[L] then return false end\n    local replica = aura_env.replicas[L][compareWith]\n    if not replica then return false end\n    return initialEmote == replica or initialEmote:find(replica)\nend\n\naura_env.replicas = {\n    ['enUS'] = {\n        CommanderWave0 = \"Li and Lo, get the sap into position!\",\n        CommanderWave1 = \"Swarmers, attack!  Tear the flesh from their bones!\",\n        CommanderWave2 = \"Demolishers, get in there!  Leave nothing but a pile of ash!\",\n        CommanderWave3 = \"Warriors, trample these weaklings!  Crush them!\",\n        CommanderWave4 = \"Everyone! Send everything! Slaughter these cowards, they are making us look like fools!\",\n        CommanderBossStart = \"I must finish this myself, then. So be it!\",\n    },\n    ['ruRU'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    },\n    ['deDE'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    },\n    ['frFR'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    },\n    ['esES'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    },\n    ['esMX'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    },\n    ['ptBR'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    },\n    ['itIT'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    },\n    ['koKR'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    },\n    ['zhCN'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    },\n    ['zhTW'] = {\n        CommanderWave0 = nil,\n        CommanderWave1 = nil,\n        CommanderWave2 = nil,\n        CommanderWave3 = nil,\n        CommanderWave4 = nil,\n        CommanderBossStart = nil,\n    }\n}",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "status",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(e, msg, subEvent, USSspellID, sourceGUID, sourceName, _, _, destGUID, destName, _, _, spellID, spellName, _, _, amount)\n    \n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        if subEvent == 'SPELL_CAST_START' then\n            if spellID == 120946 and aura_env.Antispam(spellID, 2) then\n                aura_env.Warning('ResinShell')\n            end\n        elseif subEvent == 'SPELL_AURA_APPLIED' then\n            if spellID == 123032 and sourceGUID == WeakAuras.myGUID then\n               --aura_env.Chat('{rt2} ' .. WeakAuras.me .. ' carrying keg {rt2}')\n            elseif spellID == 119388 and destGUID == WeakAuras.myGUID then\n               --aura_env.Chat('{rt2} ' .. WeakAuras.me .. ' bomb {rt2}')\n            end\n        elseif subEvent == 'SPELL_AURA_REMOVED' then\n            if spellID == 123032 and sourceGUID == WeakAuras.myGUID then\n                --aura_env.Chat('- threw keg -')\n            elseif spellID == 119388 and destGUID == WeakAuras.myGUID then\n                --aura_env.Chat('- threw -')\n            end\n        end\n        \n    elseif e == 'CHAT_MSG_MONSTER_YELL' then\n        if aura_env.IsEmote(msg, 'CommanderBossStart') then\n            aura_env.StopCD('CommanderAddsWave')\n            aura_env.Warning('CommanderBossStart')\n        elseif aura_env.IsEmote(msg, 'CommanderWave1') then\n            aura_env.Warning('CommanderAddsWave', 1)\n            aura_env.StartCD('CommanderAddsWave', 65, true)\n        elseif aura_env.IsEmote(msg, 'CommanderWave2') then\n            aura_env.Warning('CommanderAddsWave', 2)\n            aura_env.StartCD('CommanderAddsWave', 60, true)\n        elseif aura_env.IsEmote(msg, 'CommanderWave3') then\n            aura_env.Warning('CommanderAddsWave', 3)\n            aura_env.StartCD('CommanderAddsWave', 60, true)\n        elseif aura_env.IsEmote(msg, 'CommanderWave4') then\n            aura_env.Warning('CommanderAddsWave', 4)\n            aura_env.StartCD('CommanderAddsWave', 89, true)\n        end\n        \n    elseif e == 'CHAT_MSG_MONSTER_SAY' then\n        if aura_env.IsEmote(msg, 'CommanderWave0') then\n            aura_env.StartCD('CommanderAddsWave', 20)\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.ClearCache()\n        \n    elseif e == 'STATUS' then\n        aura_env.ClearCache()\n        \n    elseif e == 'OPTIONS' and not WeakAuras.IsAuraLoaded(aura_env.id) then\n        aura_env.WipeSchedulers()\n    end\nend",
