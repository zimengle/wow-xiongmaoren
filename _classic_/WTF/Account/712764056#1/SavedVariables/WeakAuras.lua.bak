["uid"] = "MERuznaEhfm",
["customText"] = "function()\n    local locale = GetLocale()\n    \n    local localizedTexts = {\n        enUS = \"Dispel HoT\",\n        enGB = \"Dispel HoT\",\n        deDE = \"HoT entfernen\",\n        esES = \"Disipa el HoT\",\n        esMX = \"Disipa el HoT\",\n        frFR = \"Dissipez le HoT\",\n        itIT = \"Dissipa HoT\",\n        koKR = \"HoT 해제\",\n        ptBR = \"Dissipar HoT\",\n        ruRU = \"Диспел ХоТ\",\n        zhCN = \"驱散HoT\",\n        zhTW = \"驅散HoT\",\n    }\n    \n    return localizedTexts[locale] or \"Dispel HoT\"\nend",
