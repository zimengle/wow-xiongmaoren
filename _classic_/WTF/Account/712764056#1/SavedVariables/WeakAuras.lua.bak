},
["custom"] = "function(states, event, ...)\n    \n    if event == 'OPTIONS' or event == 'WA_DELAYED_PLAYER_ENTERING_WORLD' then\n        local duration = event == 'OPTIONS' and 5 or 0.1\n        states:Update('', {\n                progressType   = 'timed',\n                duration       = duration,\n                expirationTime = duration + GetTime(),\n                autoHide       = true,\n                range          = 10,\n                displayText    = WA_ClassColorName(WeakAuras.me),\n        })\n    end\nend",
