["custom"] = "local encounterID = '1431'\n\nlocal function GetSpellInfoTable(spellID)\n    return {\n        name = C_Spell.GetSpellName(spellID),\n        icon = C_Spell.GetSpellTexture(spellID)\n    }\nend\n\nlocal data = {\n    ['Submerge'] = GetSpellInfoTable(120455),\n    ['Emerge'] = GetSpellInfoTable(120458)\n}\n\nlocal options = {\n    ['Submerge'] = {\n        warningText = Merfin:L('Run Out'):upper(), \n        prewarnCountVA = 2,\n        prewarnTTStext = Merfin:L('Stack')\n    },\n    ['Emerge'] = {\n        warningText = Merfin:L('Stack'):upper(), \n        ttsLine = Merfin:L('Stack'),\n    },\n}\n\naura_env.StopCD = function(ID)\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, {ID = ID})\nend\n\naura_env.StartCD = function(ID, duration, autoHide)\n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, {\n            show = true,\n            autoHide = autoHide,\n            duration = duration,\n            expirationTime = duration + GetTime(),\n            ID = ID,\n            name = data[ID].name,\n            icon = data[ID].icon,\n            count = aura_env.count\n        }, options[ID])\nend\n\naura_env.SendWarning = function(ID)\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID = ID,\n            name = data[ID].name,\n            icon = data[ID].icon,\n            count = aura_env.count\n        }, options[ID])\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, SHA_PHASE, CLEU:SPELL_CAST_START, UNIT_SPELLCAST_SUCCEEDED:boss1",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_CAST_START' then\n            if spellID == 120458 then\n                WeakAuras.ScanEvents('EMERGE')\n                WeakAuras.ScanEvents('MERFIN_TTS', Merfin:L('Stack'))\n                \n            elseif spellID == 120455 then\n                aura_env.count = aura_env.count + 1\n                aura_env.SendWarning('Submerge')\n                aura_env.StartCD('Submerge', 57)\n            end\n        end\n        \n        \n    elseif e == 'UNIT_SPELLCAST_SUCCEEDED' then\n        local _,_, spellID = ...\n        if spellID == 62535 and aura_env.phase2 then\n            C_Timer.After(1, function()\n                    local delay = 1\n                    local duration = (1 - UnitPower(\"boss1\") / UnitPowerMax(\"boss1\")) * 47\n                    aura_env.StartCD('Submerge', duration-delay)\n            end)\n        end\n        \n    elseif e == 'SHA_PHASE' then\n        local phaseN = ...\n        \n        if phaseN == 2 then\n            aura_env.phase2 = true\n            aura_env.count = 0\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.phase2 = false\n        aura_env.count = 0\n    end\n    \nend",
