["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "-- 版权声明\n-- WA制作：露露緹婭@Bilibili，https://space.bilibili.com/455259，转载请保留出处\n\nlocal e = aura_env\nlocal region = WeakAuras.GetRegion(e.id)\n\nif not _G[e.id..\"Button\"] then\n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, \"SecureActionButtonTemplate\")\n    e.btn:RegisterForClicks(\"LeftButtonUp\", \"LeftButtonDown\", \"RightButtonUp\", \"RightButtonDown\")\n    e.btn:SetAttribute(\"type1\", \"macro\")\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\nbtn:SetAttribute(\"macrotext1\", \"/run ResetInstances()\\n/p 副本已重置\\n/ra 副本已重置\")\n\nbtn:SetScript(\"OnMouseUp\", function(self)\n        region:SetAlpha(1)\nend)\nbtn:SetScript(\"OnMouseDown\", function(self)\n        region:SetAlpha(0.5)\nend)\nbtn:SetScript(\"OnEnter\", function(self)\n        GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\") \n        GameTooltip:SetText(\n        \"|cffffffff露露的快捷按钮|r\\n|cff00ffff\"..\"重置副本并通告\"..\"|r\")\n        region:SetScale(1)\nend)\nbtn:SetScript(\"OnLeave\", function(self)\n        region:SetScale(1)\n        GameTooltip:Hide()\nend)\n\nbtn:Show()",
},
},
