["width"] = 64,
["parent"] = "!【露露自用】Kaze MRT Timers 战术板WA 1001更",
["uid"] = "NoJohv0GHxH",
["inverse"] = false,
["preferToUpdate"] = false,
["displayIcon"] = "interface/scenarios/scenarioicon-interact.blp",
["cooldown"] = true,
["desc"] = "露露自用版，TTS语音默认开启，提前10秒播报。\n————————\n英文原版：\nby KazeShinu#2330\n\nhttps://wago.io/n7l5uN3YM/64",
