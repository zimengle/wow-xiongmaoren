["unit"] = "player",
["debuffType"] = "HELPFUL",
["events"] = "MERFIN_SOUND_COUNTDOWN",
["custom"] = "function(event, index, remainingSeconds, isLocalized)\n    if event ~= \"MERFIN_SOUND_COUNTDOWN\" then return end\n    if not index then return end\n    \n    local second = tonumber(remainingSeconds)\n    if not second or second < 1 or second > 5 then return end\n    \n    local index = (isLocalized and aura_env.defaultCountVA[index]) or index\n    local path = aura_env.CountdownSounds[index] and aura_env.CountdownSounds[index][second]\n    \n    if path then\n        aura_env.PlaySoundFile(path, \"Master\")\n    end\nend",
