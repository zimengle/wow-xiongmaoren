["debuffType"] = "HELPFUL",
["custom"] = "function(event)\n    if Merfin and Merfin.GetConfig and Merfin.GetConfig('HoF_Misc') then\n        local hideNameplates = Merfin.GetConfig('HoF_Misc')['1463'].hideNameplates\n        return hideNameplates\n    end\nend",
["unit"] = "player",
