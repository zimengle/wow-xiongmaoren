["custom"] = "local encounterID = '1431'\nlocal ID = 'ShaGlobe'\n\nlocal name, icon = C_Spell.GetSpellName(129189), C_Spell.GetSpellTexture(129189)\n\nlocal options = {warningText = '%icon @cffffff80%name@r %icon'}\n\naura_env.SendWarning = function()\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID = ID,\n            name = name,\n            icon = icon,\n            count = aura_env.count\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
