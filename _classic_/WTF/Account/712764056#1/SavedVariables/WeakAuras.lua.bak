["[DP] [TotJS] Liu Flameheart"] = {
["outline"] = "OUTLINE",
["wagoID"] = "zylhUqLd0",
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
