["custom"] = "function(event)\n    if event == 'DELAYED_CELESTIAL_TTS' then\n        WeakAuras.ScanEvents('WA_MERFIN_DUNGEON_TTS', 'Take Celestial Buff', 1, 2)\n    end\nend",
