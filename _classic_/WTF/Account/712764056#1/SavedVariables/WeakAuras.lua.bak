},
["anchorFrameParent"] = false,
["fontSize"] = 25,
["displayText_format_c1_format"] = "none",
["version"] = 73,
["shadowXOffset"] = 0,
["fixedWidth"] = 200,
["displayText_format_p_format"] = "timed",
["internalVersion"] = 87,
["regionType"] = "text",
["displayText_format_p_time_dynamic_threshold"] = 60,
["config"] = {
},
["xOffset"] = 0,
["displayText_format_c_format"] = "none",
["displayText_format_p_time_precision"] = 1,
["animation"] = {
["start"] = {
["colorR"] = 1,
["duration_type"] = "seconds",
["colorA"] = 1,
["colorG"] = 0.25098040699959,
["use_translate"] = true,
["duration"] = "0.2",
["type"] = "custom",
["translateType"] = "bounce",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local bounceDistance = math.sin(progress * math.pi)\n    return startX + (bounceDistance * deltaX), startY + (bounceDistance * deltaY)\nend\n",
["scaley"] = 1,
["alpha"] = 0,
["rotate"] = 0,
["y"] = 10,
["x"] = 0,
["colorB"] = 0.25098040699959,
["use_color"] = false,
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    return r1 + (progress * (r2 - r1)), g1 + (progress * (g2 - g1)), b1 + (progress * (b2 - b1)), a1 + (progress * (a2 - a1))\nend\n",
["easeStrength"] = 3,
["colorType"] = "straightColor",
["scalex"] = 1,
},
["main"] = {
["colorR"] = 1,
["duration_type"] = "seconds",
["colorA"] = 1,
["colorG"] = 0.54901963472366,
["use_translate"] = true,
["duration"] = "0.3",
["type"] = "custom",
["translateType"] = "shake",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local prog\n    if(progress < 0.25) then\n        prog = progress * 4\n    elseif(progress < .75) then\n        prog = 2 - (progress * 4)\n    else\n        prog = (progress - 1) * 4\n    end\n    return startX + (prog * deltaX), startY + (prog * deltaY)\nend\n",
["scaley"] = 1,
["alpha"] = 0,
["rotate"] = 0,
["y"] = 0,
["x"] = 3,
["colorB"] = 0.54901963472366,
["use_color"] = false,
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return r1 + (newProgress * (r2 - r1)),\n         g1 + (newProgress * (g2 - g1)),\n         b1 + (newProgress * (b2 - b1)),\n         a1 + (newProgress * (a2 - a1))\nend\n",
["easeStrength"] = 3,
["colorType"] = "pulseColor",
["scalex"] = 1,
},
["finish"] = {
["easeStrength"] = 3,
["type"] = "none",
["duration_type"] = "seconds",
["easeType"] = "none",
},
},
