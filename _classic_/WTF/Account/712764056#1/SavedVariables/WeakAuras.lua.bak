["parent"] = "[BW] Shado-Pan Monastery",
["customText"] = "function()\n    local destName = aura_env.state.destName or (WeakAuras.IsOptionsOpen() and WeakAuras.me)\n    return string.upper(WA_ClassColorName(destName))\nend",
["shadowYOffset"] = 0,
