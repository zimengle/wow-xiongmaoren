["authorOptions"] = {
{
["useName"] = true,
["text"] = "|cfffe7b2cby |cffc79c6e知半-白银之手|r 致谢原作者",
["type"] = "header",
["width"] = 1,
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["useHeight"] = false,
["width"] = 2,
},
{
["type"] = "description",
["text"] = "核心代码扒自SimpleChat 作者 五区-塞拉摩-Leyvaten SimpleChat插件更新地址 http://nga.178.com/read.php?tid=9633520 ; 按钮写法扒自论坛qfeizaijun的回帖 向大佬们致敬~",
["fontSize"] = "small",
["width"] = 2,
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["useHeight"] = false,
["width"] = 2,
},
{
["useName"] = true,
["text"] = "功能简介",
["type"] = "header",
["width"] = 1,
},
{
["type"] = "space",
["variableWidth"] = true,
["height"] = 1,
["useHeight"] = false,
["width"] = 1,
},
{
["type"] = "description",
["fontSize"] = "small",
["text"] = "自左至右: 说 大喊 公会 小队 团队 随机副本 世界频道 表情按钮 Roll点按钮 属性报告/WA 集合石 自定义功能 /reload\n\n7个频道按钮通用: 点击激活聊天输入框 shift点击关闭输入框\n团队和随机副本频道 右击为团队通知 须为团长或有A\n世界频道左击聊天 右击加入/退出世界频道\n\nRoll点按钮shift点击roll100 自娱自乐~\nRL按钮左击可打开ElvUI设置 shift+左击解锁框体布局 右击重载(/rl)\n没装ElvUI最后个按钮 左右键都是重载(/rl)\n\n组设置中可自行修改按钮间距 按钮排列方向 按钮大小(建议用\"组缩放\"修改)",
["width"] = 2,
},
},
