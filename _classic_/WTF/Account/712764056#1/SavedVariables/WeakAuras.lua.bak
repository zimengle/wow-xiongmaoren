["[DP] [Feng] Siphoning Shield"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1390'\nlocal ID          = 'SiphoningShield'\n\nlocal name, icon = C_Spell.GetSpellName(117209), C_Spell.GetSpellTexture(117209)\n\nlocal options = {\n    warningText = '@cffff4040%upper:name@r',\n    ttsLine = Merfin:L('Adds Incoming')\n}\n\naura_env.MRT = function()\n    if not WeakAuras.IsAuraLoaded(aura_env.id) then return end\n    local event = 'SHIELD_' .. (aura_env.count + 1)\n    GMRT.F.Note_Timer(event)\n    \nend\n\naura_env.CancelMRT = function()\n    if aura_env._mrtTimer and aura_env._mrtTimer.Cancel then\n        aura_env._mrtTimer:Cancel()\n        aura_env._mrtTimer = nil\n    end\nend\n\naura_env.StopCD = function()\n    aura_env.CancelMRT()\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, { ID = ID })\nend\n\naura_env.StartCD = function(duration, autoHide)\n    aura_env.CancelMRT()\n    local after = duration <= 5 and duration or duration - 5\n    aura_env._mrtTimer = C_Timer.NewTimer(after, aura_env.MRT)\n    local data = {\n        show           = true,\n        autoHide       = autoHide,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        ID             = ID,\n        count          = aura_env.count,\n        name           = name,\n        icon           = icon,\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function()\n    local data = {\n        ID    = ID,\n        count = aura_env.count,\n        name  = name,\n        icon  = icon,\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, PHASE_CHANGED, UNIT_SPELLCAST_SUCCEEDED:boss1",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'UNIT_SPELLCAST_SUCCEEDED' then\n        local _,_, spellID = ...\n        \n        if spellID == 117203 then\n            aura_env.count = aura_env.count + 1\n            aura_env.SendWarning()\n            aura_env.StartCD(35)\n        end\n        \n    elseif e == 'PHASE_CHANGED' then\n        local phase = ...\n        \n        if phase == 'SHADOW' then\n            aura_env.count = 0\n            aura_env.StartCD(4.1)\n            \n        elseif phase == 'END' then\n            aura_env.StopCD()\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.CancelMRT()\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
