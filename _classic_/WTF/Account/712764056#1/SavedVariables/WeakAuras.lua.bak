["[DP] [MV-Trash] Elegon Roleplays"] = {
["exrtLastSync"] = 1751102740,
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["preferToUpdate"] = false,
["parent"] = "[DP] Trash (Mogu'shan Vaults)",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["load"] = {
["zoneIds"] = "473",
["use_zoneIds"] = true,
["talent"] = {
["multi"] = {
},
},
["use_never"] = false,
["class"] = {
["multi"] = {
},
},
["spec"] = {
["multi"] = {
},
},
["size"] = {
["multi"] = {
},
},
},
["regionType"] = "empty",
["xOffset"] = 0,
["tocversion"] = 50500,
["url"] = "https://wago.io/progress_t14/132",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local L = GetLocale()\n\naura_env.IsEmote = function(initialEmote, compareWith)\n    if not initialEmote then return false end\n    if not aura_env.replicas[L] then return false end\n    local replica = aura_env.replicas[L][compareWith]\n    if not replica then return false end\n    return initialEmote == replica or initialEmote:find(replica)\nend\n\naura_env.replicas = {\n    ['enUS'] = {\n        roleplay1 = \"Fascinating, I have never heard tales of anything like this. The mogu hide their secrets well.\",\n        roleplay11 = \"This room pulses with energy, but feels unlike any we have seen so far.\",\n        roleplay2 = \"This seems to be a terminal controlling the device. Let's see here...\"\n    },\n    \n    ['ruRU'] = {\n        roleplay1 = \"Потрясающе. Я никогда не слышал о чем-либо подобном. Могу хорошо хранят свои секреты.\",\n        roleplay11 = \"Я чувствую энергию в этом зале. Но она не похожа на то, с чем мы сталкивались раньше.\",\n        roleplay2 = \"Это, должно быть, пульт управления этим устройством. Давай посмотрим поближе...\"\n    },\n}",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["duration"] = "25",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "custom",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["subeventPrefix"] = "SPELL",
["events"] = "CHAT_MSG_MONSTER_SAY",
["names"] = {
},
["custom"] = "function(event, ...)\n    \n    if event == 'CHAT_MSG_MONSTER_SAY' then\n        local msg = ...\n        if not msg then return end\n        \n        if aura_env.IsEmote(msg, 'roleplay1') or aura_env.IsEmote(msg, 'roleplay11') then\n            if not aura_env.first then\n                aura_env.first = true\n                WeakAuras.ScanEvents('ELEGON_GOSSIP_AVAILABLE', 10)\n            end\n        elseif aura_env.IsEmote(msg, 'roleplay2') then\n            WeakAuras.ScanEvents('PRE_ELEGON_ROLEPLAY', 39)\n        end\n    end\nend",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["customTriggerLogic"] = "",
["activeTriggerMode"] = 1,
},
["selfPoint"] = "CENTER",
["internalVersion"] = 87,
["semver"] = "2.4.59",
