["[DP] [Feng] Strength of Spirit"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1390'\nlocal ID          = 'StrengthOfSpirit'\n\nlocal name, icon = C_Spell.GetSpellName(116363), C_Spell.GetSpellTexture(116363)\n\nlocal options = {\n    warningText = '%icon @cffffff80%name@r (+%damage%) %icon'\n}\n\naura_env.SendWarning = function(amount)\n    local data = {\n        ID     = ID,\n        count  = aura_env.count,\n        amount = amount,\n        damage = 5 * amount,\n        name   = name,\n        icon   = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_APPLIED_DOSE",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_,_,_,_,_, spellID,_,_,_, amount = ...\n        \n        if spellID == 116363 then\n            aura_env.count = aura_env.count + 1\n            aura_env.SendWarning(amount or 1)\n        end\n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
