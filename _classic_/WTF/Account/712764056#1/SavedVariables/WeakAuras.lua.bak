["customVariables"] = "{\n    active = {\n        display = 'During Spray',\n        type    = 'bool',\n    },\n    \n    isNext = {\n        display = 'Is Sector Next',\n        type    = 'bool',\n    },\n    \n    color = {\n        display = 'Color',\n        type    = 'select',\n        values  = {\n            ['R'] = 'Red',\n            ['O'] = 'Orange',\n            ['Y'] = 'Yellow',\n            ['G'] = 'Green',\n        }\n    }\n}",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(states, event, ...)\n    if event == 'SPRAY_SECTOR' then\n        local active, sectorN, color, isNext = ...\n        \n        if sectorN == aura_env.sectorN then\n            states:Update('', { sectorN = sectorN, color = color, active = active, isNext = isNext })\n        end\n        \n    elseif event == 'SPRAY_SECTOR_HIDE' then\n        states:Remove('')\n    end\nend",
