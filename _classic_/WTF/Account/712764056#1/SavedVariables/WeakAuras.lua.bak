["[DP] [Mel'jarak] Mending"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1498'\nlocal ID          = 'Mending'\n\nlocal name, icon = C_Spell.GetSpellName(122193), C_Spell.GetSpellTexture(122193)\n\nlocal options = {\n    warningText = \"%icon @cffffff80%name@r %icon\",\n}\n\naura_env.StopCD = function(GUID)\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, {\n            ID = ID,\n            GUID = GUID\n    })\nend\n\naura_env.StartCD = function(duration, GUID)\n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, {\n            show           = true,\n            autoHide       = autoHide,\n            duration       = duration,\n            expirationTime = duration + GetTime(),\n            ID             = ID,\n            name           = name,\n            icon           = icon,\n            count          = aura_env.count,\n            GUID           = GUID\n    }, options)\nend\n\naura_env.SendWarning = function()\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID    = ID,\n            name  = name,\n            icon  = icon,\n            count = aura_env.count,\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, UNIT_DIED, CLEU:SPELL_CAST_START",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_, sourceGUID,_,_,_,_,_,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_CAST_START' then\n            if spellID == 122193 then\n                aura_env.count = aura_env.count + 1\n                aura_env.StartCD(37, sourceGUID)\n                if sourceGUID == UnitGUID('target') or sourceGUID == UnitGUID('focus') then\n                    aura_env.SendWarning()\n                end\n            end\n        end\n        \n    elseif e == 'UNIT_DIED' then\n        local npcID, destGUID = ...\n        \n        if npcID == 62408 then\n            aura_env.StopCD(destGUID)\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
["spellIds"] = {
},
