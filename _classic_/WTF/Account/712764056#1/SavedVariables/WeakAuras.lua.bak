["[Widget] [Sha] Dread Spray Dispatcher"] = {
["exrtLastSender"] = "Jfkx-ClassicBetaPvE",
["wagoID"] = "1qyg9npGm",
["parent"] = "[Widget] Sha Dread Spray Sectors 禁用",
["preferToUpdate"] = false,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["url"] = "https://wago.io/progress_t14/132",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.bowManSeq = {\n    [61038] = {4, 8, 8, 4, 3, 7, 7, 3, 2, 6, 6, 2, 1, 5, 5, 1}, -- Yang Guoshi\n    [61042] = {1, 4, 5, 6, 3, 6, 7, 8, 5, 8, 1, 2, 7, 2, 3, 4}, -- Cheng Kang\n    [61046] = {5, 6, 8, 1, 7, 8, 2, 3, 1, 2, 4, 5, 3, 4, 6, 7}  -- Jinlun Kun\n}",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "timed",
["events"] = "DREAD_SPRAY, LEAVE_PLATFORM, SHA_PHASE",
["spellIds"] = {
},
["subeventPrefix"] = "SPELL",
["names"] = {
},
["custom_type"] = "event",
["custom"] = "function(event, ...)\n    if event == 'DREAD_SPRAY' then\n        local active, bowMan, shotN = ...\n        \n        if not (bowMan and shotN) then return end\n        \n        for i = 1, 8 do\n            local c = 'G'\n            local isNext = false\n            \n            if aura_env.bowManSeq[bowMan][shotN + 1] == i then\n                isNext = true\n            end\n            \n            for j = shotN, 16 do\n                if aura_env.bowManSeq[bowMan][j] == i then\n                    if j - shotN < 4 then \n                        c = 'R'\n                    elseif j - shotN < 8 then \n                        c = 'O'\n                    else \n                        c = 'Y'\n                    end\n                    break\n                end\n            end\n            \n            WeakAuras.ScanEvents('SPRAY_SECTOR', active, i, c, isNext)\n        end\n        \n    elseif event == 'LEAVE_PLATFORM' then\n        WeakAuras.ScanEvents('SPRAY_SECTOR_HIDE')\n    elseif event == 'SHA_PHASE' then\n        local phaseN = ...\n        if phaseN == 2 then\n            WeakAuras.ScanEvents('SPRAY_SECTOR_HIDE')\n        end\n    end\nend",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["activeTriggerMode"] = -10,
},
["internalVersion"] = 87,
