},
["custom"] = "function(states, e)\n    if e == 'UNIT_ENTERED_VEHICLE' then\n        local seconds = aura_env.catchedOnce and 3.9 or 14.3\n        \n        if not aura_env.catchedOnce then\n            aura_env.catchedOnce = true\n        end\n        \n        states:Update('', {\n                progressType = 'timed',\n                duration = seconds,\n                expirationTime = seconds + GetTime(),\n                autoHide = true\n        })\n        \n    elseif e == 'UNIT_EXITED_VEHICLE' then\n        states:Remove('')\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.catchedOnce = false\n    end\nend",
