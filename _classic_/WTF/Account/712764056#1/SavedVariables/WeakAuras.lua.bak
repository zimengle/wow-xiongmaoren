},
["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    if t[5] or t[7] then -- If in Rested Area\n        return false\n    end\n    \n    local behavior = aura_env.config.maintenance.pet.behavior\n    \n    if behavior == 1 then -- Show if Pet Missing\n        return t[4]\n    elseif behavior == 2 then -- Show Pet Behavior\n        return t[1] or t[2] or t[3]\n    else -- Always Show\n        return true\n    end\nend",
