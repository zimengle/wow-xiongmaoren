["custom"] = "function(state, event, visibility, cooldownName)\n    if event ~= 'WA_MERFIN_BOSS_PRE_WARNING' or cooldownName ~= 'Meteor' then\n        return\n    end\n    \n    if visibility == 'HIDE' and state[''] then\n        state[''].show = false\n        state[''].changed = true\n        return true\n    end\n    \n    if visibility == 'SHOW' then\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = true,\n            duration = 5,\n            expirationTime = 5 + GetTime(),\n        }\n        return true\n    end\nend",
["events"] = "WA_MERFIN_BOSS_PRE_WARNING",
["type"] = "custom",
["check"] = "event",
["names"] = {
},
["custom_hide"] = "timed",
["customVariables"] = "{\n    expirationTime = true,\n}",
},
["untrigger"] = {
},
},
["activeTriggerMode"] = -10,
},
["displayText_format_p_format"] = "timed",
["displayText_format_p_time_legacy_floor"] = false,
["progressSource"] = {
-1,
"",
},
["animation"] = {
["start"] = {
["colorR"] = 1,
["duration_type"] = "seconds",
["colorA"] = 1,
["colorG"] = 1,
["use_translate"] = true,
["duration"] = "0.2",
["type"] = "custom",
["translateType"] = "bounce",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local bounceDistance = math.sin(progress * math.pi)\n    return startX + (bounceDistance * deltaX), startY + (bounceDistance * deltaY)\nend\n",
["scaley"] = 1,
["alpha"] = 0,
["rotate"] = 0,
["y"] = 10,
["x"] = 0,
["colorB"] = 1,
["use_color"] = false,
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    return r1 + (progress * (r2 - r1)), g1 + (progress * (g2 - g1)), b1 + (progress * (b2 - b1)), a1 + (progress * (a2 - a1))\nend\n",
["easeStrength"] = 3,
["colorType"] = "straightColor",
["scalex"] = 1,
},
