["width"] = 2,
},
{
["text"] = "TTS SETTINGS",
["type"] = "header",
["useName"] = true,
["width"] = 2,
},
{
["text"] = "Countdown sound from 3, 2, 1\n|cFFFF0000Requires Addon: |cFF00BFFFSharedMedia_Causese|r",
["type"] = "description",
["fontSize"] = "medium",
["width"] = 1,
