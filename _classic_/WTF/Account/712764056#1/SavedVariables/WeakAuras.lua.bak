["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_, sourceGUID,_,_,_,_,_,_,_, spellID = ...\n        \n        if spellID == 118299 and not aura_env.IsSpam(sourceGUID) then\n            WeakAuras.ScanEvents('DISCHARGE')\n            WeakAuras.ScanEvents('WA_MERFIN_HP_HIDER', sourceGUID)\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.antispams = {}\n    end\nend",
