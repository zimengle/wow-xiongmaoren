},
["height"] = 20,
["rotate"] = false,
["text2"] = "%p",
["desc"] = "自用改版，by 露露緹婭@Bilibili，https://space.bilibili.com/455259\n代码原版来自NGA，原名：ZB快捷聊天按钮，by：夜刃",
["source"] = "import",
["fontSize"] = 15,
["text2Containment"] = "INSIDE",
["zoom"] = 0,
["text1Color"] = {
