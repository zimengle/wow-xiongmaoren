["tocversion"] = 50500,
["url"] = "https://wago.io/progress_t14/132",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local L = GetLocale()\n\naura_env.IsEmote = function(initialEmote, compareWith)\n    if not initialEmote then return false end\n    if not aura_env.replicas[L] then return false end\n    local replica = aura_env.replicas[L][compareWith]\n    if not replica then return false end\n    return initialEmote == replica or initialEmote:find(replica)\nend\n\naura_env.replicas = {\n    ['enUS'] = {\n        roleplay1 = \"Feng the Accursed was betrayed by four emperors of the mogu, his body destroyed each time, only to rise again\",\n    }\n}",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["duration"] = "25",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "custom",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["subeventPrefix"] = "SPELL",
["events"] = "CHAT_MSG_MONSTER_SAY",
["names"] = {
},
["custom"] = "function(event, ...)\n    if event == 'CHAT_MSG_MONSTER_SAY' then\n        local msg = ...\n        if not msg then return end\n        \n        if aura_env.IsEmote(msg, 'roleplay1') then\n            WeakAuras.ScanEvents('POST_FENG_DOORS')\n        end\n    end\nend",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
