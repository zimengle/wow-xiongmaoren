},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, event, ...)\n    if event == 'MERFIN_PREWARNING_SHOW' then\n        local encounterID, cooldown, type = ...\n        if cooldown.ID ~= 'Crush' then return end\n        \n        local newState = {\n            progressType    = 'timed',\n            autoHide        = true,\n            duration        = 5,\n            expirationTime  = 5 + GetTime(),\n        }\n        \n        states:Update('', newState)\n        return true\n        \n    elseif event == 'MERFIN_PREWARNING_HIDE' then\n        local encounterID, cooldown, type = ...\n        if cooldown.ID ~= 'Crush' then return end\n        states:Remove('')\n        \n    elseif event == 'PUNGENCY_STACKS' then\n        local _, stacks = ...\n        aura_env.stacks = stacks\n        \n        if not aura_env.phase2 then return end\n        \n        local targetStack = aura_env.stacksPhase2 and (aura_env.stacksPhase2 - 3)\n        if not targetStack or targetStack < 1 then return end\n        \n        if stacks < targetStack then\n            states:Remove('')\n            return true\n        end\n        \n        if stacks == targetStack then\n            local newState = {\n                progressType    = 'timed',\n                autoHide        = true,\n                duration        = 6,\n                expirationTime  = 6 + GetTime(),\n            }\n            states:Update('', newState)\n            return true\n        end\n        \n    elseif event == 'ENCOUNTER_START' then\n        aura_env.phase2 = false\n        aura_env.stacks = nil\n        states:Remove('')\n        \n    elseif event == 'GARALON_PHASE2' then\n        aura_env.phase2 = true\n        states:Remove('')\n        \n        local stacks = aura_env.stacks\n        local targetStack = aura_env.stacksPhase2 and (aura_env.stacksPhase2 - 3)\n        if stacks and targetStack and targetStack >= 1 then\n            if stacks < targetStack then\n                states:Remove('')\n            elseif stacks == targetStack then\n                local newState = {\n                    show            = true,\n                    changed         = true,\n                    progressType    = 'timed',\n                    autoHide        = true,\n                    duration        = 6,\n                    expirationTime  = 6 + GetTime(),\n                }\n                states:Update('', newState)\n                return true\n            end\n        end\n        \n    elseif event == 'PHEROMONES_ORDER' then\n        local _, _, stacksPhase2 = ...\n        aura_env.stacksPhase2 = stacksPhase2\n    end\nend",
["events"] = "MERFIN_PREWARNING_SHOW, MERFIN_PREWARNING_HIDE, GARALON_PHASE2, ENCOUNTER_START, PUNGENCY_STACKS, PHEROMONES_ORDER",
