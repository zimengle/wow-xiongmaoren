["init"] = {
["custom"] = "-- Example on how to add aura_env table to VDT:\n-- DevTool:AddData(table, \"title\")\n-- DevTool:AddData(aura_env, aura_env.id..\"-env table\")\n\nlocal config = aura_env.config.options\n\naura_env.chosenMarkers1 = {}\naura_env.chosenMarkers2 = {}\naura_env.chosenMarkers3 = {}\naura_env.chosenMarkers4 = {}\naura_env.chosenMarkers5 = {}\naura_env.chosenMarkers6 = {}\naura_env.chosenMarkers7 = {}\naura_env.chosenMarkers8 = {}\naura_env.chosenMarkers9 = {}\naura_env.markersOrder = {}\naura_env.startValueDiff = 0\n\n-- Add it here and in custom options\naura_env.ignoreNameplates = {\n}\n\n-- Populate the markers lists\nfor i = 1, 9 do\n    for y = 1, 8 do\n        if config.markers[\"markersGroup\"..i..\"-\"..y] then\n            aura_env[\"chosenMarkers\"..i][y] = true\n        end\n    end\nend\n\n-- Populate the markers order list\nfor i = 1, 8 do\n    aura_env.markersOrder[i] = config.markers[\"markersOrder\"..i]\nend\n\n-- Checks if unit is marked and adds it to the used markers table if so\nlocal function AddMarkedUnitToUsedMarkers(unit)\n    if GetRaidTargetIndex(unit) then\n        aura_env.usedMarkers[GetRaidTargetIndex(unit)] = true\n    end\nend\n\n-- Populate the enemies list\nfunction aura_env.UpdateTables()\n    aura_env.enemies = {}\n    local instanceId = select(8, GetInstanceInfo())\n    if config[\"IID\" .. instanceId] then\n        for _, v in ipairs(config[\"IID\" .. instanceId]) do\n            if v.shouldMark then\n                if v.npcId == \"134024\" then\n                    aura_env.enemies[v.npcId] = { debuff = 278431, group = tonumber(v.enemyGroup) }\n                else\n                    aura_env.enemies[v.npcId] = { debuff = 0, group = tonumber(v.enemyGroup) }\n                end\n            end\n        end\n    end\nend\n\nfunction aura_env.UnitIsInCombatWithParty(unit)\n    return true\n    --[[for unitMember in WA_IterateGroupMembers() do\n        if UnitThreatSituation(unitMember, unit) then\n            return true\n        end\n    end\n    return false]]--\nend\n\nfunction aura_env.CheckMouseoverModifier()\n    local key = config.mouseoverSettings.mouseoverKey\n    if key == 1 then\n        return true\n    elseif key == 2 and IsShiftKeyDown() then\n        return true\n    elseif key == 3 and IsControlKeyDown() then\n        return true\n    elseif key == 4 and IsAltKeyDown() then\n        return true\n    else\n        return false\n    end\nend\n\nfunction aura_env.SelectEnemyToMark(unit)\n    local npcId = select(6, strsplit(\"-\", UnitGUID(unit)))\n    if aura_env.enemies[npcId] then\n        local group = aura_env.enemies[npcId].group\n        local debuff = aura_env.enemies[npcId].debuff\n        \n        if debuff ~= 0 then\n            if WA_GetUnitBuff(unit, debuff) then\n                table.insert(aura_env[\"enemiesToMark\"..group], unit)\n            end\n        else\n            table.insert(aura_env[\"enemiesToMark\"..group], unit)\n        end\n    end\nend\n\nfunction aura_env.MarkEnemies(chosenMarkers, enemiesToMark, startValueDiff)\n    local startValue = 1 + startValueDiff\n    local endValue = 8\n    \n    for i = 1, #enemiesToMark do\n        for j = startValue, endValue do\n            if aura_env.usedMarkers[aura_env.markersOrder[j]] == false\n            and chosenMarkers[aura_env.markersOrder[j]] == true\n            and not GetRaidTargetIndex(enemiesToMark[i]) then\n                \n                SetRaidTarget(enemiesToMark[i], aura_env.markersOrder[j])\n                aura_env.usedMarkers[aura_env.markersOrder[j]] = true\n                break\n            end\n        end\n    end\nend\n\nfunction aura_env.GetUsedMarkers()\n    for i = 1, 8 do\n        aura_env.usedMarkers[i] = false\n    end\n    \n    for partyMember in WA_IterateGroupMembers(false, true) do\n        AddMarkedUnitToUsedMarkers(partyMember)\n    end\n    \n    for i = 1, 4 do\n        AddMarkedUnitToUsedMarkers(\"boss\"..i)\n    end\n    \n    for i = 1, 40 do\n        AddMarkedUnitToUsedMarkers(\"nameplate\"..i)\n    end\nend\n\nfunction aura_env.SetupTables()\n    aura_env.usedMarkers = {}\n    \n    for i = 1, 9 do\n        aura_env[\"enemiesToMark\"..i] = {}\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["duration"] = "1",
["genericShowOn"] = "showOnCooldown",
["names"] = {
},
["debuffType"] = "HELPFUL",
["spellName"] = 0,
["type"] = "custom",
["unevent"] = "auto",
["subeventSuffix"] = "",
["subeventPrefix"] = "",
["custom_type"] = "status",
["event"] = "Cooldown Progress (Spell)",
["events"] = "NAME_PLATE_UNIT_ADDED, NAME_PLATE_UNIT_REMOVED",
["realSpellName"] = 0,
["use_spellName"] = true,
["custom"] = "function()\n    if not aura_env.enemies then return end\n    \n    -- Trigger the mouseover event on the modifier\n    if aura_env.config.options.mouseoverSettings.mouseoverKey ~= 1 \n    and aura_env.CheckMouseoverModifier() then\n        WeakAuras.ScanEvents(\"AUTOMARKER_UPDATE_MOUSEOVER\")\n    end\n    \n    aura_env.SetupTables()\n    aura_env.GetUsedMarkers()\n    \n    local nameplates = C_NamePlate.GetNamePlates()\n    for _, frame in ipairs(nameplates) do\n        local unit = frame.namePlateUnitToken\n        if unit then\n            local guid = UnitGUID(unit)\n            if guid then\n                local npcId = select(6, strsplit(\"-\", guid))\n                if npcId == \"204560\" or npcId == \"204773\" then\n                    aura_env.SelectEnemyToMark(unit)\n                elseif aura_env.UnitIsInCombatWithParty(unit) then\n                    aura_env.SelectEnemyToMark(unit)\n                end\n            end\n        end\n    end\n    \n    -- Mark enemies\n    for i = 1, 9 do\n        if aura_env[\"enemiesToMark\" .. i] then\n            aura_env.MarkEnemies(aura_env[\"chosenMarkers\" .. i], aura_env[\"enemiesToMark\" .. i], 0)\n        end\n    end\nend",
["spellIds"] = {
},
["check"] = "event",
["unit"] = "player",
["use_track"] = true,
["use_genericShowOn"] = true,
},
["untrigger"] = {
},
},
{
["trigger"] = {
["use_alwaystrue"] = true,
["duration"] = "5",
["genericShowOn"] = "showOnCooldown",
["subeventPrefix"] = "SPELL",
["use_genericShowOn"] = true,
["custom_hide"] = "timed",
["debuffType"] = "HELPFUL",
["instance_size"] = {
["single"] = "party",
["multi"] = {
["party"] = true,
},
},
["type"] = "custom",
["spellName"] = {
0,
},
["unevent"] = "timed",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function()\n    local unit = \"mouseover\"\n    \n    -- Don't continue if the unit shouldn't be marked\n    if aura_env.UnitIsInCombatWithParty(unit) or GetRaidTargetIndex(unit) or not UnitExists(unit) or UnitIsDead(unit) then return end\n    local npcId, _ = select(6, strsplit(\"-\", UnitGUID(unit)))\n    if not aura_env.enemies or not aura_env.enemies[npcId] then return end\n    \n    aura_env.SetupTables()\n    aura_env.GetUsedMarkers()\n    \n    -- Select enemies for marking\n    if aura_env.CheckMouseoverModifier() then\n        aura_env.SelectEnemyToMark(unit)\n    end\n    \n    -- Mark enemies\n    if not aura_env.ignoreNameplates[tonumber(npcId)] then\n        for i = 1, 9 do\n            if aura_env[\"enemiesToMark\" .. i] then\n                aura_env.MarkEnemies(aura_env[\"chosenMarkers\" .. i], aura_env[\"enemiesToMark\" .. i], 0)\n            end\n        end\n    else\n        -- Mark enemies with no nameplate without overriding marks (aura_env.ignoreNameplates)\n        for i = 1, 9 do\n            if aura_env[\"enemiesToMark\" .. i] then\n                aura_env.MarkEnemies(aura_env[\"chosenMarkers\" .. i], aura_env[\"enemiesToMark\" .. i], aura_env.startValueDiff)\n            end\n        end\n        \n        -- Increase startValueDiff by 1 or reset to 0 if at 7\n        if aura_env.startValueDiff < 7 then\n            aura_env.startValueDiff = aura_env.startValueDiff + 1\n        else\n            aura_env.startValueDiff = 0\n        end\n    end\nend",
