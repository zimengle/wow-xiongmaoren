["[Widget] [TSK] Shadow Blast Interrupt Order"] = {
["user_y"] = 0,
["user_x"] = 0,
["authorOptions"] = {
},
["adjustedMax"] = "",
["yOffset"] = 0,
["anchorPoint"] = "RIGHT",
["sameTexture"] = true,
["url"] = "https://wago.io/progress_t14/132",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "local ClassColorName = function(name)\n    local _, class = UnitClass(name)\n    local color = RAID_CLASS_COLORS[class]\n    if color then\n        return string.format(\"|cFF%02X%02X%02X%s|r\", color.r * 255, color.g * 255, color.b * 255, name)\n    else\n        return name\n    end\nend\n\naura_env.BuildStringLine = function(line)\n    local result = \"\"\n    for i, name in ipairs(line) do\n        local coloredName = ClassColorName(name)\n        \n        if UnitGroupRolesAssigned(name) == \"HEALER\" then\n            coloredName = \"|A:groupfinder-icon-role-large-heal:16:16:0:0|a\" .. coloredName\n        end\n        \n        if name == WeakAuras.me then\n            coloredName = \">> \" .. coloredName .. \" <<\"\n        end\n        \n        result = result .. coloredName\n        if i < #line then\n            result = result .. \"\\n\"\n        end\n    end\n    return result\nend\n\naura_env.IsPlayerInStep = function(nextStep)\n    if not aura_env.order or not nextStep then return false end\n    \n    local stepList = aura_env.order[nextStep]\n    if not stepList then return false end\n    \n    for _, name in ipairs(stepList) do\n        if name == WeakAuras.me then\n            return true\n        end\n    end\n    \n    return false\nend\n\naura_env.GetNPCIDFromGUID = function(GUID)\n    local guidType, _, _, _, _, id = strsplit(\"-\", GUID or \"\")\n    if guidType == \"Creature\" or guidType == \"Vehicle\" or guidType == \"Pet\" then\n        return tonumber(id) or 0\n    end\n    return 0\nend",
["do_custom"] = true,
},
},
["selfPoint"] = "LEFT",
["desaturate"] = false,
["rotation"] = 0,
["font"] = "Friz Quadrata TT",
["crop_y"] = 0.41,
["textureWrapMode"] = "CLAMPTOBLACKADDITIVE",
["startAngle"] = 0,
["useAdjustededMin"] = false,
["regionType"] = "texture",
["blendMode"] = "BLEND",
["slantMode"] = "INSIDE",
["texture"] = "Interface\\AddOns\\WeakAuras\\Media\\Textures\\Circle_White",
["tocversion"] = 50500,
["alpha"] = 1,
["exrtLastSync"] = 1751209613,
["backgroundOffset"] = 0,
["wagoID"] = "1qyg9npGm",
["color"] = {
0,
0,
0,
0.49803921580315,
},
["customText"] = "function()\n    \n    if WeakAuras.IsOptionsOpen() then\n        local nextStep = aura_env.nextStep\n        local order = { WeakAuras.me, 'Merfin' }\n        local nextPlayers = aura_env.BuildStringLine(order)\n        return nextStep, nextPlayers\n    end\n    \n    local nextStep = aura_env.nextStep\n    local nextPlayers = aura_env.BuildStringLine(aura_env.order[nextStep])\n    return nextStep, nextPlayers\nend",
["desaturateBackground"] = false,
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, event, ...)\n    if event == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_, sourceName,_,_,_,_,_,_,_, spellID, spellName,_, extraSpellID = ...\n        \n        if (subEvent == 'SPELL_CAST_SUCCESS' and spellID == 117628)\n        or (subEvent == 'SPELL_INTERRUPT' and extraSpellID == 117628) then\n            if not aura_env.order then return end\n            if aura_env.lineCount == 0 then return end\n            \n            aura_env.count = aura_env.count + 1\n            aura_env.nextStep = (aura_env.count % aura_env.lineCount) + 1\n            \n            if states[''] then\n                states[''].nextStep = aura_env.nextStep\n                states[''].changed = true\n                return true\n            end\n        end\n        \n    elseif event == 'NAME_PLATE_UNIT_ADDED' then\n        if not aura_env.order then return end\n        if aura_env.lineCount == 0 then return end\n        \n        local nameplateID = ...\n        local GUID = UnitGUID(nameplateID)\n        local npcID = aura_env.GetNPCIDFromGUID(GUID)\n        \n        if npcID == 60701 or npcID == 61421 then\n            states:Update('', { \n                    nextStep = aura_env.nextStep,\n                    unit     = nameplateID,\n            })\n        end\n        \n    elseif event == 'NAME_PLATE_UNIT_REMOVED' then\n        if not aura_env.order then return end\n        if aura_env.lineCount == 0 then return end\n        \n        local nameplateID = ...\n        local GUID = UnitGUID(nameplateID)\n        local npcID = aura_env.GetNPCIDFromGUID(GUID)\n        \n        if npcID == 60701 or npcID == 61421 then\n            states:Remove('')\n        end\n        \n        \n    elseif event == 'KINGS_INTERRUPT_ORDER' then\n        local order, lineCount = ...\n        aura_env.order, aura_env.lineCount = order, lineCount\n        \n        if not aura_env.order then return end\n        if aura_env.lineCount == 0 then return end\n        \n        aura_env.count = 0\n        aura_env.nextStep = (aura_env.count % aura_env.lineCount) + 1\n        \n    elseif event == 'OPTIONS' then\n        aura_env.nextStep = 1\n    end\nend",
["events"] = "KINGS_INTERRUPT_ORDER, CLEU:SPELL_CAST_SUCCESS:SPELL_INTERRUPT, NAME_PLATE_UNIT_ADDED, NAME_PLATE_UNIT_REMOVED",
