["init"] = {
["custom"] = "aura_env.bowManSide = {\n    [61038] = Merfin:L('Left Platform'),   -- Yang Guoshi (SOUTH)\n    [61042] = Merfin:L('Middle Platform'), -- Cheng Kang  (CENTER)\n    [61046] = Merfin:L('Right Platform')   -- Jinlun Kun (NORTH)\n}\n\naura_env.patternSide = {\n    -- Yang Guoshi (South / Left Platform)\n    [61038] = '1 » 8',\n    \n    -- Cheng Kang (Middle / Middle Platform)\n    [61042] = '3 » 4 » 5',\n    \n    -- Jinlun Kun (North / Right Platform)\n    [61046] = '4 » 3 » 2'\n}\n\naura_env.bestSector = {\n    -- Yang Guoshi (South / Left Platform)\n    [61038] = { \n        [0] = 1, \n        [4] = 8 \n    },\n    \n    -- Cheng Kang (Middle / Middle Platform)\n    [61042] = { \n        [0]  = 3, \n        [2]  = 4,\n        [9]  = 5\n    },\n    \n    -- Jinlun Kun (North / Right Platform)\n    [61046] = { \n        [0]  = 4,\n        [8]  = 3,\n        [10] = 2\n    }\n}",
