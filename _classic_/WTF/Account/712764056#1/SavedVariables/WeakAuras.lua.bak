["sparkRotationMode"] = "AUTO",
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, event)\n    \n    if event == 'OPTIONS' then\n        states:Update('', {\n                progressType = 'static',\n                total        = 5,\n                value        = 2.6,\n                prefix       = C_Spell.GetSpellName(116529), \n        })\n        return\n    end\n    \n    if not UnitExists('boss1') then return end\n    \n    local hper = aura_env.GetUnitHealthPercent('boss1')\n    \n    for _, range in ipairs(aura_env.ranges) do\n        local offset = aura_env.InRangeOffset(hper, range.min, range.max)\n        if offset then\n            states:Update('', {\n                    progressType = 'static',\n                    total        = 5,\n                    value        = offset,\n                    prefix       = range.prefix,\n            })\n            return\n        end\n    end\n    \n    states:Remove('')\nend",
["events"] = "UNIT_HEALTH:boss1",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
},
["untrigger"] = {
},
},
["activeTriggerMode"] = -10,
},
["internalVersion"] = 87,
["progressSource"] = {
-1,
"",
},
["animation"] = {
["start"] = {
["colorR"] = 1,
["duration_type"] = "seconds",
["colorB"] = 1,
["colorG"] = 1,
["use_translate"] = true,
["type"] = "none",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    local bounceDistance = math.sin(progress * math.pi)\n    return startX + (bounceDistance * deltaX), startY + (bounceDistance * deltaY)\nend\n",
["preset"] = "fade",
["alpha"] = 0,
["scalex"] = 1,
["y"] = 10,
["x"] = 0,
["translateType"] = "bounce",
["rotate"] = 0,
["scaley"] = 1,
["easeStrength"] = 3,
["duration"] = "0.2",
["colorA"] = 1,
},
["main"] = {
["colorR"] = 1,
["scalex"] = 1,
["colorA"] = 1,
["colorG"] = 0.25098040699959,
["type"] = "none",
["easeType"] = "none",
["duration_type"] = "seconds",
["scaley"] = 1,
["alpha"] = 0,
["colorType"] = "pulseColor",
["y"] = 0,
["x"] = 0,
["rotate"] = 0,
["use_color"] = true,
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return r1 + (newProgress * (r2 - r1)),\n         g1 + (newProgress * (g2 - g1)),\n         b1 + (newProgress * (b2 - b1)),\n         a1 + (newProgress * (a2 - a1))\nend\n",
["easeStrength"] = 3,
["duration"] = "0.5",
["colorB"] = 0.25098040699959,
},
