["auranames"] = {
"99947",
},
["spellIds"] = {
},
["custom"] = "function(state, event, visibility, cooldownName)\n    if event ~= 'WA_MERFIN_BOSS_PRE_WARNING' or cooldownName ~= 'DeathsGrasp' then\n        return\n    end\n    \n    if visibility == 'HIDE' and state[''] then\n        state[''].show = false\n        state[''].changed = true\n        return true\n    end\n    \n    if visibility == 'SHOW' then\n        state[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = true,\n            duration = 5,\n            expirationTime = 5 + GetTime(),\n        }\n        return true\n    end\nend",
["events"] = "WA_MERFIN_BOSS_PRE_WARNING",
["type"] = "custom",
["check"] = "event",
["names"] = {
},
["custom_hide"] = "timed",
["customVariables"] = "{\n    expirationTime = true,\n}",
