["[DP] [TSK] Crazy Thought"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1436'\nlocal ID          = 'CrazyThought'\n\nlocal options = {\n    warningText = \"%icon %name %icon\",\n}\n\nlocal name, icon = C_Spell.GetSpellName(117833), C_Spell.GetSpellTexture(117833)\n\naura_env.StopCD = function()\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, { ID = ID })\nend\n\naura_env.StartCD = function(duration, autoHide)\n    local data = {\n        show           = true,\n        autoHide       = autoHide,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        ID             = ID,\n        count          = aura_env.count,\n        name           = name,\n        icon           = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function()\n    local data = {\n        ID       = ID,\n        count    = aura_env.count,\n        name     = name,\n        icon     = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, BOSS_SWAP, CLEU:SPELL_CAST_START",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if spellID == 117833 then\n            aura_env.count = aura_env.count + 1\n            aura_env.StartCD(5)\n            aura_env.SendWarning()\n        end\n        \n    elseif e == 'BOSS_SWAP' then\n        local bossID, activated, delay = ...\n        if bossID ~= 'MENG' then return end\n        \n        aura_env.bossActivated = activated\n        \n        if activated then \n            aura_env.StartCD(5-delay)\n        else\n            aura_env.StopCD()\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
