["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    local behavior = aura_env.config.maintenance.presences.behavior\n    \n    if behavior == 1 then -- Show if not Blood\n        return t[3] or t[4]\n    elseif behavior == 2 then -- Show if not Frost\n        return t[2] or t[4]\n    elseif behavior == 3 then -- Show if not Unholy\n        return t[2] or t[3]\n    else -- Always Show\n        return true\n    end\nend",
["activeTriggerMode"] = -10,
