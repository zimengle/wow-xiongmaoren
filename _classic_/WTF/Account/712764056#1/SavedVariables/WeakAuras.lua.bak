["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1436'\n\nlocal options = {\n    ['Crazed'] = {\n        warningText = \"%icon @cffff8b17%name@r %icon\",\n    },\n    ['Cowardice'] = {\n        warningText = \"%icon @cffff8b17%name@r %icon\"\n    }\n}\n\nlocal name, icon = C_Spell.GetSpellName(117737), C_Spell.GetSpellTexture(117737)\n\naura_env.SendWarning = function(ID)\n    local data = {\n        ID    = ID,\n        count = aura_env.count,\n        name  = name,\n        icon  = icon,\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options[ID])\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "CLEU:SPELL_AURA_APPLIED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if spellID == 117737 then\n            aura_env.SendWarning('Crazed')\n        elseif spellID == 117756 then\n            aura_env.SendWarning('Cowardice')\n        end\n    end\nend",
