["unit"] = "player",
["custom"] = "function(e, _, subEvent, channelspellID, sourceGUID, sourceName, _, _, destGUID, destName, _, _, spellID, spellName)\n    \n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        if subEvent == 'SPELL_CAST_SUCCESS' then\n            if spellID == 106736 then\n                aura_env.StartCD('WitherWill', 6, false, true)\n                aura_env.Warning('WitherWill', aura_env.count['WitherWill'])\n            elseif spellID == 106113 then\n                aura_env.StartCD('TouchOfNothingness', 15.5, false, true)\n            end\n        elseif subEvent == 'SPELL_AURA_APPLIED' then\n            if spellID == 117665 then\n                aura_env.StopCD('WitherWill')\n                aura_env.StopCD('TouchOfNothingness')\n                aura_env.StartCD('BoundsOfReality', 60, false, true)\n                aura_env.TTS(spellName)\n            elseif spellID == 106113 then\n                if destName == WeakAuras.me then \n                    \n                else\n                    aura_env.Warning('TouchOfNothingness', destName, spellName)\n                end\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.ClearCache()\n        aura_env.StartCD('WitherWill', 6)\n        aura_env.StartCD('TouchOfNothingness', 13)\n        aura_env.StartCD('BoundsOfReality', 23)\n        \n    elseif e == 'STATUS' then\n        aura_env.ClearCache()\n        \n    elseif e == 'OPTIONS' and not WeakAuras.IsAuraLoaded(aura_env.id) then\n        aura_env.WipeSchedulers()\n    end\nend",
