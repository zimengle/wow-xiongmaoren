["custom"] = "local encounterID = '1395'\nlocal ID          = 'PowerDown'\n\nlocal name, icon = C_Spell.GetSpellName(116529), C_Spell.GetSpellTexture(116529)\n\nlocal options = {\n    warningText = '%icon @cffff8b17%name@r %icon',\n}\n\naura_env.SendWarning = function()\n    local data = {\n        ID    = ID,\n        name  = name,\n        icon  = icon,\n        localization = localization\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
