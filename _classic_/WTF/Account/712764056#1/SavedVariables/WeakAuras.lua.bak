["parent"] = "[Widget] [Protectors] Text Reminders",
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "function()\n    local icon = WeakAuras.IsOptionsOpen() and 136050 or C_Spell.GetSpellTexture(aura_env.spellID)\n    return Merfin:L('Interrupt Now'):upper(), Merfin.GetIconCropped(icon, 10)\nend",
["shadowYOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
