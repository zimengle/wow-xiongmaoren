["[DP] [TSK] Shield of Darkness"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1436'\nlocal ID          = 'ShieldOfDarkness'\n\nlocal options = {\n    warningText = \"%icon %name %icon\",\n    ttsLine = Merfin:L(\"Stop Attack\"),\n    prewarnCountVA = 2,\n    prewarnTTStext = Merfin:L(\"Stop Attack Soon\"),\n}\n\nlocal name, icon = C_Spell.GetSpellName(117697), C_Spell.GetSpellTexture(117697)\n\naura_env.MRT = function()\n    if not WeakAuras.IsAuraLoaded(aura_env.id) then return end\n    local event = 'ZIAN_SHIELD_' .. (aura_env.count + 1)\n    GMRT.F.Note_Timer(event)\nend\n\naura_env.CancelMRT = function()\n    if aura_env._mrtTimer and aura_env._mrtTimer.Cancel then\n        aura_env._mrtTimer:Cancel()\n        aura_env._mrtTimer = nil\n    end\nend\n\naura_env.StopCD = function()\n    aura_env.CancelMRT()\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, { ID = ID })\nend\n\naura_env.StartCD = function(duration, GUID)\n    aura_env.CancelMRT()\n    local after = duration <= 5 and duration or duration - 5\n    aura_env._mrtTimer = C_Timer.NewTimer(after, aura_env.MRT)\n    local data = {\n        show           = true,\n        autoHide       = false,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        ID             = ID,\n        count          = aura_env.count,\n        name           = name,\n        icon           = icon,\n        GUID           = GUID\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function()\n    local data = { \n        ID    = ID, \n        count = aura_env.count, \n        name  = name, \n        icon  = icon \n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_CAST_START, BOSS_SWAP",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_, sourceGUID,_,_,_,_,_,_,_, spellID = ...\n        \n        if spellID == 117697 then\n            aura_env.count = aura_env.count + 1\n            aura_env.SendWarning()\n            aura_env.StartCD(42.5, sourceGUID)\n        end\n        \n    elseif e == 'BOSS_SWAP' then\n        local bossID, activated, delay, GUID = ...\n        if bossID ~= 'ZIAN' then return end\n        \n        if activated then \n            aura_env.StartCD(40-delay, GUID)\n        else\n            aura_env.StopCD()\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n        aura_env.CancelMRT()\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
