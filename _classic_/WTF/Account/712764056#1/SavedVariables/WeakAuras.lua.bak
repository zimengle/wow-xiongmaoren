["width"] = 200,
["wagoID"] = "1qyg9npGm",
["xOffset"] = 0,
["preferToUpdate"] = false,
["parent"] = "[DP] Custom Notes HP",
["yOffset"] = 0,
["regionType"] = "empty",
["load"] = {
