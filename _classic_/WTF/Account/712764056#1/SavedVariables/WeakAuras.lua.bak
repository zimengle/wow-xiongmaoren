["[DP] [Protectors] Phase"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1409'\n\naura_env.MRT = function(event) GMRT.F.Note_Timer(event) end\n\nlocal phaseNames = {\n    ['Phase1'] = Merfin:L('Phase 1'),\n    ['Phase2'] = Merfin:L('Phase 2'),\n    ['Phase3'] = Merfin:L('Phase 3')\n}\n\nlocal options = {\n    ['Phase1'] = {\n        warningText = string.format(\"@cffe3e3e3» %s «@r\",\n            phaseNames['Phase1']:upper()),\n        ttsLine = phaseNames['Phase1'],\n    },\n    ['Phase2'] = {\n        warningText = string.format(\"@cffe3e3e3» %s «@r\",\n            phaseNames['Phase2']:upper()),\n        ttsLine = phaseNames['Phase2'],\n    },\n    ['Phase3'] = {\n        warningText = string.format(\"@cffe3e3e3» %s «@r\",\n            phaseNames['Phase3']:upper()),\n        ttsLine = phaseNames['Phase3'],\n    }\n}\n\naura_env.SendWarning = function(ID)\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID,\n        {ID = ID, name = phaseNames[ID]}, options[ID])\nend\n\naura_env.IsSpam = function(before)\n    local cur = GetTime()\n    if not aura_env.antispam or cur - aura_env.antispam > before then\n        aura_env.antispam = cur\n        return false\n    end\n    return true\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_APPLIED_DOSE",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_, sourceGUID,_,_,_, destGUID,_,_,_, spellID = ...\n        \n        if spellID ~= 117052 then return end\n        local npcID = Merfin.GetNPCIDFromGUID(destGUID)\n        \n        if subEvent == 'SPELL_AURA_APPLIED' then\n            WeakAuras.ScanEvents('PROTECTORS_PHASE_CHANGING', npcID, 2)\n            \n            if not aura_env.IsSpam(5) then\n                aura_env.SendWarning('Phase2')\n                aura_env.MRT('PHASE_2')\n            end\n            \n        elseif subEvent == 'SPELL_AURA_APPLIED_DOSE' then\n            WeakAuras.ScanEvents('PROTECTORS_PHASE_CHANGING', npcID, 3)\n            \n            if not aura_env.IsSpam(5) then\n                aura_env.SendWarning('Phase3')\n                aura_env.MRT('PHASE_3')\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.phase = 1\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "\n\n",
},
},
