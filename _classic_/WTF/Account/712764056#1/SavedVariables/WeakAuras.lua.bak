["exrtLastSync"] = 1751209613,
["sparkOffsetX"] = 0,
["wagoID"] = "1qyg9npGm",
["parent"] = "[Widget] Elegon Soaks",
["customText"] = "function()\n    local state = aura_env.states and aura_env.states[2]\n    if not state then return end\n    \n    return (state.stacks or 1) * 10, Merfin:L('Damage')\nend",
["sparkRotationMode"] = "AUTO",
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
["custom_type"] = "stateupdate",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(states, event, ...)\n    if event == 'OPTIONS' then\n        states:Update('', { stacks = 4 })\n        \n    elseif event == 'MERFIN_WARNING' then\n        local _, warning = ...\n        if warning.ID == 'FocusPower' then\n            states:Update('', { stacks = 6 })\n        end\n        \n    elseif event == 'DISCHARGE' then\n        if states[''] then\n            states[''].stacks  = states[''].stacks - 1\n            states[''].changed = true\n            return true\n        end\n        \n    elseif event == 'FLOOR_FALLING' then\n        states:Remove('')\n        \n    elseif event == 'ELEGON_PHASE' then\n        local phaseN = ...\n        \n        if phaseN == 3 and states[''] then\n            states:Remove('')\n        end\n    end\nend",
["events"] = "MERFIN_WARNING, DISCHARGE, FLOOR_FALLING, ELEGON_PHASE",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    stacks = true\n}",
