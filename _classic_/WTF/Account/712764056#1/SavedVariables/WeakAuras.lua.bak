},
["custom"] = "function(states, e, _, warning)\n    if e == 'OPTIONS' then\n        states:Update('', {\n                progressType = 'timed',\n                duration = 3.5,\n                expirationTime = 3.5 + GetTime(),\n                name = C_Spell.GetSpellName(122774),\n                count = 2\n        })\n    end\n    if e == 'MERFIN_WARNING' and warning.ID == 'Crush' then\n        states:Update('', {\n                progressType = 'timed',\n                duration = 3,\n                expirationTime = 3 + GetTime(),\n                autoHide = true,\n                name = warning.name,\n                count = warning.count \n        })\n    end\nend",
