["init"] = {
["custom"] = "local encounterID = '1501'\nlocal ID          = 'HeartOfFear'\n\nlocal name, icon = C_Spell.GetSpellName(123845), C_Spell.GetSpellTexture(123845)\n\nlocal options = {\n    warningText = \"%icon @cffff8b17%name@r %icon\",\n}\n\naura_env.SendWarning = function(destName)\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID       = ID,\n            name     = name,\n            icon     = icon,\n            count    = aura_env.count,\n            destName = WA_ClassColorName(destName)\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "CLEU:SPELL_AURA_APPLIED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_,_,_,_,_,_, destName,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_AURA_APPLIED' then\n            if spellID == 123845 then\n                aura_env.SendWarning(destName)\n            end\n        end\n    end\nend",
["spellIds"] = {
