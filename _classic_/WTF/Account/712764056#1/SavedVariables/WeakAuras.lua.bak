["customDuration"] = "function()\n    local duration = aura_env.timer or 0\n    return duration, duration + GetTime()\nend",
["custom"] = "function(states, e, id,_,_,_, success)\n    if e == 'ENCOUNTER_END' and id == 1506 and success == 1 then\n        Merfin.ShaArrivalTime = GetTime() + 56\n        states:Update('', { \n                progressType = 'timed', \n                duration = 56, \n                expirationTime = Merfin.ShaArrivalTime, \n                autoHide = true\n        })\n    elseif e == 'STATUS' and Merfin.ShaArrivalTime then\n        local tilExpire = Merfin.ShaArrivalTime - GetTime()\n        if tilExpire > 0 then\n            states:Update('', { \n                    progressType = 'timed', \n                    duration = 56, \n                    expirationTime = Merfin.ShaArrivalTime, \n                    autoHide = true\n            })\n        end\n    end\nend",
