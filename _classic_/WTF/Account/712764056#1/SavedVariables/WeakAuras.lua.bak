["[DP] [Tsulong] Terrorize"] = {
["outline"] = "OUTLINE",
["exrtLastSender"] = "Jfkx-ClassicBetaPvE",
["wagoID"] = "1qyg9npGm",
["parent"] = "[DP] Tsulong",
["displayText_format_p_time_dynamic_threshold"] = 60,
["shadowYOffset"] = -1,
