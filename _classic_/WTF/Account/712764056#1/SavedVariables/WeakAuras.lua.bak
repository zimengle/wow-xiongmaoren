{
["trigger"] = {
["debuffType"] = "HELPFUL",
["type"] = "custom",
["custom"] = "function(states, e, ...)\n    if e == 'MERFIN_CD_HIDE' then\n        local encounterID, cooldown = ...\n        if cooldown.ID ~= 'AmberExplosionM' then return end\n        states:Remove('')\n        \n    elseif e == 'MERFIN_CD_SHOW_WIDGET' then\n        local encounterID, cooldown = ...\n        if cooldown.ID ~= 'AmberExplosionM' then return end\n        \n        local newState = {\n            progressType   = 'timed',\n            duration       = cooldown.duration,\n            expirationTime = cooldown.expirationTime,\n            autoHide       = true,\n            cooldownId     = cooldown.ID,\n            \n        }\n        \n        states:Update('', newState)\n    end\nend",
["custom_type"] = "stateupdate",
["check"] = "event",
["customVariables"] = "{\n    expirationTime = true,\n    cooldownId = {\n        display = 'Cooldown ID',\n        type = 'string',\n    },\n}",
["events"] = "MERFIN_CD_SHOW_WIDGET, MERFIN_CD_HIDE",
["unit"] = "player",
},
["untrigger"] = {
},
},
