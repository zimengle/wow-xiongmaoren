["[DP] [Lei Shi] Get Away"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1506'\nlocal ID          = 'GetAway'\n\nlocal name, icon = C_Spell.GetSpellName(123461), C_Spell.GetSpellTexture(123461)\n\nlocal options = {warningText = \"@cff66cccc%upper:name@r\"}\n\n\naura_env.SendWarning = function()\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID    = ID,\n            name  = name,\n            icon  = icon,\n            count = aura_env.count,\n    }, options)\nend\n\naura_env.MRT = function()\n    local event = 'GET_AWAY_' .. aura_env.count\n    GMRT.F.Note_Timer(event)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_CAST_START",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_CAST_START' then\n            if spellID == 123461 then -- Get Away\n                aura_env.count = aura_env.count + 1\n                aura_env.SendWarning()\n                aura_env.MRT()\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "\n\n",
},
},
["disjunctive"] = "any",
