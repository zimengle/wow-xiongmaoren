["[DP] [Gara'jal] Shadowy Attack"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1434'\nlocal ID          = 'ShadowyAttack'\n\nlocal name, icon = Merfin:L('Shadowy Attack'), 574575\n\nlocal options = {\n    warningText = '%icon %name (%count) %icon'\n}\n\naura_env.StartCD = function(duration, autoHide)\n    local data = {\n        show           = true,\n        autoHide       = autoHide,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        ID             = ID,\n        count          = aura_env.count,\n        name           = name,\n        icon           = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function()\n    local data = {\n        ID     = ID,\n        count  = aura_env.count,\n        name   = name,\n        icon   = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend\n\naura_env.ShadowyAttacks = {\n    [117215] = true,\n    [117218] = true, \n    [117219] = true,\n    [117222] = true,\n}",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, UNIT_SPELLCAST_SUCCEEDED:boss1",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'UNIT_SPELLCAST_SUCCEEDED' then\n        local _,_, spellID = ...\n        if aura_env.ShadowyAttacks[spellID] then\n            aura_env.count = aura_env.count + 1\n            aura_env.SendWarning()\n            aura_env.StartCD(8)\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n        aura_env.StartCD(7)\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "\n\n",
},
},
