["check"] = {
["trigger"] = -1,
["op"] = "FRAME_UPDATE",
["value"] = "function()\n    -- Chat Message\n    if WeakAuras.IsOptionsOpen() then return end\n    if not aura_env.state then return end\n    \n    local now = GetTime()\n    if now - (aura_env.lastChatUpdate or 0) <= 1 then return end\n    \n    aura_env.lastChatUpdate = now\n    \n    local remainingSeconds = math.ceil(aura_env.state.expirationTime - now)\n    if remainingSeconds > 3 or remainingSeconds <= 0 then return end\n    \n    WeakAuras.ScanEvents('WA_MERFIN_DUNGEON_CHAT', remainingSeconds)\nend",
