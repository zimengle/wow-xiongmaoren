["[Core] [T14] Sounds"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["finish"] = {
["hide_all_glows"] = true,
},
["init"] = {
["custom"] = "aura_env.PlaySoundFile = PlaySoundFile\n\nlocal defaultCountVA = {\n    enUS = { 1,  2  },\n    deDE = { 5,  6  },\n    frFR = { 7,  8  },\n    ruRU = { 9,  10 },\n    zhCN = { 13, 14 },\n    zhTW = { 15, 16 },\n}\n\naura_env.defaultCountVA = defaultCountVA[GetLocale()] or defaultCountVA['enUS']\n\nlocal indexToVoiceActor = {\n    [1]  = \"English (Sally)\",\n    [2]  = \"English (Alex)\",\n    [3]  = \"English (female)\",\n    [4]  = \"English (male)\",\n    [5]  = \"German (female)\",\n    [6]  = \"German (male)\",\n    [7]  = \"French (female)\",\n    [8]  = \"French (male)\",\n    [9]  = \"Russian (female)\",\n    [10] = \"Russian (male)\",\n    [11] = \"Korean (female)\",\n    [12] = \"Korean (male)\",\n    [13] = \"Chinese (Simplified) (female)\",\n    [14] = \"Chinese (Simplified) (male)\",\n    [15] = \"Chinese (Traditional) (female)\",\n    [16] = \"Chinese (Traditional) (male)\",\n    [17] = \"Italian (female)\",\n    [18] = \"Italian (male)\",\n    [19] = \"Portuguese (female)\",\n    [20] = \"Portuguese (male)\",\n    [21] = \"Spanish (Spain) (female)\",\n    [22] = \"Spanish (Spain) (male)\",\n    [23] = \"Spanish (Mexico) (male)\",\n}\n\naura_env.GetVoiceActor = function(index)\n    local configIndex = aura_env.config.sounds.countdowns[tostring(index)]\n    return indexToVoiceActor[configIndex]\nend\n\nlocal base = \"Interface/AddOns/MerfinPlus/Media/sound/countdowns\"\n\naura_env.CountdownSounds = {\n    {\n        base .. \"/enUS/sally/1.ogg\",\n        base .. \"/enUS/sally/2.ogg\",\n        base .. \"/enUS/sally/3.ogg\",\n        base .. \"/enUS/sally/4.ogg\",\n        base .. \"/enUS/sally/5.ogg\",\n    },\n    {\n        base .. \"/enUS/alex/1.ogg\",\n        base .. \"/enUS/alex/2.ogg\",\n        base .. \"/enUS/alex/3.ogg\",\n        base .. \"/enUS/alex/4.ogg\",\n        base .. \"/enUS/alex/5.ogg\",\n    },\n    {\n        base .. \"/enUS/female/1.ogg\",\n        base .. \"/enUS/female/2.ogg\",\n        base .. \"/enUS/female/3.ogg\",\n        base .. \"/enUS/female/4.ogg\",\n        base .. \"/enUS/female/5.ogg\",\n    },\n    {\n        base .. \"/enUS/male/1.ogg\",\n        base .. \"/enUS/male/2.ogg\",\n        base .. \"/enUS/male/3.ogg\",\n        base .. \"/enUS/male/4.ogg\",\n        base .. \"/enUS/male/5.ogg\",\n    },\n    {\n        base .. \"/deDE/female/1.ogg\",\n        base .. \"/deDE/female/2.ogg\",\n        base .. \"/deDE/female/3.ogg\",\n        base .. \"/deDE/female/4.ogg\",\n        base .. \"/deDE/female/5.ogg\",\n    },\n    {\n        base .. \"/deDE/male/1.ogg\",\n        base .. \"/deDE/male/2.ogg\",\n        base .. \"/deDE/male/3.ogg\",\n        base .. \"/deDE/male/4.ogg\",\n        base .. \"/deDE/male/5.ogg\",\n    },\n    {\n        base .. \"/frFR/female/1.ogg\",\n        base .. \"/frFR/female/2.ogg\",\n        base .. \"/frFR/female/3.ogg\",\n        base .. \"/frFR/female/4.ogg\",\n        base .. \"/frFR/female/5.ogg\",\n    },\n    {\n        base .. \"/frFR/male/1.ogg\",\n        base .. \"/frFR/male/2.ogg\",\n        base .. \"/frFR/male/3.ogg\",\n        base .. \"/frFR/male/4.ogg\",\n        base .. \"/frFR/male/5.ogg\",\n    },\n    {\n        base .. \"/ruRU/female/1.ogg\",\n        base .. \"/ruRU/female/2.ogg\",\n        base .. \"/ruRU/female/3.ogg\",\n        base .. \"/ruRU/female/4.ogg\",\n        base .. \"/ruRU/female/5.ogg\",\n    },\n    {\n        base .. \"/ruRU/male/1.ogg\",\n        base .. \"/ruRU/male/2.ogg\",\n        base .. \"/ruRU/male/3.ogg\",\n        base .. \"/ruRU/male/4.ogg\",\n        base .. \"/ruRU/male/5.ogg\",\n    },\n    {\n        base .. \"/koKR/female/1.ogg\",\n        base .. \"/koKR/female/2.ogg\",\n        base .. \"/koKR/female/3.ogg\",\n        base .. \"/koKR/female/4.ogg\",\n        base .. \"/koKR/female/5.ogg\",\n    },\n    {\n        base .. \"/koKR/male/1.ogg\",\n        base .. \"/koKR/male/2.ogg\",\n        base .. \"/koKR/male/3.ogg\",\n        base .. \"/koKR/male/4.ogg\",\n        base .. \"/koKR/male/5.ogg\",\n    },\n    {\n        base .. \"/zhCN/female/1.ogg\",\n        base .. \"/zhCN/female/2.ogg\",\n        base .. \"/zhCN/female/3.ogg\",\n        base .. \"/zhCN/female/4.ogg\",\n        base .. \"/zhCN/female/5.ogg\",\n    },\n    {\n        base .. \"/zhCN/male/1.ogg\",\n        base .. \"/zhCN/male/2.ogg\",\n        base .. \"/zhCN/male/3.ogg\",\n        base .. \"/zhCN/male/4.ogg\",\n        base .. \"/zhCN/male/5.ogg\",\n    },\n    {\n        base .. \"/zhTW/female/1.ogg\",\n        base .. \"/zhTW/female/2.ogg\",\n        base .. \"/zhTW/female/3.ogg\",\n        base .. \"/zhTW/female/4.ogg\",\n        base .. \"/zhTW/female/5.ogg\",\n    },\n    {\n        base .. \"/zhTW/male/1.ogg\",\n        base .. \"/zhTW/male/2.ogg\",\n        base .. \"/zhTW/male/3.ogg\",\n        base .. \"/zhTW/male/4.ogg\",\n        base .. \"/zhTW/male/5.ogg\",\n    },\n    {\n        base .. \"/itIT/female/1.ogg\",\n        base .. \"/itIT/female/2.ogg\",\n        base .. \"/itIT/female/3.ogg\",\n        base .. \"/itIT/female/4.ogg\",\n        base .. \"/itIT/female/5.ogg\",\n    },\n    {\n        base .. \"/itIT/male/1.ogg\",\n        base .. \"/itIT/male/2.ogg\",\n        base .. \"/itIT/male/3.ogg\",\n        base .. \"/itIT/male/4.ogg\",\n        base .. \"/itIT/male/5.ogg\",\n    },\n    {\n        base .. \"/ptBR/female/1.ogg\",\n        base .. \"/ptBR/female/2.ogg\",\n        base .. \"/ptBR/female/3.ogg\",\n        base .. \"/ptBR/female/4.ogg\",\n        base .. \"/ptBR/female/5.ogg\",\n    },\n    {\n        base .. \"/ptBR/male/1.ogg\",\n        base .. \"/ptBR/male/2.ogg\",\n        base .. \"/ptBR/male/3.ogg\",\n        base .. \"/ptBR/male/4.ogg\",\n        base .. \"/ptBR/male/5.ogg\",\n    },\n    {\n        base .. \"/esES/female/1.ogg\",\n        base .. \"/esES/female/2.ogg\",\n        base .. \"/esES/female/3.ogg\",\n        base .. \"/esES/female/4.ogg\",\n        base .. \"/esES/female/5.ogg\",\n    },\n    {\n        base .. \"/esES/male/1.ogg\",\n        base .. \"/esES/male/2.ogg\",\n        base .. \"/esES/male/3.ogg\",\n        base .. \"/esES/male/4.ogg\",\n        base .. \"/esES/male/5.ogg\",\n    },\n    {\n        base .. \"/esMX/male/1.ogg\",\n        base .. \"/esMX/male/2.ogg\",\n        base .. \"/esMX/male/3.ogg\",\n        base .. \"/esMX/male/4.ogg\",\n        base .. \"/esMX/male/5.ogg\",\n    },\n}",
