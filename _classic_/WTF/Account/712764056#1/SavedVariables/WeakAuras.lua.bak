["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    local behavior = aura_env.config.maintenance.blessings.behavior\n    \n    if behavior == 1 then -- Show if Applied\n        return t[1]\n    elseif behavior == 2 then -- Show if Missing\n        if t[6] and t[7] then\n            return false\n        end\n        return t[2] or t[3]\n    else -- Always Show\n        return true\n    end\nend",
["activeTriggerMode"] = -10,
},
