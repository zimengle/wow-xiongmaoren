["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1390'\nlocal ID          = 'ShroudOfReversal'\n\nlocal name, icon = C_Spell.GetSpellName(115911), C_Spell.GetSpellTexture(115911)\n\nlocal options = {\n    warningText = '%icon @cffffff80%name@r » %destName %icon'\n}\n\naura_env.StopCD = function()\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, { ID = ID })\nend\n\naura_env.StartCD = function(duration, autoHide)\n    local data = {\n        show           = true,\n        autoHide       = autoHide,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        ID             = ID,\n        count          = aura_env.count,\n        name           = name,\n        icon           = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function(destName)\n    local data = {\n        ID       = ID,\n        count    = aura_env.count,\n        name     = name,\n        icon     = icon,\n        destName = WA_ClassColorName(destName),\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_CAST_SUCCESS",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_, destGUID, destName,_,_, spellID = ...\n        \n        if spellID == 115911 then\n            aura_env.count = aura_env.count + 1\n            \n            if destGUID ~= WeakAuras.myGUID then\n                aura_env.SendWarning(destName)\n            end\n            \n            if not aura_env.isLfr then\n                aura_env.StartCD(30)\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n        aura_env.isLfr = WeakAuras.InstanceDifficulty() == 'lfr'\n    end\nend",
["spellIds"] = {
