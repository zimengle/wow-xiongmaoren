["[DP] [Zorlok] Echo Clone"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1507'\nlocal ID          = 'EchoClone'\n\nlocal name, icon = Merfin.GetTitleEJ(6568), C_Spell.GetSpellTexture(127834)\n\nlocal options = {\n    warningText = \"%icon @cffff8b17\" .. name .. \"@r %icon\",\n    ttsLine = name,\n}\n\naura_env.SendWarning = function()\n    local data = {\n        ID    = ID,\n        count = aura_env.count,\n        name  = name,\n        icon  = icon,\n    }\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend\n\naura_env.StopCD = function()\n    local data = { ID = ID }\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, data) -- no options\nend\n\naura_env.StartCD = function(duration)\n    local data = {\n        show           = true,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        autoHide       = true,\n        ID             = ID,\n        count          = aura_env.count,\n        name           = name,\n        icon           = icon,\n        noCount        = true,\n    }\n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, PLATFORM_CHANGED, CLONE_SPAWNED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'PLATFORM_CHANGED' then\n        local platformN = ...\n        if platformN == 4 then\n            local seconds = 58\n            aura_env.StartCD(seconds)\n            aura_env.scheduler = C_Timer.NewTimer(seconds, function()\n                    WeakAuras.ScanEvents('CLONE_SPAWNED')\n            end)\n        end\n        \n    elseif e == 'CLONE_SPAWNED' then\n        aura_env.StopCD()\n        aura_env.SendWarning()\n        \n    elseif e == 'ENCOUNTER_START' then\n        if aura_env.scheduler then\n            aura_env.scheduler:Cancel()\n        end\n        \n        aura_env.count = 0\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
