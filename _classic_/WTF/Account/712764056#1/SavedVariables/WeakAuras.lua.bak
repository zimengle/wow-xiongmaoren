{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["custom_type"] = "stateupdate",
["subeventSuffix"] = "_CAST_START",
["unit"] = "player",
["event"] = "Combat Log",
["customStacks"] = "\n\n",
["names"] = {
},
["custom"] = "function(e, event, timestamp, subevent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, arg12, arg13, arg14, arg15, arg16)\n    --player name\n    local name = UnitName(\"player\")\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" or event == \"COMBAT_LOG_EVENT\" then\n        --swing parry\n        if subevent == \"SWING_MISSED\" then\n            --print(\"E\"..event..\" 时间戳\"..timestamp..\" subEvent:\"..subevent..\" sourceName:\"..sourceName..\" missType:\"..arg12)\n            if arg12 == \"PARRY\" and sourceName == name then\n                --print(\"SwingParry +1\")\n                aura_env.swingparry = aura_env.swingparry + 1\n            end\n        end\n        \n        --spell parry\n        if subevent == \"SPELL_MISSED\" then\n            --print(\"E\"..event..\" 时间戳\"..timestamp..\" subEvent:\"..subevent..\" sourceName:\"..sourceName..\" missType:\"..arg15..\" ARG12:\"..arg12)\n            if arg15 == \"PARRY\" and sourceName == name then\n                --print(\"SpellParry +1\")\n                aura_env.spellparry = aura_env.spellparry + 1\n            end\n        end\n        \n        \n    end\n    \n    return true\nend\n\n\n\n\n",
