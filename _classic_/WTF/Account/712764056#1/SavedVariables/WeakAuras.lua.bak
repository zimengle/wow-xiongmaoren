["JT招架统计"] = {
["sparkWidth"] = 10,
["iconSource"] = 0,
["authorOptions"] = {
{
["type"] = "toggle",
["default"] = true,
["key"] = "enableReport",
["name"] = "战斗结束后通报统计",
["useDesc"] = false,
["width"] = 2,
},
},
["adjustedMax"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["url"] = "https://wago.io/YJ9N1kS5C/11",
["actions"] = {
["start"] = {
["custom"] = "aura_env.swingparry = 0\naura_env.spellparry = 0",
["do_custom"] = true,
},
["finish"] = {
["message"] = "%c",
["custom"] = "local total = aura_env.swingparry + aura_env.spellparry\nlocal rate\nif total <= 0 then\n    rate = aura_env.parrtyperfect\nelse \n    if total <=3 then\n        rate = aura_env.parrtynormal\n    else \n        if total <=6 then\n            rate = aura_env.parrtybad\n        else\n            rate = aura_env.parrtyterrible\n        end\n    end\nend\n\nlocal text = aura_env.parryheader..total..aura_env.parrydetailstimes..\" -- \"..rate..\" ( \"..aura_env.parrydetailsspell..aura_env.spellparry..\" \"..aura_env.parrydetailsswing..aura_env.swingparry..\" )\"\n\n\nlocal channel = nil\nif aura_env.config.enableReport then\n    \n    if IsInRaid() and not  IsInGroup(LE_PARTY_CATEGORY_INSTANCE)  then\n        channel = 'RAID'\n    elseif IsInGroup(LE_PARTY_CATEGORY_HOME) and not  IsInGroup(LE_PARTY_CATEGORY_INSTANCE) then\n        channel = 'PARTY'\n    elseif IsInRaid() and  IsInGroup(LE_PARTY_CATEGORY_INSTANCE)  then\n        channel = 'INSTANCE_CHAT'\n    end\n    if aura_env.isMelee and channel then\n        \n        SendChatMessage(text,channel,nil,nil)\n    end\nend\n\n\n",
["message_custom"] = "function()\n    if not aura_env.isMelee then\n        return \"\"\n    end\n    \n    local total = aura_env.swingparry + aura_env.spellparry\n    local rate\n    if total <= 0 then\n        rate = aura_env.parrtyperfect\n    else \n        if total <=3 then\n            rate = aura_env.parrtynormal\n        else \n            if total <=6 then\n                rate = aura_env.parrtybad\n            else\n                rate = aura_env.parrtyterrible\n            end\n        end\n    end\n    \n    \n    local text = aura_env.parryheader..total..aura_env.parrydetailstimes..\" -- \"..rate..\" ( \"..aura_env.parrydetailsspell..aura_env.spellparry..\" \"..aura_env.parrydetailsswing..aura_env.swingparry..\" ) \"\n    return text\nend",
["do_custom"] = true,
["message_type"] = "SMARTRAID",
["message_format_c_format"] = "none",
["do_message"] = false,
["message_format_s_format"] = "none",
},
["init"] = {
["custom"] = "--count\naura_env.swingparry = 0\naura_env.spellparry = 0\n\n--zhCN message\naura_env.parryheader = \"[JT找背工具WA] 本次招架: \"\n\naura_env.parrtyperfect = \"完美！\"\naura_env.parrtynormal = \"还阔以！\"\naura_env.parrtybad = \"有点多……\"\naura_env.parrtyterrible = \"疯狂打脸！\"\n\naura_env.parrydetailsspell = \"技能: \"\naura_env.parrydetailsswing = \"普攻: \"\naura_env.parrydetailstimes = \" 次 \"\n\n\n--shaman/pal/dru\nlocal _, class = UnitClass(\"player\")\naura_env.isMelee = false\n\n-- Melee class\nif class == \"ROGUE\" or class == \"WARRIOR\" or class == \"DEATHKNIGHT\" then\n    aura_env.isMelee = true\nend\n\n--风暴打击 /dump GetTalentInfo(2, 13)\nif class == \"SHAMAN\" and select(5,GetTalentInfo(2, 13)) > 0 then\n    aura_env.isMelee = true\nend\n\n--神圣风暴 /dump GetTalentInfo(3, 24)\nif class == \"PALADIN\" and select(5,GetTalentInfo(3, 24)) > 0 then\n    aura_env.isMelee = true\nend\n\n--裂伤 /dump GetTalentInfo(2, 20)\nif class == \"DRUID\" and select(5,GetTalentInfo(2, 20)) > 0 then\n    aura_env.isMelee = true\nend\n\nif not ( GetLocale() == \"zhCN\" or GetLocale() == \"zhTW\" ) then\n    -- change Attacking Face voice to english if not cn client.\n    aura_env.parryheader = \"[JT-BackFinder-WA] Got Parry : \"\n    \n    aura_env.parrtyperfect = \"Perfect!\"\n    aura_env.parrtynormal = \"Pretty Good!\"\n    aura_env.parrtybad = \"A little bit ......\"\n    aura_env.parrtyterrible = \"You are FACE BITBER!\"\n    \n    aura_env.parrydetailsspell = \"Skill: \"\n    aura_env.parrydetailsswing = \"Swing: \"\n    aura_env.parrydetailstimes = \" times.\"\nend\n\n\n\n",
["do_custom"] = true,
},
},
