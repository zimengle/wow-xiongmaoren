},
["anchorFrameType"] = "SCREEN",
["alpha"] = 1,
["useAdjustededMin"] = false,
["regionType"] = "aurabar",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "local strsplit = strsplit\nlocal bband = bit.band\nlocal pairs = pairs\n\nlocal MerfinTestCharacters = {\n    ['Merfinbang'] = true,\n    ['Merfinx'] = true,\n}\n\naura_env.isDebug = MerfinTestCharacters[WeakAuras.me]\n\naura_env.GetOption = function(optionName)\n    local cfg = aura_env.config.healthbar\n    return cfg[optionName]\nend\n\nlocal GetDifficultyRaw = function()\n    return WeakAuras.InstanceTypeRaw()\nend\n\naura_env.damage_events = {\n    ['SPELL_PERIODIC_DAMAGE'] = true,\n    ['SPELL_DAMAGE'] = true,\n    ['RANGE_DAMAGE'] = true,\n    ['SWING_DAMAGE'] = true,\n}\n\nlocal RAID_ICONS = {\n    [0x00000001] = 1,\n    [0x00000002] = 2,\n    [0x00000004] = 3,\n    [0x00000008] = 4,\n    [0x00000010] = 5,\n    [0x00000020] = 6,\n    [0x00000040] = 7,\n    [0x00000080] = 8,\n}\n\nlocal function GetRaidIconFromFlags(flags)\n    for mask, index in pairs(RAID_ICONS) do\n        if bband(flags, mask) ~= 0 then\n            return index\n        end\n    end\n    return nil\nend\n\nlocal GetFlagMark = function(raidFlag)\n    if not raidFlag then\n        return\n    end\n    \n    local raidIcon = GetRaidIconFromFlags(raidFlag)\n    return raidIcon\nend\n\naura_env.GetFormattedFlagMark = function(raidFlag)\n    local raidIcon = GetFlagMark(raidFlag)\n    \n    if raidIcon then\n        return '{rt' .. raidIcon .. '}'\n    end\nend\n\n-- 3: 10nm, 4: 25nm, 5: 10hc, 6: 25hc\naura_env.npcData = {\n    ['60793'] = {\n        id = 'CELESTIAL_PROTECTOR',\n        displayName = 'Protector', \n        icon = 237587,\n        hp = { \n            [3] = 4215920, \n            [5] = 4110522,\n            [4] = 12647760,\n            [6] = 12331566\n        },\n    },\n    \n    ['60913'] = {\n        id = 'ENERGY_CHARGE',\n        displayName = 'Energy Charge', \n        icon = 525026,\n        hp = { \n            [3] = 492426, \n            [5] = 738639,\n            [4] = 1477279,\n            [6] = 2215918\n        },\n    },\n    \n    ['64183'] = {\n        id = 'ENORMOUS_QUILEN',\n        displayName = 'Enormous Quilen', \n        icon = 625905,\n        hp = { \n            [3] = 8150640, \n            [5] = 8150640,\n            [4] = 8150640,\n            [6] = 8150640\n        },\n    },\n    \n    ['65173'] = {\n        id = 'ECHO_OF_ATTENUATION',\n        displayName = 'Attenuation', \n        icon = 123721,\n        hp = { \n            [3] = 4215920, \n            [5] = 4110000,\n            [4] = 12647760,\n            [6] = 100000\n        },\n    },\n    \n    ['65174'] = {\n        id = 'ECHO_OF_FORCE',\n        displayName = 'Force and Verve', \n        icon = 589118,\n        hp = { \n            [3] = 4215920, \n            [5] = 4110000,\n            [4] = 12647760,\n            [6] = 100000\n        },\n    },\n}\naura_env.GetNpcData = function(id)\n    if not id then return 0 end\n    local npcData = aura_env.npcData[id]\n    \n    local hp = npcData.hp[aura_env.diffRaw]\n    local displayName = npcData.displayName\n    local icon = npcData.icon\n    local entryId = npcData.id\n    \n    return hp, displayName, icon, entryId\nend\n\naura_env.GetNpcId = function(guid)\n    if not guid then return 0 end\n    if aura_env.cachedGUID[guid] then\n        return aura_env.cachedGUID[guid]\n    end\n    \n    local _, _, _, _, _, npcId = strsplit(\"-\", guid)\n    \n    aura_env.cachedGUID[guid] = npcId\n    return aura_env.cachedGUID[guid]\nend\n\naura_env.UpdateRaidTarget = function(a)\n    \n    if not next(a) then\n        return\n    end\n    \n    --\nend\n\naura_env.ClearCache = function()\n    aura_env.diffRaw = GetDifficultyRaw()\n    aura_env.deadGUID = {}\n    aura_env.cachedGUID = {}\nend\n\naura_env.ClearCache()\n\nif aura_env.isDebug then\n    aura_env.npcData['55689'] = crystalData\nend",
["do_custom"] = true,
},
},
