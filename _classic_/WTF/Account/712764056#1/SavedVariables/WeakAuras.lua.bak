["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = 'Trash'\nlocal ID          = 'Detonate'\n\nlocal name, icon = C_Spell.GetSpellName(117241), C_Spell.GetSpellTexture(117241)\n\nlocal options = {\n    warningText = '%icon @cffff8b17%name@r %icon'\n}\n\naura_env.SendWarning = function()\n    local data = {\n        ID   = ID,\n        name = name,\n        icon = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
