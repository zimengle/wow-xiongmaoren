["subeventPrefix"] = "SPELL",
["custom_type"] = "stateupdate",
["dynamicDuration"] = true,
["custom"] = "function(states, event, encounterID, encounterName, difficultyID, groupSize, success)\n    \n    if event == 'OPTIONS' then\n        states:Update('', {\n                progressType   = 'timed',\n                duration       = 30,\n                expirationTime = 30 + GetTime(),\n                autoHide       = true,\n                encounterName  = 'The Spirit Kings',\n        })\n    end\n    \n    if success == 0 then\n        local duration = aura_env.customRespawn[encounterID] or 30\n        states:Update('', {\n                progressType   = 'timed',\n                duration       = duration,\n                expirationTime = duration + GetTime(),\n                autoHide       = true,\n                encounterName  = encounterName,\n        })\n        return true\n    end\nend",
