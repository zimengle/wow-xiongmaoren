["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, e, ...)\n    if e == 'OPTIONS' then\n        states:Update(i, {\n                progressType   = 'timed',\n                autoHide       = false,\n                duration       = 15,\n                expirationTime = 15 + GetTime(),\n                name           = 'Corrupted Essence',\n                nextCount      = math.random(1, 10),\n        })\n    end\n    \n    if e == 'MERFIN_CD_HIDE' then\n        local encounterID, cooldown = ...\n        \n        if cooldown.ID ~= 'ShroudOfReversal' then return end\n        \n        local stateName = encounterID .. cooldown.ID .. (cooldown.GUID or '')\n        states:Remove(stateName)\n        \n    elseif e == 'MERFIN_CD_SHOW_WIDGET' then\n        local encounterID, cooldown = ...\n        \n        if cooldown.ID ~= 'ShroudOfReversal' then return end\n        \n        local stateName = encounterID .. cooldown.ID  .. (cooldown.GUID or '')\n        \n        local newState = {\n            progressType   = 'timed',\n            duration       = cooldown.duration,\n            expirationTime = cooldown.expirationTime,\n            autoHide       = true,\n            icon           = cooldown.icon,\n            name           = cooldown.name,\n            nextCount      = (cooldown.count or 0) + 1,\n            noCount        = cooldown.noCount,\n            cooldownId     = cooldown.ID,\n            sourceName     = cooldown.sourceName,\n            hasSrcName     = cooldown.sourceName ~= nil,\n        }\n        \n        states:Update(stateName, newState)\n    end\nend",
["events"] = "MERFIN_CD_SHOW_WIDGET, MERFIN_CD_HIDE",
