["height"] = 34,
["rotate"] = false,
["desc"] = "WA制作：露露緹婭@Bilibili。\n代码支持：Pediyzhi@Bilibili。\n\n转载请保留出处，请勿二次上传wago。",
["source"] = "import",
["anchorFrameType"] = "UIPARENT",
["fontSize"] = 15,
["text2Containment"] = "INSIDE",
["useCooldownModRate"] = true,
["text1Color"] = {
1,
1,
1,
1,
},
["selfPoint"] = "TOPLEFT",
["mirror"] = false,
["anchorFrameFrame"] = "SpellBookFrame",
["displayIcon"] = "Interface\\Challenges\\challenges-gold",
["text1Enabled"] = true,
["actions"] = {
["start"] = {
["do_custom"] = true,
["do_message"] = false,
["custom"] = "local e = aura_env\nlocal e = aura_env\nlocal Rurutia_MAIN = WeakAuras.GetRegion(\"【左上按钮】露露的问答（框架）\") \nlocal Rurutia_FAQ = WeakAuras.GetRegion(\"露露的问答-近期问答\") \nlocal Rurutia_LOG = WeakAuras.GetRegion(\"露露的问答-更新日志\") \nlocal Rurutia_VIDEO = WeakAuras.GetRegion(\"露露的问答-视频教程\") \nlocal Rurutia_LINK = WeakAuras.GetRegion(\"露露的问答-反馈问题\") \nlocal Rurutia_CMD = WeakAuras.GetRegion(\"露露的问答-常用命令\") \nlocal Rurutia_MACRO = WeakAuras.GetRegion(\"露露的问答-宏分享\") \nlocal Rurutia_DMG = WeakAuras.GetRegion(\"露露的问答-伤害数字\") \nRurutia_MAIN:Hide()\nRurutia_FAQ:Hide()\nRurutia_LOG:Hide()\nRurutia_LINK:Hide()\nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, nil) \n    e.btn:RegisterForClicks(\"AnyUp\",\"AnyDown\")\n    e.btn:SetAttribute(\"type\", \"macro\")\n    e.btn:SetAttribute(\"macrotext\",str)\n    e.btn:SetText(e.id)\n    e.btn:SetAllPoints(region) \nend\nlocal btn = _G[e.id..\"Button\"]\n\nbtn:SetScript(\"OnMouseUp\", function(self)\n        if Rurutia_MAIN:IsShown() then\n            Rurutia_MAIN:Hide()\n        else            \n            Rurutia_MAIN:Show()\n            Rurutia_FAQ:Show()\n            Rurutia_LOG:Hide()\n            Rurutia_VIDEO:Hide()\n            Rurutia_LINK:Hide()\n            Rurutia_CMD:Hide()\n            Rurutia_MACRO:Hide()\n            Rurutia_DMG:Hide()\n        end\nend)\n\nlocal function onEnter(self)\n    GameTooltip:SetOwner(self, \"ANCHOR_NONE\");\n    GameTooltip:SetPoint(\"LEFT\", self, \"RIGHT\");\n    GameTooltip:ClearLines();\n    GameTooltip:SetText(\"打开：|cffff78ab露露的问答手册|r\", 1, 1, 1, 1, 1)\nend\nlocal function onLeave(self)\n    GameTooltip:Hide();\nend\nbtn:SetScript(\"OnEnter\",onEnter)\nbtn:SetScript(\"OnLeave\",onLeave)",
},
["finish"] = {
["do_message"] = false,
},
["init"] = {
["do_custom"] = false,
["custom"] = "local e = aura_env\nlocal str=\"/run for i=1,GetNumTradeSkills()do a,_,b=GetTradeSkillInfo(i)if (a:find('\"..e.id..\"'))and b>0 then DoTradeSkill(i,1) break end end\"\nlocal _,ilink=GetItemInfo(e.config.GemID)\nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, \"SecureActionButtonTemplate\") \n    e.btn:RegisterForClicks(\"AnyUp\",\"AnyDown\")\n    e.btn:SetAttribute(\"type\", \"macro\")\n    e.btn:SetAttribute(\"macrotext\",str)\n    e.btn:SetText(e.id)\n    e.btn:SetAllPoints(region) \nend\nlocal btn = _G[e.id..\"Button\"]\nlocal function onEnter(self)\n    GameTooltip:SetOwner(self, \"ANCHOR_NONE\");\n    GameTooltip:SetPoint(\"LEFT\", self, \"RIGHT\");\n    GameTooltip:ClearLines();\n    --GameTooltip:SetInventoryItem(\"player\",self.slot);\n    GameTooltip:SetHyperlink(ilink)\nend\nlocal function onLeave(self)\n    GameTooltip:Hide();\nend\nbtn:SetScript(\"OnEnter\",onEnter)\nbtn:SetScript(\"OnLeave\",onLeave)",
},
},
