["[DP] [Sha] Implacable Strike"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1431'\nlocal ID = 'ImplacableStrike'\n\nlocal name, icon = C_Spell.GetSpellName(120672), C_Spell.GetSpellTexture(120672)\n\nlocal options = {\n    warningText = '%upper:name',\n    ttsLine = Merfin:L('Frontal')\n}\n\naura_env.StopCD = function(ID)\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, {ID = ID})\nend\n\naura_env.StartCD = function(duration, autoHide)\n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, {\n            show = true,\n            autoHide = autoHide,\n            duration = duration,\n            expirationTime = duration + GetTime(),\n            ID = ID,\n            name = name,\n            icon = icon,\n            count = aura_env.count\n    }, options)\nend\n\naura_env.SendWarning = function()\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID = ID,\n            name = name,\n            icon = icon,\n            count = aura_env.count\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_CAST_START, SPECIAL_CAST_CD",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_CAST_START' then\n            if spellID == 120672 then\n                aura_env.count = aura_env.count + 1\n                aura_env.SendWarning()\n                aura_env.StopCD('ImplacableStrike')\n                aura_env.StopCD('RandomAbility')\n            end\n        end\n        \n    elseif e == 'SPECIAL_CAST_CD' then\n        local ID, duration = ...\n        \n        if ID == 'ImplacableStrike' then\n            aura_env.StartCD(duration)\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
