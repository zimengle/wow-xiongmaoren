["[Progress] [T14] Auto Gossip"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["parent"] = "[Progress] T14（露露删减自用，Merfin制作）1001",
["displayText"] = "",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["finish"] = {
["message"] = "",
["do_message"] = false,
["message_type"] = "PRINT",
},
["init"] = {
["custom"] = "local gossips = {\n    [35145] = true, -- TSK Role Play Panda\n    [41380] = true, -- Elegon: Start Gossip\n    [41013] = true, -- ToES: Start Role Play (1)\n    [41012] = true, -- ToES: Start Role Play (2)\n}\n\nfunction aura_env.AutoSelect()\n    if IsControlKeyDown() then return end\n    local gossipInfo = C_GossipInfo.GetOptions()\n    local id = gossipInfo[1] and gossipInfo[1].gossipOptionID\n    if id and gossips[id] then \n        C_GossipInfo.SelectOption(id)\n    end\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["debuffType"] = "HELPFUL",
["events"] = "GOSSIP_SHOW, MODIFIER_STATE_CHANGED",
["custom"] = "function(e, ...)\n    if e == \"GOSSIP_SHOW\" then\n        aura_env.AutoSelect()\n    elseif e == 'MODIFIER_STATE_CHANGED' then\n        local mod, state = ...\n        if mod == 'LCTRL' or mod == 'RCTRL' then\n            if state == 0 then\n                aura_env.AutoSelect()\n            end\n        end\n    end\nend",
