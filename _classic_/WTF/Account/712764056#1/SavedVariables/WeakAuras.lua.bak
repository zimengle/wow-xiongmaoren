["semver"] = "1.3.29",
["sparkHidden"] = "NEVER",
["id"] = "[SB] [SC:04] Unleashed Anguish",
["config"] = {
},
["frameStrata"] = 1,
["width"] = 250,
["anchorFrameType"] = "SCREEN",
["zoom"] = 0.3,
