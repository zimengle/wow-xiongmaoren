["[DP] [Trash] Toxic Spew (Zar'thik Augurer)"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = 'Trash'\nlocal ID          = 'ToxicSpew'\n\nlocal name, icon = C_Spell.GetSpellName(125871), C_Spell.GetSpellTexture(125871)\n\nlocal options = {\n    warningText = \"%icon %name %icon\",\n}\n\naura_env.StopCD = function(GUID)\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, {\n            ID = ID,\n            GUID = GUID\n    })\nend\n\naura_env.StartCD = function(duration, GUID)\n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, {\n            show           = true,\n            autoHide       = true,\n            duration       = duration,\n            expirationTime = duration + GetTime(),\n            ID             = ID,\n            name           = name,\n            icon           = icon,\n            count          = aura_env.count,\n            GUID           = GUID\n    }, options)\nend\n\naura_env.SendWarning = function()\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID    = ID,\n            name  = name,\n            icon  = icon,\n            count = aura_env.count,\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "UNIT_DIED, CLEU:SPELL_CAST_SUCCESS, NAME_PLATE_ENTERED_COMBAT",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_, sourceGUID,_,_,_,_,_,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_CAST_SUCCESS' then\n            if spellID == 125871 then\n                aura_env.StartCD(18, sourceGUID)\n            end\n        end\n        \n    elseif e == 'NAME_PLATE_ENTERED_COMBAT' then\n        local _, unitGUID, npcID = ...\n        if npcID == 64454 then\n            aura_env.StartCD(10, unitGUID)\n        end\n        \n    elseif e == 'UNIT_DIED' then\n        local npcID, destGUID = ...\n        \n        if npcID == 64454 then\n            aura_env.StopCD(destGUID)\n        end\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
