["preferToUpdate"] = false,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["sparkRotation"] = 0,
["url"] = "https://wago.io/mop_dungeons/73",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "local UnitIsGroupLeader, UnitIsGroupAssistant = UnitIsGroupLeader, UnitIsGroupAssistant\nlocal UnitGroupRolesAssigned = UnitGroupRolesAssigned\n\nlocal roleIcons = {\n    ['TANK']   = '|A:groupfinder-icon-role-large-tank:14:14:0:0|a',\n    ['DPS']    = '|A:groupfinder-icon-role-large-dps:14:14:0:0|a',\n    ['HEALER'] = '|A:groupfinder-icon-role-large-heal:16:16:0:0|a',\n}\n\nlocal roleToIndex = {\n    ['DAMAGER'] = 1,\n    ['TANK'] = 2,\n    ['HEALER'] = 3,\n}\n\nlocal GetFormattedName = function(cooldown, enabledCustom, customName)\n    \n    if enabledCustom then\n        cooldown.name = customName\n    end\n    \n    if not cooldown.roleIcon then\n        return cooldown.name\n    end\n    \n    local icon = roleIcons[cooldown.roleIcon]\n    return icon .. ' ' .. cooldown.name\nend\n\nlocal playerRole = UnitGroupRolesAssigned('player')\nlocal registered = {}\nlocal schedulers = {}\n\nlocal IsPassThrough = function()\n    return (UnitIsGroupLeader('player') or UnitIsGroupAssistant('player')) and aura_env.config.cooldowns.all.enableRL\nend\n\nlocal GetConfig = function(encounterID, cooldownId)\n    local cfg = aura_env.config.cooldowns\n    \n    if cfg.all.emphasizedBar then\n        return true, cfg.all.emphasizedOn\n    end\n    \n    if not cfg[encounterID] or not cfg[encounterID][cooldownId] then\n        return false, 5\n    end\n    \n    local cd = cfg[encounterID][cooldownId]\n    return cd.emphasizedBar, cd.emphasizedOn, cd.enableCustomName, cd.customName\n    \nend\n\n-- [[ Condition Checks ]]\n\nlocal IsEncounterEnabled = function(encounterID)\n    if not encounterID:find('Trash') then\n        local currEnc = WeakAuras.CurrentEncounter\n        if encounterID ~= (currEnc and tostring(currEnc.id)) then\n            return\n        end\n    end\n    \n    local cfg = aura_env.config.cooldowns\n    if cfg[encounterID] and cfg[encounterID].enableCooldowns then\n        return true\n    end\n    return false\nend\n\nlocal IsRoleEligible = function(encounterID, cooldownId)\n    \n    -- We ignore the role check if the player is the RL or an Assistant and the option is enabled\n    if IsPassThrough() then\n        return true\n    end\n    \n    if playerRole == 'NONE' then\n        return true\n    end\n    \n    local cfg = aura_env.config.cooldowns\n    \n    if not cfg[encounterID] or not cfg[encounterID][cooldownId] then\n        return true\n    end\n    \n    local eligRoles = cfg[encounterID][cooldownId].enabledRole\n    local myIndex = roleToIndex[playerRole]\n    \n    return eligRoles[myIndex]\nend\n\nlocal IsCooldownEligible = function(encounterID, cooldown)\n    return not cooldown.special and IsEncounterEnabled(encounterID) and IsRoleEligible(encounterID, cooldown.id)\nend\n\n-- [[ Registers & Schedulers ]]\n\nlocal function ScheduleEvent(after, encounterID, cooldown, emphasizedOn)\n    local id, GUID = cooldown.id, cooldown.GUID\n    \n    schedulers[encounterID] = schedulers[encounterID] or {}\n    \n    if GUID then\n        schedulers[encounterID][id] = schedulers[encounterID][id] or {}\n        schedulers[encounterID][id][GUID] = WeakAuras.timer:ScheduleTimer(\n            WeakAuras.ScanEvents, after, 'WA_MERFIN_BOSS_CD_EMPH', encounterID, cooldown, emphasizedOn\n        )\n        return\n    end\n    \n    schedulers[encounterID][cooldown.id] = WeakAuras.timer:ScheduleTimer(\n        WeakAuras.ScanEvents, after, 'WA_MERFIN_BOSS_CD_EMPH', encounterID, cooldown, emphasizedOn\n    )\nend\n\nlocal function UnscheduleEvent(encounterID, cooldownId, GUID)\n    local encounterData = schedulers[encounterID]\n    if not encounterData then return end\n    \n    local cooldownData = encounterData[cooldownId]\n    if not cooldownData then return end\n    \n    if GUID then\n        WeakAuras.timer:CancelTimer(cooldownData[GUID])\n        cooldownData[GUID] = nil\n        if next(cooldownData) == nil then\n            encounterData[cooldownId] = nil\n        end\n    else\n        WeakAuras.timer:CancelTimer(encounterData[cooldownId])\n        encounterData[cooldownId] = nil\n    end\n    \n    if next(encounterData) == nil then\n        schedulers[encounterID] = nil\n    end\n    \nend\n\nlocal function UnregisterCD(encounterID, cooldownId, GUID)\n    local encounterData = registered[encounterID]\n    if not encounterData or not encounterData[cooldownId] then return end\n    \n    if GUID then\n        encounterData[cooldownId][GUID] = nil\n        if not next(encounterData[cooldownId]) then\n            encounterData[cooldownId] = nil\n        end\n    else\n        encounterData[cooldownId] = nil\n    end\nend\n\nlocal function RegisterCD(encounterID, cooldown)\n    local id, GUID = cooldown.id, cooldown.GUID\n    \n    registered[encounterID] = registered[encounterID] or {}\n    \n    if GUID then\n        registered[encounterID][id] = registered[encounterID][id] or {}\n        registered[encounterID][id][GUID] = cooldown.expirationTime\n        return\n    end\n    \n    registered[encounterID][id] = cooldown.expirationTime\nend\n\n-- [[ Handlers ]]\n\nlocal GetStateName = function(encounterID, cooldownID, GUID)\n    return string.format(\"%s%s%s\", encounterID, cooldownID, GUID or \"\")\nend\n\naura_env.OnHandler = {}\n\nlocal WipeAllEncounters = function()\n    local currEnc = WeakAuras.CurrentEncounter\n    local currEncID = currEnc and tostring(currEnc.id)\n    for encounterID, encounterSchedulers in pairs(schedulers) do\n        if not currEncID or currEncID ~= encounterID then\n            for cooldownID, cooldownData in pairs(encounterSchedulers) do\n                -- cooldownData is always \"table\" type so we use a scuffed workaround\n                if cooldownData.object then\n                    UnscheduleEvent(encounterID, cooldownID)\n                else\n                    for GUID in pairs(cooldownData) do\n                        UnscheduleEvent(encounterID, cooldownID, GUID)\n                    end\n                end\n            end\n        end\n    end\nend\n\naura_env.OnHandler['STATUS'] = function() \n    WipeAllEncounters()\nend\n\naura_env.OnHandler['OPTIONS'] = function(a)\n    WipeAllEncounters()\n    \n    for i = 1, 3 do\n        local duration = math.random(5, 30)\n        a[i] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            autoHide = false,\n            duration = duration,\n            expirationTime = duration + GetTime(),\n            name = 'Cooldown',\n            nextCount = math.random(1, 10),\n        }\n    end\n    return true\nend\n\nlocal HideEmphasize = function(encounterID, cooldownID, GUID)\n    UnscheduleEvent(encounterID, cooldownID, GUID)\n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD_EMPH_HIDE', encounterID, { id = cooldownID, GUID = GUID })\nend\n\nlocal HideCooldown = function(a, encounterID, cooldownID, GUID)\n    UnregisterCD(encounterID, cooldownID, GUID)\n    HideEmphasize(encounterID, cooldownID, GUID)\n    \n    local stateName = GetStateName(encounterID, cooldownID, GUID)\n    if a[stateName] then\n        a[stateName].show = false\n        a[stateName].changed = true\n    end\n    \n    return true\nend\n\n\naura_env.OnHandler['ENCOUNTER_END'] = function(a, encounterID)\n    \n    local encounterID = tostring(encounterID)\n    local encounterCooldowns = registered[encounterID]\n    if not encounterCooldowns then return end\n    \n    for cooldownID, cooldownData in pairs(encounterCooldowns) do\n        if type(cooldownData) == 'table' then\n            for GUID in pairs(cooldownData) do\n                HideCooldown(a, encounterID, cooldownID, GUID)\n            end\n        else\n            HideCooldown(a, encounterID, cooldownID)\n        end\n    end\n    \n    if not next(encounterCooldowns) then\n        registered[encounterID] = nil\n    end\n    \n    return true\nend\n\naura_env.OnHandler['WA_MERFIN_BOSS_CD'] = function(a, encounterID, cooldown)\n    if not cooldown then return end\n    \n    HideEmphasize(encounterID, cooldown.id, cooldown.GUID)\n    \n    if not IsCooldownEligible(encounterID, cooldown) then\n        return\n    end\n    \n    RegisterCD(encounterID, cooldown)\n    \n    local emphasizedBar, emphasizeOn, enabledCustom, customName = GetConfig(encounterID, cooldown.id)\n    local emphasizedIn = emphasizedBar and (cooldown.duration - emphasizeOn)\n    \n    cooldown.name = GetFormattedName(cooldown, enabledCustom, customName)\n    \n    -- If the emphasized option is active and the current time is greater than the emphasized timer\n    if not emphasizedBar or emphasizedIn > 0 then\n        local stateName = GetStateName(encounterID, cooldown.id, cooldown.GUID)\n        a[stateName] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            duration = cooldown.duration,\n            expirationTime = cooldown.expirationTime,\n            autoHide = cooldown.autoHide,\n            icon = cooldown.icon,\n            name = cooldown.name,\n            nextCount = (cooldown.count or 0) + 1,\n            cooldownId = cooldown.id,\n        }\n    end\n    \n    if emphasizedBar then\n        if emphasizedIn > 0 then\n            ScheduleEvent(emphasizedIn, encounterID, cooldown, emphasizeOn)\n        else\n            WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD_EMPH', encounterID, cooldown)\n            return false\n        end\n    end\n    \n    return true\nend\n\naura_env.OnHandler['WA_MERFIN_BOSS_CD_HIDE'] = function(a, encounterID, cooldown)\n    if not encounterID or not cooldown or not cooldown.id then return end\n    \n    local registeredEnc = registered[encounterID]\n    if not registeredEnc then return end\n    \n    local registeredCd = registeredEnc[cooldown.id]\n    if not registeredCd then return end\n    \n    if cooldown.GUID then\n        if not registeredCd[cooldown.GUID] then return end\n        HideCooldown(a, encounterID, cooldown.id, cooldown.GUID)\n        return true\n    end\n    \n    if type(registeredCd) ~= 'table' then\n        HideCooldown(a, encounterID, cooldown.id)\n        return true\n    end\n    \n    for GUID in pairs(registeredCd) do\n        HideCooldown(a, encounterID, cooldown.id, GUID)\n    end\n    \n    \n    return true\nend\n\naura_env.OnHandler['WA_MERFIN_BOSS_CD_EMPH'] = function(a, encounterID, cooldown)\n    if not cooldown then return end\n    \n    local stateName = GetStateName(encounterID, cooldown.id, cooldown.GUID)\n    \n    if a[stateName] then\n        a[stateName].show = false\n        a[stateName].changed = true\n        return true\n    end\n    \n    return true\nend\n\naura_env.OnHandler['PLAYER_ROLES_ASSIGNED'] = function()\n    playerRole = UnitGroupRolesAssigned('player')\nend",
["do_custom"] = true,
},
},
