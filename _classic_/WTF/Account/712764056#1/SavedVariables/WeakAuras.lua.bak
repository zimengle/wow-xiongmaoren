["custom"] = "function(a, e, warning, count)\n    if e == 'WA_MERFIN_BOSS_WARNING' and warning == 'ScarletProtection' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            duration = 4,\n            expirationTime = 4 + GetTime(),\n            autoHide = true,\n            count = count,\n        }\n        return true\n    end\nend",
