["[Widget] [Feng] Nullification Barrier"] = {
["iconSource"] = 2,
["wagoID"] = "1qyg9npGm",
["parent"] = "[Widget] Feng Special Abilities",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "TOPRIGHT",
["cooldownSwipe"] = true,
["cooldownEdge"] = false,
["actions"] = {
