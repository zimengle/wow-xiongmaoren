["use_cloneId"] = true,
["debuffType"] = "HELPFUL",
["type"] = "custom",
["custom_type"] = "stateupdate",
["unit"] = "player",
["event"] = "Combat Log",
["subeventSuffix"] = "_DAMAGE",
["custom"] = "function(allstates, event, timestamp, subEvent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellid)\n    if not destName and spellid then return end\n    if spellid ~= 121995 then return end\n    if select(6,strsplit(\"-\",sourceGUID)) ~= \"62511\" then return end\n    \n    local unit = Ambiguate(destName, \"short\")\n    allstates:Update(unit, {\n            progressType = \"timed\",\n            duration = 1,\n            autoHide = true,\n            unit = unit,\n    })\n    return true\n    \nend",
