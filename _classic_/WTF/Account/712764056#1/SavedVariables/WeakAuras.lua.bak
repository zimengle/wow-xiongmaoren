["custom_hide"] = "custom",
["type"] = "custom",
["events"] = "WA_BEST_SECTOR",
["custom_type"] = "event",
["check"] = "event",
["custom"] = "function(_, sector)\n    return sector == aura_env.sectorN\nend",
["debuffType"] = "HELPFUL",
["unit"] = "player",
},
["untrigger"] = {
["custom"] = "function(_, sector)\n    return sector ~= aura_env.sectorN\nend",
