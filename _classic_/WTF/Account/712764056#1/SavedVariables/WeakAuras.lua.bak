["[DP] [TSG] Amethyst Pool"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1395'\nlocal ID          = 'AmethystPool'\n\nlocal name, icon = C_Spell.GetSpellName(130774), C_Spell.GetSpellTexture(130774)\n\nlocal options = {\n    warningText = '%icon @cffffff80%name@r (%count) %icon',\n}\n\naura_env.StartCD = function(duration, autoHide)\n    local data = {\n        show           = true,\n        autoHide       = autoHide,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        ID             = ID,\n        count          = aura_env.count,\n        name           = name,\n        icon           = icon,\n        localization = localization,\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function()\n    local data = {\n        ID    = ID,\n        count = aura_env.count,\n        name  = name,\n        icon  = icon,\n        localization = localization,\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend\n\naura_env.Schedule = function(event, seconds)\n    if aura_env.scheduler then \n        aura_env.scheduler:Cancel() \n    end\n    \n    aura_env.scheduler = C_Timer.NewTimer(seconds, function()\n            WeakAuras.ScanEvents(event)\n    end)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, ENCOUNTER_ENGAGE, AMETHYST_POOL",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'AMETHYST_POOL' then\n        aura_env.SendWarning()\n        aura_env.count = aura_env.count + 1\n        \n        local seconds = 11\n        aura_env.StartCD(seconds)\n        aura_env.Schedule('AMETHYST_POOL', seconds)\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n        \n        if WeakAuras.InstanceType() == 'twentyfive' and WeakAuras.InstanceDifficulty() ~= 'lfr' then\n            local seconds = 11\n            aura_env.StartCD(seconds)\n            aura_env.Schedule('AMETHYST_POOL', seconds)\n        end\n        \n    elseif e == 'ENCOUNTER_ENGAGE' then -- -- Custom Event for 10 Man\n        local npcID = ...\n        if npcID == 60047 then\n            local seconds = 6-1\n            aura_env.StartCD(seconds)\n            aura_env.Schedule('AMETHYST_POOL', seconds)\n        end\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
