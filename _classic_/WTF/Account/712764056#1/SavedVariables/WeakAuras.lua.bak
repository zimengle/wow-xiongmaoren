["unit"] = "player",
["custom"] = "function(states, e, _, warning)\n    if e == 'OPTIONS' then\n        states:Update('', {\n                progressType   = 'timed',\n                duration       = 6,\n                expirationTime = 6 + GetTime(),\n                autoHide       = true,\n                count          = 2,\n                name           = C_Spell.GetSpellName(115817),\n        })\n    end\n    if e == 'MERFIN_WARNING' and warning.ID == 'NullificationBarrier' then\n        states:Update('', {\n                progressType   = 'timed',\n                duration       = 6,\n                expirationTime = 6 + GetTime(),\n                autoHide       = true,\n                count          = warning.count,\n                name           = warning.name\n        })\n    end\nend",
