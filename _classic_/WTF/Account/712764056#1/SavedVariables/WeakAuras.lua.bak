["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, event, unitID)\n    \n    if event == 'OPTIONS' then\n        states:Update('', {\n                progressType = 'static',\n                total        = 5,\n                value        = 2.6,\n                prefix       = Merfin:L('Phase') .. ' 2', \n        })\n    end\n    \n    if event == 'UNIT_HEALTH' then\n        local npcID = aura_env.GetNPCIDFromUnitID(unitID)\n        if npcID == 63191 then\n            local hper = aura_env.GetUnitHealthPercent(unitID)\n            for _, range in ipairs(aura_env.ranges) do\n                local offset = aura_env.InRangeOffset(hper, range.min, range.max)\n                if offset then\n                    states:Update('', {\n                            progressType = 'static',\n                            total        = 5,\n                            value        = offset,\n                            prefix       = range.prefix,\n                    })\n                    return\n                end\n            end\n            states:Remove('')\n        end\n    end\nend",
["events"] = "UNIT_HEALTH:boss1",
