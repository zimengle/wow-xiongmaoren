},
["init"] = {
["custom"] = "local encounterID = '1498'\nlocal ID          = 'Phase2'\n\nlocal name = Merfin:L('Phase 2')\n\nlocal options = {\n    warningText = string.format(\"@cffe3e3e3» %s «@r\", name:upper()),\n    ttsLine = name\n}\n\naura_env.SendWarning = function()\n    local warning = {\n        ID      = ID,\n        name    = 'Phase 2',\n        noCount = true,\n    }\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, warning, options)\nend",
["do_custom"] = true,
},
