0.54117649793625,
1,
1,
},
["do_glow"] = false,
["glow_XOffset"] = 1,
["custom"] = "-- Author: 露露緹婭@Bilibili\n-- 获取当前触发的技能ID\nlocal spellId = aura_env.state and aura_env.state.spellId\nif not spellId or not aura_env.RurutiaSoundMap[spellId] then\n    return\nend\n\nlocal currentTime = GetTime()\n\n-- 检查冷却时间\nif aura_env.cooldownConfig[spellId] then\n    local cooldownTime = aura_env.cooldownConfig[spellId]\n    local lastTime = aura_env.lastPlayTime[spellId] or 0\n    if currentTime - lastTime < cooldownTime then\n        return\n    end\n    aura_env.lastPlayTime[spellId] = currentTime\nend\n\n-- 播放音效\nlocal soundFile = aura_env.RurutiaSoundMap[spellId]\nif not soundFile:match(\"^Interface\\\\\") then\n    soundFile = aura_env.RurutiaFilePath .. soundFile\nend\nPlaySoundFile(soundFile, \"Master\")",
["do_sound"] = false,
["glow_frame_type"] = "UNITFRAME",
["use_glow_color"] = true,
["do_custom"] = true,
["sound_path"] = "",
},
["finish"] = {
["stop_sound"] = false,
["hide_all_glows"] = true,
},
["init"] = {
["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\naura_env.RurutiaFilePath = \"Interface\\\\Addons\\\\SharedMedia_Rurutia\\\\Rurutia\\\\\"\n\naura_env.cooldownConfig = {\n    --[61295] = 10, --激流，测试用\n}\n\nif not aura_env.lastPlayTime then\n    aura_env.lastPlayTime = {}\nend\n\naura_env.RurutiaSoundMap = {\n    --魔古山宝库\n    [116990] = \"【露露】目标是你.ogg\", -- 专注打击\n    [116281] = \"【露露】定身.ogg\", -- 蓝晶冲击\n    [130774] = \"【露露】快躲开.ogg\", -- 紫晶之池\n    [116278] = \"【露露】打小怪.ogg\", --灵魂撕裂\n    [116161] = \"【露露】刷满血量.ogg\", --灵魂越界\n    \n    --BUFF\n    --[61295] = \"【露露】安全安全.ogg\", -- 激流，测试用\n    [116541] = \"【露露】获得增益.ogg\", -- 充能之瓦\n    [115911] = \"【露露】获得增益.ogg\", -- 反射罩\n    [115856] = \"【露露】安全安全.ogg\", -- 废灵壁垒\n    [117549] = \"【露露】获得增益.ogg\", -- 灵魂支配\n    [117543] = \"【露露】回蓝.ogg\", --灵魂支配\n    [132422] = \"【露露】Bingo.ogg\", --机不可失\n}",
},
},
["outline"] = "OUTLINE",
