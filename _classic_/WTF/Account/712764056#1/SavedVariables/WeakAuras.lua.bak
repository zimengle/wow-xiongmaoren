["customText"] = "-- Author: 露露緹婭@Bilibili\nfunction()\n    local default_text = \"\"\n    local spellId = aura_env.state and aura_env.state.spellId\n    local RurutiaSpellName = (spellId and GetSpellInfo(spellId)) or default_text\n    \n    local RurutiaSpellIDs = {\n        -- 测试用\n        -- [61295] = \"回血\", -- 激流\n        \n        -- 其他\n        [94794] = \"漏油\",\n        \n        -- 永春台\n        [120629] = \"畏惧\",\n        \n        -- 恐惧之心\n        [126122] = \"腐蚀力场\",\n    }\n    return spellId and RurutiaSpellIDs[spellId] or RurutiaSpellName\nend",
