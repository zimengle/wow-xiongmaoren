["displayText_format_p_time_format"] = 2,
["displayText_format_p_time_precision"] = 1,
["sparkHeight"] = 30,
["customTextUpdate"] = "event",
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(a, e, warning, counter)\n    if e == 'WA_MERFIN_BOSS_WARNING' and warning == 'SummonSpirit' then\n        a[''] = {\n            show = true,\n            changed = true,\n            progressType = 'timed',\n            duration = 4,\n            expirationTime = 4 + GetTime(),\n            autoHide = true,\n        }\n        return true\n    end\nend",
