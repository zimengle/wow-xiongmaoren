["start"] = {
},
["init"] = {
["custom"] = "aura_env.GetUnitCreatureId = function(unitID)\n    if not UnitExists(unitID) then return 0 end\n    local unitGUID = UnitGUID(unitID)\n    return Merfin.GetNPCIDFromGUID(unitGUID)\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "timed",
["spellIds"] = {
},
["custom"] = "function(e)\n    if e == 'ENCOUNTER_START' then\n        if WeakAuras.InstanceType() == 'ten' or WeakAuras.InstanceDifficulty() == 'lfr' then\n            WeakAuras.timer:ScheduleTimer(WeakAuras.ScanEvents, 1, 'ENCOUNTER_START_DELAYED')\n        end\n    elseif e == 'ENCOUNTER_START_DELAYED' then\n        local units = { 'boss1', 'boss2', 'boss3', 'boss4' }\n        for _, bossID in ipairs(units) do\n            if UnitExists(bossID) then\n                local npcID = aura_env.GetUnitCreatureId(bossID)\n                WeakAuras.ScanEvents('ENCOUNTER_ENGAGE', npcID)\n            end\n        end\n    end\nend",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["custom_type"] = "event",
