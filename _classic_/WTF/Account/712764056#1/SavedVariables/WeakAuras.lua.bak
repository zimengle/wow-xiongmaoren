["preferToUpdate"] = false,
["customText"] = "function()\n    return Merfin:L('Entrance')\nend",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["url"] = "https://wago.io/progress_t14/132",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.sectorN = 1",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["customVariables"] = "{\n    active = {\n        display = 'During Spray',\n        type    = 'bool',\n    },\n    \n    isNext = {\n        display = 'Is Sector Next',\n        type    = 'bool',\n    },\n    \n    color = {\n        display = 'Color',\n        type    = 'select',\n        values  = {\n            ['R'] = 'Red',\n            ['O'] = 'Orange',\n            ['Y'] = 'Yellow',\n            ['G'] = 'Green',\n        }\n    }\n}",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(states, event, ...)\n    if event == 'SPRAY_SECTOR' then\n        local active, sectorN, color, isNext = ...\n        \n        if sectorN == aura_env.sectorN then\n            states:Update('', { sectorN = sectorN, color = color, active = active, isNext = isNext })\n        end\n        \n    elseif event == 'SPRAY_SECTOR_HIDE' then\n        states:Remove('')\n    end\nend",
["spellIds"] = {
},
["events"] = "SPRAY_SECTOR, SPRAY_SECTOR_HIDE",
["check"] = "event",
["names"] = {
},
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["custom_hide"] = "custom",
["type"] = "custom",
["events"] = "WA_BEST_SECTOR",
["custom_type"] = "event",
["check"] = "event",
["custom"] = "function(_, sector)\n    return sector == aura_env.sectorN\nend",
["debuffType"] = "HELPFUL",
["unit"] = "player",
},
["untrigger"] = {
["custom"] = "function(_, sector)\n    return sector ~= aura_env.sectorN\nend",
},
},
["disjunctive"] = "custom",
