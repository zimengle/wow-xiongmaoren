["通用-00-纯语音系统（分职责播报，恐惧+永春+魔古）"] = {
["outline"] = "OUTLINE",
["wagoID"] = "H5gs0vTam",
["color"] = {
1,
1,
1,
1,
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://afdian.com/a/Rurutia",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\naura_env.RurutiaFileLocation = \"Interface\\\\AddOns\\\\SharedMedia_Rurutia\\\\Rurutia\"\naura_env.lastPlayed = aura_env.lastPlayed or {}\naura_env.RurutiaDefaultCD = 3 -- 默认冷却时间\nprint(\"露露的T14团本语音 v1.1.1 已加载。\")\n\naura_env.spellMap = {\n    -- ===== 魔古山宝库 =====\n    -- 02-受诅者魔封\n    [116784] = {\"SAAP\", \"【露露】远离人群.ogg\"}, -- 野性火花  \n    [116417] = { -- 奥术回响    \n        {\"SAA\", \"【露露】注意点名.ogg\"},\n        {\"SAAP\", \"【露露】远离人群.ogg\"},\n    },\n    [116374] = { -- 闪电充能 \n        {\"SAA\", \"【露露】驱散魔法.ogg\"},\n        {\"SAAP\", \"【露露】你被点名.ogg\"},\n    },\n    [116018] = {\"SCS\", \"【露露】准备AOE.ogg\"}, -- 震中\n    \n    -- 04-先王之魂\n    [119521] = {\"SCS\", \"【露露】躲开正面.ogg\"}, -- 歼灭\n    [117910] = {\"SCC\", \"【露露】快躲人墙.ogg\"}, -- 侧援指令\n    [117961] = {\"SCS\", \"【露露】注意停手.ogg\"}, -- 密封之盾，牧师大驱/碎甲投掷\n    [118094] = {\"SCS\", \"【露露】躲开正面.ogg\"}, -- 连射\n    [118162] = {\"SCS\", \"【露露】控制BOSS.ogg\"}, -- 盗匪诡计，晕控BOSS\n    [118049] = {\"SCS\", \"【露露】躲圈.ogg\"}, -- 掠夺\n    [117708] = {\"SCS\", \"【露露】准备心控.ogg\"}, -- 癫狂之吼\n    [117697] = {\"SAA\", \"【露露】进攻驱散.ogg\"}, -- 黑暗之盾，进攻驱散\n    [117628] = {\"SCS\", \"【露露】Glass.ogg|CD2\"}, -- 暗影冲击\n    [117833] = {\"SCS\", \"【露露】Sonar.ogg|CD2\"}, -- 疯狂心智\n    \n    -- 05-伊拉贡\n    [118303] = {\"SAA\", \"【露露】风筝小怪.ogg\"}, -- 注视\n    [132222] = { -- 动荡能量\n        {\"SAA\", \"【露露】刷满血量.ogg\"},\n        {\"SAAP\", \"【露露】注意自保.ogg\"},\n    },\n    \n    -- 06-皇帝的意志\n    [116778] = {\"SAAP\", \"【露露】目标是你.ogg\"}, -- 专注防御\n    [116829] = {\"SAAP\", \"【露露】目标是你.ogg\"}, -- 专注能量\n    \n    \n    -- ===== 恐惧之心 =====\n    -- 01-皇家宰相佐尔洛克\n    [122713] = { -- 力与魄\n        {\"SCS\", \"【露露】准备AOE.ogg\"},\n        {\"SCC\", \"【露露】注意群疗.ogg\"},\n    },\n    [127834] = { -- 音波衰减\n        {\"SCS\", \"【露露】叮咚.ogg\"},\n        {\"SCC\", \"【露露】躲避弹幕.ogg\"},\n    },\n    [122761] = { -- 吐气\n        {\"SCS\", \"【露露】准备挡线.ogg\"},\n        {\"SCC\", \"【露露】快挡线.ogg|T\"},\n        {\"SCC\", \"【露露】注意刷坦.ogg|H\"},\n    },\n    [122740] = { -- 策反\n        {\"SCS\", \"【露露】注意心控.ogg\"},\n        {\"SAA\", \"【露露】打队友.ogg\"},\n        {\"SAAP\", \"【露露】你被心控.ogg\"},\n    },\n    -- 02-刀锋领主塔亚克\n    [122706] = { -- 噪音取消\n        {\"SAA\", \"【露露】快进罩子.ogg|CD22\"},\n        {\"SAAP\", \"【露露】安全安全.ogg\"},\n    },\n    [125310] = { -- 乱刃风暴\n        {\"SCS\", \"【露露】远离BOSS.ogg\"},\n        {\"SCC\", \"【露露】保持移动.ogg\"},\n    },\n    [123180] = { -- 疾风步\n        {\"SAA\", \"【露露】注意点名.ogg\"},\n        {\"SAAP\", \"【露露】你被点名.ogg\"},\n    },\n    --[123017] = {\"SAAP\", \"【露露】你被点名.ogg\"}, -- 无影击，点名，LOG事件缺失，已独立制作\n    \n    -- 03-加拉隆\n    [122774] = {\"SCS\", \"【露露】准备AOE.ogg\"}, -- 重碾\n    \n    -- 04-风领主梅尔加拉克\n    [122406] = { -- 刃雨\n        {\"SCS\", \"【露露】准备AOE.ogg\"},\n        {\"SCC\", \"【露露】注意群疗.ogg\"},\n    },\n    [125873] = {\"SAA\", \"【露露】易伤阶段.ogg\"}, -- 鲁莽\n    [121896] = {\"SCS\", \"【露露】躲避飞刀.ogg\"}, -- 回旋之刃\n    [122064] = {\"SAAP\", \"【露露】保持移动.ogg\"}, -- 腐蚀树脂\n    --[123963] = {\"SAAP\", \"【露露】注意自保.ogg\"}, -- 库尔提克打击，点名，LOG事件缺失，已独立制作\n    --[131813] = {\"SCS\", \"【露露】小心脚下.ogg\"}, -- 风爆弹，有召唤事件，差分点名，已独立制作\n    \n    -- 05-琥珀塑形者昂舒克\n    [121994] = {\"SCC\", \"【露露】注意点名.ogg\"}, -- P1琥珀雕刻刀，点名\n    [125502] = { -- P3琥珀信标\n        {\"SAA\", \"【露露】信标点名.ogg\"},\n        {\"SAAP\", \"【露露】远离人群，合并宝珠.ogg\"},\n    },\n    \n    -- 06-大女皇夏柯希尔\n    -- P1\n    [123788] = { -- 恐怖嚎叫，点名\n        {\"SAA\", \"【露露】注意点名.ogg|TD\"},\n        {\"SAA\", \"【露露】注意治疗.ogg|H\"},\n        {\"SAAP\", \"【露露】你被点名.ogg\"},\n    },\n    \n    -- P2\n    [125390] = {\"SAAP\", \"【露露】快跑哟，笨笨被点名啦！.ogg\"}, -- 凝视，追人点名，保持20码风筝\n    [124097] = {\"SAAP\", \"【露露】快集合.ogg\"}, -- 粘稠树脂，点名\n    \n    -- P3\n    [124849] = {\"SCS\", \"【露露】躲开正面.ogg\"}, -- 恐惧吞噬，头前\n    [124845] = {\"SCC\", \"【露露】Sonar.ogg\"}, -- 灾星，6.5秒一次AOE\n    [123845] = { -- 恐惧之心，点名（挡线）\n        {\"SAA\", \"【露露】注意挡线.ogg|T\"}, -- 坦克挡线\n        {\"SAAP\", \"【露露】目标是你.ogg\"}, -- 维持原地等T挡线\n    },\n    [124862] = { -- 死亡幻像，点名（出人群）\n        {\"SAA\", \"【露露】准备恐惧.ogg\"},\n        {\"SAAP\", \"【露露】远离人群.ogg\"},\n    },\n    \n    \n    -- ===== 永春台 =====\n    -- 01-无尽守护者\n    [111850] = { -- 闪电囚笼1，点名出人群\n        {\"SAA\", \"【露露】注意点名.ogg\"},\n        {\"SAAP\", \"【露露】远离人群.ogg\"},\n    },\n    [117436] = { -- 闪电囚笼2，点名解魔法\n        {\"SAA\", \"【露露】驱散魔法.ogg\"},\n        {\"SAAP\", \"【露露】Sonar.ogg\"},\n    },\n    [118312] = {\"SCS\", \"【露露】Glass.ogg|CD2\"}, -- 水箭\n    -- [117187] = {\"SCS\", \"【露露】Sonar.ogg|CD2\"}, -- 闪电箭\n    [117283] = {\"SAA\", \"【露露】进攻驱散.ogg\"}, -- 净化之水\n    \n    -- 02-烛龙\n    [123012] = { -- 暗影恐怖\n        {\"SAA\", \"【露露】驱散魔法.ogg\"},\n        {\"SAAP\", \"【露露】目标是你.ogg\"},\n    },\n    \n    -- 04-惧之煞\n    [119414] = {\"SCC\", \"【露露】注意吐息.ogg\"}, -- 恐惧吐息\n    [119692] = {\"SCS\", \"【露露】注意点名.ogg\"}, -- 不详蔑笑\n    [119593] = {\"SCS\", \"【露露】注意点名.ogg\"}, -- 不详蔑笑\n    [119693] = {\"SCS\", \"【露露】注意点名.ogg\"}, -- 不详蔑笑\n    [129147] = {\"SAAP\", \"【露露】你被点名.ogg\"}, -- 不详蔑笑，点名\n    [119888] = { -- 死亡之花\n        {\"SCS\", \"【露露】快找掩体.ogg\"},\n        {\"SCC\", \"【露露】Sonar.ogg\"},\n    },\n    [119983] = {\"SAAP\", \"【露露】注意自保.ogg\"}, -- 恐惧喷射\n    [120388] = {\"SAAP\", \"【露露】目标是你.ogg\"}, -- 追寻光芒\n    [120629] = { -- 因畏惧而蜷缩\n        {\"SAA\", \"【露露】注意治疗|H.ogg\"},\n        {\"SAA\", \"【露露】注意点名|TD.ogg\"},\n        {\"SAAP\", \"【露露】你被点名.ogg\"},\n    },\n}",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["events"] = "CLEU:SPELL_CAST_START,CLEU:SPELL_CAST_SUCCESS,CLEU:SPELL_AURA_APPLIED,CLEU:SPELL_AURA_REMOVED",
["custom"] = "-- Author: 露露緹婭@Bilibili\nfunction(_, event, _, subEvent, _, sourceGUID, _, sourceFlags, _, destGUID, _, _, _, spellID, _, _, auraType)\n    -- 基础检查\n    if not spellID or not aura_env or not aura_env.spellMap then\n        return\n    end\n    \n    -- 事件类型过滤\n    if subEvent ~= \"SPELL_CAST_START\" and subEvent ~= \"SPELL_CAST_SUCCESS\"\n    and subEvent ~= \"SPELL_AURA_APPLIED\" and subEvent ~= \"SPELL_AURA_REMOVED\" then\n        return\n    end\n    \n    local currentTime = GetTime()\n    local spellConfig = aura_env.spellMap[spellID]\n    if not spellConfig then return end\n    \n    -- 处理单配置和多配置\n    local configs = {}\n    if type(spellConfig[1]) == \"string\" then\n        configs = {spellConfig}\n    else\n        configs = spellConfig\n    end\n    \n    -- 处理所有匹配的配置\n    for _, config in ipairs(configs) do\n        local eventType = config[1]\n        local voiceConfig = config[2]\n        local customCD = config[3]\n        \n        -- 事件匹配检查\n        local matched = false\n        local needHostileCheck = false\n        \n        if eventType == \"SCS\" and subEvent == \"SPELL_CAST_START\" then\n            matched, needHostileCheck = true, true\n        elseif eventType == \"SCC\" and subEvent == \"SPELL_CAST_SUCCESS\" then\n            matched, needHostileCheck = true, true\n        elseif eventType == \"SAAP\" and subEvent == \"SPELL_AURA_APPLIED\" and destGUID == UnitGUID(\"player\") then\n            matched, needHostileCheck = true, false\n        elseif eventType == \"SAA\" and subEvent == \"SPELL_AURA_APPLIED\" then\n            matched, needHostileCheck = true, true\n        elseif eventType == \"SARP\" and subEvent == \"SPELL_AURA_REMOVED\" and destGUID == UnitGUID(\"player\") then\n            matched, needHostileCheck = true, false\n        elseif eventType == \"SAR\" and subEvent == \"SPELL_AURA_REMOVED\" then\n            matched, needHostileCheck = true, false\n        end\n        \n        if matched then\n            -- 敌对性检查\n            local shouldProcess = true\n            if needHostileCheck then\n                if not sourceGUID or not sourceFlags or bit.band(sourceFlags, 0x40) == 0 then\n                    shouldProcess = false\n                end\n            end\n            \n            if shouldProcess then\n                -- 解析语音配置\n                local voice, roleTag, configCD\n                if voiceConfig then\n                    -- 格式1：语音文件|职责|CD数字\n                    voice, roleTag, configCD = voiceConfig:match(\"^(.+)|([THD]+)|CD(%d+)$\")\n                    if voice and roleTag and configCD then\n                        configCD = tonumber(configCD)\n                    else\n                        -- 格式2：语音文件|CD数字\n                        voice, configCD = voiceConfig:match(\"^(.+)|CD(%d+)$\")\n                        if voice and configCD then\n                            configCD = tonumber(configCD)\n                            roleTag = nil\n                        else\n                            -- 格式3：语音文件|职责\n                            voice, roleTag = voiceConfig:match(\"^(.+)|([THD]+)$\")\n                            if voice and roleTag then\n                                configCD = nil\n                            else\n                                -- 格式4：纯语音文件\n                                voice = voiceConfig\n                                roleTag = nil\n                                configCD = nil\n                            end\n                        end\n                    end\n                end\n                \n                if voice then\n                    -- 职责检查\n                    local roleMatched = true\n                    if roleTag then\n                        local playerRole = UnitGroupRolesAssigned and UnitGroupRolesAssigned(\"player\") or \"DAMAGER\"\n                        playerRole = (playerRole == \"TANK\" and \"T\") or (playerRole == \"HEALER\" and \"H\") or \"D\"\n                        if not roleTag:find(playerRole) then\n                            roleMatched = false\n                        end\n                    end\n                    \n                    if roleMatched then\n                        -- 冷却检查\n                        local finalCD = configCD or customCD or (aura_env.RurutiaDefaultCD or 3)\n                        local cooldownKey = spellID .. \"_\" .. eventType .. \"_\" .. (roleTag or \"ALL\")\n                        local canPlay = true\n                        \n                        if aura_env.lastPlayed[cooldownKey] then\n                            local timeSinceLastPlay = currentTime - aura_env.lastPlayed[cooldownKey]\n                            -- 检查冷却间隔\n                            if timeSinceLastPlay < finalCD then\n                                canPlay = false\n                            end\n                        end\n                        \n                        if canPlay then\n                            -- 播放语音\n                            aura_env.lastPlayed[cooldownKey] = currentTime\n                            local soundPath = aura_env.RurutiaFileLocation .. \"\\\\\" .. voice\n                            PlaySoundFile(soundPath, \"Master\")\n                        end\n                    end\n                end\n            end\n        end\n    end\nend",
