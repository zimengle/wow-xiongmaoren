["[DP] [Gara'jal] Crossed Over"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1434'\nlocal ID          = 'CrossedOver'\n\nlocal name, icon = C_Spell.GetSpellName(116161), C_Spell.GetSpellTexture(116161)\n\nlocal options = {\n    warningText = '%icon @cffffff80%name@r » %destName (%count) %icon'\n}\n\naura_env.SendWarning = function(destName)\n    local data = {\n        ID       = ID,\n        count    = aura_env.count,\n        destName = destName,\n        name     = name,\n        icon     = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend\n\naura_env.IsSpam = function(before)\n    local cur = GetTime()\n    if not aura_env.antispam or cur - aura_env.antispam > before then\n        aura_env.antispam = cur\n        return false\n    end\n    return true\nend\n\naura_env.Synch = function(event, destName)\n    WeakAuras.ScanEvents('MERFIN_SYNCH', 'RAID', nil, event, destName) \nend\n\naura_env.LatencyCheck = function()\n    return select(4, GetNetStats()) < 250\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED, CROSSED_OVER_SYNCH",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_, destGUID,_,_,_, spellID = ...\n        \n        if spellID == 116161 or spellID == 116260 then\n            if not aura_env.LatencyCheck() then return end\n            if not destGUID then return end\n            \n            local destName = select(6, GetPlayerInfoByGUID(destGUID))\n            \n            if not destName or destName == '' then \n                return \n            end\n            \n            aura_env.Synch('CROSSED_OVER_SYNCH', destName)\n        end\n        \n    elseif e == 'CROSSED_OVER_SYNCH' then\n        local destName = ...\n        \n        if not destName or destName == '' then \n            return \n        end\n        \n        for _, name in ipairs(aura_env.targets) do\n            if destName == name then\n                return\n            end\n        end\n        \n        table.insert(aura_env.targets, destName)\n        \n        if aura_env.IsSpam(3) then\n            return\n        end\n        \n        C_Timer.After(0.3, function()\n                aura_env.count = aura_env.count + 1\n                \n                local names = {}\n                for _, name in ipairs(aura_env.targets) do\n                    table.insert(names, WA_ClassColorName(name))\n                end\n                \n                local destNames = table.concat(names, ', ')\n                aura_env.SendWarning(destNames)\n                aura_env.targets = {}\n        end)\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.targets = {}\n        aura_env.count = 0\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "\n\n",
},
},
