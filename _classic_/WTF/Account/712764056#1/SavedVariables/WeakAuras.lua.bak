["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, e, warning)\n    if e == 'OPTIONS' then\n        local destName = WA_ClassColorName(WeakAuras.me)\n        local icon = '|T133785:14:14:0:0:64:64:4:60:4:60|t'\n        \n        local newState = {\n            progressType   = 'timed',\n            duration       = 3,\n            expirationTime = 3 + GetTime(),\n            autoHide       = true,\n            displayText    = string.format(Merfin:L('%s Huge Tariffs » %s %s'), icon, destName, icon),\n        }\n        \n        states:Update('', newState)\n    end\n    \n    if e == 'MERFIN_WARNING_SHOW' and warning.config.littleWarning then\n        local newState = {\n            progressType   = 'timed',\n            duration       = 4,\n            expirationTime = 4 + GetTime(),\n            autoHide       = true,\n            displayText    = warning.displayText,\n        }\n        \n        local stateName = warning.ID\n        states:Update(stateName, newState)\n    end\nend",
["events"] = "MERFIN_WARNING_SHOW",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
