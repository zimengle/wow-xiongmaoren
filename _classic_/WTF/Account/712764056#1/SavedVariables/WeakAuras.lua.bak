["[DP] [Mel'jarak] Kor'thik Strike"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1498'\nlocal ID          = 'KorthikStrike'\n\nlocal name, icon = C_Spell.GetSpellName(123963), C_Spell.GetSpellTexture(123963)\n\nlocal options = {\n    warningText = \"%icon @cffff8b17%name@r » %destName %icon\",\n}\n\naura_env.StopCD = function()\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, {\n            ID = ID\n    })\nend\n\naura_env.StartCD = function(duration, autoHide)\n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, {\n            show           = true,\n            autoHide       = autoHide,\n            duration       = duration,\n            expirationTime = duration + GetTime(),\n            ID             = ID,\n            name           = name,\n            icon           = icon,\n            count          = aura_env.count,\n    }, options)\nend\n\naura_env.SendWarning = function(destName)\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID       = ID,\n            name     = name,\n            icon     = icon,\n            count    = aura_env.count,\n            destName = WA_ClassColorName(destName)\n    }, options)\nend\n\naura_env.IsSpam = function(before)\n    local cur = GetTime()\n    if not aura_env.antispam or cur - aura_env.antispam > before then\n        aura_env.antispam = cur\n        return false\n    end\n    return true\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, UNIT_SPELLCAST_SUCCEEDED:boss1:boss2:boss3:boss4, UNIT_DIED, KORTHIK_STRIKE_TARGET",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'UNIT_SPELLCAST_SUCCEEDED' then\n        local unitID,_, spellID = ...\n        \n        if spellID == 123963 and not aura_env.IsSpam(2) then\n            aura_env.count = aura_env.count + 1\n            if not aura_env.firstStrikeDone then\n                aura_env.firstStrikeDone = true\n                aura_env.StartCD(32)\n            else\n                aura_env.StartCD(50)\n            end\n        end\n        \n    elseif e == 'KORTHIK_STRIKE_TARGET' then\n        local destName = ...\n        if destName ~= WeakAuras.me then\n            aura_env.SendWarning(destName)\n        end\n        \n    elseif e == 'UNIT_DIED' then\n        local npcID = ...\n        \n        if npcID == 62402 then\n            if aura_env.isHeroic then\n                aura_env.StartCD(79)\n            else\n                aura_env.StopCD()\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.isHeroic = WeakAuras.InstanceDifficulty() == 'heroic'\n        aura_env.count = 0\n        aura_env.firstStrikeDone = false\n        aura_env.StartCD(19)\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "\n\n",
},
},
["disjunctive"] = "any",
