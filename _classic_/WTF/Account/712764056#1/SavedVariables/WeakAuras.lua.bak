["[DP] [Trash] Overwhelming Assault (Tak'thok)"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = 'Trash'\nlocal ID          = 'OverwhelmingAssault'\n\nlocal name, icon = C_Spell.GetSpellName(123474), C_Spell.GetSpellTexture(123474)\n\nlocal options = {\n    warningText = \"%icon @cffff8b17%name@r » %destName (%amount) %icon\",\n}\n\naura_env.StopCD = function(destGUID)\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, {\n            ID   = ID,\n            GUID = destGUID\n    })\nend\n\naura_env.StartCD = function(duration, GUID)\n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, {\n            show           = true,\n            autoHide       = true,\n            duration       = duration,\n            expirationTime = duration + GetTime(),\n            ID             = ID,\n            noCount        = true,\n            GUID           = GUID,\n            sourceName     = '|cff9d9d9dTakthok|r',\n            name           = name,\n            icon           = icon\n    }, options)\nend\n\naura_env.SendWarning = function(destName, amount)\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID       = ID,\n            count    = aura_env.count,\n            noCount  = true,\n            destName = WA_ClassColorName(destName),\n            amount   = amount,\n            name     = name,\n            icon     = icon\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "CLEU:SPELL_CAST_SUCCESS:SPELL_AURA_APPLIED:SPELL_AURA_APPLIED_DOSE:UNIT_DIED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_, sourceGUID,_,_,_, destGUID, destName,_,_, spellID, _,_,_, amount = ...\n        \n        if subEvent == 'SPELL_CAST_SUCCESS' then\n            if spellID == 123474 and Merfin.GetNPCIDFromGUID(sourceGUID) == 64339 then\n                aura_env.StartCD(10, sourceGUID)\n            end\n        elseif subEvent == 'UNIT_DIED' then\n            if Merfin.GetNPCIDFromGUID(destGUID) == 64339 then\n                aura_env.StopCD(destGUID)\n            end\n        elseif subEvent == 'SPELL_AURA_APPLIED' or subEvent == 'SPELL_AURA_APPLIED_DOSE' then\n            if spellID == 123474 and Merfin.GetNPCIDFromGUID(sourceGUID) == 64339 then\n                if destGUID ~= WeakAuras.myGUID then\n                    aura_env.SendWarning(destName, amount or 1)\n                end\n            end\n        end\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "\n\n",
},
},
["disjunctive"] = "any",
