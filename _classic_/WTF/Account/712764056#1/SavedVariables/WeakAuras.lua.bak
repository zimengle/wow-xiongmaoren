["duration"] = "",
["event"] = "Health",
["unit"] = "player",
["customDuration"] = "function()\n    local duration = aura_env.timer or 0\n    return duration, duration + GetTime()\nend",
["custom"] = "function(states, e, id,_,_,_, success)\n    if e == 'ENCOUNTER_END' and id == 1409 and success == 1 then\n        Merfin.TsulongArrivalTime = GetTime() + 40\n        states:Update('', { \n                progressType = 'timed', \n                duration = 40, \n                expirationTime = 40 + GetTime(), \n                autoHide = true\n        })\n    elseif e == 'STATUS' and Merfin.TsulongArrivalTime then\n        local tilExpire = Merfin.TsulongArrivalTime - GetTime()\n        if tilExpire > 0 then\n            states:Update('', { \n                    progressType = 'timed', \n                    duration = 40, \n                    expirationTime = Merfin.TsulongArrivalTime, \n                    autoHide = true\n            })\n        end\n    end\nend",
["spellIds"] = {
