["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1434'\nlocal ID          = 'Frenzy'\n\nlocal name, icon = C_Spell.GetSpellName(117752), C_Spell.GetSpellTexture(117752)\n\nlocal options = {\n    warningText = '@cffff4040%upper:name@r'\n}\n\naura_env.SendWarning = function(amount)\n    local data = {\n            ID    = ID,\n            count = aura_env.count,\n            name  = name,\n            icon  = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_APPLIED_DOSE",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if spellID == 117752 then\n            aura_env.count = aura_env.count + 1\n            aura_env.SendWarning()\n        end\n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
