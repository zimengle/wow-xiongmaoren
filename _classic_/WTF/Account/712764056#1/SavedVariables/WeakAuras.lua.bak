["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.GetNPCIDFromGUID = function(GUID)\n    local guidType, _, _, _, _, id = strsplit(\"-\", GUID or \"\")\n    if guidType == \"Creature\" or guidType == \"Vehicle\" or guidType == \"Pet\" then\n        return tonumber(id) or 0\n    end\n    return 0\nend\n\naura_env.guids = {}\n\naura_env.tracked = {\n    -- Heart of Fear\n    [64902] = true, -- Kor'thik Fleshrender (after Mel'jarak)\n    [63569] = true, -- Amber Searsting\n    [63568] = true, -- Amber-Ridden Mushan\n    [64453] = true, -- Set'thik Windblade\n    [64458] = true, -- Kor'thik Warsinger\n    [64454] = true, -- Zar'thik Augurer\n    \n    -- Terrace of Endless Spring\n    [66100] = true, -- Apparition of Terror\n    [64368] = true, -- Apparition of Fear\n}",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["duration"] = "25",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "custom",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["subeventPrefix"] = "SPELL",
["events"] = "NAME_PLATE_UNIT_ADDED, UNIT_THREAT_LIST_UPDATE",
["names"] = {
},
["custom"] = "function(e, ...)\n    if e == 'UNIT_THREAT_LIST_UPDATE' then\n        local nameplateID = ...\n        local unitGUID = UnitGUID(nameplateID)\n        local npcID = aura_env.GetNPCIDFromGUID(unitGUID)\n        \n        if npcID and aura_env.tracked[npcID] and aura_env.guids[unitGUID] then\n            local inCombat = UnitAffectingCombat(nameplateID)\n            if inCombat then\n                WeakAuras.ScanEvents('NAME_PLATE_ENTERED_COMBAT', nameplateID, unitGUID, npcID)\n            end\n        end\n        \n    elseif e == 'NAME_PLATE_UNIT_ADDED' then\n        local nameplateID = ...\n        local unitGUID = UnitGUID(nameplateID)\n        local npcID = aura_env.GetNPCIDFromGUID(unitGUID)\n        \n        if npcID and aura_env.tracked[npcID] then\n            local inCombat = UnitAffectingCombat(nameplateID)\n            if not inCombat then\n                aura_env.guids[unitGUID] = true\n            else\n                aura_env.guids[unitGUID] = nil\n            end\n        end\n    end\nend",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["disjunctive"] = "any",
["customTriggerLogic"] = "",
["activeTriggerMode"] = 1,
},
