["custom"] = "function(states, e, _, warning)\n    if e == 'OPTIONS' then\n        states:Update('', {count = 2, destName = WA_ClassColorName(WeakAuras.me)})\n    end\n    \n    if e == 'MERFIN_WARNING' and warning.ID == 'OminousCackle' then\n        states:Update('', {\n                progressType   = 'timed',\n                duration       = 1,\n                expirationTime = 1 + GetTime(),\n                autoHide       = true,\n                count          = warning.count\n        })\n    end\nend",
