["custom"] = "function(states, event, bossID)\n    if event  == 'ATTEN_CAST_START' then\n        states:Update(bossID, {\n                progressType   = 'timed',\n                duration       = 2,\n                expirationTime = 2 + GetTime(),\n                autoHide       = true,\n                sourceName     = bossID == 'BOSS' and aura_env.loc.boss or aura_env.loc.echo,\n                isInversed     = true\n        })\n    elseif event == 'ATTEN_CAST_SUCCESS' then\n        states:Update(bossID, {\n                progressType   = 'timed',\n                duration       = 9,\n                expirationTime = 9 + GetTime(),\n                autoHide       = true,\n                sourceName     = bossID == 'BOSS' and aura_env.loc.boss or aura_env.loc.echo,\n                isInversed     = false\n        })\n    elseif event == 'ATTEN_CAST_FINISH' then\n        states:Remove('')\n    end\nend",
