["[DP] [MP] Trash"] = {
["outline"] = "OUTLINE",
["wagoID"] = "zylhUqLd0",
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/mop_dungeons/73",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local tonumber, strsplit, pairs = tonumber, strsplit, pairs\nlocal UnitExists, UnitGUID = UnitExists, UnitGUID\nlocal GetTime = GetTime\n\nlocal L = GetLocale()\n\nlocal encounterID = 'TrashMP'\n\nlocal BuildSpellData = function(id, role)\n    return { \n        name = C_Spell.GetSpellName(id), \n        icon = C_Spell.GetSpellTexture(id),\n        roleIcon = role,\n    }\nend\nlocal cooldownData = {\n    --['Resin'] = BuildSpellData(121447),\n}\n\nlocal warningSounds = {\n    ['MoltenBarrage'] = 'minorAlert1',\n}\n\nlocal CREATURE_ID = { \n}\n\nlocal PRE_WARNING = {\n}\n\nlocal GetGuidCreatureId = function(GUID)\n    local guidType, _, playerdbID, _, _, cid, _ = strsplit(\"-\", GUID or \"\")\n    if guidType and (guidType == \"Creature\" or guidType == \"Vehicle\" or guidType == \"Pet\") then\n        return tonumber(cid)\n    end\n    if guidType and (guidType == \"Player\" or guidType == \"Item\") then\n        return tonumber(playerdbID)\n    end\n    return 0\nend\n\nlocal GetUnitCreatureId = function(unitId)\n    if not UnitExists(unitId) then return 0 end\n    local unitGUID = UnitGUID(unitId)\n    return GetGuidCreatureId(unitGUID)\nend\n\naura_env.IsGUID = function(sourceGUID, creature)\n    local creatureId = CREATURE_ID[creature]\n    if not creatureId then  return false end\n    local npcId = aura_env.guidCache[sourceGUID] or GetGuidCreatureId(sourceGUID)\n    return npcId == creatureId\nend\n\naura_env.ManageCounter = function(action, mechanicName, value)\n    if action == \"increase\" then\n        aura_env.count[mechanicName] = (aura_env.count[mechanicName] or 0) + 1\n        return aura_env.count[mechanicName]\n    elseif action == \"get\" then\n        return aura_env.count[mechanicName] or 0\n    elseif action == \"set\" then\n        aura_env.count[mechanicName] = value\n        return aura_env.count[mechanicName]\n    else\n        --print(\"Unknown action: \" .. tostring(action))\n    end\nend\n\naura_env.Antispam = function(id, before)\n    local cur = GetTime()\n    if not aura_env.antispams[id] \n    or cur - aura_env.antispams[id] > before then\n        aura_env.antispams[id] = cur\n        return true\n    end\n    return false\nend\n\naura_env.WipeSchedulers = function()\n    if not aura_env.schedulers then return end\n    for schedulerName, scheduler in pairs(aura_env.schedulers) do\n        WeakAuras.timer:CancelTimer(scheduler)\n    end\nend\n\naura_env.ClearCache = function()\n    aura_env.IsHeroic = WeakAuras.InstanceDifficulty() == 'heroic'\n    \n    aura_env.WipeSchedulers()\n    \n    -- Clear caches and counters\n    aura_env.guidCache = {}\n    aura_env.count = {}\n    aura_env.predict = {}\n    aura_env.schedulers = {}\n    aura_env.antispams = {}\nend\n\naura_env.ScheduleEvent = function(id, after, ...)\n    aura_env.schedulers = aura_env.schedulers or {}\n    \n    if aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n    end\n    \n    aura_env.schedulers[id] = WeakAuras.timer:ScheduleTimer(\n        WeakAuras.ScanEvents,\n        after,\n        'WA_MERFIN_DUNGEON_SCHEDULED',\n        id,\n        ...\n    )\nend\n\naura_env.SchedulePrewarning = function(id, duration)\n    aura_env.schedulers = aura_env.schedulers or {}\n    \n    if aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n        WeakAuras.ScanEvents('WA_MERFIN_BOSS_PRE_WARNING', 'HIDE', id)\n    end\n    \n    aura_env.schedulers[id] = WeakAuras.timer:ScheduleTimer(\n        WeakAuras.ScanEvents,\n        duration - 5,\n        'WA_MERFIN_BOSS_PRE_WARNING',\n        'SHOW',\n        id\n    )\nend\n\naura_env.StopCD = function(id, GUID)\n    aura_env.predict[id] = nil\n    \n    if PRE_WARNING[id] and aura_env.schedulers[id] then\n        WeakAuras.timer:CancelTimer(aura_env.schedulers[id])\n        WeakAuras.ScanEvents('WA_MERFIN_BOSS_PRE_WARNING', 'HIDE', id)\n    end\n    \n    local data = cooldownData[id]\n    if not data then return end\n    \n    local cooldown = {\n        id = id,\n        GUID = GUID,\n    }\n    \n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD_HIDE', encounterID, cooldown)\nend\n\naura_env.StartCD = function(id, duration, isIncrease, autoHide, GUID)\n    local count = aura_env.ManageCounter(isIncrease and 'increase' or 'get', id)\n    aura_env.predict[id] = duration + GetTime()\n    \n    if PRE_WARNING[id] then aura_env.SchedulePrewarning(id, duration) end\n    \n    local data = cooldownData[id]\n    if not data then return end\n    \n    local cooldown  = {\n        show = true,\n        autoHide = autoHide,\n        duration = duration,\n        expirationTime = duration + GetTime(),\n        name = data.name,\n        id = id,\n        GUID = GUID,\n        icon = data.icon,\n        count = count,\n        roleIcon = data.roleIcon,\n        special = data.special,\n    }\n    \n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_CD', encounterID, cooldown)\nend\n\naura_env.Warning = function(warning, ...)\n    WeakAuras.ScanEvents('WA_MERFIN_BOSS_WARNING', warning, ...)\n    local sound = warningSounds[warning]\n    if sound then aura_env.PlaySound(sound) end\nend\n\naura_env.TTS = function(text, voiceID)\n    local voiceID = voiceID or 2\n    WeakAuras.ScanEvents('WA_MERFIN_DUNGEON_TTS', text, voiceID)\nend\n\naura_env.PlaySound = function(...)\n    WeakAuras.ScanEvents('WA_MERFIN_DUNGEON_SOUND', ...)\nend\n\naura_env.Chat = function(text, chatType)\n    WeakAuras.ScanEvents('WA_MERFIN_DUNGEON_CHAT', text, chatType)\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "status",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(e, schedEvent, subEvent, USSspellID, sourceGUID, sourceName, _, _, destGUID, destName, _, _, spellID, spellName, _, extraSpellID, amount)\n    \n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        if subEvent == 'SPELL_AURA_APPLIED' then\n            if spellID == 121182 and aura_env.Antispam(spellID, 2) then\n                aura_env.Warning('MoltenBarrage')\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.ClearCache()\n        \n    elseif e == 'STATUS' then\n        aura_env.ClearCache()\n        \n    elseif e == 'OPTIONS' and not WeakAuras.IsAuraLoaded(aura_env.id) then\n        aura_env.WipeSchedulers()\n    end\nend",
