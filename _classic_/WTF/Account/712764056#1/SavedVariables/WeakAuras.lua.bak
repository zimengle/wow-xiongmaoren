["[Widget] [Sha] Dread Spray Uptime"] = {
["user_y"] = 0,
["exrtLastSender"] = "Jfkx-ClassicBetaPvE",
["wagoID"] = "1qyg9npGm",
["parent"] = "[Widget] Sha Dread Spray Sectors 禁用",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["foregroundColor"] = {
1,
1,
0.501960813999176,
1,
},
["desaturateBackground"] = false,
["foregroundTexture"] = "Interface\\AddOns\\MerfinPlus\\Media\\textures\\Ring_5px.tga",
["user_x"] = 0,
["sameTexture"] = true,
["url"] = "https://wago.io/progress_t14/132",
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["customVariables"] = "{\n    active = {\n        display = 'During Spray',\n        type    = 'bool',\n    },\n}",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(states, event, ...)\n    if event == 'DREAD_SPRAY' then\n        local active, bowMan, shotN = ...\n        if not bowMan then return end\n        if not active then\n            states:Remove('')\n        else\n            states:Update('', {\n                    progressType = 'static',\n                    value        = shotN,\n                    total        = 16,\n            })\n        end\n        \n    elseif event == 'LEAVE_PLATFORM' then\n        states:Remove('')\n        \n    elseif event == 'SPRAY_SECTOR_HIDE' then\n        states:Remove('')\n        \n    elseif event == 'OPTIONS' then\n        states:Update('', {\n                progressType = 'static',\n                value        = 7,\n                total        = 16,\n        })\n    end\nend",
["spellIds"] = {
},
["events"] = "DREAD_SPRAY, LEAVE_PLATFORM, SPRAY_SECTOR_HIDE",
["check"] = "event",
["names"] = {
},
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(states, e, ...)\n    if e == 'MERFIN_CD_HIDE' then\n        local encounterID, cooldown = ...\n        \n        if cooldown.ID ~= 'DreadSpray' then return end\n        local stateName = encounterID .. cooldown.ID .. (cooldown.GUID or '')\n        states:Remove(stateName)\n        \n    elseif e == 'MERFIN_CD_SHOW_WIDGET' then\n        local encounterID, cooldown = ...\n        \n        if cooldown.ID ~= 'DreadSpray' then return end\n        local stateName = encounterID .. cooldown.ID  .. (cooldown.GUID or '')\n        \n        local newState = {\n            progressType   = 'timed',\n            duration       = cooldown.duration,\n            expirationTime = cooldown.expirationTime,\n            autoHide       = cooldown.autoHide,\n        }\n        \n        states:Update(stateName, newState)\n    end\nend",
["custom_type"] = "stateupdate",
["check"] = "event",
["events"] = "MERFIN_CD_SHOW_WIDGET, MERFIN_CD_HIDE",
["subeventPrefix"] = "SPELL",
["customVariables"] = "{\n    expirationTime = true\n}",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
["custom_type"] = "stateupdate",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(states, event, ...)\n    if event == 'DREAD_SPRAY' then\n        local active, bowMan, shotN = ...\n        if not (bowMan and shotN) then return end\n        \n        local pattern = aura_env.patternSide[bowMan]\n        local bestMatch = -1\n        \n        for k in pairs(aura_env.bestSector[bowMan]) do\n            if k <= shotN and k > bestMatch then\n                bestMatch = k\n            end\n        end\n        \n        local ttsLine = ''\n        local msg = ''\n        \n        if bowMan == 61038 then -- South\n            if shotN == 0 then\n                ttsLine = 'Start in 1' \n                msg = Merfin:L(ttsLine)\n            elseif shotN == 4 then\n                ttsLine = 'Right'\n                msg = Merfin:L(ttsLine) .. ' >'\n            end\n            \n        elseif bowMan == 61042 then -- Middle\n            if shotN == 0 then\n                ttsLine = 'Start in 3'\n                msg = Merfin:L(ttsLine)\n            elseif shotN == 2 or shotN == 9 then\n                ttsLine = 'Left'\n                msg = '< ' .. Merfin:L(ttsLine)\n            end\n            \n        elseif bowMan == 61046 then -- North\n            if shotN == 0 then\n                ttsLine = 'Start in 4'\n                msg = Merfin:L(ttsLine)\n            elseif shotN == 8 or shotN == 10 then\n                ttsLine = 'Right'\n                msg = Merfin:L(ttsLine) .. ' >>'\n            end\n        end\n        \n        if ttsLine ~= '' then\n            if not ttsLine:find('Start') \n            or not aura_env.lastTTS or aura_env.lastTTS ~= ttsLine then\n                WeakAuras.ScanEvents('MERFIN_TTS', Merfin:L(ttsLine))\n                WeakAuras.ScanEvents('MERFIN_SEND_CHAT_MESSAGE', msg)\n            end\n            aura_env.lastTTS = ttsLine\n        end\n        \n        if bestMatch >= 0 then\n            local bestSector = aura_env.bestSector[bowMan][bestMatch]\n            WeakAuras.ScanEvents('WA_BEST_SECTOR', bestSector)\n        end\n        \n        states:Update('', {\n                side         = aura_env.bowManSide[bowMan],\n                nextMove     = pattern,\n        })\n        \n    elseif event == 'LEAVE_PLATFORM' then\n        states:Remove('')\n        \n    elseif event == 'SPRAY_SECTOR_HIDE' then\n        states:Remove('')\n        \n    elseif event == 'OPTIONS' then\n        states:Update('', {\n                progressType = 'static',\n                value        = 7,\n                total        = 16,\n                active       = true,\n                side         = aura_env.bowManSide[61038],\n                nextMove     = aura_env.patternSide[61038],\n        })\n    end\nend",
["events"] = "DREAD_SPRAY, LEAVE_PLATFORM, SPRAY_SECTOR_HIDE",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    active = {\n        display = 'During Spray',\n        type    = 'bool',\n    },\n}",
["custom_hide"] = "timed",
},
