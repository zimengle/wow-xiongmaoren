["op"] = "FRAME_UPDATE",
["value"] = "function()\n    -- Play Sound\n    if WeakAuras.IsOptionsOpen() then return end\n    if not Merfin or not Merfin.PlaySound then return end\n    if not aura_env.state then return end\n    \n    local now = GetTime()\n    if now - (aura_env.lastUpdate or 0) <= 1 then return end\n    \n    aura_env.lastUpdate = now\n    \n    local remainingSeconds = math.ceil(aura_env.state.expirationTime - now)\n    if remainingSeconds <= 0 then return end\n    \n    local language = Merfin.L\n    local voiceActor = (language == 'ruRU') and 'Fondago' or 'Sally'\n    \n    Merfin.PlaySound(voiceActor .. ' - ' .. tostring(remainingSeconds))\nend",
