{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["events"] = "MERFIN_WARNING",
["custom"] = "function(states, e, _, warning)\n    if e == 'OPTIONS' then\n        states:Update('', {count = 2})\n    end\n    \n    if e == 'MERFIN_WARNING' and warning.ID == 'ImplacableStrike' then\n        states:Update('', {\n                progressType   = 'timed',\n                duration       = 3.5,\n                expirationTime = 3.5 + GetTime(),\n                autoHide       = true,\n                count          = warning.count\n        })\n    end\nend",
["custom_type"] = "stateupdate",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
