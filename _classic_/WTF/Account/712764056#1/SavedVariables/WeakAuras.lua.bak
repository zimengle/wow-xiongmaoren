["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
["custom_type"] = "stateupdate",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(states, event, ...)\n    \n    if event == 'ENCOUNTER_START' then\n        aura_env.targets = {}\n        aura_env.index = nil\n        return\n    end\n    \n    if event == 'PROTECTORS_DISPEL_ORDER' then\n        local order = ...\n        aura_env.index = nil\n        for i, group in ipairs(order) do\n            for _, name in ipairs(group) do\n                if name == aura_env.myName then\n                    aura_env.index = i\n                    break\n                end\n            end\n            if aura_env.index then break end\n        end\n        return\n    end\n    \n    if event == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent, _, _, sourceName, _, _, destGUID, destName, _, _, spellID = ...\n        \n        if subEvent == 'SPELL_AURA_APPLIED' and spellID == 111850 then\n            table.insert(aura_env.targets, destName)\n            \n            if not aura_env.scheduled then\n                aura_env.scheduled = true\n                C_Timer.After(0.3, function()\n                        for i, name in ipairs(aura_env.targets) do\n                            local isMyTarget = aura_env.index and aura_env.index == i\n                            states:Update(name, {\n                                    unit = name,\n                                    order = i,\n                                    myTarget = isMyTarget,\n                                    dispel = false\n                            })\n                        end\n                        aura_env.targets = {}\n                        aura_env.scheduled = false\n                        return true\n                end)\n            end\n            \n        elseif subEvent == 'SPELL_AURA_APPLIED' and spellID == 117436 then\n            local state = states[destName]\n            if state then\n                states:Update(destName, {\n                        dispel = true\n                })\n                return true\n            end\n            \n        elseif subEvent == 'SPELL_AURA_REMOVED' and spellID == 111850 then\n            local state = states[destName]\n            if state and not state.dispel then\n                states:Remove(destName)\n                return true\n            end\n            \n        elseif subEvent == 'SPELL_AURA_REMOVED' and spellID == 117436 then\n            states:Remove(destName)\n            return true\n        end\n    end\nend",
["events"] = "ENCOUNTER_START, PROTECTORS_DISPEL_ORDER, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    myTarget = {\n        display = 'Is My Target',\n        type = 'bool',\n    },\n    \n    dispel = {\n        display = 'Is Dispellable',\n        type = 'bool',\n    }\n}",
["custom_hide"] = "timed",
},
