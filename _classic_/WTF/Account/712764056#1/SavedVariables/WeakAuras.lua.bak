["【全局】露露的插件包 版本号 1001v2"] = {
["outline"] = "OUTLINE",
["authorOptions"] = {
},
["displayText"] = "Rurutia 10.01.2-E MOP 露露緹婭@BiliBili",
["yOffset"] = 16.95238104926216,
