["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_, destGUID, destName,_,_, spellID = ...\n        \n        if spellID == 116525 then\n            aura_env.count = aura_env.count + 1\n            if destGUID ~= WeakAuras.myGUID then\n                aura_env.SendWarning(destName)\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
