["cooldownTextEnabled"] = true,
["useglowColor"] = false,
["desaturate"] = false,
["text1"] = "%s",
["anchorFrameParent"] = false,
["parent"] = "【露露】简易聊天条（MOP）",
["text2Point"] = "CENTER",
["zoom"] = 0,
["justify"] = "CENTER",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local chatFrame = SELECTED_DOCK_FRAME\nlocal inputbox = chatFrame.editBox\nlocal e = aura_env\nlocal region = WeakAuras.GetRegion(e.id) \n\nif not _G[e.id..\"Button\"] then \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region) \n    e.btn:RegisterForClicks(\"AnyUp\")\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\n\nbtn:SetScript(\"OnClick\", function(self, button)\n        if ChatEdit_GetActiveWindow() and IsShiftKeyDown() then\n            ChatEdit_DeactivateChat(inputbox)\n        else\n            if button == \"LeftButton\" then\n                ChatFrame_OpenChat(\"/bg \" .. inputbox:GetText(), chatFrame)\n            else\n                ChatFrame_OpenChat(\"/bg \" .. inputbox:GetText(), chatFrame)\n            end \n        end\nend)\nbtn:SetScript(\"OnMouseUp\", function(self)\n        region:SetAlpha(1)\nend)\nbtn:SetScript(\"OnMouseDown\", function(self)\n        region:SetAlpha(0.5)\nend)\nbtn:SetScript(\"OnEnter\",function(self)\n        region:SetScale(1.25)\nend)\nbtn:SetScript(\"OnLeave\",function(self)\n        region:SetScale(1)\nend)\n\n\n\n",
},
},
["id"] = "副本",
["cooldownEdge"] = false,
["frameStrata"] = 1,
["anchorFrameType"] = "SCREEN",
["text1Font"] = "Friz Quadrata TT",
["desc"] = "自用改版，by 露露緹婭@Bilibili，https://space.bilibili.com/455259\n代码原版来自NGA，原名：ZB快捷聊天按钮，by：夜刃",
["inverse"] = false,
["xOffset"] = 0,
["conditions"] = {
{
["check"] = {
["trigger"] = 1,
["variable"] = "show",
["value"] = 1,
},
["changes"] = {
{
["value"] = 0.7,
["property"] = "alpha",
},
},
},
},
["cooldown"] = true,
["font"] = "艺黑",
},
["[DP] [Gara'jal] Summon Spirit Totems"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1434'\nlocal ID          = 'SpiritTotems'\n\nlocal name, icon = C_Spell.GetSpellName(116174), C_Spell.GetSpellTexture(116174)\n\nlocal options = {\n    warningText = '%icon @cffff8b17%name@r (%count) %icon'\n}\n\naura_env.StopCD = function()\n    WeakAuras.ScanEvents('MERFIN_CD_STOP', encounterID, { ID = ID })\nend\n\naura_env.StartCD = function(duration, autoHide)\n    local data = {\n        show           = true,\n        autoHide       = autoHide,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        ID             = ID,\n        count          = aura_env.count,\n        name           = name,\n        icon           = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function()\n    local data = {\n        ID     = ID,\n        count  = aura_env.count,\n        name   = name,\n        icon   = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend\n\naura_env.Synch = function()\n    WeakAuras.ScanEvents('MERFIN_SYNCH', 'RAID', nil, 'SPIRIT_TOTEMS_SYNCH') \nend\n\naura_env.IsSpam = function(before)\n    local cur = GetTime()\n    if not aura_env.antispam or cur - aura_env.antispam > before then\n        aura_env.antispam = cur\n        return false\n    end\n    return true\nend\n\naura_env.LatencyCheck = function()\n    return select(4, GetNetStats()) < 250\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_CAST_SUCCESS:SPELL_AURA_APPLIED, UNIT_SPELLCAST_SUCCEEDED:boss1, SPIRIT_TOTEMS_SYNCH",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_CAST_SUCCESS' then\n            if spellID == 116174 and aura_env.LatencyCheck() then\n                aura_env.Synch()\n            end\n        elseif subEvent == 'SPELL_AURA_APPLIED' then\n            if spellID == 117752 and aura_env.diff ~= 7 then\n                aura_env.StopCD()\n            end\n        end\n        \n    elseif e == 'UNIT_SPELLCAST_SUCCEEDED' then\n        local _,_, spellID = ...\n        \n        if spellID == 116964 then -- LFR only\n            --aura_env.Synch()\n        end\n        \n    elseif e == 'SPIRIT_TOTEMS_SYNCH' then\n        if not aura_env.IsSpam(10) then\n            aura_env.count = aura_env.count + 1\n            aura_env.StartCD(aura_env.totemTime)\n            aura_env.SendWarning()\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n        \n        aura_env.diff = WeakAuras.InstanceTypeRaw()\n        local diff = aura_env.diff\n        aura_env.totemTime = (diff == 3 or diff == 5) and 36.5 or (diff == 4 or diff == 6) and 20.5 or 30\n        aura_env.StartCD(aura_env.totemTime - 5)\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
