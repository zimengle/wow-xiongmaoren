["customText"] = "function()\n    local ctx = Merfin:L('Barrier')\n    \n    if WeakAuras.IsOptionsOpen() then\n        return WeakAuras.me, ctx\n    end\n    \n    local state = aura_env.states and aura_env.states[2]\n    if not state then return end\n    \n    return state.unitName, ctx\nend",
