["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_,_,_,_,_, destGUID,_,_,_, spellID = ...\n        \n        if spellID == 129189 and destGUID == WeakAuras.myGUID then\n            WeakAuras.ScanEvents('MERFIN_SEND_CHAT_MESSAGE', 'Soaked', 'SAY')\n            aura_env.SendWarning()\n        end\n    end\nend",
