["custom"] = "local L = GetLocale()\naura_env.IsEmote = function(initialEmote, compareWith)\n    if not initialEmote then return false end\n    if not aura_env.replicas[L] then return false end\n    local replica = aura_env.replicas[L][compareWith]\n    if not replica then return false end\n    return initialEmote == replica or initialEmote:find(replica)\nend\n\naura_env.replicas = {\n    ['enUS'] = {\n        LastAdds = \"You have bested our most junior of students.  Now you will face two of my most senior.\",\n    },\n}",
["do_custom"] = true,
},
},
