["[MerfinDung] Text to Speech"] = {
["outline"] = "OUTLINE",
["wagoID"] = "zylhUqLd0",
["parent"] = "[MerfinDung] Core",
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
["do_message"] = false,
["message_type"] = "TTS",
},
["finish"] = {
},
["init"] = {
["custom"] = "local SpeakText = C_VoiceChat.SpeakText\n\nlocal cfg = aura_env.config.options\n\nif cfg.testSound then\n    local text = cfg.testText\n    local voiceID = cfg.voiceID\n    local destination = Enum.VoiceTtsDestination.LocalPlayback\n    local speed = cfg.voiceRate\n    local volume = cfg.volume\n    \n    print(text, voiceID, destination, speed, volume)\n    \n    C_VoiceChat.SpeakText(voiceID, text, destination, speed, volume)\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["debuffType"] = "HELPFUL",
["custom"] = "function(e, text, voiceId, speed, volume)\n    if WeakAuras.IsOptionsOpen() then return end\n    if not text then return end\n    \n    if e ~= 'WA_MERFIN_DUNGEON_TTS' then return end\n    local cfg = aura_env.config.options\n    if not cfg.enable then return end\n    \n    local voiceId = (cfg.applyAll and cfg.voiceId) or voiceId or 1\n    local destination = Enum.VoiceTtsDestination.LocalPlayback\n    local speed = speed or 1\n    local volume = (cfg.applyAll and cfg.volume) or volume or 100\n    \n    C_VoiceChat.SpeakText(voiceId, text, destination, speed, volume)\nend",
["events"] = "WA_MERFIN_DUNGEON_TTS",
["custom_type"] = "event",
["names"] = {
},
["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
