["auranames"] = {
"99947",
},
["events"] = "MERFIN_PREWARNING_SHOW, MERFIN_PREWARNING_HIDE",
["spellIds"] = {
},
["custom"] = "function(states, event, encounterID, cooldown, config)\n    \n    if event == 'OPTIONS' then\n        local newState = {\n            progressType   = 'timed',\n            autoHide       = true,\n            duration       = 5,\n            expirationTime = 5 + GetTime(),\n            name           = Merfin:L('BIG BANG'),\n        }\n        states:Update('', newState)\n    end\n    \n    if event == 'MERFIN_PREWARNING_SHOW' then\n        if not config.pwTexture then return end\n        \n        local stateName = encounterID .. cooldown.ID  .. (cooldown.GUID or '')\n        local remaining = cooldown.expirationTime - GetTime()\n        \n        local newState = {\n            show            = true,\n            changed         = true,\n            progressType    = 'timed',\n            autoHide        = true,\n            duration        = remaining,\n            expirationTime  = remaining + GetTime(),\n            name            = cooldown.rawName,\n            enableCountdown = cooldown.countdown,\n            voiceActorIndex = cooldown.voiceActorIndex,\n            sourceName      = cooldown.sourceName,\n            hasSrcName      = cooldown.sourceName ~= nil,\n            cooldownID      = cooldown.ID,\n        }\n        states:Update(stateName, newState)\n    end\n    \n    \n    if event == 'MERFIN_PREWARNING_HIDE' then\n        local stateName = encounterID .. cooldown.ID  .. (cooldown.GUID or '')\n        states:Remove(stateName)\n    end\n    \nend",
["type"] = "custom",
["check"] = "event",
["unit"] = "group",
["custom_hide"] = "timed",
["customVariables"] = "{\n    enableCountdown = {\n        display = 'Is Countdown Enabled',\n        type = 'bool'\n    },\n    \n    expirationTime = true,\n    cooldownID = {\n        display = 'Cooldown ID',\n        type = 'string',\n    }\n}",
