},
{
["type"] = "toggle",
["default"] = false,
["width"] = 1,
["name"] = "Update Raid Target",
["useDesc"] = true,
["key"] = "updateRaidTarget",
["desc"] = "Update the raid target on every RAID_TARGET_UPDATE by iterating through all existing units, including players' targets. This may slightly impact performance",
},
{
["type"] = "toggle",
["default"] = false,
["width"] = 1,
["name"] = "Use Actual Names",
["useDesc"] = true,
["key"] = "actualNames",
["desc"] = "Use actual unit names instead of custom names from the code",
},
},
["hideReorder"] = true,
["useDesc"] = false,
["nameSource"] = 0,
["name"] = "Health Bars",
["width"] = 1,
["useCollapse"] = false,
["noMerge"] = false,
