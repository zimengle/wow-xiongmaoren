["cooldownEdge"] = false,
["semver"] = "1.1.1",
["customText"] = "function()\n    local default_text = \"注意自保\"\n    local spellId = aura_env.state and aura_env.state.spellId\n    local RurutiaSpellIDs = {\n        -- 恐惧之心\n        [123963] = \"注意自保\", -- 库尔提克打击\n        [123175] = \"疾风步：你\", -- 疾风步\n        \n        [116606] = \"冲锋：你\", -- 巨魔冲锋\n        [116784] = \"远离人群\", -- 野性火花\n        [116374] = \"闪电充能：你\", -- 闪电充能\n        [118303] = \"风筝小怪\", -- 注视\n        [132222] = \"刷满血量\", -- 动荡能量\n        [116778] = \"专注防御：你\", -- 专注防御\n        [116829] = \"专注能量：你\", -- 专注能量\n        [122064] = \"保持移动\", -- 腐蚀树脂\n        [123012] = \"解魔法+Dot\", -- 暗影恐怖\n        --[119983] = \"%i 恐惧喷射 %s层 %p\", -- 恐惧喷射\n        [120388] = \"你被锁定\", -- 追寻光芒\n        [120629] = \"畏惧：你\", -- 因畏惧而蜷缩\n        \n        -- 魔古山宝库\n        [116374] = \"闪电充能：你\", -- 闪电充能\n    }\n    return spellId and RurutiaSpellIDs[spellId] or default_text\nend",
