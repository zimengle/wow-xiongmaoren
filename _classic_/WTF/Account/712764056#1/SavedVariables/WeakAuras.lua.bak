["useAdjustededMax"] = false,
["cooldown"] = true,
["source"] = "import",
["conditions"] = {
},
["customText"] = "function()\n    if WeakAuras.IsOptionsOpen() then\n        return \"|cffff0000玩家姓名\"\n    end\n    \n    local Name = aura_env.state.sourceName\n    if Name then\n        if WA_ClassColorName(Name) ~= \"\" then\n            Name = WA_ClassColorName(Name)\n        end\n        return Name\n    end\nend",
["keepAspectRatio"] = false,
