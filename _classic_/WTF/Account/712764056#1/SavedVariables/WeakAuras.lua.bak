["[DP] [Elegon] Phase"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1500'\nlocal IDs = {\n    [1] = { 'Phase1', Merfin:L('Phase 1')},\n    [2] = { 'Phase2', Merfin:L('Phase 2')},\n    [3] = { 'Phase3', Merfin:L('Phase 3')},\n}\n\nlocal options = {\n    ['Phase1'] = {\n        warningText = string.format(\"@cffe3e3e3» %s «@r\", IDs[1][2]:upper()),\n    },\n    ['Phase2'] = {\n        warningText = string.format(\"@cffe3e3e3» %s «@r\", IDs[2][2]:upper()),\n    },\n    ['Phase3'] = {\n        warningText = string.format(\"@cffe3e3e3» %s «@r\", IDs[3][2]:upper()),\n    },\n}\n\naura_env.SendWarning = function()\n    local n = aura_env.phase\n    local ID = IDs[n][1]\n    \n    local data = {\n        ID    = ID,\n        name  = IDs[n][2],\n        count = aura_env.phase,\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options[ID])\nend\n\naura_env.MRT = function(phase)\n    if not WeakAuras.IsAuraLoaded(aura_env.id) then return end\n    local event = phase\n    GMRT.F.Note_Timer(event)\nend\n\naura_env.SendPhase = function(n)\n    aura_env.MRT('PHASE_' .. n)\n    WeakAuras.ScanEvents('ELEGON_PHASE', aura_env.phase)\n    if n ~= '1_INITIAL' then\n        aura_env.SendWarning()\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_AURA_APPLIED' then\n            if spellID == 124967 then\n                aura_env.phase = 2\n                aura_env.SendPhase(2)\n            elseif spellID == 116994 then\n                aura_env.phase = 3\n                aura_env.SendPhase(3)\n            end\n        elseif subEvent == 'SPELL_AURA_REMOVED' then\n            if spellID == 116994 then\n                aura_env.phase = 1\n                aura_env.SendPhase(1)\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.phase = 1\n        aura_env.SendPhase('1_INITIAL')\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
