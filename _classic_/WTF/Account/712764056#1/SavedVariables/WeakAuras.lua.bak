["unit"] = "player",
["custom"] = "function(states, e, _, warning)\n    if e == 'OPTIONS' then\n        states:Update('', {\n                progressType   = 'timed',\n                duration       = 4,\n                expirationTime = 4 + GetTime(),\n                name           = 'Total Annihilation', \n        })\n        \n    elseif e == 'MERFIN_WARNING' and warning.ID == 'TotalAnnihilation' then\n        local stateName = warning.sourceGUID\n        states:Update(stateName, {\n                progressType   = 'timed',\n                duration       = 4,\n                expirationTime = 4 + GetTime(),\n                autoHide       = true,\n                name           = warning.name, \n        })\n    end\nend",
["events"] = "MERFIN_WARNING",
