["finish"] = {
},
["init"] = {
["custom"] = "local L = {\n    enUS = {\n        RESPAWN = \"Respawn\"\n    },\n    frFR = {\n        RESPAWN = \"Réapparition\"\n    },\n    deDE = {\n        RESPAWN = \"Wiederbeleben\"\n    },\n    esES = {\n        RESPAWN = \"Reaparecer\"\n    },\n    esMX = {\n        RESPAWN = \"Reaparecer\"\n    },\n    ruRU = {\n        RESPAWN = \"Ресет Босса\"\n    },\n    koKR = {\n        RESPAWN = \"재생성\"\n    },\n    zhCN = {\n        RESPAWN = \"重生\"\n    },\n    zhTW = {\n        RESPAWN = \"重生\"\n    },\n    itIT = {\n        RESPAWN = \"Riappare\"\n    },\n    ptBR = {\n        RESPAWN = \"Ressurgir\"\n    }\n}\n\nlocal locale = GetLocale()\naura_env.GetLocalizedText = function(key)\n    if L[locale] and L[locale][key] then\n        return L[locale][key]\n    else\n        return L[\"enUS\"][key]\n    end\nend\n\naura_env.encounterID = 0\naura_env.customRespawn = {\n    [1082] = 40,\n    [1083] = 40,\n    [1436] = 50, -- The Spirit Kings (Mogu'shan Vaults)\n    [1500] = 15, -- Elegon (Mogu'shan Vaults)\n    [1507] = 15, -- Zorlok\n}",
["do_custom"] = true,
},
},
["frameStrata"] = 1,
["anchorFrameType"] = "SCREEN",
["zoom"] = 0.3,
["uid"] = "nFXXxN3IeRF",
