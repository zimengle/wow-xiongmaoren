["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(states, event)\n    \n    if event == 'OPTIONS' then\n        states:Update('', {\n                progressType = 'static',\n                total        = 5,\n                value        = 2.6,\n                prefix       = C_Spell.GetSpellName(117752), \n        })\n        return\n    end\n    \n    if not UnitExists('boss1') then return end\n    \n    local hper = aura_env.GetUnitHealthPercent('boss1')\n    \n    for _, range in ipairs(aura_env.ranges) do\n        local offset = aura_env.InRangeOffset(hper, range.min, range.max)\n        if offset then\n            states:Update('', {\n                    progressType = 'static',\n                    total        = 5,\n                    value        = offset,\n                    prefix       = range.prefix,\n            })\n            return\n        end\n    end\n    \n    states:Remove('')\nend\n\n--C_Spell.GetSpellName(117752)",
["events"] = "ENCOUNTER_START, UNIT_HEALTH:boss1",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
},
["untrigger"] = {
