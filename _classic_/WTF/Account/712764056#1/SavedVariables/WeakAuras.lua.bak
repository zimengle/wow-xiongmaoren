["宏面板"] = {
["text2Point"] = "CENTER",
["iconSource"] = -1,
["text1FontSize"] = 12,
["xOffset"] = 0,
["displayText"] = "%c",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["url"] = "https://afdian.com/a/Rurutia",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local e = aura_env\nlocal region = WeakAuras.GetRegion(e.id)\n\nif not _G[e.id..\"Button\"] then \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region) \n    e.btn:RegisterForClicks(\"LeftButtonUp\") -- 修复为正确的参数\n    e.btn:SetAllPoints(region)\n    e.btn:SetFrameStrata(\"HIGH\")\n    e.btn:EnableMouse(true)\nend\n\nlocal btn = _G[e.id..\"Button\"]\n\nbtn:SetScript(\"OnClick\", function(self, button)\n    if button == \"LeftButton\" then\n        if not MacroFrame then\n            ShowMacroFrame() -- 打开宏界面\n        else\n            ToggleFrame(MacroFrame) -- 切换宏界面的显示/隐藏\n        end\n    end\nend)\n\nbtn:SetScript(\"OnEnter\", function(self)\n    region:SetScale(1.15) -- 鼠标悬停时放大\nend)\nbtn:SetScript(\"OnLeave\", function(self)\n    region:SetScale(1) -- 鼠标离开时恢复\nend)",
},
["finish"] = {
},
},
