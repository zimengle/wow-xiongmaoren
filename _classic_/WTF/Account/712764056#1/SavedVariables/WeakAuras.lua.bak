["Construct [5] Power"] = {
["sparkWidth"] = 10,
["iconSource"] = -1,
["wagoID"] = "1qyg9npGm",
["parent"] = "[Widget] Player Construct [5]",
["preferToUpdate"] = false,
["adjustedMin"] = "",
