["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1507'\nlocal ID          = 'Song'\n\nlocal name, icon = C_Spell.GetSpellName(123791), C_Spell.GetSpellTexture(123791)\n\nlocal options = {\n    warningText = \"%icon %sourceName @cffff8b17%name@r %icon\",\n}\n\nlocal sourceName = {\n    ['ECHO'] = '|cffff8080' .. Merfin:L('Echo') .. '|r',\n    ['BOSS'] = '|cffb5b5b5' .. BOSS .. '|r',\n}\n\naura_env.SendWarning = function(bossID)\n    local data = {\n        ID         = ID,\n        count      = aura_env.count,\n        sourceName = sourceName[bossID],\n        name       = name,\n        icon       = icon,\n    }\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend\n\naura_env.GetBossID = function(GUID)\n    local npcID = Merfin.GetNPCIDFromGUID(GUID)\n    local isEcho = npcID == 65173 or npcID == 65174\n    return isEcho and 'ECHO' or 'BOSS'\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_CAST_START:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED, PLATFORM_CHANGED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent, _, sourceGUID, sourceName, _, _, _, destName, _, _, spellID = ...\n        \n        if spellID == 123791 then\n            if subEvent == 'SPELL_CAST_START' then\n                local bossID = aura_env.GetBossID(sourceGUID)\n                \n                if bossID == 'ECHO' and aura_env.initialized then\n                    aura_env.initialized = false\n                    WeakAuras.ScanEvents('CLONE_SPAWNED')\n                end\n                \n                --aura_env.SendWarning(bossID)\n                \n            elseif subEvent == 'SPELL_AURA_APPLIED' then\n                WeakAuras.ScanEvents('SONG_APPLIED')\n            elseif subEvent == 'SPELL_AURA_REMOVED' then\n                WeakAuras.ScanEvents('SONG_REMOVED')\n            end\n        end\n        \n    elseif e == 'PLATFORM_CHANGED' then\n        aura_env.platformN = ...\n        \n        if aura_env.platformN == 4 then\n            aura_env.initialized = true\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.initialized = false\n        aura_env.count = 0\n    end\nend",
