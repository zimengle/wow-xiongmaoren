["[DP] [Emperor] Emperor's Courage"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local encounterID = '1407'\nlocal ID          = 'CourageActivate'\n\nlocal name = Merfin.GetTitleEJ(5676)\nlocal icon = 463281\n\nlocal options = {\n    warningText = \"%icon @cffff8b17%name@r (%count) %icon\",\n    ttsLine = Merfin:L(\"Courage\"),\n    prewarnTTStext = string.format(Merfin:L('%s soon'), name),\n}\n\naura_env.StartCD = function(duration)\n    local data = {\n        show           = true,\n        autoHide       = true,\n        duration       = duration,\n        expirationTime = duration + GetTime(),\n        ID             = ID,\n        name           = name,\n        icon           = icon,\n        count          = aura_env.count,\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_CD_START', encounterID, data, options)\nend\n\naura_env.SendWarning = function()\n    local data = {\n        ID     = ID,\n        count  = aura_env.count,\n        name   = name,\n        icon   = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend\n\naura_env.Schedule = function(seconds)\n    if aura_env.scheduler then \n        aura_env.scheduler:Cancel() \n    end\n    \n    aura_env.scheduler = C_Timer.NewTimer(seconds, function()\n            WeakAuras.ScanEvents('COURAGE_SCHEDULED')\n    end)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, ADD_ACTIVATION, COURAGE_SCHEDULED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'ADD_ACTIVATION' then\n        local add = ...\n        \n        if add == 'COURAGE' then\n            aura_env.Schedule(10)\n        end\n        \n    elseif e == 'COURAGE_SCHEDULED' then\n        aura_env.count = aura_env.count + 1\n        aura_env.SendWarning()\n        local duration = aura_env.count >= 2 and 150 or 100\n        aura_env.StartCD(duration)\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n        aura_env.isHeroic = WeakAuras.InstanceDifficulty() == 'heroic'\n        local duration = aura_env.isHeroic and 69 or 75\n        aura_env.StartCD(duration)\n    end\nend",
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
