["[Widget] [Pheromones] Send Chat Warning"] = {
["width"] = 200,
["information"] = {
},
["wagoID"] = "1qyg9npGm",
["parent"] = "[Widget] Garalon Pheromones",
["preferToUpdate"] = false,
["xOffset"] = 0,
