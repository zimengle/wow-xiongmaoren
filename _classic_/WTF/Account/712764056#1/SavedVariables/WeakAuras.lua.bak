["[DP] [MV-Trash] Gara'jal Arrival"] = {
["exrtLastSync"] = 1751102740,
["wagoID"] = "1qyg9npGm",
["authorOptions"] = {
},
["preferToUpdate"] = false,
["parent"] = "[DP] Trash (Mogu'shan Vaults)",
