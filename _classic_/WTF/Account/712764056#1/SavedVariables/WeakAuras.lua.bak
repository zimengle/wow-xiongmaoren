},
["custom_type"] = "event",
["custom"] = "--by 露露緹婭@Bilibili\n--不需要的可以在触发器代码里注释对应行，或者直接在载入里勾选从不/右键删除此WA。\nfunction() \n    SetCVar(\"cameraDistanceMaxZoomFactor\", 5) --最远视距\n    SetCVar(\"nameplateMaxDistance\", 41) --41码血条\n    SetCVar(\"ffxDeath\", 0) --关闭死亡特效\n    SetCVar(\"ffxGlow\", 0) --关闭全屏幕泛光\n    SetCVar(\"weatherdensity\", 1) --关闭天气特效，数字范围1-3\n    SetCVar(\"chatClassColorOverride\", 0) --聊天框职业色开关\n    SetCVar(\"violenceLevel\", 2) --溅血效果调整，数字范围0-5\n    SetCVar(\"scriptErrors\", 0) --屏蔽Lua错误\n    SetCVar(\"alwaysCompareItems\", 1)--装备自动对比\n    SetCVar(\"floatingCombatTextCombatDamage\", 1)--显示伤害数字\n    SetCVar(\"equipmentManager\", 1)--默认开启系统自带的装备管理\nend",
