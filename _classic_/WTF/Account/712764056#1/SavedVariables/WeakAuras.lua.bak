["actions"] = {
["start"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1499'\nlocal ID          = 'LivingAmber'\n\nlocal name = Merfin.GetTitleEJ(6261)\nlocal icon = 344804\n\nlocal options = {\n    warningText = \"%icon @cff40ff40%name@r (%count) %icon\",\n}\n\naura_env.SendWarning = function()\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID    = ID,\n            name  = name,\n            icon  = icon,\n            count = aura_env.count,\n    }, options)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
