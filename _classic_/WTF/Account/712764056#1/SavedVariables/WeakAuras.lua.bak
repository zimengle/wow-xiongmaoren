["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    if t[4] then -- If in Rested Area\n        return false\n    end\n    \n    local behavior = aura_env.config.maintenance.battle_commanding_shout.behavior\n    \n    if behavior == 1 then -- Show if Applied\n        return t[1]\n    elseif behavior == 2 then -- Show if Missing\n        if t[6] and t[7] then\n            return false\n        end\n        return t[2] or t[3]\n    else -- Always Show\n        return true\n    end\nend",
