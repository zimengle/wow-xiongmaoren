["type"] = "custom",
["custom"] = "function(event, npcID)\n    if event == 'UNIT_DIED' then\n        if npcID == 63593 then\n            aura_env.count = (aura_env.count or 0) + 1\n        end\n    end\n    \n    if aura_env.count and aura_env.count < 7 then\n        return true\n    end   \nend",
["custom_type"] = "status",
