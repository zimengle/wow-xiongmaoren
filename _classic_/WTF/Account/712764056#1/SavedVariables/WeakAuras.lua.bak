["tocversion"] = 50500,
["url"] = "https://wago.io/progress_t14/132",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local L = GetLocale()\n\naura_env.IsEmote = function(initialEmote, compareWith)\n    if not initialEmote then return false end\n    if not aura_env.replicas[L] then return false end\n    local replica = aura_env.replicas[L][compareWith]\n    if not replica then return false end\n    return initialEmote == replica or initialEmote:find(replica)\nend\n\naura_env.replicas = {\n    ['enUS'] = {\n        tsulongActive = \"No... the waters... I must... resist... I shall not... fear...\",\n        zorlokActive = \"And so it falls to us, Her chosen voice.\",\n        tayakActive = \"They failed their test. Will you?\",\n        garalonActive = \"Breath of the empress, bring mighty Garalon to us!\",\n    },\n    \n    ['ruRU'] = {\n        --tsulongActive = \"\",\n        --zorlokActive = \"\",\n        tayakActive = \"Они не прошли испытание. Сможете ли вы?\",\n        garalonActive = \"Дыхание императрицы, пошли нам могучего Гаралона!\",\n    }\n}",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["duration"] = "25",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "custom",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["subeventPrefix"] = "SPELL",
["events"] = "CHAT_MSG_MONSTER_YELL",
["names"] = {
},
["custom"] = "function(event, ...)\n    if event == 'CHAT_MSG_MONSTER_YELL' then\n        local msg = ...\n        if not msg then return end\n        \n        if aura_env.IsEmote(msg, 'tsulongActive') then\n            WeakAuras.ScanEvents('TSULONG_ACTIVE')\n            \n        elseif aura_env.IsEmote(msg, 'zorlokActive') then\n            WeakAuras.ScanEvents('ZORLOK_ACTIVE')\n            \n        elseif aura_env.IsEmote(msg, 'tayakActive') then\n            WeakAuras.ScanEvents('TAYAK_ACTIVE')\n            \n        elseif aura_env.IsEmote(msg, 'garalonActive') then\n            WeakAuras.ScanEvents('GARALON_ACTIVE')\n        end\n    end\nend",
["debuffType"] = "HELPFUL",
},
