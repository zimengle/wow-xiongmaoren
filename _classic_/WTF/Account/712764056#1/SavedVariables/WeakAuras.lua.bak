["exrtLastSync"] = 1749992740,
["icon_side"] = "LEFT",
["sparkTexture"] = "Interface\\AddOns\\WeakAuras\\Media\\Textures\\Square_FullWhite",
["anchorFrameParent"] = false,
["sparkHeight"] = 27,
