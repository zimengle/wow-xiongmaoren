["init"] = {
["custom"] = "local encounterID = '1407'\nlocal ID          = 'FocusedAssault'\n\nlocal name, icon = C_Spell.GetSpellName(116525), C_Spell.GetSpellTexture(116525)\n\nlocal options = {\n    warningText = \"%icon @cffff8b17%name@r » %destName %icon\",\n}\n\naura_env.SendWarning = function(destName)\n    local data = {\n        ID       = ID,\n        count    = aura_env.count,\n        destName = WA_ClassColorName(destName),\n        name     = name,\n        icon     = icon\n    }\n    \n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, data, options)\nend",
