["actions"] = {
["start"] = {
["do_custom"] = false,
},
["init"] = {
["custom"] = "local encounterID = '1499'\nlocal ID          = 'Phase'\n\nlocal phaseNames = {\n    ['Phase2'] = Merfin:L('Phase 2'),\n    ['Phase3'] = Merfin:L('Phase 3'),\n}\n\nlocal options = {\n    ['Phase2'] = {\n        warningText = string.format(\"@cffe3e3e3» %s «@r\", phaseNames['Phase2']:upper()),\n        ttsLine = phaseNames['Phase2'],\n    },\n    ['Phase3'] = {\n        warningText = string.format(\"@cffe3e3e3» %s «@r\", phaseNames['Phase3']:upper()),\n        ttsLine = phaseNames['Phase3'],\n    },\n}\n\naura_env.MRT = function(event)\n    GMRT.F.Note_Timer(event)\nend\n\naura_env.SendWarning = function(ID)\n    WeakAuras.ScanEvents('MERFIN_WARNING', encounterID, {\n            ID   = ID,\n            name = phaseNames[ID],\n        }, options[ID])\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "\n    ",
["do_custom"] = false,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent,_,_,_,_,_,_,_,_,_, spellID = ...\n        \n        if subEvent == 'SPELL_AURA_APPLIED' then\n            if spellID == 122540 then\n                WeakAuras.ScanEvents('UNSOK_PHASE', 2)\n                aura_env.SendWarning('Phase2')\n                aura_env.MRT('PHASE_2')\n            end\n            \n        elseif subEvent == 'SPELL_AURA_REMOVED' then\n            if spellID == 122540 then\n                WeakAuras.ScanEvents('UNSOK_PHASE', 3)\n                aura_env.SendWarning('Phase3')\n                aura_env.MRT('PHASE_3')\n            end\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        WeakAuras.ScanEvents('UNSOK_PHASE', 1)\n    end\nend",
