["icon_side"] = "RIGHT",
["selfPoint"] = "CENTER",
["customText"] = "-- Author: 露露緹婭@Bilibili\nfunction()\n    local default_text = \"自保\"\n    local spellId = aura_env.state and aura_env.state.spellId\n    local RurutiaSpellName = (spellId and GetSpellInfo(spellId)) or default_text\n    \n    local RurutiaSpellIDs = {\n        -- 测试用\n        -- [61295] = \"回血\", -- 激流\n        \n        -- 魔古山宝库\n        [116990] = \"被锁定\", --专注打击\n        [116281] = \"定身\", --蓝晶冲击\n        [130774] = \"快躲开\", --紫晶之池\n        [122151] = \"复制伤害\", --巫毒娃娃\n        [116278] = \"打小怪\", --灵魂撕裂\n        [116161] = \"刷满血量\", --灵魂越界\n        [117723] = \"内场CD\", --脆弱灵魂\n        [118048] = \"-伤害/治疗\", --被掠夺\n        [118163] = \"-伤害/治疗\", --巧取豪夺\n        [118135] = \"定身\", --重箭钉体\n        [117708] = \"心控+Dot\", --癫狂之吼\n        [132226] = \"不能分摊\", --动荡能量\n        [117878] = \"+承伤\", --能量超载\n        \n        -- BUFF\n        [115856] = \"安全安全\", --废灵壁垒\n        [117543] = \"回蓝\", --灵魂支配\n    }\n    return spellId and RurutiaSpellIDs[spellId] or RurutiaSpellName\nend",
