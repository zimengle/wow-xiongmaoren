},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, UNIT_SPELLCAST_SUCCEEDED:boss1, CLEU:UNIT_DIED",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'UNIT_SPELLCAST_SUCCEEDED' then\n        local _,_, spellID = ...\n        \n        if spellID == 127542      -- Platform 1 Echo Spawn\n        or spellID == 127541      -- Platform 2 Echo Spawn\n        or spellID == 130297 then -- Phase 2 Echo\n            aura_env.EchoState(true)\n        end\n        \n    elseif e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _,_,_,_,_,_,_, destGUID = ...\n        \n        local npcID = Merfin.GetNPCIDFromGUID(destGUID)\n        if npcID == 68168 or npcID == 65173 or npcID == 65174 then\n            aura_env.EchoState(false)\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.EchoState(false)\n    end\nend",
