["init"] = {
["custom"] = "-- Initialize aura_env properties\naura_env.IsHeroic = WeakAuras.InstanceDifficulty() == 'heroic'\naura_env.spells = {}\naura_env.nameplates = {}\naura_env.guids = {}\naura_env.temp = {}\naura_env.units = {}\naura_env.progtime = {}\naura_env.proglast = {}\naura_env.last = {}\naura_env.GetSpellInfo = WeakAuras.IsRetail() and C_Spell.GetSpellInfo or GetSpellInfo\n\naura_env.GetSpellIcon = function(spellId)\n    if WeakAuras.IsRetail() then\n        return C_Spell.GetSpellInfo(spellId).iconID\n    end\n    return select(3, GetSpellInfo(spellId))\nend\n\n-- Convert spells from custom options\naura_env.OnInit = function()\n    \n    for _, v in ipairs(aura_env.config.spells) do\n        \n        local difficultyCheck = v.difficulty == (aura_env.IsHeroic and 2 or 1) or v.difficulty == 3\n        \n        if v.spellID ~= 0 and v.active and difficultyCheck then\n            local spell = {\n                active = v.active,\n                icon = select(3, aura_env.GetSpellInfo(v.spellID)),\n                duration = v.duration,\n                intduration = v.intduration,\n                onstart = v.casttype == 1,\n                onsuccess = v.casttype == 2,\n                tank = v.tank,\n                heal = v.heal,\n                mdps = v.mdps,\n                rdps = v.rdps,\n                hide = v.hideafter,\n                overwrite = v.overwrite,\n                npcID = v.npcID,\n                oncombat = v.oncombat,\n                combattimer = v.combattimer,\n                loop = v.loop,\n                progressive = v.progressive,\n                repeating = v.repeating,\n                other = 0,\n                npcIDoffset = v.npcIDoffset,\n                offsetnum = v.offsetnum,\n                offset = {},\n                desynch = v.desynch,\n            }\n            \n            -- Parse npcIDoffset and offsetnum\n            if v.npcIDoffset ~= \"\" and v.offsetnum ~= \"\" then\n                local i = 1\n                while true do\n                    local timer = tonumber(select(i, strsplit(\" \", v.offsetnum)))\n                    local npcID = select(i, strsplit(\" \", v.npcIDoffset))\n                    if not timer or not npcID then break end\n                    spell.offset[npcID] = timer\n                    i = i + 1\n                end\n            end\n            \n            -- Parse spelltrigger and spelltimer\n            if v.spelltrigger ~= \"0\" and v.spelltrigger ~= \"\" then\n                spell.other = {}\n                local i = 1\n                while true do\n                    local timer = tonumber(select(i, strsplit(\" \", v.spelltimer)))\n                    local sid = tonumber(select(i, strsplit(\" \", v.spelltrigger)))\n                    if not timer or not sid then break end\n                    spell.other[sid] = timer\n                    i = i + 1\n                end\n            end\n            \n            -- Parse progressive timers\n            if v.progressive ~= \"0\" and v.progressive ~= \"\" then\n                spell.progressive = {}\n                local i = 1\n                while true do\n                    local timer = tonumber(select(i, strsplit(\" \", v.progressive)))\n                    if not timer then break end\n                    table.insert(spell.progressive, timer)\n                    i = i + 1\n                end\n            end\n            \n            aura_env.spells[v.spellID] = spell\n        end\n    end\nend\n\naura_env.OnInit()\n\n-- Role check function\naura_env.rolecheck = function(spell)\n    return true\nend\n\n-- Boss unit check\naura_env.bossunit = function(GUID)\n    for i = 1, 10 do\n        if not UnitExists(\"boss\" .. i) then break end\n        if GUID == UnitGUID(\"boss\" .. i) then\n            return true\n        end\n    end\n    return false\nend\n\n-- Spell interrupt handler\naura_env.oninterrupt = function(spellID, GUID)\n    local spell, key = aura_env.spells[spellID], GUID .. spellID\n    if spell and spell.intduration > 0 and aura_env.rolecheck(spell) and ((not aura_env.last[key]) or GetTime() > aura_env.last[key] + 0.1) then\n        aura_env.last[key] = GetTime()\n        WeakAuras.ScanEvents(\"RELOE_SPELLCD_STATE_UPDATE\", spell, GUID, spellID, spell.intduration, false, false, 0, key, aura_env.id)\n    end\nend\n\n-- Spell cast start handler\naura_env.onstart = function(spellID, GUID, name)\n    local spell, key = aura_env.spells[spellID], GUID .. spellID\n    local npcID = select(6, strsplit(\"-\", GUID))\n    if spell and spell.onstart and ((not aura_env.last[key]) or GetTime() > aura_env.last[key] + 0.1) then\n        aura_env.last[key] = GetTime()\n        local count, duration = -1, aura_env.rolecheck(spell) and spell.duration\n        if type(spell.other) == \"table\" then\n            for k, v in pairs(spell.other) do\n                local spello = aura_env.spells[k] or spell\n                if aura_env.spells[k] and aura_env.spells[k].active then\n                    WeakAuras.ScanEvents(\"RELOE_SPELLCD_STATE_UPDATE\", spello, GUID, k, v, false, false, 0, GUID .. k, aura_env.id)\n                end\n            end\n        end\n        if type(spell.progressive) == \"table\" then\n            duration, count = aura_env.getprogressivetimer(spell, spellID, GUID, duration, key)\n        end\n        if duration then\n            duration = type(spell.offset) == \"table\" and spell.offset[npcID] or duration\n            WeakAuras.ScanEvents(\"RELOE_SPELLCD_STATE_UPDATE\", spell, GUID, spellID, duration, false, false, count + 1, key, aura_env.id)\n        end\n        if spell.desynch ~= 0 then\n            WeakAuras.ScanEvents(\"RELOE_SPELLCD_DESYNCH\", spell, spellID, GUID, spell.desynch, aura_env.id)\n        end\n    end\nend\n\n-- Spell cast success handler\naura_env.onsuccess = function(spellID, GUID, name, CLEU)\n    local spell, key = aura_env.spells[spellID], GUID .. spellID\n    local npcID = select(6, strsplit(\"-\", GUID))\n    if spell and spell.onsuccess and ((not aura_env.last[key]) or GetTime() > aura_env.last[key] + 0.1) then\n        aura_env.last[key] = GetTime()\n        local count, duration = -1, aura_env.rolecheck(spell) and spell.duration\n        if type(spell.other) == \"table\" then\n            for k, v in pairs(spell.other) do\n                local spello = aura_env.spells[k] or spell\n                if aura_env.spells[k] and aura_env.spells[k].active then\n                    WeakAuras.ScanEvents(\"RELOE_SPELLCD_STATE_UPDATE\", spello, GUID, k, v, false, false, 0, GUID .. k, aura_env.id)\n                end\n            end\n        end\n        if duration and type(spell.progressive) == \"table\" then\n            duration, count = aura_env.getprogressivetimer(spell, spellID, GUID, duration, key)\n        end\n        if duration then\n            duration = type(spell.offset) == \"table\" and spell.offset[npcID] or duration\n            WeakAuras.ScanEvents(\"RELOE_SPELLCD_STATE_UPDATE\", spell, GUID, spellID, duration, false, true, count + 1, key, aura_env.id)\n        end\n    end\nend\n\n-- Combat handler\naura_env.oncombat = function(spellID, GUID)\n    local spell = aura_env.spells[spellID]\n    if spell and spell.oncombat and aura_env.rolecheck(spell) then\n        WeakAuras.ScanEvents(\"RELOE_SPELLCD_STATE_UPDATE\", spell, GUID, spellID, spell.combattimer, true, spell.onsuccess, 0, GUID .. spellID, aura_env.id)\n    end\nend\n\n-- Progressive timer calculation\naura_env.getprogressivetimer = function(spell, spellID, GUID, duration, key)\n    aura_env.progtime[key] = (aura_env.progtime[key] or 0) + 1\n    local timer = spell.progressive[aura_env.progtime[key]]\n    if not timer then\n        if spell.repeating then\n            aura_env.progtime[key] = 1\n            timer = spell.progressive[1]\n        else\n            timer = math.min(unpack(spell.progressive))\n        end\n    end\n    return timer or duration, aura_env.progtime[key]\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["duration"] = "2",
["subeventPrefix"] = "SPELL",
["destUnit"] = "target",
["debuffType"] = "HELPFUL",
["spellName"] = {
"Battle Stance",
},
["unit"] = "player",
["type"] = "custom",
["use_destNpcId"] = false,
["subeventSuffix"] = "_CAST_SUCCESS",
["custom_type"] = "stateupdate",
["unevent"] = "timed",
["event"] = "Combat Log",
["spellIds"] = {
},
["events"] = "STATUS UNIT_THREAT_LIST_UPDATE RELOE_SPELLCD_STATE_CLEAN RELOE_SPELLCD_STATE_UPDATE UNIT_SPELLCAST_SUCCEEDED:nameplate UNIT_SPELLCAST_START:nameplate CLEU:SPELL_CAST_SUCCESS:SPELL_INTERRUPT:SPELL_CAST_START NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED RELOE_SPELLCD_DESYNCH",
["use_spellName"] = true,
["custom"] = "function(states, e, ...)\n    local function handleStatusEvent()\n        for i = 1, 40 do\n            local u = \"nameplate\" .. i\n            if UnitExists(u) then\n                local G = UnitGUID(u)\n                aura_env.nameplates[u] = G\n                aura_env.guids[G] = u\n            end\n        end\n    end\n    \n    local function handleNamePlateUnitAddedEvent(u)\n        if not u then return false end\n        \n        local G = UnitGUID(u)\n        aura_env.nameplates[u] = G\n        aura_env.guids[G] = u\n        \n        local updatestate = false\n        for k, state in pairs(aura_env.temp) do\n            if state.GUID == G then\n                if UnitAffectingCombat(u) then\n                    state.unit = u\n                    state.show = true\n                    state.changed = true\n                    states[k] = state\n                    aura_env.temp[k] = nil\n                else\n                    aura_env.units[G] = nil\n                    states[k] = nil\n                    aura_env.temp[k] = nil\n                end\n                updatestate = true\n            end\n        end\n        return updatestate\n    end\n    \n    local function handleNamePlateUnitRemovedEvent(u)\n        if not u then return false end\n        \n        local G = UnitGUID(u)\n        if not G then return false end\n        \n        aura_env.nameplates[u] = nil\n        aura_env.guids[G] = nil\n        \n        local updatestate = false\n        for k, state in pairs(states) do\n            if state.GUID == G then\n                aura_env.temp[k] = state\n                state.show = false\n                state.changed = true\n                updatestate = true\n            end\n        end\n        return updatestate\n    end\n    \n    local function handleSpellCdDesynchEvent(spell, spellID, GUID, desynch, id)\n        if aura_env.id ~= id then return end\n        \n        local now = GetTime()\n        for k, v in pairs(states) do\n            if v.spellID == spellID and v.GUID ~= GUID and now >= v.expirationTime - desynch then\n                WeakAuras.ScanEvents(\"RELOE_SPELLCD_STATE_UPDATE\", spell, v.GUID, spellID, desynch, false, false, 0, v.GUID .. spellID)\n            end\n        end\n        \n        for k, v in pairs(aura_env.temp) do\n            if v.spellID == spellID and v.GUID ~= GUID and now >= v.expirationTime - desynch then\n                v.duration = desynch\n                v.expirationTime = GetTime() + desynch\n            end\n        end\n    end\n    \n    local function handleSpellCdStateCleanEvent(key, expires, id)\n        if aura_env.id ~= id then return false end\n        \n        local state = states[key]\n        local temp = aura_env.temp[key]\n        if (state and state.expirationTime == expires and state.expirationTime < GetTime()) or\n        (temp and temp.expirationTime < GetTime()) then\n            states[key] = nil\n            aura_env.temp[key] = nil\n            return true\n        end\n        return false\n    end\n    \n    local function handleSpellCdStateUpdateEvent(spell, GUID, spellID, duration, combat, type, count, key, id)\n        if aura_env.id ~= id or not spell or not duration then return false end\n        \n        local current = GetTime()\n        local icon = spell.overwrite ~= 0 and aura_env.GetSpellIcon(spell.overwrite) or aura_env.GetSpellIcon(spellID)\n        \n        local state = states[key]\n        local last = aura_env.last[GUID]\n        if (combat and not state) or not last or current > last[1] or icon ~= last[2] or spellID ~= last[3] then\n            if duration <= 0 then\n                states[key] = nil\n                aura_env.temp[key] = nil\n                return true\n            end\n            \n            local data = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = duration,\n                spellID = spellID,\n                expirationTime = current + duration,\n                icon = icon,\n                hide = spell.hide,\n                autoHide = false,\n                GUID = GUID,\n                count = count,\n                unit = aura_env.guids[GUID],\n                spellId = spellID,\n            }\n            \n            if spell.hide == 0 or spell.loop then\n                data.autoHide = true\n            end\n            \n            aura_env.last[GUID] = {current, icon, spellID}\n            \n            if aura_env.guids[GUID] then\n                states[key] = data\n            else\n                aura_env.temp[key] = data\n            end\n            \n            if spell.loop and not combat then\n                C_Timer.After(duration, function()\n                        if aura_env.guids[GUID] then\n                            WeakAuras.ScanEvents(\"RELOE_SPELLCD_STATE_UPDATE\", spell, GUID, spellID, duration, combat, type, count, key)\n                        end\n                end)\n            end\n            \n            return true\n        end\n        return false\n    end\n    \n    local function handleCombatLogEvent(unit, subevent, spellIDUNIT, sourceGUID, sourceName, sflags, _, destGUID, _, dflags, _, spellIDCLEU, _, _, spellIDINT)\n        if sourceGUID and sourceName then\n            if spellIDINT and bit.band(dflags, COMBATLOG_OBJECT_CONTROL_PLAYER) == 0 then\n                aura_env.oninterrupt(spellIDINT, destGUID)\n            elseif subevent == \"SPELL_CAST_SUCCESS\" and bit.band(sflags, COMBATLOG_OBJECT_CONTROL_PLAYER) == 0 and bit.band(sflags, COMBATLOG_OBJECT_REACTION_HOSTILE) > 0 then\n                aura_env.onsuccess(spellIDCLEU, sourceGUID, sourceName, true)\n            elseif subevent == \"SPELL_CAST_START\" and bit.band(sflags, COMBATLOG_OBJECT_CONTROL_PLAYER) == 0 and bit.band(sflags, COMBATLOG_OBJECT_REACTION_HOSTILE) > 0 then\n                aura_env.onstart(spellIDCLEU, sourceGUID)\n            end\n        elseif unit then\n            local GUID = UnitGUID(unit)\n            if GUID then\n                local creature, _, _, _, _, npcID = strsplit(\"-\", GUID)\n                if npcID and (creature == \"Creature\" or creature == \"Vehicle\") then\n                    if e == \"UNIT_THREAT_LIST_UPDATE\" then\n                        if UnitAffectingCombat(unit) and not aura_env.units[GUID] then\n                            aura_env.units[GUID] = {GUID = GUID, time = GetTime()}\n                            for k, _ in pairs(aura_env.spells) do\n                                if aura_env.spells[k].oncombat and aura_env.spells[k].npcID and string.find(aura_env.spells[k].npcID, npcID) then\n                                    aura_env.oncombat(k, GUID)\n                                end\n                            end\n                        end\n                    elseif e == \"UNIT_SPELLCAST_SUCCEEDED\" and spellIDUNIT then\n                        aura_env.onsuccess(spellIDUNIT, GUID, UnitName(unit), false)\n                    elseif e == \"UNIT_SPELLCAST_START\" and spellIDUNIT then\n                        aura_env.onstart(spellIDUNIT, GUID)\n                    end\n                end\n            end\n        end\n    end\n    \n    -- Main event handler\n    if e == \"STATUS\" then\n        handleStatusEvent()\n    elseif e == \"NAME_PLATE_UNIT_ADDED\" then\n        return handleNamePlateUnitAddedEvent(...)\n    elseif e == \"NAME_PLATE_UNIT_REMOVED\" then\n        return handleNamePlateUnitRemovedEvent(...)\n    elseif e == \"RELOE_SPELLCD_DESYNCH\" then\n        handleSpellCdDesynchEvent(...)\n    elseif e == \"RELOE_SPELLCD_STATE_CLEAN\" then\n        return handleSpellCdStateCleanEvent(...)\n    elseif e == \"RELOE_SPELLCD_STATE_UPDATE\" then\n        return handleSpellCdStateUpdateEvent(...)\n    else\n        handleCombatLogEvent(...)\n    end\nend",
["use_unit"] = true,
["check"] = "event",
