["custom_type"] = "status",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED:SPELL_AURA_APPLIED_DOSE",
["names"] = {
},
["check"] = "event",
["custom"] = "function(e, ...)\n    if e == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        local _, subEvent, _, _, _, _, _, _, destName, _, _, spellID, _, _, _, amount = ...\n        \n        if spellID == 122852 then\n            aura_env.count = aura_env.count + 1\n            aura_env.SendWarning(amount or 1)\n        end\n        \n    elseif e == 'ENCOUNTER_START' then\n        aura_env.count = 0\n    end\nend",
