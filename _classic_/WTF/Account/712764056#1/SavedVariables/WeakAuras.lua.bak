["[Core] [T14] Version Checker"] = {
["outline"] = "OUTLINE",
["wagoID"] = "1qyg9npGm",
["xOffset"] = 0,
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "local requiredVersions = {\n    AddOns = {\n        ['MerfinPlus'] = {\n            version = '1.92',\n            prompt = \"You can download the addon on https://www.curseforge.com/wow/addons/merfinplus\"\n        },\n    },\n    \n    WeakAuras = {\n        --[[['[Progress] Raid Anchors'] = {\n            version = '1.0.0',\n            prompt = \"You can find this aura in the public channel in this Discord server: https://discord.com/merfin\"\n        },]]--\n    }\n}\n\nlocal IsAddOnLoaded = IsAddOnLoaded or C_AddOns.IsAddOnLoaded\nlocal GetAddOnMetadata = GetAddOnMetadata or C_AddOns.GetAddOnMetadata\nlocal icon1 = \"|TInterface\\\\AddOns\\\\MerfinPlus\\\\Media\\\\icons\\\\progress\\\\progress_icon_t14.png:16:16|t\"\nlocal prefix = icon1 .. \" \" .. \" |cffffff80[T14 Pack]|r \"\n\nlocal WeakAuras = WeakAuras\n\nlocal GetAuraVersion = function(auraName)\n    if not auraName then return false end\n    local data = WeakAuras.GetData(auraName)\n    if not data then return 'NOT INSTALLED' end\n    return data.semver\nend\n\nlocal GetAddOnVersion = function(addonName)\n    if not (addonName and IsAddOnLoaded(addonName)) then return 'NOT LOADED' end\n    return GetAddOnMetadata(addonName, \"Version\")\nend\n\nlocal ColorizeName = function(name)\n    return \"|cffaaff00\" .. name .. \"|r\"\nend\n\nlocal IsUpToDate = function(v1, v2)\n    \n    local function splitVersion(version)\n        local parts = {}\n        for part in version:gmatch(\"%d+\") do\n            table.insert(parts, tonumber(part))\n        end\n        return parts\n    end\n    \n    local v1Parts = splitVersion(v1)\n    local v2Parts = splitVersion(v2)\n    \n    local maxLength = math.max(#v1Parts, #v2Parts)\n    \n    for i = 1, maxLength do\n        local num1 = v1Parts[i] or 0\n        local num2 = v2Parts[i] or 0\n        \n        if num1 > num2 then\n            return true\n        elseif num1 < num2 then\n            return false\n        end\n    end\n    \n    return true\nend\n\nlocal OnInit = function()\n    if WeakAuras.IsOptionsOpen() then return end\n    \n    local issues = {}\n    \n    for addonName, info in pairs(requiredVersions.AddOns) do\n        local requiredVersion = info.version or '0.0.0'\n        local prompt = info.prompt\n        local installedVersion = GetAddOnVersion(addonName)\n        \n        if installedVersion == 'NOT LOADED' then\n            table.insert(issues, ColorizeName(addonName) .. \" is not loaded. Install version \" .. requiredVersion .. \" or later.\" ..\n                (prompt and \"\\n   \" .. prompt or \"\"))\n        elseif not IsUpToDate(installedVersion, requiredVersion) then\n            table.insert(issues, ColorizeName(addonName) .. \" is outdated. Update to version \" .. requiredVersion .. \"+.\" ..\n                (prompt and \"\\n   \" .. prompt or \"\"))\n        end\n    end\n    \n    for auraName, info in pairs(requiredVersions.WeakAuras) do\n        local requiredVersion = info.version or '0.0.0'\n        local prompt = info.prompt\n        local installedVersion = GetAuraVersion(auraName)\n        \n        if installedVersion == 'NOT INSTALLED' then\n            table.insert(issues, ColorizeName(auraName) .. \" is not installed. Install version \" .. requiredVersion .. \" or later.\" ..\n                (prompt and \"\\n   \" .. prompt or \"\"))\n        elseif not IsUpToDate(installedVersion, requiredVersion) then\n            table.insert(issues, ColorizeName(auraName) .. \" is outdated. Update to version \" .. requiredVersion .. \"+.\" ..\n                (prompt and \" \" .. prompt or \"\"))\n        end\n    end\n    \n    if #issues > 0 then\n        print(prefix .. \"|cFF00FF00Issues detected:|r\")\n        for _, issue in ipairs(issues) do\n            print(\" - \" .. issue)\n        end\n    end\nend\n\naura_env.CheckVersions = function()\n    C_Timer.After(1, function()\n            OnInit()\n    end)\nend",
["do_custom"] = true,
},
},
