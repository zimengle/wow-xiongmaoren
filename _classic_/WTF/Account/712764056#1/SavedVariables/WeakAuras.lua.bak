["anchorPoint"] = "BOTTOMRIGHT",
["url"] = "https://afdian.com/a/Rurutia",
["actions"] = {
["start"] = {
["do_custom"] = true,
["custom"] = "local e = aura_env\nlocal Rurutia_MAIN = WeakAuras.GetRegion(\"【左上按钮】露露的问答（框架）\") \nRurutia_MAIN:Hide()\nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, nil) \n    e.btn:RegisterForClicks(\"AnyUp\",\"AnyDown\")\n    e.btn:SetAttribute(\"type\", \"macro\")\n    e.btn:SetAttribute(\"macrotext\",str)\n    e.btn:SetText(e.id)\n    e.btn:SetAllPoints(region) \nend\nlocal btn = _G[e.id..\"Button\"]\n\nbtn:SetScript(\"OnMouseUp\", function(self)\n        if Rurutia_MAIN:IsShown() then\n            Rurutia_MAIN:Hide()\n        else\n            Rurutia_MAIN:Show()\n        end\nend)\n\nlocal function onEnter(self)\n    GameTooltip:SetOwner(self, \"ANCHOR_NONE\");\n    GameTooltip:SetPoint(\"LEFT\", self, \"RIGHT\");\n    GameTooltip:ClearLines();\nend\nlocal function onLeave(self)\n    GameTooltip:Hide();\nend\nbtn:SetScript(\"OnEnter\",onEnter)\nbtn:SetScript(\"OnLeave\",onLeave)",
},
