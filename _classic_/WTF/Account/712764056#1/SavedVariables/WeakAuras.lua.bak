},
["preferToUpdate"] = false,
["displayText_format_p_time_precision"] = 1,
["selfPoint"] = "TOPLEFT",
["authorOptions"] = {
},
["yOffset"] = -70,
["justify"] = "LEFT",
["tocversion"] = 30404,
["id"] = "露露的问答-常用命令",
["uid"] = "Mgaw1dKzFf2",
["frameStrata"] = 4,
["anchorFrameType"] = "SELECTFRAME",
["parent"] = "【左上按钮】露露的问答（框架）",
["config"] = {
},
["color"] = {
1,
1,
1,
1,
},
["displayText"] = "游戏常用命令\n\n【通用】自动装备对比宏\n/run SetCVar(\"alwaysCompareItems\", \"1\")\n\n【通用】自动追踪任务命令\n/run SetCVar(\"autoQuestWatch\", 1) ReloadUI()\n\n【通用】瓦格里血条/怪物没了，试试这个命令\n/run SetCVar(\"nameplateShowOnlyNames\", 0) ReloadUI()\n\n【正式】超远视距解锁宏\n/console camerafov 90\n\n【通用】血条掉血显示与实际掉血不符（血量同步宏）\n/run SetCVar('predictedHealth', 1)\n\n【正式】鼠标放到技能栏上面看不到详细信息\n/console UberTooltips 1\n\n【通用】死亡摘要不可用\n/run SetCVar(\"CombatLogRetentionTime\",300)\n\n【正式】一键退队宏\n/script C_PartyInfo.LeaveParty()\n",
["shadowColor"] = {
0,
0,
0,
1,
},
["fixedWidth"] = 700,
["information"] = {
["forceEvents"] = false,
["ignoreOptionsEventErrors"] = false,
},
["url"] = "https://afdian.com/a/Rurutia",
},
["集结号"] = {
["text2Point"] = "CENTER",
["iconSource"] = -1,
["text1FontSize"] = 12,
["xOffset"] = 0,
["displayText"] = "%c",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["url"] = "https://afdian.com/a/Rurutia",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local e = aura_env\nlocal region = WeakAuras.GetRegion(e.id) \n\nif not _G[e.id..\"Button\"] then \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region) \n    e.btn:RegisterForClicks(\"AnyUp\")\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\n\nbtn:SetScript(\"OnClick\", function(self, button)\n        local adName ={\"MeetingHorn\", \"MeetingStone\"}\n        for k,v in ipairs(adName) do \n            if IsAddOnLoaded(v) then\n                LibStub('AceAddon-3.0'):GetAddon(v):Toggle()\n                break\n            end\n        end\n        -- ToggleLFDParentFrame()\nend)\nbtn:SetScript(\"OnMouseUp\", function(self)\n        region:SetAlpha(1)\nend)\nbtn:SetScript(\"OnMouseDown\", function(self)\n        region:SetAlpha(0.5)\nend)\nbtn:SetScript(\"OnEnter\",function(self)\n        region:SetScale(1)\nend)\nbtn:SetScript(\"OnLeave\",function(self)        \n        region:SetScale(1)\nend)\nbtn:SetScript(\"OnMouseUp\", function(self)\n        region:SetAlpha(1)\nend)\nbtn:SetScript(\"OnMouseDown\", function(self)\n        region:SetAlpha(0.5)\nend)\nbtn:SetScript(\"OnEnter\",function(self)\n        region:SetScale(1.25)\nend)\nbtn:SetScript(\"OnLeave\",function(self)\n        region:SetScale(1)\nend)",
},
},
