["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["events"] = "WA_DELAYED_PLAYER_ENTERING_WORLD",
["custom"] = "function(states, event)\n    if event == 'OPTIONS' or event == 'WA_DELAYED_PLAYER_ENTERING_WORLD' then\n        local duration = event == 'OPTIONS' and 5 or 0.1\n        for i = 1, 2 do\n            states:Update(i, {\n                    progressType   = 'timed',\n                    duration       = duration,\n                    expirationTime = duration + GetTime(),\n                    autoHide       = true, \n                    destName       = WeakAuras.me,\n                    index          = i,\n            })\n        end\n    end\nend",
["spellIds"] = {
