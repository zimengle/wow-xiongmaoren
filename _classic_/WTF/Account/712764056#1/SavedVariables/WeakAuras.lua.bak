["[Bars] [Zorlok] Exhale"] = {
["sparkWidth"] = 1,
["sparkOffsetX"] = 0,
["wagoID"] = "1qyg9npGm",
["parent"] = "[Bars] Imperial Vizier Zor'lok",
["adjustedMax"] = "",
["customText"] = "function()\n    local state = aura_env.states[4]\n    if not state then \n        return '(0%)'\n    end\n    \n    local stacks = state.stacks\n    local inc = (stacks and stacks * 50) or 0\n    \n    return '(' .. inc .. '%)'\nend",
