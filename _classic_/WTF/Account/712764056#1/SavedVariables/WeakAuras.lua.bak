["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local chatFrame = SELECTED_DOCK_FRAME\nlocal inputbox = chatFrame.editBox\nlocal e = aura_env\nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region) \n    e.btn:RegisterForClicks(\"AnyUp\",\"AnyDown\")\n    e.btn:SetScript(\"OnMouseUP\", function(self)\n            if not _G.PlayerTalentFrame then\n                _G.TalentFrame_LoadUI()\n            end\n            \n            local PlayerTalentFrame = _G.PlayerTalentFrame\n            if not PlayerTalentFrame:IsShown() then\n                ShowUIPanel(PlayerTalentFrame)\n            else\n                HideUIPanel(PlayerTalentFrame)\n            end\n            region:SetAlpha(1)\n    end)\n    e.btn:SetScript(\"OnMouseDown\", function(self)\n            region:SetAlpha(0.5)\n    end)\n    e.btn:SetScript(\"OnEnter\",function(self)\n            GameTooltip:SetOwner(self, 'ANCHOR_TOP', 0,1)\n            --            GameTooltip:AddLine(_G.TALENTS_BUTTON)\n            GameTooltip:AddLine(\"天赋和模拟器（N）\")\n            GameTooltip:Show()\n            region:SetScale(1.05)\n    end)\n    e.btn:SetScript(\"OnLeave\",function(self)\n            GameTooltip:Hide()\n            region:SetScale(1)\n    end)\n    e.btn:SetAllPoints(region)\nend\n\n\n\n\n\n\n\n\n",
},
