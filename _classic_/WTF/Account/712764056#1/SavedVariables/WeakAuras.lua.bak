["custom"] = "function(states, e, _, warning)\n    if e == 'OPTIONS' then\n        states:Update('', {count = 2, destName = WA_ClassColorName(WeakAuras.me)})\n    end\n    \n    if e == 'MERFIN_WARNING' and warning.ID == 'LightningStorm' then\n        states:Update('', {count = warning.count})\n    end\nend",
