						["event"] = "Conditions",
						["use_unit"] = true,
						["subeventPrefix"] = "SPELL",
						["custom"] = "function(sEvent, ...)\n    if sEvent == \"STATUS\" then\n        aura_env.fnInit() \n    end \nend",
