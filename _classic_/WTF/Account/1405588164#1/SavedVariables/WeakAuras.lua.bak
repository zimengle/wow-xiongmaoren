			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "local tAuraData = {}\naura_env.sPlayerClass = \"HUNTER\"\n\ntAuraData.tDotOrderIndices = {\n    [1] = \"None\", \n    [2] = \"Serpent Sting\", \n    [3] = \"Hunter's Mark\", \n    [4] = \"Black Arrow\", \n    [5] = \"Explosive Shot\", \n}\n\ntAuraData.tDotAuras = {\n    -- To Fill\n    [1978] = \"Serpent Sting\",\n    [13549] = \"Serpent Sting\",\n    [13550] = \"Serpent Sting\",\n    [13551] = \"Serpent Sting\",\n    [13552] = \"Serpent Sting\",\n    [13553] = \"Serpent Sting\",\n    [13554] = \"Serpent Sting\",\n    [13555] = \"Serpent Sting\",\n    [25295] = \"Serpent Sting\",\n    [27016] = \"Serpent Sting\",\n    [49000] = \"Serpent Sting\",\n    [49001] = \"Serpent Sting\",\n    [1130] = \"Hunter's Mark\",\n    [14323] = \"Hunter's Mark\",\n    [14324] = \"Hunter's Mark\",\n    [14325] = \"Hunter's Mark\",\n    [53338] = \"Hunter's Mark\",\n    [3674] = \"Black Arrow\",\n    [63668] = \"Black Arrow\",\n    [63669] = \"Black Arrow\",\n    [63670] = \"Black Arrow\",\n    [63671] = \"Black Arrow\",\n    [63672] = \"Black Arrow\",\n    [53301] = \"Explosive Shot\",\n    [60051] = \"Explosive Shot\",\n    [60052] = \"Explosive Shot\",\n    [60053] = \"Explosive Shot\",\n}\ntAuraData.tDamageTriggers = {\n}\n\ntAuraData.tDamageInfos = {\n}\n\ntAuraData.tSpellsInfos = {\n    -- To Fill\n    [\"Serpent Sting\"] = {\n        iDuration = 15,\n        sName = \"Serpent Sting\",\n        iIcon = 132204,\n        tGlyphDuration = {\n            iGlyphID = 237645,\n            iExtraDuration = 6,\n        },\n        iColorR = 0.138,\n        iColorG = 0.747,\n        iColorB = 0.234,\n    },    \n    [\"Hunter's Mark\"] = {\n        iDuration = 300,\n        sName = \"Hunter's Mark\",\n        iIcon = 132212,\n    },\n    [\"Black Arrow\"] = {\n        iDuration = 15,\n        sName = \"Black Arrow\",\n        iIcon = 136181,\n        iColorR = 0.448,\n        iColorG = 0.047,\n        iColorB = 0.748,\n    },\n    [\"Explosive Shot\"] = {\n        iDuration = 2,\n        sName = \"Explosive Shot\",\n        iIcon = 236178,\n        iColorR = 0.948,\n        iColorG = 0.547,\n        iColorB = 0.247,\n    },\n}\n\ntAuraData.tCastingModeBindings = aura_env.config.tCastingModeBindings.tHunter\ntAuraData.tBlacklist = aura_env.config.tBlacklist\ntAuraData.tForceDoTOrder = aura_env.config.tForceDoTOrder.tHunter\n\ntAuraData.fExecuteRange = 0.2\n\nlocal function SendAuraData()\n    WeakAuras.ScanEvents(\"MultiDotFrame_AuraData\", tAuraData, aura_env.sPlayerClass)\nend\n\naura_env.fnSendAuraData = SendAuraData\n\n",
					["do_custom"] = true,
				},
