		["MDF - Initer Backdrops"] = {
			["outline"] = "OUTLINE",
			["wagoID"] = "5Pz4pCOF5",
			["authorOptions"] = {
				{
					["type"] = "description",
					["text"] = "|cFF6666FFJeyp's Boss Frames|r",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [1]
				{
					["type"] = "description",
					["text"] = "|cFFFF6666Important |r: Always update your options when having the top most group of the WA selected (Jeyp's Boss Frames) to avoid desyncing the values.",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [2]
				{
					["type"] = "space",
					["variableWidth"] = true,
					["height"] = 1,
					["width"] = 2,
					["useHeight"] = false,
				}, -- [3]
				{
					["desc"] = "|cFF6666FFClassic Skin|r : Progress bars showing the status of all DoTs in a visual way.|n|cFF66FF66Alternative Skin|r : Made by Solah. More compact and uses Icons to display the status of DoTs.",
					["type"] = "select",
					["values"] = {
						"Classic", -- [1]
						"Alternative", -- [2]
					},
					["default"] = 1,
					["key"] = "iSkin",
					["useDesc"] = true,
					["name"] = "Skin",
					["width"] = 2,
				}, -- [4]
			},
			["displayText_format_p_time_dynamic_threshold"] = 60,
			["yOffset"] = 0,
			["anchorPoint"] = "CENTER",
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/5Pz4pCOF5/108",
			["actions"] = {
				["start"] = {
					["do_message"] = false,
				},
				["init"] = {
					["custom"] = "-- This WA is used to Init the Borders at a single location.\nlocal sEventName_AttemptTarget = \"MultiDotFrame_AttemptTarget\"\n\nlocal tBackdropData = {}\naura_env.tBackdropData = tBackdropData\ntBackdropData.sMode = aura_env.config.sMode\n\nlocal sSetupTargetMacro = \"/tar [@target,noexists] player\\n/cleartarget\\n/targetlasttarget\\n\"\nlocal sRestoreTargetMacro = \"/targetlasttarget\\n/targetlasttarget [@target,noexists]\\n/cleartarget [@target,help]\\n\"\n\nlocal tReservedSpells = {\n    [\"focus\"] = true,\n    [\"target\"] = true,\n    [\"petattack\"] = true,\n}\n\nlocal function GetMacroAction(sAction, sSpell, sShiftSpell, sCtrlSpell, sAltSpell)\n    local sMacro = \"\"\n    local sMacro2 = \"\"\n    local bIsSet = false\n    local function SetupMacro(sModifierSpell, sModifier)\n        if sModifierSpell == sAction then\n            if not bIsSet then \n                sMacro = \"\\n/targetexact \"\n                sMacro2 = \"\\n/\" .. sAction .. \" \"\n            end\n            sMacro = sMacro .. \"[mod:\" .. sModifier .. \"]\"\n            sMacro2 = sMacro2 .. \"[mod:\" .. sModifier .. \"]\"\n            bIsSet = true\n        end\n    end\n    if sAction == sSpell then\n        sMacro = \"\\n/targetexact [nomod]\"\n        sMacro2 = \"\\n/\" .. sAction .. \" [nomod]\"\n        bIsSet = true\n    end\n    SetupMacro(sShiftSpell, \"shift\")\n    SetupMacro(sCtrlSpell, \"ctrl\")\n    SetupMacro(sAltSpell, \"alt\")\n    \n    if bIsSet then \n        sMacro = sMacro .. aura_env.tZoneData.sTarName .. \"\\n\"  \n    end\n    \n    return bIsSet, sMacro, sMacro2\nend\n\nlocal function GetMacroSpell(sSpell, sShiftSpell, sCtrlSpell, sAltSpell)\n    local sMacro = \"\"\n    local bHasSpell = false\n    local function SetupSpellMacro(sModifierSpell, sModifier)\n        if sModifierSpell ~= \"\" and (tReservedSpells[sModifierSpell] == nil) then\n            if bHasSpell  then \n                sMacro = sMacro .. \"; \"\n            end\n            sMacro = sMacro .. \"[mod:\" .. sModifier .. \"] \" .. sModifierSpell\n            bHasSpell = true\n        end\n    end\n    if sSpell ~= \"\" and tReservedSpells[sModifierSpell] == nil then\n        sMacro = sMacro .. \"[nomod] \" .. sSpell\n        bHasSpell = true\n    end\n    SetupSpellMacro(sShiftSpell , \"shift\")\n    SetupSpellMacro(sCtrlSpell , \"ctrl\")\n    SetupSpellMacro(sAltSpell, \"alt\")\n    \n    return bHasSpell, sMacro\nend\n\nlocal function GetBindingMacro(sSpell, sShiftSpell, sCtrlSpell, sAltSpell)\n    local sMacro = \"\"\n    local bHasSpell, sMacro = GetMacroSpell(sSpell, sShiftSpell, sCtrlSpell, sAltSpell)  \n    local bHasTarget, sTargetMacro = GetMacroAction(\"target\", sSpell, sShiftSpell, sCtrlSpell, sAltSpell)\n    local bHasFocus, sFocusMacro, sFocusMacro2 = GetMacroAction(\"focus\", sSpell, sShiftSpell, sCtrlSpell, sAltSpell)\n    local bHasPetAttack, sPetAttackMacro, sPetAttackMacro2 = GetMacroAction(\"petattack\", sSpell, sShiftSpell, sCtrlSpell, sAltSpell)\n    \n    \n    if bHasSpell then \n        sMacro = sSetupTargetMacro .. \"/targetexact \" .. aura_env.tZoneData.sTarName .. \"\\n/cast \" .. sMacro .. \"\\n\" .. sRestoreTargetMacro \n    end\n    if bHasTarget then\n        sMacro = sMacro .. sTargetMacro .. \"\\n/run WeakAuras.ScanEvents('\" .. sEventName_AttemptTarget .. \"', '\" .. aura_env.sFrameID .. \"')\"\n    end\n    if bHasPetAttack then\n        sMacro = sMacro .. sSetupTargetMacro .. sPetAttackMacro .. sPetAttackMacro2 .. \"\\n\" .. sRestoreTargetMacro \n    end\n    if bHasFocus then\n        sMacro = sMacro .. sSetupTargetMacro .. sFocusMacro .. sFocusMacro2 .. \"\\n\" .. sRestoreTargetMacro \n    end\n    return sMacro\nend\n\nlocal function SetupSecuredFrame()    \n    if not aura_env.clickableFrame then\n        if _G[aura_env.sFrameName] then \n            aura_env.clickableFrame = _G[aura_env.sFrameName]\n        else \n            local r = aura_env.region\n            aura_env.clickableFrame = CreateFrame(\"Button\", aura_env.sFrameName, r, \"SecureActionButtonTemplate\")\n            aura_env.clickableFrame:RegisterForClicks(\"AnyUp\");--   Register all buttons\n            aura_env.clickableFrame:SetAllPoints()\n            aura_env.clickableFrame:SetAttribute(\"*type1\", \"macro\")   \n            aura_env.clickableFrame:SetAttribute(\"*type2\", \"macro\") \n            aura_env.clickableFrame:SetAttribute(\"*type3\", \"macro\") \n            aura_env.clickableFrame:SetAttribute(\"*type4\", \"macro\") \n            aura_env.clickableFrame:SetAttribute(\"*type5\", \"macro\")   \n        end\n    end\n    \n    if aura_env.clickableFrame then \n        local sLClickMacro, sRClickMacro, sMClickMacro, s4ClickMacro, s5ClickMacro = \"\",\"\",\"\",\"\",\"\"\n        \n        sLClickMacro = GetBindingMacro(tBackdropData.tBindings.tLClick.sSpell, tBackdropData.tBindings.tSLClick.sSpell, tBackdropData.tBindings.tCLClick.sSpell, tBackdropData.tBindings.tALClick.sSpell)\n        sRClickMacro = GetBindingMacro(tBackdropData.tBindings.tRClick.sSpell, tBackdropData.tBindings.tSRClick.sSpell, tBackdropData.tBindings.tCRClick.sSpell, tBackdropData.tBindings.tARClick.sSpell)\n        sMClickMacro = GetBindingMacro(tBackdropData.tBindings.tMClick.sSpell, tBackdropData.tBindings.tSMClick.sSpell, tBackdropData.tBindings.tCMClick.sSpell, tBackdropData.tBindings.tAMClick.sSpell)\n        s4ClickMacro = GetBindingMacro(tBackdropData.tBindings.t4Click.sSpell, tBackdropData.tBindings.tS4Click.sSpell, tBackdropData.tBindings.tC4Click.sSpell, tBackdropData.tBindings.tA4Click.sSpell)\n        s5ClickMacro = GetBindingMacro(tBackdropData.tBindings.t5Click.sSpell, tBackdropData.tBindings.tS5Click.sSpell, tBackdropData.tBindings.tC5Click.sSpell, tBackdropData.tBindings.tA5Click.sSpell)\n        \n        --print(s4ClickMacro)\n        aura_env.clickableFrame:SetAttribute(\"*macrotext1\", sLClickMacro)\n        aura_env.clickableFrame:SetAttribute(\"*macrotext2\", sRClickMacro)\n        aura_env.clickableFrame:SetAttribute(\"*macrotext3\", sMClickMacro)\n        aura_env.clickableFrame:SetAttribute(\"*macrotext4\", s4ClickMacro)\n        aura_env.clickableFrame:SetAttribute(\"*macrotext5\", s5ClickMacro)\n    end\n    \n    return true\nend\ntBackdropData.fnSetupSecuredFrame = SetupSecuredFrame\n\nlocal function InitBorderDuplicateData()\n    -- Care - This could be called after the values have already been initialized, depending on the order in which the Init and the ZoneChanged events are received. Don't override anything that isn't nil\n    if aura_env.bShown == nil then aura_env.bShown = true end\nend\ntBackdropData.fnInitDuplicateData = InitBorderDuplicateData\n\nlocal function Init(tClassData)\n    tBackdropData.tBindings = tClassData.tCastingModeBindings\n    WeakAuras.ScanEvents(\"MultiDotFrame_InitBackdrops\", tBackdropData)\nend\naura_env.fnInit = Init\n\n",
					["do_custom"] = true,
				},
