,\n            },\n        },\n        [\"B\"] = {\n            sNPCID = \"33966\",\n            sTarName = \"Crusher Tentacle\",\n            iIcon = 133574,\n            tEnabledOptions = {\n                \"bYoggSaronFight\", \n                \"bCrusherTentacle\",\n            },\n        },\n        [\"C\"] = {\n            sNPCID = \"33985\",\n            sTarName = \"Corruptor Tentacle\",\n            iIcon = 237521,\n            tEnabledOptions = {\n                \"bYoggSaronFight\", \n                \"bCorruptorTentacle\",\n            },\n        },\n    },\n}\n\nlocal function SendZonesData()\n    WeakAuras.ScanEvents(\"MultiDotFrame_ZonesData_Section\", tZonesData)\nend\n\naura_env.fnSendZonesData = SendZonesData\n\n",
