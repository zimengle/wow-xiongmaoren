		["基本信息"] = {
			["outline"] = "OUTLINE",
			["wagoID"] = "VMfNhd-Bp",
			["xOffset"] = -329.66614532471,
			["preferToUpdate"] = false,
			["customText"] = "function ()\n    local maxh,maxm=0\n    maxh=UnitHealthMax(\"PLAYER\")\n    maxm=UnitPowerMax(\"PLAYER\")\n    local str=''\n    local className, classFilename, classId = UnitClass('Player')\n    local realmName = GetRealmName()\n    local name=GetUnitName(\"PLAYER\")\n    local level=UnitLevel('PLAYER')\n    \n    \n    --服务器：%1.realm   角色名：%1.name    职业：%1.class\n    --等级：%3.level   生命值：%c1 能量值：%c2\n    if classId==11 then str=\"|cffff7d0a\" end\n    if classId==1 then str=\"|cffc79c6e\" end\n    if classId==2 then str=\"|cfff58cba\" end\n    if classId==6 then str=\"|cffc31f3b\" end\n    \n    str=str..'iTank坦克生存输出评分 V2.2.3 WLKC'..'\\n'\n    str=str..'服务器：'..realmName..'   角色名：'..name..'   职业：'..className..'\\n'\n    str=str..'等级：'..level..'   生命值：'..maxh..'   能量值：'..maxm..'\\n'\n    \n    str=str..\"|r\";\n    return str\n    \nend\n\n--Author and modifier information, please do not delete those comment.\n--Coder by: A打头的那个@NGA\n--UI designer：ahhz@NGA\n--DPS model designer：青酒醉红颜123@NGA\n--2022.11.17",
