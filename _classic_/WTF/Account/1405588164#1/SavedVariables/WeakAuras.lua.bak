				["specifiedMark"] = 9,
				["emphasizeIcon"] = false,
				["overrideSettings"] = false,
				["emphasizeText"] = true,
				["npcID"] = "33271",
				["raidLeader"] = false,
				["showName"] = false,
				["specifiedSound"] = 1,
				["showCastDuration"] = true,
				["flashColor"] = {
					1, -- [1]
