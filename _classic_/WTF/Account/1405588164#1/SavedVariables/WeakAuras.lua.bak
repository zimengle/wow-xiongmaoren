						["unit"] = "player",
						["custom"] = "function()\n    aura_env.roster = {}\n    for unit in WA_IterateGroupMembers() do\n        aura_env.roster[UnitGUID(unit)] = unit\n    end\n    return false\nend",
						["debuffType"] = "HELPFUL",
