						["subeventSuffix"] = "_CAST_START",
						["subeventPrefix"] = "SPELL",
						["custom"] = "function(a, _, _, subEvent, _, _, _, _, _, _, _, _, _, spellId)\n    if subEvent == \"SPELL_CAST_START\" then\n        if aura_env.spell[spellId] then\n            aura_env.timed(a, aura_env.cast[spellId], \"CHAIN_LIGHTNING_START\", \"CHAIN_LIGHTNING_END\", aura_env.count)\n            return true\n        end\n    end\nend",
