			["height"] = 30,
			["internalVersion"] = 66,
			["load"] = {
				["use_class"] = true,
				["use_encounterid"] = true,
				["use_never"] = false,
				["talent"] = {
					["multi"] = {
					},
				},
				["spec"] = {
					["multi"] = {
					},
				},
				["class"] = {
					["single"] = "SHAMAN",
					["multi"] = {
					},
				},
				["encounterid"] = "755",
				["size"] = {
					["multi"] = {
					},
				},
			},
			["sparkBlendMode"] = "ADD",
			["useAdjustededMax"] = false,
			["actions"] = {
				["start"] = {
				},
				["finish"] = {
					["do_sound"] = false,
				},
				["init"] = {
					["custom"] = "-- Interrupt Rotation Template v1.0.1\n-- WeakAura TSU Template v1.0.1\n\n-- Custom constants\n\n-- Structure: {\n--   <npc_id> = {\n--     <spell_id> = <cast_time>,\n--     ...\n--   },\n--   ...\n-- }\naura_env.SPELL_CAST_TIMES = {\n    [33271] = {  -- general-vezax\n        [62661] = select(4, GetSpellInfo(62661)) / 1000,  -- Searing Flames (25-man)\n    },\n}\n\naura_env.GROUP_NAME_FORMAT = 'Group %i'\naura_env.GROUP_STATES = {\n    NONE = 1,\n    NEXT_INTERRUPT = 2,\n    CURRENTLY_CASTING = 3,\n    CAST_FAILED = 4,\n    CAST_SUCCEEDED = 5,\n}\n\naura_env.SPELL_DURATION_ADJUSTMENT = -0.05\n\n-- Custom variables\n\naura_env.current_group_index = -1\naura_env.groups = {}\n\n-- Custom functions\n\nfunction aura_env.get_next_group_index()\n    return (aura_env.current_group_index % aura_env.config.num_groups) + 1\nend\n\nfunction aura_env.increment_current_group_index()\n    aura_env.current_group_index = aura_env.get_next_group_index()\nend\n\nfunction aura_env.set_current_group_state(state, opt_cast_time)\n    local current_group = aura_env.groups[aura_env.current_group_index]\n    current_group.state = state\n    if opt_cast_time ~= nil then\n        local now = GetTime()\n        current_group.expiration_time = now + opt_cast_time\n        current_group.duration = opt_cast_time\n    else\n        current_group.expiration_time = -1\n        current_group.duration = 0\n    end\nend\n\nfunction aura_env.start_turn(cast_time)\n    aura_env.set_current_group_state(\n    aura_env.GROUP_STATES.CURRENTLY_CASTING, cast_time)\nend\n\nfunction aura_env.end_turn(result_state)\n    aura_env.set_current_group_state(result_state)\n    aura_env.increment_current_group_index()\n    aura_env.set_current_group_state(aura_env.GROUP_STATES.NEXT_INTERRUPT)\nend\n\nfunction aura_env.find_spell_cast_time(npc_id, spell_id)\n    local spells = aura_env.SPELL_CAST_TIMES[npc_id]\n    if not spells then\n        return nil\n    end\n    local cast_time = spells[spell_id]\n    if cast_time == nil then\n        return nil\n    end\n    return cast_time + aura_env.SPELL_DURATION_ADJUSTMENT\nend\n\n-- Customized functions\n\nfunction aura_env.reset()\n    aura_env.current_group_index = 1\n    aura_env.groups = {}\n    for index = 1, aura_env.config.num_groups do\n        aura_env.groups[index] = {\n            name = string.format(aura_env.GROUP_NAME_FORMAT, index),\n            state = aura_env.GROUP_STATES.NONE,\n            expiration_time = -1,\n            duration = 0,\n        }\n    end\n    aura_env.groups[1].state = aura_env.GROUP_STATES.NEXT_INTERRUPT\nend\n\nfunction aura_env.register_event_handlers()\n    local reset_handler = function(event, ...)\n        aura_env.reset()\n        return true\n    end\n    aura_env.add_event_handler('ENCOUNTER_START', reset_handler)\n    aura_env.add_event_handler('PLAYER_REGEN_DISABLED', reset_handler)\n    \n    local spell_cast_handler = function(event, ...)\n        local subevent = select(2, ...)\n        local npc_id = aura_env.parse_npc_id_from_guid(select(4, ...))\n        local spell_id = select(12, ...)\n        local cast_time = aura_env.find_spell_cast_time(npc_id, spell_id)\n        if cast_time == nil then\n            return false\n        end\n        \n        if subevent == 'SPELL_CAST_START' then\n            aura_env.start_turn(cast_time)\n            return true\n        elseif subevent == 'SPELL_CAST_SUCCESS' then\n            aura_env.end_turn(aura_env.GROUP_STATES.CAST_SUCCEEDED)\n            return true\n        elseif subevent == 'SPELL_CAST_FAILED' then\n            aura_env.end_turn(aura_env.GROUP_STATES.CAST_FAILED)\n            return true\n        end\n        return false\n    end\n    aura_env.add_combat_log_event_handler(\n    'SPELL_CAST_START', spell_cast_handler)\n    aura_env.add_combat_log_event_handler(\n    'SPELL_CAST_SUCCESS', spell_cast_handler)\n    aura_env.add_combat_log_event_handler(\n    'SPELL_CAST_FAILED', spell_cast_handler)\n    \n    local spell_interrupt_handler = function(event, ...)\n        local subevent = select(2, ...)\n        local npc_id = aura_env.parse_npc_id_from_guid(select(8, ...))\n        local spell_id = select(15, ...)\n        local cast_time = aura_env.find_spell_cast_time(npc_id, spell_id)\n        if cast_time == nil then\n            return false\n        end\n        \n        if subevent == 'SPELL_INTERRUPT' then\n            aura_env.end_turn(aura_env.GROUP_STATES.CAST_FAILED)\n            return true\n        end\n        return false\n    end\n    aura_env.add_combat_log_event_handler(\n    'SPELL_INTERRUPT', spell_interrupt_handler)\nend\n\nfunction aura_env.update_allstates(allstates, is_options_open)\n    for index = 1, aura_env.config.num_groups do\n        local group = aura_env.groups[index]\n        local is_player_group = index == aura_env.config.player_group_index - 1\n        local show_glow = is_player_group and group.state == 3 and\n        aura_env.config.use_animated_border\n        local show_border = aura_env.config.num_groups > 1 and not show_glow and\n        (group.state == 2 or group.state == 3)\n        -- Disable sounds when (group.state == 2) if (num_groups == 1)\n        local play_sounds = aura_env.config.play_sounds and\n        (aura_env.config.num_groups > 1 or group.state ~= 2)\n        allstates[index] = {\n            changed = true,\n            show = true,\n            progressType = 'timed',\n            index = index,\n            name = group.name,\n            expirationTime = group.expiration_time,\n            duration = group.duration,\n            showBorder = show_border,\n            showGlow = show_glow,\n            groupState = group.state,\n            isPlayerGroup = is_player_group,\n            playSounds = play_sounds,\n        }\n    end\n    return true\nend\n\n-- Common utility functions\n\nfunction aura_env.parse_npc_id_from_guid(guid)\n    if not guid then\n        return nil\n    end\n    -- https://wowpedia.fandom.com/wiki/GUID\n    local unit_type, _, _, _, _, npc_id = strsplit('-', guid)\n    if unit_type ~= 'Creature' then\n        return nil\n    end\n    return tonumber(npc_id)\nend\n\n-- Structure: {\n--   [<event_key>] = <handler_array>  -- {function(event, ...):boolean, ...}\n-- }\naura_env.EVENT_HANDLERS = {}\naura_env.COMBAT_LOG_EVENT_HANDLERS = {}\n\n-- Event handler signature: function(event, ...):boolean\nfunction aura_env.add_event_handler(event, handler)\n    if not aura_env.EVENT_HANDLERS[event] then\n        aura_env.EVENT_HANDLERS[event] = {}\n    end\n    table.insert(aura_env.EVENT_HANDLERS[event], handler)\nend\n\n-- Combat log event handler signature: function(event, ...):boolean\n-- https://wowpedia.fandom.com/wiki/COMBAT_LOG_EVENT\nfunction aura_env.add_combat_log_event_handler(subevent, handler)\n    if not aura_env.COMBAT_LOG_EVENT_HANDLERS[subevent] then\n        aura_env.COMBAT_LOG_EVENT_HANDLERS[subevent] = {}\n    end\n    table.insert(aura_env.COMBAT_LOG_EVENT_HANDLERS[subevent], handler)\nend\n\nfunction aura_env.handle_event_helper(event_handler_map, event_key, event, ...)\n    local event_handlers = event_handler_map[event_key]\n    if not event_handlers then\n        return false\n    end\n    local handled = false\n    for _, handler in ipairs(event_handlers) do\n        handled = handled or handler(event, ...)\n    end\n    return handled\nend\n\nfunction aura_env.handle_event(event, ...)\n    if event == 'COMBAT_LOG_EVENT_UNFILTERED' then\n        return aura_env.handle_event_helper(\n            aura_env.COMBAT_LOG_EVENT_HANDLERS, select(2, ...), event, ...)\n    else\n        return aura_env.handle_event_helper(\n        aura_env.EVENT_HANDLERS, event, event, ...)\n    end\nend\n\n-- Init code\n\naura_env.register_event_handlers()\naura_env.reset()",
					["do_custom"] = true,
				},
			},
