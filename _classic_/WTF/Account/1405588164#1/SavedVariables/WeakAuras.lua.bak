			["displayText_format_1.name_realm_name"] = "never",
			["outline"] = "OUTLINE",
			["wagoID"] = "FOgRTsreg",
			["parent"] = "冰12345",
			["customText"] = "",
			["shadowYOffset"] = -1,
			["cooldownSwipe"] = true,
			["customTextUpdate"] = "update",
			["cooldownEdge"] = false,
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["custom_type"] = "stateupdate",
						["customVariables"] = "{\n    glow = \"bool\"\n}",
						["event"] = "Health",
						["unit"] = "player",
						["subeventSuffix"] = "_CAST_START",
						["subeventPrefix"] = "SPELL",
						["spellIds"] = {
						},
						["names"] = {
						},
						["check"] = "event",
						["custom"] = "function(a, event, _, subEvent, _, _, _, _, _, destGUID, _, _, _, spellId)\n    if spellId == aura_env.spell then\n        if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" then\n            if not aura_env.last or aura_env.last < GetTime() - 15 then\n                aura_env.last = GetTime()\n                C_Timer.After(0.05, function()\n                        WeakAuras.ScanEvents(\"ANUBARAK_PC_SCAN\")\n                end)\n            end\n            \n        elseif subEvent == \"SPELL_PERIODIC_DAMAGE\" or subEvent == \"SPELL_PERIODIC_MISSED\" then\n            if not aura_env.config.notick then\n                local unit = aura_env.roster[destGUID]\n                if a[unit] then\n                    WeakAuras.ScanEvents(\"PC_TICK_START\", 3, unit)\n                end\n            end\n            \n        elseif subEvent == \"SPELL_AURA_REMOVED\" then\n            local unit = aura_env.roster[destGUID]\n            aura_env.off(a, unit)\n            WeakAuras.ScanEvents(\"PC_TICK_END\", _, unit)\n            return true\n        end\n        \n    elseif event == \"ANUBARAK_PC_SCAN\" then\n        for _, state in pairs(a) do\n            state.show = false\n            WeakAuras.ScanEvents(\"PC_TICK_END\", _, state.unit)\n        end\n        aura_env.count = 0\n        for unit in WA_IterateGroupMembers() do\n            if WA_GetUnitDebuff(unit, aura_env.spell) and select(6, WA_GetUnitDebuff(unit, aura_env.spell)) - GetTime() > 15 then\n                aura_env.count = aura_env.count + 1\n                aura_env.blank(a, unit)\n                a[unit].unit = unit\n                a[unit].index = aura_env.count\n                a[unit].glow = aura_env.config.numbers[aura_env.count]\n                if not aura_env.config.notick then\n                    WeakAuras.ScanEvents(\"PC_TICK_START\", 2.95, unit)\n                end\n            end\n        end\n        return true\n    end\nend",
						["events"] = "CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REFRESH:SPELL_AURA_REMOVED:SPELL_PERIODIC_DAMAGE:SPELL_PERIODIC_MISSED,ANUBARAK_PC_SCAN",
						["debuffType"] = "HELPFUL",
