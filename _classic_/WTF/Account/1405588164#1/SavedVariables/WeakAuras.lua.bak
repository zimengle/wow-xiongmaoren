			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "aura_env.spell = {\n    [64390] = true,\n    [62131] = true\n}\n\naura_env.cast = {\n    [64390] = 0.5,\n    [62131] = 0.5\n}\n\naura_env.cdfirst = 13\naura_env.cd = 8\n\naura_env.text = GetSpellInfo(64390)\n\nfunction aura_env.timed(a, duration, startevent, endevent, extra)\n    WeakAuras.timer:CancelTimer(aura_env.timer)\n    if startevent then\n        WeakAuras.ScanEvents(startevent, duration, extra)\n    end\n    if endevent and duration then\n        aura_env.timer = WeakAuras.timer:ScheduleTimer(WeakAuras.ScanEvents, duration, endevent, extra)\n    end\n    if duration >0 then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            autoHide = true,\n            progressType = \"timed\",\n            duration = duration,\n            expirationTime = duration + GetTime(),\n            name = aura_env.text,\n            stacks = aura_env.count\n        }\n    end\nend\n\nfunction aura_env.blank(a)\n    a[\"\"] = {\n        show = true,\n        changed = true,\n        name = aura_env.text,\n        stacks = aura_env.count\n    }\nend\n\nfunction aura_env.off(a)\n    a[\"\"] = {\n        show = false\n    }\nend",
					["do_custom"] = true,
				},
				["finish"] = {
				},
			},
		},
