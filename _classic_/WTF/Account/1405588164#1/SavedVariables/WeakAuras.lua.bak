			["sparkTexture"] = "Interface\\CastingBar\\UI-CastingBar-Spark",
			["auto"] = false,
			["displayText_format_1.npcid_format"] = "none",
			["crop_x"] = 0.41,
			["orientation"] = "HORIZONTAL",
			["alpha"] = 1,
			["displayText"] = "Use Elixir of Demonslaying?",
			["uid"] = "F64AWGfNev)",
			["config"] = {
			},
			["foregroundTexture"] = "Interface\\AddOns\\WeakAuras\\Media\\Textures\\Ring_10px.tga",
			["zoom"] = 0.32,
			["width"] = 220,
			["fixedWidth"] = 200,
			["adjustedMax"] = "10",
			["backgroundOffset"] = 2,
			["outline"] = "OUTLINE",
			["color"] = {
				1, -- [1]
				1, -- [2]
				1, -- [3]
				1, -- [4]
			},
			["sparkOffsetX"] = 0,
			["wagoID"] = "F2PsfgKth",
			["parent"] = "Algalon - Stars Health - Bars",
			["id"] = "Algaon - Stars Health - Bar",
			["customText"] = "function()\n    local healthDelta, percentHealth = nil, nil\n    \n    local state = aura_env.state\n    if state and state.value and state.total then\n        percentHealth = Round((state.value / state.total) * 100)\n    end\n    if state and state.healthDelta then\n        healthDelta = string.format(\"%+.1fk\", state.healthDelta / 1000)\n    end\n    \n    return healthDelta, percentHealth\nend",
			["shadowYOffset"] = -1,
			["actions"] = {
				["start"] = {
				},
				["finish"] = {
				},
				["init"] = {
					["custom"] = "local npcName = \"坍缩星\"\nlocal addonMsgPrefix = \"WA_STARS_SYNC\"\nlocal amountIndexes = {\n    [\"SWING_DAMAGE\"] = 12,\n    [\"RANGE_DAMAGE\"] = 15,\n    [\"SPELL_DAMAGE\"] = 15,\n    [\"SPELL_PERIODIC_DAMAGE\"] = 15,\n    [\"ENVIRONMENTAL_DAMAGE\"] = 13,\n}\nlocal bigBangTime = nil\n\nlocal function syncNewUnit(allStates, unit)\n    DebugPrint(\"syncNewUnit\", unit)\n    -- Bail if not Collapsing Star\n    if UnitName(unit) ~= npcName then\n        return false\n    end\n    -- Bail if GUID isn't new\n    local guid = UnitGUID(unit)\n    if allStates[guid] then\n        return false\n    end\n    \n    DebugPrint(\"SyncEvents\", guid, UnitHealth(unit), UnitHealthMax(unit))\n    local syncMessage = strconcat(guid, \"|\", UnitHealth(unit), \"|\", UnitHealthMax(unit), \"|\")\n    C_ChatInfo.SendAddonMessage(addonMsgPrefix, syncMessage, \"RAID\")\n    return false  -- we'll update by receiving our own sync message\nend\n\nfunction aura_env.NAME_PLATE_UNIT_ADDED(allStates, unit)\n    if not unit then\n        return false\n    end\n    return syncNewUnit(allStates, unit)\nend\n\nfunction aura_env.UPDATE_MOUSEOVER_UNIT(allStates)\n    return syncNewUnit(allStates, \"mouseover\")\nend\n\nfunction aura_env.CHAT_MSG_ADDON(allStates, prefix, text, channel)\n    -- Bail if unknown AddOn prefix\n    if prefix ~= addonMsgPrefix then\n        return false\n    end\n    -- Bail if not sent through raid chat\n    if channel ~= \"RAID\" then\n        return false\n    end\n    DebugPrint(\"CHAT_MSG_ADDON\", text)\n    local guid, health, healthMax = strsplit(\"|\", text)\n    -- Bail if GUID isn't new\n    if allStates[guid] then\n        return false\n    end\n    \n    allStates[guid] = {\n        show = true,\n        changed = true,\n        guid = guid,\n        name = npcName,\n        progressType = \"static\",\n        value = tonumber(health),\n        total = tonumber(healthMax),\n    }\n    return true\nend\n\nlocal function update(state, delta)\n    DebugPrint(\"update\", state.guid, delta)\n    -- Star health\n    state.value = state.value - delta\n    state.show = state.value > 0\n    state.changed = true\n    \n    -- Star health delta required for it to die during Big Bang\n    if bigBangTime then\n        local timeUntilBigBang = bigBangTime - GetTime()\n        local requiredHealth = (timeUntilBigBang * state.total) / 100\n        state.healthDelta = state.value - requiredHealth\n        WeakAuras.ScanEvents(\"WA_ALGALON_STAR_HEALTH_DELTA\", state.guid, state.healthDelta)\n    end\n    \n    return true\nend\n\nfunction aura_env.COMBAT_LOG_EVENT_UNFILTERED(allStates, _, subEvent, _, _, _, _, _, destGUID, destName, _, destRaidFlags, ...)\n    -- Bail if not Collapsing Star\n    if destName ~= npcName then\n        return false\n    end\n    -- Bail if not damage event\n    local amountIndex = amountIndexes[subEvent]\n    if not amountIndex then\n        return false\n    end\n    -- Bail if star health not known (awaiting sync)\n    local state = allStates[destGUID]\n    if not state then\n        return false\n    end\n    \n    -- Update raid mark\n    local raidTargetIndex = math.log(destRaidFlags) / math.log(2) + 1\n    state.mark = raidTargetIndex > 0 and (ICON_LIST[raidTargetIndex] .. \"0|t\")\n    \n    -- Subtract damage amount from star's health\n    -- We subtract 11 from the amountIndex to account for the named arguments before the variable arguments table ('...')\n    local amount = select(amountIndex - 11, ...)\n    return update(state, amount)\nend\n\nfunction aura_env.WA_ALGALON_STAR_PERIODIC_DAMAGE(allStates)\n    -- Stars lose 1% health every second\n    DebugPrint(\"WA_ALGALON_STAR_PERIODIC_DAMAGE\")\n    for _, state in pairs(allStates) do\n        update(state, state.total * 0.01)\n    end\n    return true\nend\n\nfunction aura_env.CHAT_MSG_MONSTER_YELL(allStates, text, ...)\n    -- The first Big Bang is 80 seconds from first stars spawn\n    if text == \"群星将为我而战！\" then\n        DebugPrint(\"CHAT_MSG_MONSTER_YELL\", text)\n        bigBangTime = GetTime() + 80\n    end\n    return false\nend\n\nfunction aura_env.UNIT_SPELLCAST_START(allStates, _, _, spellId)\n    -- Subsequent Big Bangs are every 90 seconds + 8 second cast time\n    if spellId == 64584 or spellId == 64443 then\n        DebugPrint(\"UNIT_SPELLCAST_START\", spellId)\n        C_Timer.After(8, function()\n                bigBangTime = GetTime() + 90\n        end)\n    end\n    return false\nend\n\nfunction aura_env.OPTIONS(allStates)\n    if not WeakAuras.IsOptionsOpen() then\n        return false\n    end\n    DebugPrint(\"OPTIONS\")\n    bigBangTime = GetTime() + fastrandom(40, 80)\n    for i=1,4 do\n        allStates[i] = {\n            show = true,\n            changed = true,\n            name = npcName,\n            progressType = \"static\",\n            value = fastrandom(60000, 211680),\n            total = 211680,\n        }\n    end\n    return true\nend\n\nlocal function reset(allStates)\n    DebugPrint(\"reset\")\n    bigBangTime = nil\n    for _, state in pairs(allStates) do\n        state.show = false\n        state.changed = true\n    end\n    return true\nend\n\nfunction aura_env.ENCOUNTER_START(allStates, ...)\n    DebugPrint(\"ENCOUNTER_START\")\n    return reset(allStates)\nend\n\nfunction aura_env.STATUS(allStates)\n    DebugPrint(\"STATUS\")\n    return reset(allStates)\nend\n\nC_ChatInfo.RegisterAddonMessagePrefix(addonMsgPrefix)",
					["do_custom"] = true,
				},
			},
