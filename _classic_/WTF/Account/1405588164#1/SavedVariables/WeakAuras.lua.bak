			["url"] = "https://wago.io/5Pz4pCOF5/108",
			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"deDE\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] = \"Die große Schmiede\",\n    [\"War Quarter\"] = \"Kriegsviertel\",\n    [\"Heroic Training Dummy\"] = \"Heroische Trainingsattrappe\",\n    [\"Grandmaster's Training Dummy\"] = \"Übungsattrappe des Großmeisters\",\n    [\"Expert's Training Dummy\"] = \"Übungsattrappe des Experten\",\n    [\"Master's Training Dummy\"] = nil,\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = \"Das Obsidiansanktum\",\n    [\"Tenebron\"] = \"Tenebron\",\n    [\"Shadron\"] = nil, -- Same as EN\n    [\"Vesperon\"] = nil, -- Same as EN\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = nil,\n    [\"Baron Rivendare\"] = nil, -- Same as EN\n    [\"Thane Korth'azz\"] = nil, -- Same as EN\n    [\"Lady Blaumeux\"] = nil, -- Same as EN\n    -- Ulduar\n    [\"Formation Grounds\"] = \"Gestaltungsgelände\",\n    [\"Flame Leviathan\"] = \"Flammenleviathan\",\n    [\"The Colossal Forge\"] = \"Die kollossale Schmiede\",\n    [\"Ignis the Furnace Master\"] = \"Ignis, Meister des Eisenwerks\",\n    [\"Razorscale's Aerie\"] = \"Klingenschuppes Kanzel\",\n    [\"Razorscale\"] = \"Klingenschuppe\",\n    [\"The Scrapyard\"] = \"Der Schrottplatz\",\n    [\"XT-002 Deconstructor\"] = \"XT-002 Dekonstruktor\",\n    [\"The Celestial Planetarium\"] = \"Das Himmlische Planetarium\",\n    [\"Algalon the Observer\"] = \"Algalon der Beobachter\",\n    [\"The Observation Ring\"] = \"Der Beobachtungsring\",\n    [\"Auriaya\"] = nil, -- Same as EN\n    [\"The Halls of Winter\"] = \"Die Hallen des Winters\",\n    [\"Hodir\"] = nil, -- Same as EN\n    [\"The Clash of Thunder\"] = \"Der Donnerschlag\",\n    [\"Thorim\"] = nil, -- Same as EN\n    [\"The Descent into Madness\"] = nil,\n    [\"General Vezax\"] = nil, -- Same as EN\n    [\"The Prison of Yogg-Saron\"] = nil,\n    [\"Yogg-Saron\"] = nil, -- Same as EN\n    [\"The Assembly of Iron\"] = \"Die Versammlung des Eisens\",\n    [\"Stormcaller Brundir\"] = \"Sturmrufer Brundir\",\n    [\"Runemaster Molgeim\"] = \"Runenmeister Molgeim\",\n    [\"Steelbreaker\"] = \"Stahlbrecher\",\n    [\"The Shattered Walkway\"] = \"Der zerschmetterte Gang\",\n    [\"Right Arm\"] = \"Rechter Arm\",\n    [\"Kologarn\"] = nil,\n    [\"Left Arm\"] = \"Linker Arm\",\n    [\"The Conservatory of Life\"] = \"Das Konservatorium des Lebens\",\n    [\"Snaplasher\"] = \"Knallpeitscher\",\n    [\"Storm Lasher\"] = \"Sturmpeitscher\",\n    [\"Ancient Water Spirit\"] = \"Uralter Wassergeist\",\n    [\"The Spark of Imagination\"] = \"Der Funke der Imagination\",\n    [\"Aerial Command Unit\"] = \"Luftkommandoeinheit\",\n    [\"VX-001\"] = nil, -- Same as EN\n    [\"Leviathan Mk II\"] = \"Leviathan MK II\",\n    [\"Saronite Animus\"] = \"Saronitanimus\",\n    [\"Life Spark\"] = \"Lebensfunke\",\n    [\"XM-024 Pummeller\"] = \"XM-024 Verprügler\",\n    [\"Freya\"] = nil, -- Same as EN\n    [\"Assault Bot\"] = \"Angriffsbot\",\n    [\"Crusher Tentacle\"] = \"Schmettertentakel\",\n    [\"Corruptor Tentacle\"] = \"Verderbertentakel\",\n    [\"Feral Defender\"] = nil,\n    -- TOC\n    [\"Trial of the Crusader\"] = \"Prüfung des Kreuzfahrers\",\n    [\"Gormok the Impaler\"] = \"Gormok der Pfähler\",\n    [\"Snobold Vassal\"] = \"Schneeboldvasall\",\n    [\"Acidmaw\"] = \"Ätzschlund\",\n    [\"Dreadscale\"] = \"Schreckensmaul\",\n    [\"Icehowl\"] = \"Eisheuler\",\n    [\"Lord Jaraxxus\"] = nil, -- same as EN\n    [\"Nether Portal\"] = \"Netherportal\",\n    [\"Infernal Volcano\"] = \"Höllischer Vulkan\",\n    [\"Shaabad\"] = nil,\n    [\"Broln Stouthorn\"] = nil,\n    [\"Anthar Forgemender\"] = nil,\n    [\"Caiphus the Stern\"] = nil,\n    [\"Melador Valestrider\"] = nil,\n    [\"Erin Misthoof\"] = nil,    \n    [\"Saamul\"] = nil,\n    [\"Thrakgar\"] = nil,\n    [\"Irieth Shadowstep\"] = nil,\n    [\"Maz'dinah\"] = nil,\n    [\"Shocuul\"] = nil,\n    [\"Narrhok Steelbreaker\"] = nil, \n    [\"Alyssia Moonstalker\"] = nil,\n    [\"Ruj'kah\"] = nil,\n    [\"Tyrius Duskblade\"] = nil,\n    [\"Gorgrim Shadowcleave\"] = nil,\n    [\"Serissa Grimdabbler\"] = nil,\n    [\"Harkzog\"] = nil, \n    [\"Baelnor Lightbearer\"] = nil,\n    [\"Malithas Brightblade\"] = nil,\n    [\"Velanaa\"] = nil,\n    [\"Liandra Suncaller\"] = nil,\n    [\"Kavina Grovesong\"] = nil,\n    [\"Birana Stormhoof\"] = nil, \n    [\"Brienna Nightfell\"] = nil,\n    [\"Vivienne Blackwhisper\"] = nil,\n    [\"Noozle Whizzlestick\"] = nil,\n    [\"Ginselle Blightslinger\"] = nil,\n    [\"Fjola Lightbane\"] = \"Fjola Lichtbann\",\n    [\"Eydis Darkbane\"] = \"Eydis Nachtbann\",\n    [\"The Icy Depths\"] = \"Die Eisigen Tiefen\",\n    [\"Anub'arak\"] = nil, -- same as EN\n    [\"Nerubian Burrower\"] = \"Nerubischer Gräber\",\n    [\"Onyxia's Lair\"] = \"Onyxias Hort\",\n    [\"Onyxia\"] = nil, -- same as EN\n    [\"Onyxian Lair Guard\"] = \"Wache von Onyxias Hort\",\n    -- ICC\n    [\"Putricide's Laboratory of Alchemical Horrors and Fun\"] = \"Seuchenmords Laboratorium der alchemistischen Schrecken und Späße\",\n    [\"Volatile Ooze\"] = \"Flüchtiger Schlamm\",\n    [\"Professor Putricide\"] = \"Professor Seuchenmord\",\n    [\"Gas Cloud\"] = \"Gaswolke\",\n    [\"The Crimson Hall\"] = \"Die Blutrote Halle\",\n    [\"Prince Taldaram\"] = \"Prinz Taldaram\",\n    [\"Prince Keleseth\"] = \"Prinz Keleseth\",\n    [\"Prince Valanar\"] = \"Prinz Valanar\",\n}\n\n\n\nlocal function LocalizeTable(tTableToLocalize)\n    if tTableToLocalize.bLocalized then return tTableToLocalize end\n    \n    local tLocalizedTable = {\n        bLocalized = GetLocale(),\n        \n    }\n    \n    local function LocalizeField(tIn, tOut, sKey)\n        local sLocalizedKey = sKey\n        if tLocData.tLocalizations[sKey] and tLocData.tLocalizations[sKey] then\n            sLocalizedKey = tLocData.tLocalizations[sKey]\n        end\n        \n        if type(tIn[sKey]) == \"table\" then\n            tOut[sLocalizedKey] = {}\n            \n            for k,_ in pairs(tIn[sKey]) do\n                LocalizeField(tIn[sKey], tOut[sLocalizedKey], k)\n            end\n        else\n            if tLocData.tLocalizations[tIn[sKey]] and tLocData.tLocalizations[tIn[sKey]] then\n                tOut[sLocalizedKey] = tLocData.tLocalizations[tIn[sKey]]\n            else\n                tOut[sLocalizedKey] = tIn[sKey]\n            end\n        end\n    end\n    \n    for k,_ in pairs(tTableToLocalize) do\n        LocalizeField(tTableToLocalize, tLocalizedTable, k)\n    end\n    \n    return tLocalizedTable\nend\ntLocData.fnLocalizeTable = LocalizeTable\n\nlocal function InitLoca()\n    if GetLocale() == aura_env.sLocale then\n        WeakAuras.ScanEvents(\"MultiDotFrame_Localize\", tLocData)\n    end\nend\naura_env.fnInitLoca = InitLoca\n\nInitLoca()",
