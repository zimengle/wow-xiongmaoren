		["MDF - Cast Dispatcher"] = {
			["outline"] = "OUTLINE",
			["wagoID"] = "5Pz4pCOF5",
			["authorOptions"] = {
				{
					["type"] = "description",
					["text"] = "|cFF6666FFJeyp's Boss Frames|r",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [1]
				{
					["type"] = "description",
					["text"] = "|cFFFF6666Important |r: Always update your options when having the top most group of the WA selected (Jeyp's Boss Frames) to avoid desyncing the values.",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [2]
				{
					["type"] = "space",
					["variableWidth"] = true,
					["height"] = 1,
					["width"] = 2,
					["useHeight"] = false,
				}, -- [3]
				{
					["type"] = "toggle",
					["default"] = true,
					["desc"] = "",
					["key"] = "bShowNPCCasts",
					["useDesc"] = false,
					["name"] = "Show NPC Casts",
					["width"] = 1,
				}, -- [4]
			},
			["displayText_format_p_time_dynamic_threshold"] = 60,
			["yOffset"] = 0,
			["anchorPoint"] = "CENTER",
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/5Pz4pCOF5/108",
			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "aura_env.bActive = false\n\naura_env.tNPCIdToFrames = {\n    \n}\n\naura_env.tFrameToNPCIds = {\n    \n}\n\nlocal function HandleCLEU(...)\n    if not aura_env.bActive or not aura_env.config.bShowNPCCasts then return false end\n    \n    local sSourceGUID = select(4, ...)\n    local sSourceNPCID = select(6, strsplit(\"-\", sSourceGUID))\n    \n    local sSubEvent = select(2, ...)\n    \n    if aura_env.tNPCIdToFrames[sSourceNPCID] then \n        local sFrame = aura_env.tNPCIdToFrames[sSourceNPCID]\n        if sFrame then\n            \n            if sSubEvent == \"SPELL_CAST_START\" then \n                aura_env.fnStartCast(sFrame, ...)\n            elseif sSubEvent == \"SPELL_CAST_FAILED\" then\n                aura_env.fnEndCast(sFrame, ...)\n            end \n        end\n    elseif sSubEvent == \"SPELL_INTERRUPT\" then\n        local sTargetGUID = select(8, ...)\n        local sTargetNPCID = select(6, strsplit(\"-\", sTargetGUID))\n        local sFrame = aura_env.tNPCIdToFrames[sTargetNPCID]\n        if sFrame then\n            aura_env.fnInterruptCast(sFrame, ...)\n        end\n    end\nend\naura_env.fnHandleCLEU = HandleCLEU\n\nlocal function StartCast(sFrame, ...)\n    local iSpellID = select(12, ...)\n    if iSpellID == nil then return end\n    local name, _, icon, castTime = GetSpellInfo(iSpellID)\n    local tPackage = {\n        sSpellName = name,\n        icon = icon,\n        iDuration = castTime / 1000,\n        iExpirationTime = castTime / 1000 + GetTime()\n    }\n    \n    WeakAuras.ScanEvents(\"MultiDotFrame_CastStarted\", sFrame, tPackage)\nend\naura_env.fnStartCast = StartCast\n\nlocal function EndCast(sFrame, ...)\n    local tPackage = {\n        sSpellName = \"Failed\",\n    }\n    \n    WeakAuras.ScanEvents(\"MultiDotFrame_CastEnded\", sFrame, tPackage)\nend\naura_env.fnEndCast = EndCast\n\nlocal function InterruptCast(sFrame, ...)\n    local iSpellID = select(12, ...)\n    local sSourceName = select(5, ...)\n    if iSpellID == nil then return end\n    \n    local tPackage = {\n        sSpellName = \"Interrupted - \" .. WA_ClassColorName(sSourceName),\n    }\n    \n    WeakAuras.ScanEvents(\"MultiDotFrame_CastEnded\", sFrame, tPackage)\nend\naura_env.fnInterruptCast = InterruptCast\n\n-- Stored NPCID<->Frame correspondance in tables for quick access\nlocal function SetNPCIDToFrame(sFrame, tSharedZoneData)\n    if tSharedZoneData == nil then return false end\n    local tZoneData = tSharedZoneData[sFrame]\n    if tZoneData == nil or tZoneData.sNPCID == nil then return false end\n    \n    if aura_env.tFrameToNPCIds[sFrame] ~= nil then\n        aura_env.tNPCIdToFrames[aura_env.tFrameToNPCIds[sFrame]] = nil\n    end\n    \n    aura_env.tFrameToNPCIds[sFrame] = tZoneData.sNPCID\n    aura_env.tNPCIdToFrames[tZoneData.sNPCID] = sFrame\nend\n\n-- Register the NPC ID with each frame for easier lookup later\nlocal function SetNPCIDToFrames(sEvent, tZoneData) \n    local bRetA = SetNPCIDToFrame(\"A\", tZoneData)\n    local bRetB = SetNPCIDToFrame(\"B\", tZoneData)\n    local bRetC = SetNPCIDToFrame(\"C\", tZoneData)\n    \n    return bRetA or bRetB or bRetC\nend\naura_env.fnSetNPCIDToFrames = SetNPCIDToFrames\n\n",
					["do_custom"] = true,
				},
				["finish"] = {
				},
			},
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["use_alwaystrue"] = true,
						["subeventSuffix"] = "_CAST_START",
						["unit"] = "player",
						["event"] = "Conditions",
						["use_unit"] = true,
						["subeventPrefix"] = "SPELL",
						["custom"] = "function(sEvent, ...)\n    if sEvent == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        aura_env.fnHandleCLEU(...)\n    elseif sEvent == \"MultiDotFrame_ChangeZone\" then\n        local tZoneData = select(2, ...)\n        aura_env.bActive = tZoneData ~= nil\n        \n        aura_env.fnSetNPCIDToFrames(sEvent, tZoneData)\n    end \n    return true\nend\n\n\n\n",
						["spellIds"] = {
