		["MDF - Zones Dispatcher"] = {
			["outline"] = "OUTLINE",
			["wagoID"] = "5Pz4pCOF5",
			["authorOptions"] = {
				{
					["type"] = "description",
					["text"] = "|cFF6666FFJeyp's Boss Frames|r",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [1]
				{
					["type"] = "description",
					["text"] = "|cFFFF6666Important |r: Always update your options when having the top most group of the WA selected (Jeyp's Boss Frames) to avoid desyncing the values.",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [2]
				{
					["type"] = "space",
					["variableWidth"] = true,
					["height"] = 1,
					["width"] = 2,
					["useHeight"] = false,
				}, -- [3]
				{
					["subOptions"] = {
						{
							["type"] = "toggle",
							["default"] = false,
							["desc"] = "If set to false, will disable debug no matter the state of other toggles",
							["key"] = "bDebug",
							["useDesc"] = true,
							["name"] = "Allow Any Debug",
							["width"] = 2,
						}, -- [1]
					},
					["hideReorder"] = true,
					["useDesc"] = false,
					["nameSource"] = 0,
					["collapse"] = true,
					["width"] = 1,
					["useCollapse"] = true,
					["noMerge"] = false,
					["name"] = "Debug",
					["key"] = "tDebug",
					["limitType"] = "none",
					["groupType"] = "simple",
					["type"] = "group",
					["size"] = 10,
				}, -- [4]
			},
			["displayText_format_p_time_dynamic_threshold"] = 60,
			["yOffset"] = 0,
			["anchorPoint"] = "CENTER",
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/5Pz4pCOF5/108",
			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "aura_env.sEventName = \"MultiDotFrame_ChangeZone\"\naura_env.tLastZoneData = nil\naura_env.iLastEncounter = 0\naura_env.iCurrentEncounter = 0\naura_env.tLocalizedZones = {} -- Generated\n\nlocal function HandleEncounterEnd(...)\n    local tZoneData = aura_env.tLocalizedZones[aura_env.sLastZone]\n    if tZoneData == nil then return false end\n    \n    local iEncID = select(1, ...)\n    local iSuccess = select(5, ...)\n    if iSuccess == 1 then\n        if tZoneData and tZoneData[\"Encounters\"] ~= nil and tZoneData[\"Encounters\"][iEncID] ~= nil and tZoneData[\"Encounters\"][iEncID].iNextEncounter ~= nil then\n            aura_env.iCurrentEncounter = tZoneData[\"Encounters\"][iEncID].iNextEncounter   \n        end\n    else\n        aura_env.iCurrentEncounter = iEncID\n    end\n    \n    return true\nend\naura_env.fnHandleEncounterEnd = HandleEncounterEnd\n\nlocal function GetZoneData()\n    local sNewZone = GetSubZoneText()\n    if sNewZone == \"\" then \n        sNewZone = GetZoneText()\n    end\n    local tZoneData = aura_env.tLocalizedZones[sNewZone]\n    if tZoneData and tZoneData[\"Encounters\"] ~= nil then\n        tZoneData = tZoneData[\"Encounters\"][aura_env.iCurrentEncounter] or tZoneData[\"Encounters\"][tZoneData[\"Encounters\"].iStartingFight]\n    end\n    \n    return sNewZone, tZoneData\nend\naura_env.fnGetZoneData = GetZoneData\n\nlocal function BroadcastZoneData(sEvent, sNewZone, tZoneData)\n    if aura_env.sLastZone ~= sNewZone or aura_env.iLastEncounter ~= aura_env.iCurrentEncounter or sEvent == \"MultiDotFrame_ZoneData_LateInit\" then -- Force update on entering world, as sLastZone could be based on a STATUS called that happened before everything was loaded \n        if tZoneData ~= nil then \n            WeakAuras.ScanEvents(aura_env.sEventName, sNewZone, tZoneData)\n            aura_env.iIcon = tZoneData.iIcon\n        else\n            WeakAuras.ScanEvents(aura_env.sEventName, sNewZone, nil)\n        end\n    end\nend\naura_env.fnBroadcastZoneData = BroadcastZoneData\n\n",
					["do_custom"] = true,
				},
				["finish"] = {
				},
			},
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["use_alwaystrue"] = true,
						["subeventSuffix"] = "_CAST_START",
						["unit"] = "player",
						["event"] = "Conditions",
						["use_unit"] = true,
						["subeventPrefix"] = "SPELL",
						["custom"] = "function(sEvent, ...)\n    if aura_env.config.bDebug then\n        print(\"Data\", sEvent, ...)\n    end\n    if sEvent == \"STATUS\" or sEvent == \"PLAYER_ENTERING_WORLD\" then\n        -- Delay Init on Stats/Enter world to ensure everything else is properly init first\n        C_Timer.NewTimer(0.1, function() WeakAuras.ScanEvents(\"MultiDotFrame_ZoneData_LateInit\") end) \n    elseif sEvent == \"MultiDotFrame_Localize\" then \n        aura_env.tLocData = select(1, ...)\n        if aura_env.tZonesData then\n            aura_env.tLocalizedZones = aura_env.tLocData.fnLocalizeTable(aura_env.tZonesData.tZones)\n            --print(dump(aura_env.tLocalizedZones))\n        end\n    elseif sEvent == \"MultiDotFrame_ZonesData\" then\n        aura_env.tZonesData = select(1, ...)\n        if aura_env.tLocData then\n            aura_env.tLocalizedZones = aura_env.tLocData.fnLocalizeTable(aura_env.tZonesData.tZones)\n        end\n    elseif sEvent == \"ENCOUNTER_END\" then\n        return aura_env.fnHandleEncounterEnd(...)\n    end\n    \n    if InCombatLockdown() then \n        -- In combat - keep current result to avoid messing with SecureFrame\n        return aura_env.bLastResult\n    end\n    \n    local sNewZone, tZoneData = aura_env.fnGetZoneData()\n    aura_env.fnBroadcastZoneData(sEvent, sNewZone, tZoneData)\n    \n    aura_env.iLastEncounter = aura_env.iCurrentEncounter\n    aura_env.sLastZone = sNewZone\n    aura_env.tLastZoneData = tZoneData\n    aura_env.bLastResult = (tZoneData ~= nil)\n    return aura_env.bLastResult\nend\n\n\n",
						["spellIds"] = {
						},
						["names"] = {
						},
						["check"] = "event",
						["events"] = "ZONE_CHANGED ZONE_CHANGED_NEW_AREA ZONE_CHANGED_INDOORS PLAYER_ENTERING_WORLD PLAYER_REGEN_ENABLED STATUS ENCOUNTER_END MultiDotFrame_Localize MultiDotFrame_ZoneData_LateInit MultiDotFrame_ZonesData",
						["custom_type"] = "status",
						["debuffType"] = "HELPFUL",
					},
					["untrigger"] = {
					},
				}, -- [1]
				["activeTriggerMode"] = -10,
			},
