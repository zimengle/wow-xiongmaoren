						["trigger"] = -1,
						["op"] = "ACTIVE_TALENT_GROUP_CHANGED",
						["value"] = "function()\n    local _, _, classIndex = UnitClass(\"player\");\n    \n    -- Paladin\n    if(classIndex == 2) then \n        local _, _, _, _, holyPala, _, _, _ = GetTalentInfo(1, 23, false);            -- Holy Spec\n        if(holyPala == 1) then\n            return true         \n        else\n            return false\n        end\n    elseif (classIndex == 11) then -- Druid\n        local _, _, _, _, specSelect, _, _, _ = GetTalentInfo(1, 23, false);    \n        if(not specSelect == 0) then\n            return true            \n        else\n            return false\n        end\n    elseif(classIndex == 3) then -- Hunter\n        return true\n    elseif(classIndex == 8) then -- Mage\n        return true\n    else\n        return false\n    end\nend\n\n\n",
