			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/hEveRUXlI/1",
			["actions"] = {
				["start"] = {
					["custom"] = "local f = aura_env.region.bar\nWorldMapFrame.ScrollContainer.Child:SetParent(f)\nWorldMapFrame.ScrollContainer.Child:SetPoint(\"TOPLEFT\",f,\"TOPLEFT\",-621,206)\nWorldMapFrame:SetGlobalAlpha(aura_env.config[\"map\"] and 0 or 1)\n\nlocal WorldMapUnitPin, WorldMapUnitPinSizes\n\nfor pin in WorldMapFrame:EnumeratePinsByTemplate(\"GroupMembersPinTemplate\") do\n    WorldMapUnitPin = pin\n    WorldMapUnitPinSizes = pin.dataProvider:GetUnitPinSizesTable()\n    break\nend\n\nC_Timer.After(0.1, function()\n        WorldMapFrame:Show()\n        WorldMapFrame.ScrollContainer:InstantPanAndZoom(2.5, 0, 0)\n        \n        WorldMapFrame.Show = function()\n            print(\"|CFFFF0000World Map disabled, reload UI to return it's functions\")\n            return\n        end\n        \n        C_Timer.After(0.1, function()\n                WorldMapFrame:Hide()\n                WorldMapUnitPinSizes.player = 20\n                WorldMapUnitPin:SynchronizePinSizes()\n        end)\nend)\n\n\n\n",
				},
				["finish"] = {
				},
				["init"] = {
				},
			},
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["custom_type"] = "stateupdate",
						["debuffType"] = "HELPFUL",
						["subeventSuffix"] = "_CAST_START",
						["event"] = "Health",
						["subeventPrefix"] = "SPELL",
						["names"] = {
						},
						["spellIds"] = {
						},
						["custom"] = "function(s)\n    \n    local maxPlayers = select(5, GetInstanceInfo())\n    local portals = maxPlayers==10 and 4 or 10\n    \n    for i=1, portals do\n        local p = math.fmod(i + aura_env.config[\"shift\"],10)\n        s[i] = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            autoHide = false,\n            value = 1,\n            total = 1,\n            portal = p == 0 and 10 or p\n        }\n    end\n    \n    return true\nend",
						["events"] = "PLAYER_ENTERING_WORLD",
						["check"] = "event",
						["unit"] = "player",
						["customVariables"] = "{\n    portal = \"number\"\n}",
