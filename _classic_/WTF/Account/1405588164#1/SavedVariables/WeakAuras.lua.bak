					["custom"] = "aura_env.slot = INVSLOT_TRINKET1\n\n-- Add Trinkets to the list below. First is Item ID, followed by Buff ID.\n\naura_env.trinketBuffs = {\n    -- Physical / Tanks:\n    [37390] = 60302, -- Whetstone\n    [42987] = 60229, -- DMC Greatness Str\n    [44253] = 60233, -- DMC Greatness Agi\n    [60439] = 39257, -- Loathebs Shadow\n    [46088] = 64527, -- Platinum Disks of Swiftness\n    [46086] = 64524, -- Platinum Disks of Battle\n    [45263] = 64800, -- Wrathstone\n    [40531] = 60319, -- Mark of Norgannon\n    [48722] = 67683, -- Shard of the Crystal Heart\n    [47734] = 67695, -- Mark of Supremacy\n    [44014] = 59658, -- Fezzik's Pocketwatch\n    [43836] = 61620, -- Thorny Rose Brooch\n    [37723] = 60299, -- Incisor Fragment\n    [37166] = 60305, -- Sphere of Red Dragon's Blood\n    [54590] = 75456, -- Sharpened Twilight Scale HC\n    [54569] = 75458, -- Sharpened Twilight Scale\n    [50343] = 71541, -- Whispering Fanged Skull HC\n    [50342] = 71401, -- Whispering Fanged Skull\n    [50351] = 71432, -- Tiny Abomination in a Jar\n    [50355] = 71396, -- Herkuml War Token\n    [50363] = 71556, -- Deathbringer's Will H\n    [50363] = 71559, -- Deathbringer's Will H\n    [50363] = 71558, -- Deathbringer's Will H\n    [50363] = 71557, -- Deathbringer's Will H\n    [50363] = 71560, -- Deathbringer's Will H\n    [50363] = 71561, -- Deathbringer's Will H\n    [50362] = 71485, -- Deathbringer's Will\n    [50362] = 71491, -- Deathbringer's Will\n    [50362] = 71486, -- Deathbringer's Will\n    [50362] = 71487, -- Deathbringer's Will\n    [50362] = 71492, -- Deathbringer's Will\n    [50362] = 71484, -- Deathbringer's Will\n    [47131] = 67773, -- Death's Verdict HC - A\n    [47464] = 67773, -- Death's Choice HC - H\n    [47115] = 67708, -- Death's Verdict - A\n    [47303] = 67708, -- Death's Choice - H\n    [45609] = 64772, -- Comets Trail\n    [50198] = 71403, -- Needle-Encrusted Scorpion\n    [45522] = 64790, -- Blood of the Old God\n    [45931] = 65019, -- Mjolnir Runestone\n    [46038] = 65024, -- Dark Matter\n    [45286] = 65014, -- Pyrite Infuser\n    [40256] = 60437, -- Grim Toll\n    [43573] = 58904, -- Tears of Bitter Anguish\n    [40684] = 60065, -- Mirror of Truth\n    [49074] = 60065, -- Mirror of Truth // Brewfest\n    [47214] = 67671, -- Banner of Victory\n    [40372] = 60258, -- Rune of Repulsion\n    [50349] = 71639, -- Corpse Tongue Coin - H\n    [50364] = 71638, -- Sindragosa's Flawless Fang H\n    [50361] = 71635, -- Sindragosa's Flawless Fang\n    [50356] = 71586, -- Corroded Skeleton Key\n    [47451] = 67753, -- Juggernaut's Vitality H\n    [47088] = 67753, -- Satrina's Impeding Scarab H\n    [47290] = 67699, -- Juggernaut's Vitality\n    [47080] = 67699, -- Satrina's Impeding Scarab\n    [42133] = 67596, -- Battlemaster's Fury\n    [42134] = 67596, -- Battlemaster's Precision\n    [42136] = 67596, -- Battlemaster's Rage\n    [42137] = 67596, -- Battlemaster's Ruination\n    [42135] = 67596, -- Battlemaster's Vivacity\n    [47734] = 67695, -- Mark of Supremacy\n    [47735] = 67694, -- Glyph of Indomitability\n    [48020] = 67746, -- Vengeance of the Forsaken H\n    [47948] = 67746, -- Victor's Call H\n    [47881] = 67737, -- Vengeance of the Forsaken\n    [47725] = 67737, -- Victor's Call\n    [48021] = 67741, -- Eitrigg's Oath H\n    [47949] = 67741, -- Fervor of the Frostborn H\n    [47882] = 67727, -- Eitrigg's Oath\n    [47727] = 67727, -- Fervor of the Frostborn\n    [48722] = 67683, -- Shard of the Crystal Heart\n    [50235] = 71569, -- Ick's Rotting Thumb\n    [45158] = 64763, -- Heart of Iron\n    [45313] = 65011, -- Furnace Stone\n    [46021] = 65012, -- Royal Seal of King Llane\n    [40257] = 60286, -- Defender's Code\n    [42129] = 55915, -- Battlemaster's Accuracy\n    [42130] = 55915, -- Battlemaster's Avidity\n    [42132] = 55915, -- Battlemaster's Bravery\n    [42131] = 55915, -- Battlemaster's Conviction\n    [42128] = 55915, -- Battlemaster's Hostility\n    [37638] = 60180, -- Offering of Sacrifice\n    [39292] = 60180, -- Repelling Charge\n    [40683] = 60054, -- Valor Medal of the First War\n}\naura_env.trinketBuffId = 0",
