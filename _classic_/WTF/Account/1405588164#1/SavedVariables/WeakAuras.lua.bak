						["subeventSuffix"] = "_CAST_START",
						["names"] = {
						},
						["custom"] = "-- Not a secure frame - add here the visual modifications to the frame that can happen in combat \nfunction(sEvent, ...)    \n    if aura_env.config.tDebug.bDebug and aura_env.config.tDebug.bFramesBorderEvents then\n        print(\"Border\", aura_env.sFrameID, sEvent, ...)\n    end\n    if sEvent == \"MultiDotFrame_InitBorders\" then\n        aura_env.tData = select(1, ...)\n        aura_env.tData.fnInitDuplicateData()\n        if aura_env.sNPCID ~= \"\" then\n            aura_env.tData.fnSetIsTargeted()\n        end\n    elseif sEvent == \"MultiDotFrame_InitSharedTrigger_Borders\" then\n        aura_env.tTriggerData = select(1, ...)\n    else\n        if aura_env.tTriggerData then\n            return aura_env.tTriggerData.fnHandleTrigger(sEvent, ...)\n        end\n    end\n    return true\nend",
						["event"] = "Chat Message",
