		["MDF - Zones Merger"] = {
			["outline"] = "OUTLINE",
			["wagoID"] = "5Pz4pCOF5",
			["authorOptions"] = {
				{
					["type"] = "description",
					["text"] = "|cFF6666FFJeyp's Boss Frames|r",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [1]
				{
					["type"] = "description",
					["text"] = "|cFFFF6666Important |r: Always update your options when having the top most group of the WA selected (Jeyp's Boss Frames) to avoid desyncing the values.",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [2]
				{
					["type"] = "space",
					["variableWidth"] = true,
					["height"] = 1,
					["width"] = 2,
					["useHeight"] = false,
				}, -- [3]
				{
					["subOptions"] = {
					},
					["hideReorder"] = true,
					["useDesc"] = false,
					["nameSource"] = 0,
					["collapse"] = true,
					["width"] = 1,
					["useCollapse"] = true,
					["noMerge"] = false,
					["name"] = "NPC Selection",
					["key"] = "tNPCBlackList",
					["limitType"] = "none",
					["groupType"] = "simple",
					["type"] = "group",
					["size"] = 10,
				}, -- [4]
				{
					["subOptions"] = {
						{
							["type"] = "toggle",
							["default"] = false,
							["desc"] = "If set to false, will disable debug no matter the state of other toggles",
							["key"] = "bDebug",
							["useDesc"] = true,
							["name"] = "Allow Any Debug",
							["width"] = 2,
						}, -- [1]
					},
					["hideReorder"] = true,
					["useDesc"] = false,
					["nameSource"] = 0,
					["collapse"] = true,
					["width"] = 1,
					["useCollapse"] = true,
					["noMerge"] = false,
					["name"] = "Debug",
					["key"] = "tDebug",
					["limitType"] = "none",
					["groupType"] = "simple",
					["type"] = "group",
					["size"] = 10,
				}, -- [5]
			},
			["displayText_format_p_time_dynamic_threshold"] = 60,
			["yOffset"] = 0,
			["anchorPoint"] = "CENTER",
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/5Pz4pCOF5/108",
			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "local tSectionsToLoad = {\n    \"Testing\",\n    \"T7\",\n    \"T8\",\n    \"T9\",\n    \"T10\",\n}\nlocal tZonesData = {}\ntZonesData.tZones = {}\n\nlocal tOrder = {\"A\",\"B\",\"C\",\"D\", \"E\", \"F\", \"G\", \"H\", \"I\", \"J\", \"K\", \"L\", \"M\", \"N\"}\n\nlocal function ProcessEncounterFrame(tEncounterTable, sFrameID, tBlacklist)\n    local bRemove = false\n    if sFrameID == \"Encounters\" then \n        for _, tZoneEncounterData in pairs(tEncounterTable[sFrameID]) do\n            if type(tZoneEncounterData) == \"table\" then\n                for sFrame, tTest in pairs(tZoneEncounterData) do\n                    ProcessEncounterFrame(tZoneEncounterData, sFrame, tBlacklist)\n                end\n            end\n        end\n    else\n        if type(tEncounterTable[sFrameID]) == \"table\" and\n        tEncounterTable[sFrameID].tEnabledOptions ~= nil then\n            for _, sOption in ipairs(tEncounterTable[sFrameID].tEnabledOptions) do\n                if not tBlacklist[sOption] then\n                    bRemove = true\n                    break\n                end\n            end\n        end\n    end\n    \n    if bRemove then\n        tEncounterTable[sFrameID] = nil\n    end\nend\n\nlocal function ProcessBlacklist()\n    for _, tZoneData in pairs(tZonesData.tZones) do\n        for sZoneFrame,_ in pairs(tZoneData) do\n            ProcessEncounterFrame(tZoneData, sZoneFrame, tZoneData.tBlacklist)\n        end\n        \n        local iIdx = 0\n        for i, sFrameID in ipairs(tOrder) do\n            if tZoneData[sFrameID] then \n                if sFrameID ~= tOrder[i] then\n                    tZoneData[sFrameID] = tZoneData[tOrder[i]]\n                end\n                tZoneData[sFrameID].iIndex = iIdx\n                iIdx = iIdx + 1\n            end\n        end\n        if tZoneData[\"Encounters\"] ~= nil then \n            for _, tEncounterData in pairs(tZoneData[\"Encounters\"]) do\n                if type(tEncounterData) == \"table\" then\n                    local iEncIdx = 0\n                    for i, sFrameID in ipairs(tOrder) do\n                        if tEncounterData[sFrameID] then \n                            local sFinalID = sFrameID\n                            if sFrameID ~= tOrder[iEncIdx + 1] then\n                                sFinalID = tOrder[iEncIdx + 1]\n                                tEncounterData[sFinalID] = tEncounterData[sFrameID]\n                                tEncounterData[sFrameID] = nil\n                            end\n                            tEncounterData[sFinalID].iIndex = iEncIdx\n                            iEncIdx = iEncIdx + 1\n                        end\n                    end\n                end\n            end\n        end\n    end\nend\n\nlocal function SendZonesData()\n    ProcessBlacklist()\n    WeakAuras.ScanEvents(\"MultiDotFrame_ZonesData\", tZonesData)\nend\n\nlocal function AttemptToSendData()\n    for _,bDataReceived in ipairs(tSectionsToLoad) do\n        if not bDataReceived then return false end\n    end\n    SendZonesData()\nend\naura_env.fnAttemptToSendData = AttemptToSendData\n\nlocal function deepcopy(orig, copies)\n    copies = copies or {}\n    local orig_type = type(orig)\n    local copy\n    if orig_type == 'table' then\n        if copies[orig] then\n            copy = copies[orig]\n        else\n            copy = {}\n            copies[orig] = copy\n            for orig_key, orig_value in next, orig, nil do\n                copy[deepcopy(orig_key, copies)] = deepcopy(orig_value, copies)\n            end\n            setmetatable(copy, deepcopy(getmetatable(orig), copies))\n        end\n    else -- number, string, boolean, etc\n        copy = orig\n    end\n    return copy\nend\n\nlocal function ReadSection(tZoneDataSection)\n    local tLocalZoneDataSection = deepcopy(tZoneDataSection)\n    tSectionsToLoad[tLocalZoneDataSection.sName] = true\n    for k, v in pairs(tLocalZoneDataSection.tZones) do\n        tZonesData.tZones[k] = v\n        tZonesData.tZones[k].tBlacklist = tLocalZoneDataSection.tBlacklist\n    end\n    AttemptToSendData()\nend\naura_env.fnReadSection = ReadSection\n\n\n\n",
					["do_custom"] = true,
				},
				["finish"] = {
				},
			},
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["custom_type"] = "status",
						["custom_hide"] = "timed",
						["event"] = "Health",
						["unit"] = "player",
						["subeventSuffix"] = "_CAST_START",
						["subeventPrefix"] = "SPELL",
						["custom"] = "function(sEvent, ...)\n    if sEvent == \"MultiDotFrame_ZonesData_Section\" then\n        local tZoneDataSection = select(1, ...)\n        aura_env.fnReadSection(tZoneDataSection)\n    elseif sEvent == \"STATUS\" then\n        aura_env.fnAttemptToSendData()\n    end \n    return true\nend",
