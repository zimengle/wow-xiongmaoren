			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "aura_env.sFrameID = \"A\"\naura_env.iSkinID = 1\naura_env.sFrameName = \"ConsumeButton_MDF_Unit\" .. aura_env.sFrameID\n\n",
