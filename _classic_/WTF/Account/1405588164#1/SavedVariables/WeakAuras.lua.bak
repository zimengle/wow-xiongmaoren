						["custom"] = "function()\n    return true\nend",
						["customName"] = "function()\n    local e=aura_env\n    if e.Chat then \n        return e.col.._G['SAY']..'|r'\n    else    \n        return ''\n    end    \nend",
						["events"] = "PLAYER_ENTERING_WORLD,ENV_Marker_Chat",
						["use_unit"] = true,
						["check"] = "event",
