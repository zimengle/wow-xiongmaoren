						["custom"] = "function(a, event)\n    if event == \"THORIM_START\" then\n        aura_env.timed(a, aura_env.cdfirst)\n        return true\n        \n    elseif event == \"CHAIN_LIGHTNING_END\" then\n        aura_env.timed(a, aura_env.cd)\n        return true\n    end\nend",
						["events"] = "THORIM_START,CHAIN_LIGHTNING_END",
						["debuffType"] = "HELPFUL",
					},
