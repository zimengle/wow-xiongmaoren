			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/5Pz4pCOF5/108",
			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"ruRU\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] =  \"Великая Кузня\",\n    [\"War Quarter\"] = \"Квартал Воинов\",\n    [\"Heroic Training Dummy\"] = \"Героический тренировочный манекен\",\n    [\"Grandmaster's Training Dummy\"] = \"Тренировочный манекен великого мастера\",\n    [\"Expert's Training Dummy\"] = \"Тренировочный манекен для опытных бойцов\",\n    [\"Master's Training Dummy\"] = \"Тренировочный манекен для мастеров\",\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = \"Обсидиановое святилище\",\n    [\"Tenebron\"] = \"Тенеброн\",\n    [\"Shadron\"] = \"Шадрон\",\n    [\"Vesperon\"] = \"Весперон\",\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = nil,\n    [\"Baron Rivendare\"] = \"Барон Ривендер\",\n    [\"Thane Korth'azz\"] = \"Тан Корт'азз\",\n    [\"Lady Blaumeux\"] = \"Леди Бломе\",\n    -- Ulduar\n    [\"Formation Grounds\"] = \"Плац\",\n    [\"Flame Leviathan\"] = \"Огненный Левиафан\",\n    [\"The Colossal Forge\"] = \"Гигантская кузня\",\n    [\"Ignis the Furnace Master\"] = \"Повелитель Горнов Игнис\",\n    [\"Razorscale's Aerie\"] = \"Гнездо Острокрылой\",\n    [\"Razorscale\"] = \"Острокрылая\",\n    [\"The Scrapyard\"] = \"Мусорная свалка\",\n    [\"XT-002 Deconstructor\"] = \"Разрушитель XT-002\",\n    [\"The Celestial Planetarium\"] = \"Священный планетарий\",\n    [\"Algalon the Observer\"] = \"Алгалон Наблюдатель\",\n    [\"The Observation Ring\"] = \"Круг Наблюдения\",\n    [\"Auriaya\"] = \"Ауриайя\",\n    [\"The Halls of Winter\"] = \"Залы Зимы\",\n    [\"Hodir\"] = \"Ходир\",\n    [\"The Clash of Thunder\"] = \"Раскаты Грома\",\n    [\"Thorim\"] = \"Торим\",\n    [\"The Descent into Madness\"] = \"Провал Безумия\",\n    [\"General Vezax\"] = \"Генерал Везакс\",\n    [\"The Prison of Yogg-Saron\"] = \"Темница Йогг-Сарона\",\n    [\"Yogg-Saron\"] = \"Йогг-Сарон\",\n    [\"The Assembly of Iron\"] = \"Железное Собрание\",\n    [\"Stormcaller Brundir\"] = \"Буревестник Брундир\",\n    [\"Runemaster Molgeim\"] = \"Мастер рун Молгейм\",\n    [\"Steelbreaker\"] = \"Сталелом\",\n    [\"The Shattered Walkway\"] = \"Обвалившаяся галерея\",\n    [\"Right Arm\"] = \"Правая рука\",\n    [\"Kologarn\"] = \"Кологарн\",\n    [\"Left Arm\"] = \"Левая рука\",\n    [\"The Conservatory of Life\"] = \"Оранжерея Жизни\",\n    [\"Snaplasher\"] = \"Хватоплет\",\n    [\"Storm Lasher\"] = \"Грозовой плеточник\",\n    [\"Ancient Water Spirit\"] = \"Древний дух воды\",\n    [\"The Spark of Imagination\"] = \"Искра Воображения\",\n    [\"Aerial Command Unit\"] = \"Воздушное судно\",\n    [\"VX-001\"] = nil,\n    [\"Leviathan Mk II\"] = \"Левиафан II\",\n    [\"Saronite Animus\"] = \"Саронитовый враг\",\n    [\"Life Spark\"] = \"Искра жизни\",\n    [\"XM-024 Pummeller\"] = \"Утрамбовщик XM-024\",\n    [\"Freya\"] = \"Фрейя\",\n    [\"Assault Bot\"] = \"Штурмовой робот\",\n    [\"Crusher Tentacle\"] = \"Тяжелое щупальце\",\n    [\"Corruptor Tentacle\"] = \"Разлагающее щупальце\",\n    [\"Feral Defender\"] = \"Дикий защитник\",\n    -- TOC\n    [\"Trial of the Crusader\"] = \"Испытание крестоносца\",\n    [\"Gormok the Impaler\"] = \"Гормок Пронзающий Бивень\",\n    [\"Snobold Vassal\"] = \"Снобольд-вассал\",\n    [\"Acidmaw\"] = \"Кислотная Утроба\",\n    [\"Dreadscale\"] = \"Жуткая Чешуя\",\n    [\"Icehowl\"] = \"Ледяной Рев\",\n    [\"Lord Jaraxxus\"] = \"Лорд Джараксус\",\n    [\"Nether Portal\"] = \"Врата Пустоты\",\n    [\"Infernal Volcano\"] = \"Вулкан инферналов\",\n    [\"Shaabad\"] = nil,\n    [\"Broln Stouthorn\"] = nil,\n    [\"Anthar Forgemender\"] = nil,\n    [\"Caiphus the Stern\"] = nil,\n    [\"Melador Valestrider\"] = nil,\n    [\"Erin Misthoof\"] = nil,    \n    [\"Saamul\"] = nil,\n    [\"Thrakgar\"] = nil,\n    [\"Irieth Shadowstep\"] = nil,\n    [\"Maz'dinah\"] = nil,\n    [\"Shocuul\"] = nil,\n    [\"Narrhok Steelbreaker\"] = nil, \n    [\"Alyssia Moonstalker\"] = nil,\n    [\"Ruj'kah\"] = nil,\n    [\"Tyrius Duskblade\"] = nil,\n    [\"Gorgrim Shadowcleave\"] = nil,\n    [\"Serissa Grimdabbler\"] = nil,\n    [\"Harkzog\"] = nil, \n    [\"Baelnor Lightbearer\"] = nil,\n    [\"Malithas Brightblade\"] = nil,\n    [\"Velanaa\"] = nil,\n    [\"Liandra Suncaller\"] = nil,\n    [\"Kavina Grovesong\"] = nil,\n    [\"Birana Stormhoof\"] = nil, \n    [\"Brienna Nightfell\"] = nil,\n    [\"Vivienne Blackwhisper\"] = nil,\n    [\"Noozle Whizzlestick\"] = nil,\n    [\"Ginselle Blightslinger\"] = nil,\n    [\"Fjola Lightbane\"] = \"Фьола Погибель Света\",\n    [\"Eydis Darkbane\"] = \"Эйдис Погибель Тьмы\",\n    [\"The Icy Depths\"] = \"Ледяные глубины\",\n    [\"Anub'arak\"] = \"Ануб'арак\",\n    [\"Nerubian Burrower\"] = \"Нерубский землеглот\",\n    [\"Onyxia's Lair\"] = \"Логово Ониксии\",\n    [\"Onyxia\"] = \"Ониксия\",\n    [\"Onyxian Lair Guard\"] = \"Страж логова Ониксии\",\n    -- ICC\n    [\"Putricide's Laboratory of Alchemical Horrors and Fun\"] = nil,\n    [\"Volatile Ooze\"] = nil,\n    [\"Professor Putricide\"] = nil,\n    [\"Gas Cloud\"] = nil,\n    [\"The Crimson Hall\"] = nil,\n    [\"Prince Taldaram\"] = nil,\n    [\"Prince Keleseth\"] = nil,\n    [\"Prince Valanar\"] = nil,    \n}\n\n\nlocal function LocalizeTable(tTableToLocalize)\n    if tTableToLocalize.bLocalized then return tTableToLocalize end\n    \n    local tLocalizedTable = {\n        bLocalized = GetLocale(),\n        \n    }\n    \n    local function LocalizeField(tIn, tOut, sKey)\n        local sLocalizedKey = sKey\n        if tLocData.tLocalizations[sKey] and tLocData.tLocalizations[sKey] then\n            sLocalizedKey = tLocData.tLocalizations[sKey]\n        end\n        \n        if type(tIn[sKey]) == \"table\" then\n            tOut[sLocalizedKey] = {}\n            \n            for k,_ in pairs(tIn[sKey]) do\n                LocalizeField(tIn[sKey], tOut[sLocalizedKey], k)\n            end\n        else\n            if tLocData.tLocalizations[tIn[sKey]] and tLocData.tLocalizations[tIn[sKey]] then\n                tOut[sLocalizedKey] = tLocData.tLocalizations[tIn[sKey]]\n            else\n                tOut[sLocalizedKey] = tIn[sKey]\n            end\n        end\n    end\n    \n    for k,_ in pairs(tTableToLocalize) do\n        LocalizeField(tTableToLocalize, tLocalizedTable, k)\n    end\n    \n    return tLocalizedTable\nend\ntLocData.fnLocalizeTable = LocalizeTable\n\nlocal function InitLoca()\n    if GetLocale() == aura_env.sLocale then\n        WeakAuras.ScanEvents(\"MultiDotFrame_Localize\", tLocData)\n    end\nend\naura_env.fnInitLoca = InitLoca\n\nInitLoca()",
					["do_custom"] = true,
				},
