						["custom"] = "function(sEvent, ...)    \n    if aura_env.config.tDebug.bDebug and aura_env.config.tDebug.bFramesIconEvents then\n        print(\"Icon\", aura_env.sFrameID, sEvent, ...)\n    end\n    if sEvent == \"MultiDotFrame_ChangeZone\" then \n        local tZoneData = select(2, ...)\n        if tZoneData == nil or tZoneData[aura_env.sFrameID] == nil then return false end\n        aura_env.iIcon = tZoneData[aura_env.sFrameID].iIcon\n    end\n    return true\nend\n\n\n",
