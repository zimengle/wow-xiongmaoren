			},
			["displayText_format_p6_format"] = "none",
			["fixedWidth"] = 200,
			["outline"] = "OUTLINE",
			["sparkOffsetX"] = 0,
			["wagoID"] = "EqZ6HNPJe",
			["parent"] = "Hunter - Survival",
			["shadowYOffset"] = -1,
			["cooldownSwipe"] = true,
			["sparkRotationMode"] = "AUTO",
			["automaticWidth"] = "Auto",
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["subeventSuffix"] = "_CAST_START",
						["event"] = "Health",
						["unit"] = "player",
						["names"] = {
						},
						["spellIds"] = {
						},
						["custom"] = "function(s, e, ...)\n    -- PLAYER_STOPPED_MOVING, PLAYER_STARTED_MOVING, CLEU:SPELL_AURA_APPLIED, CLEU:SPELL_AURA_REFRESH\n    if (e == \"PLAYER_STOPPED_MOVING\") then\n        aura_env.offset = nil;\n        local now = GetTime();\n        local duration = aura_env.getDuration(false);\n        aura_env.isMoving = false;\n        \n        s.sniper = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            expirationTime = now + duration,\n            duration = duration,\n            startTime = now,\n            isMoving = aura_env.isMoving,\n        }\n        return true;\n    elseif (e == \"PLAYER_STARTED_MOVING\") then\n        aura_env.offset = nil;\n        aura_env.isMoving = true;\n        s.sniper = {\n            show = true,\n            changed = true,\n            progressType = \"static\",\n            value = 0,\n            total = 1,\n            isMoving = aura_env.isMoving,\n        }\n        return true;\n    elseif (e == \"COMBAT_LOG_EVENT_UNFILTERED\" and not aura_env.isMoving) then\n        local destGUID = select(8, ...);\n        local spellId = select(12 , ...);\n        if (destGUID == aura_env.pGUID and spellId == 64420) then\n            local now = GetTime();\n            local duration = aura_env.getDuration(true);\n            \n            if (s.sniper and s.sniper.progressType == \"timed\") then\n                local timeLeft = (s.sniper.startTime + 6) - now;\n                aura_env.offset = timeLeft;\n                \n                if (timeLeft < 0.4) then\n                    -- Initial tick should not be dynamic, it will be wrong\n                    aura_env.offset = aura_env.config.standingOffset; \n                end\n                \n                if (aura_env.config.printOffset) then\n                    print(\"Sniper Training Offset:\", timeLeft);\n                end\n            end\n            \n            s.sniper = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                expirationTime = now + duration,\n                duration = duration,\n                startTime = now,\n                isMoving = aura_env.isMoving,\n            }\n            return true;\n        end\n    end\nend",
						["custom_type"] = "stateupdate",
						["check"] = "event",
						["subeventPrefix"] = "SPELL",
