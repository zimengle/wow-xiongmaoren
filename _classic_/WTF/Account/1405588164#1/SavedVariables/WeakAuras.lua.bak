			},
			["displayText_format_p_time_dynamic_threshold"] = 60,
			["yOffset"] = 0,
			["anchorPoint"] = "CENTER",
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/5Pz4pCOF5/108",
			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"zhTW\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] = nil,\n    [\"War Quarter\"] = \"軍事區\",\n    [\"Heroic Training Dummy\"] = \"英雄訓練假人\",\n    [\"Grandmaster's Training Dummy\"] = \"宗師的訓練假人\",\n    [\"Expert's Training Dummy\"] = \"專家的訓練假人\",\n    [\"Master's Training Dummy\"] = \"大師的訓練假人\",\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = nil,\n    [\"Tenebron\"] = nil,\n    [\"Shadron\"] = nil,\n    [\"Vesperon\"] = nil,\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = nil,\n    [\"Baron Rivendare\"] = nil,\n    [\"Thane Korth'azz\"] = nil,\n    [\"Lady Blaumeux\"] = nil,\n    -- Ulduar\n    [\"Formation Grounds\"] = nil,\n    [\"Flame Leviathan\"] = nil,\n    [\"The Colossal Forge\"] = \"巨熔爐\",\n    [\"Ignis the Furnace Master\"] = \"『火爐之主』伊格尼司\",\n    [\"Razorscale's Aerie\"] = \"銳鱗之巢\",\n    [\"Razorscale\"] = \"銳鱗\",\n    [\"The Scrapyard\"] = \"廢料場\",\n    [\"XT-002 Deconstructor\"] = \"XT-002拆解者\",\n    [\"The Celestial Planetarium\"] = \"星穹渾天儀\",\n    [\"Algalon the Observer\"] = \"『觀察者』艾爾加隆\",\n    [\"The Observation Ring\"] = \"觀察之環\",\n    [\"Auriaya\"] = \"奧芮雅\",\n    [\"The Halls of Winter\"] = \"凜冬之廳\",\n    [\"Hodir\"] = \"霍迪爾\",\n    [\"The Clash of Thunder\"] = \"雷鳴之廳\",\n    [\"Thorim\"] = \"索林姆\",\n    [\"The Descent into Madness\"] = \"驟狂斜廊\",\n    [\"General Vezax\"] = \"威札斯將軍\",\n    [\"The Prison of Yogg-Saron\"] = \"尤格薩倫之獄\",\n    [\"Yogg-Saron\"] = \"尤格薩倫\",\n    [\"The Assembly of Iron\"] = \"鐵之集會所\",\n    [\"Stormcaller Brundir\"] = \"風暴召喚者布倫迪爾\",\n    [\"Runemaster Molgeim\"] = \"符文大師墨吉姆\",\n    [\"Steelbreaker\"] = \"破鋼者\",\n    [\"The Shattered Walkway\"] = \"破碎走道\",\n    [\"Right Arm\"] = \"右臂\",\n    [\"Kologarn\"] = \"柯洛剛恩\",\n    [\"Left Arm\"] = \"左臂\",\n    [\"The Conservatory of Life\"] = \"生命溫室\",\n    [\"Snaplasher\"] = \"猛攫鞭笞者\",\n    [\"Storm Lasher\"] = \"風暴鞭笞者\",\n    [\"Ancient Water Spirit\"] = \"上古水之靈\",\n    [\"The Spark of Imagination\"] = \"創思之廳\",\n    [\"Aerial Command Unit\"] = \"空中指揮裝置\",\n    [\"VX-001\"] = nil,\n    [\"Leviathan Mk II\"] = \"戰輪MK II\",\n    [\"Saronite Animus\"] = \"薩倫聚惡體\",\n    [\"Life Spark\"] = \"生命火光\",\n    [\"XM-024 Pummeller\"] = \"XM-024擊打者\",\n    [\"Freya\"] = \"芙蕾雅\",\n    [\"Assault Bot\"] = \"突襲機器人\",\n    [\"Crusher Tentacle\"] = \"粉碎觸手\",\n    [\"Corruptor Tentacle\"] = \"腐化觸手\",\n    [\"Feral Defender\"] = \"聖所哨衛\",\n    -- TOC\n    [\"Trial of the Crusader\"] = nil,\n    [\"Gormok the Impaler\"] = nil,\n    [\"Snobold Vassal\"] = nil,\n    [\"Acidmaw\"] = nil,\n    [\"Dreadscale\"] = nil,\n    [\"Icehowl\"] = nil,\n    [\"Lord Jaraxxus\"] = nil,\n    [\"Nether Portal\"] = nil,\n    [\"Infernal Volcano\"] = nil,\n    [\"Shaabad\"] = nil,\n    [\"Broln Stouthorn\"] = nil,\n    [\"Anthar Forgemender\"] = nil,\n    [\"Caiphus the Stern\"] = nil,\n    [\"Melador Valestrider\"] = nil,\n    [\"Erin Misthoof\"] = nil,    \n    [\"Saamul\"] = nil,\n    [\"Thrakgar\"] = nil,\n    [\"Irieth Shadowstep\"] = nil,\n    [\"Maz'dinah\"] = nil,\n    [\"Shocuul\"] = nil,\n    [\"Narrhok Steelbreaker\"] = nil, \n    [\"Alyssia Moonstalker\"] = nil,\n    [\"Ruj'kah\"] = nil,\n    [\"Tyrius Duskblade\"] = nil,\n    [\"Gorgrim Shadowcleave\"] = nil,\n    [\"Serissa Grimdabbler\"] = nil,\n    [\"Harkzog\"] = nil, \n    [\"Baelnor Lightbearer\"] = nil,\n    [\"Malithas Brightblade\"] = nil,\n    [\"Velanaa\"] = nil,\n    [\"Liandra Suncaller\"] = nil,\n    [\"Kavina Grovesong\"] = nil,\n    [\"Birana Stormhoof\"] = nil, \n    [\"Brienna Nightfell\"] = nil,\n    [\"Vivienne Blackwhisper\"] = nil,\n    [\"Noozle Whizzlestick\"] = nil,\n    [\"Ginselle Blightslinger\"] = nil,\n    [\"Fjola Lightbane\"] = nil,\n    [\"Eydis Darkbane\"] = nil,\n    [\"The Icy Depths\"] = nil,\n    [\"Anub'arak\"] = nil,\n    [\"Nerubian Burrower\"] = nil,\n    [\"Onyxia's Lair\"] = nil,\n    [\"Onyxia\"] = nil,\n    [\"Onyxian Lair Guard\"] = nil,\n    -- ICC\n    [\"Putricide's Laboratory of Alchemical Horrors and Fun\"] = nil,\n    [\"Volatile Ooze\"] = nil,\n    [\"Professor Putricide\"] = nil,\n    [\"Gas Cloud\"] = nil,\n    [\"The Crimson Hall\"] = nil,\n    [\"Prince Taldaram\"] = nil,\n    [\"Prince Keleseth\"] = nil,\n    [\"Prince Valanar\"] = nil,\n}\n\n\n\nlocal function LocalizeTable(tTableToLocalize)\n    if tTableToLocalize.bLocalized then return tTableToLocalize end\n    \n    local tLocalizedTable = {\n        bLocalized = GetLocale(),\n        \n    }\n    \n    local function LocalizeField(tIn, tOut, sKey)\n        local sLocalizedKey = sKey\n        if tLocData.tLocalizations[sKey] and tLocData.tLocalizations[sKey] then\n            sLocalizedKey = tLocData.tLocalizations[sKey]\n        end\n        \n        if type(tIn[sKey]) == \"table\" then\n            tOut[sLocalizedKey] = {}\n            \n            for k,_ in pairs(tIn[sKey]) do\n                LocalizeField(tIn[sKey], tOut[sLocalizedKey], k)\n            end\n        else\n            if tLocData.tLocalizations[tIn[sKey]] and tLocData.tLocalizations[tIn[sKey]] then\n                tOut[sLocalizedKey] = tLocData.tLocalizations[tIn[sKey]]\n            else\n                tOut[sLocalizedKey] = tIn[sKey]\n            end\n        end\n    end\n    \n    for k,_ in pairs(tTableToLocalize) do\n        LocalizeField(tTableToLocalize, tLocalizedTable, k)\n    end\n    \n    return tLocalizedTable\nend\ntLocData.fnLocalizeTable = LocalizeTable\n\nlocal function InitLoca()\n    if GetLocale() == aura_env.sLocale then\n        WeakAuras.ScanEvents(\"MultiDotFrame_Localize\", tLocData)\n    end\nend\naura_env.fnInitLoca = InitLoca\n\nInitLoca()",
					["do_custom"] = true,
				},
				["finish"] = {
