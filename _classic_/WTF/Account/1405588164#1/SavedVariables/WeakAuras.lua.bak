		["WCL评分排名通报3.2版"] = {
			["outline"] = "OUTLINE",
			["wagoID"] = "ahIxep7wC",
			["color"] = {
				1, -- [1]
				1, -- [2]
				1, -- [3]
				1, -- [4]
			},
			["displayText_format_p_time_dynamic_threshold"] = 60,
			["yOffset"] = 0,
			["anchorPoint"] = "CENTER",
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/ahIxep7wC/1",
			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "aura_env.reportTemplate = \"  %s:%s(%s%%)\"\n\naura_env.raidTemplate = gsub(ERR_RAID_MEMBER_ADDED_S, '%%s', '(.+)')\naura_env.partyTemplate = gsub(JOINED_PARTY, '%%s', '(.+)')\n\naura_env.raidName = {\n    ['X'] = 'NAXX',\n}\naura_env.raidOrder = {'NAXX'}\n\naura_env.loadData = function(playerName)\n    if type(WP_Database) ~= 'table' then return end\n    DebugPrint(playerName)\n    DebugPrint( WP_Database[playerName] )\n    return (WP_Database[playerName])\nend\n\naura_env.loadTitle = function(playerName)\n    local top = TOP_Database[playerName .. \"_\" .. GetRealmName()]\n    local ctop = CTOP_Database[playerName .. \"_\" .. GetRealmName()]\n    local stop = STOP_Database[playerName]\n    if top then \n        return '世界全明星第' .. top .. ' '\n    elseif ctop then\n        return '国服全明星第' .. ctop .. ' '\n    elseif stop then\n        return '本服全明星第' .. stop .. ' '\n    else\n        return ''\n    end\nend\n\ndo\n    local scoreTable = {}\n    aura_env.fetchScore = function(scoreText)\n        DebugPrint(scoreText)\n        if scoreText == nil then return end\n        scoreText = strsplit('|', scoreText)\n        DebugPrint(scoreText)\n        local textTable = {strsplit('%', scoreText)}\n        \n        wipe(scoreTable)\n        for _, text in pairs(textTable) do\n            if text ~= '' then\n                local raid, info = strsplit(':', text)\n                local point, score = strsplit('/', info)\n                \n                local raidName = strsub(raid, 2, 2)\n                raidName = aura_env.raidName[raidName] or raidName\n                \n                scoreTable[raidName] = format(aura_env.reportTemplate, raidName, point, score)\n            end\n        end\n        return scoreTable\n    end\nend",
					["do_custom"] = true,
				},
				["finish"] = {
				},
			},
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["custom_type"] = "event",
						["custom_hide"] = "custom",
						["use_unit"] = true,
						["event"] = "Health",
						["subeventPrefix"] = "SPELL",
						["unit"] = "player",
						["custom"] = "function(_, ...)\n    local message = ...\n    if not message then return end\n    if not IsInGroup() then return end\n    \n    if (\n        aura_env.config.onlyIsLeader and\n        not UnitIsGroupLeader('player') and not UnitIsGroupAssistant('player')\n    ) then return end\n    \n    local template, channel\n    if IsInRaid() then\n        template = aura_env.raidTemplate\n        channel = 'RAID'\n    else\n        template = aura_env.partyTemplate\n        channel = 'PARTY'\n    end\n    \n    local playerName = strmatch(message, template)\n    if not playerName then return end\n    \n    local scoreText = aura_env.loadData(playerName)\n    if not scoreText then return end\n    \n    local playerClass = UnitClass(playerName)\n    local playerTitle = aura_env.loadTitle(playerName)\n    local scoreTable = aura_env.fetchScore(scoreText)\n    \n    \n    local reportText = format(\"欢迎%s<%s> %sWCL分数:\", playerClass, playerName, playerTitle)\n    local anyReport\n    for _, raidName in ipairs(aura_env.raidOrder) do\n        if scoreTable[raidName] and aura_env.config[raidName] then\n            anyReport = true\n            reportText = reportText .. scoreTable[raidName]\n        end\n    end\n    \n    if anyReport then\n        SendChatMessage(reportText, channel)\n    end\nend",
