			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "aura_env.sFrameID = \"C\"\naura_env.iSkinID = 2\naura_env.sFrameName = \"ConsumeButton_MDF_Unit\" .. aura_env.sFrameID .. \"_Alternative\"",
					["do_custom"] = true,
