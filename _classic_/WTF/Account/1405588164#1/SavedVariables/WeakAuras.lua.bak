			},
		},
		["关【Noobs】刺骨之寒图标编号（0704露露自用高亮取消，兼容巴尼）"] = {
			["outline"] = "OUTLINE",
			["iconSource"] = 0,
			["wagoID"] = "Uo-BkzG_b",
			["xOffset"] = 15,
			["preferToUpdate"] = true,
			["anchorFrameType"] = "UNITFRAME",
			["shadowYOffset"] = -1,
			["anchorPoint"] = "CENTER",
			["color"] = {
				1, -- [1]
				1, -- [2]
				1, -- [3]
				1, -- [4]
			},
			["cooldownSwipe"] = true,
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["cooldownEdge"] = false,
			["actions"] = {
				["start"] = {
					["glow_frame_type"] = "UNITFRAME",
					["glow_type"] = "buttonOverlay",
					["do_glow"] = false,
					["glow_action"] = "show",
				},
				["finish"] = {
					["hide_all_glows"] = true,
				},
				["init"] = {
					["custom"] = "aura_env.lastUpdate = GetTime() - 10\naura_env.timerTable = {}\naura_env.nameToUnit = {}\naura_env.unitList = {}\naura_env.maxCount = 5\naura_env.checkClass = function(unit)\n    local _,_,classindex = UnitClass(unit)\n    -- 不换萨满\n    if aura_env.config.isShamanHeroClass and classindex == 7 then \n        return true\n    end\n    -- 不换牧师\n    if aura_env.config.isPriestBaseClass and classindex == 5 then \n        return true\n    end\n    return false\nend\naura_env.checkPriority  = function(unit)\n    if not unit or not UnitExists(unit) then return false end\n    local _,_,classindex = UnitClass(unit)\n    local health = UnitHealthMax(unit)\n    if aura_env.config.checkTank then\n        -- 当职业为战士、骑士、DK、德鲁伊，且血量大于35000时，判断为坦克\n        if  health >= 35000 and (classindex == 1 or classindex == 2 or classindex == 6 or classindex == 11) then\n            return true\n        end\n    end\n    if aura_env.config.checkWarlock and classindex == 9 then\n        return true\n    end\n    if aura_env.config.checkRogue  and classindex == 4 then\n        return true\n    end\n    if aura_env.config.checkDK  and classindex == 6 then\n        return true\n    end\n    return false\nend\naura_env.getUnitPartyIndex = function(unit)\n    if not unit then return 0 end\n    local index = UnitInRaid(unit)\n    if index then\n        local _,_,Party = GetRaidRosterInfo(index)\n        return Party \n    end\n    return 0\nend\n\n\n",
					["do_custom"] = true,
				},
			},
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["custom_type"] = "stateupdate",
						["debuffType"] = "HELPFUL",
						["subeventSuffix"] = "_CAST_START",
						["event"] = "Health",
						["subeventPrefix"] = "SPELL",
						["names"] = {
						},
						["spellIds"] = {
						},
						["custom"] = "function(all, event,flag, subEvent,_, _, _, _, _, _,destName,_,_, spellId)\n    local checkDebuff = tonumber(aura_env.config.debuffid)\n    if event == \"GROUP_ROSTER_UPDATE\"then\n        for unit in WA_IterateGroupMembers() do\n            aura_env.nameToUnit[UnitName(unit)] = unit\n        end\n        \n        local changed = false\n        for name in pairs(all) do\n            if UnitExists(name) and all[name].show then\n                local party = aura_env.getUnitPartyIndex(name)\n                if all[name].party and party ~= all[name].party then\n                    all[name].unit =  aura_env.nameToUnit[name] or name\n                    all[name].show = true\n                    all[name].changed = true\n                    all[name].party = party\n                    changed = true\n                    if aura_env.config.notGlowGroup ~= 0 then\n                        if party ~= aura_env.config.notGlowGroup  then\n                            all[name].glow = true\n                        else\n                            all[name].glow = false\n                        end\n                    end\n                end\n            end\n        end\n        return changed\n    end\n    if not flag then return end\n    \n    if event == \"START_SHOW_ICON\" then\n        local highIndex = 1\n        local lowIndex = aura_env.maxCount\n        local index = highIndex\n        local _,_,icon = GetSpellInfo(checkDebuff)\n        for raidUnit in WA_IterateGroupMembers() do\n            local name = UnitName(raidUnit)\n            if aura_env.unitList[name] and raidUnit ~= \"player\" then\n                local lowPriority = false \n                if aura_env.checkPriority(raidUnit) then\n                    index = lowIndex\n                    lowPriority = true\n                else\n                    index = highIndex\n                end\n                local glow = false\n                if index == 1 and aura_env.config.glow1 then glow = true end\n                if index == 2 and aura_env.config.glow2 then glow = true end\n                if index == 3 and aura_env.config.glow3 then glow = true end\n                if index == 4 and aura_env.config.glow4 then glow = true end\n                if index == 5 and aura_env.config.glow5 then glow = true end\n                local party = aura_env.getUnitPartyIndex(name)\n                if aura_env.config.notGlowGroup ~= 0 then\n                    if party ~= aura_env.config.notGlowGroup  then\n                        glow = true\n                    else\n                        glow = false\n                    end\n                end\n                all[name] = {\n                    show = true,\n                    changed = true,\n                    icon = icon,\n                    progressType = \"timed\",\n                    autoHide = true,\n                    duration = aura_env.config.duration,\n                    expirationTime = aura_env.config.duration + GetTime(),\n                    name = tostring(index),\n                    unit = aura_env.nameToUnit[name] or name,\n                    glow = glow,\n                    isHero = aura_env.checkClass(name),\n                    party = party\n                }\n                if lowPriority then \n                    lowIndex = lowIndex - 1\n                else\n                    highIndex = highIndex + 1\n                end\n            end\n        end\n        return true\n    end\n    \n    if event ==\"COMBAT_LOG_EVENT_UNFILTERED\" then\n        if (subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_REFRESH\" )and spellId and spellId == checkDebuff and destName then\n            if GetTime() - aura_env.lastUpdate > 10 then -- 新一轮点名，0.02秒后排序\n                aura_env.lastUpdate = GetTime()\n                aura_env.maxCount = 1\n                for timer  in pairs(aura_env.timerTable) do\n                    if timer then\n                        timer:Cancel()\n                    end\n                end\n                aura_env.timerTable = {}\n                aura_env.unitList = {}\n                local delay = aura_env.config.delay\n                local timer = C_Timer.NewTimer(delay, function()\n                        WeakAuras.ScanEvents(\"START_SHOW_ICON\",true)\n                end)\n                aura_env.timerTable[timer] = true\n            else\n                aura_env.maxCount = aura_env.maxCount + 1\n            end\n            aura_env.unitList[destName] = true\n        elseif subEvent == \"SPELL_AURA_REMOVED\"and spellId and spellId == checkDebuff and destName and all[destName] then\n            all[destName].show = false\n            all[destName].changed = true\n            return true\n        end\n    end\nend",
						["events"] = "CLEU:SPELL_AURA_REFRESH,CLEU:SPELL_AURA_APPLIED,CLEU:SPELL_AURA_REMOVED,START_SHOW_ICON,GROUP_ROSTER_UPDATE",
						["check"] = "event",
						["unit"] = "player",
						["customVariables"] = "{\n    expirationTime = true,\n    glow = \"bool\",\n    isHero = \"bool\"\n}",
						["custom_hide"] = "timed",
					},
					["untrigger"] = {
					},
				}, -- [1]
				["disjunctive"] = "custom",
				["customTriggerLogic"] = "function(t)\n    return t[1]\nend",
				["activeTriggerMode"] = 1,
			},
			["displayText_format_p_time_mod_rate"] = true,
