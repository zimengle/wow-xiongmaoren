					["untrigger"] = {
						["custom"] = "function(event, ...)\n    if UnitExists(\"target\") and UnitExists(\"targettarget\") then\n        if UnitName(\"player\") ~= UnitName(\"targettarget\")then\n            return true\n        end\n    else\n        return true\n    end\nend\n\n\n",
