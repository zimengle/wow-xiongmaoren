					["variableWidth"] = true,
					["height"] = 1,
					["width"] = 2,
					["useHeight"] = false,
				}, -- [3]
			},
			["displayText_format_p_time_dynamic_threshold"] = 60,
			["yOffset"] = 0,
			["anchorPoint"] = "CENTER",
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/5Pz4pCOF5/108",
			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"zhCN\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] = nil,\n    [\"War Quarter\"] = \"军事区\",\n    [\"Heroic Training Dummy\"] = \"英雄训练假人\",\n    [\"Grandmaster's Training Dummy\"] = \"宗师的训练假人\",\n    [\"Expert's Training Dummy\"] = \"专家的训练假人\",\n    [\"Master's Training Dummy\"] = \"大师的训练假人\",\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = nil,\n    [\"Tenebron\"] = nil,\n    [\"Shadron\"] = nil,\n    [\"Vesperon\"] = nil,\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = nil,\n    [\"Baron Rivendare\"] = nil,\n    [\"Thane Korth'azz\"] = nil,\n    [\"Lady Blaumeux\"] = nil,\n    -- Ulduar\n    [\"Formation Grounds\"] = \"练兵场\",\n    [\"Flame Leviathan\"] = \"烈焰巨兽\",\n    [\"The Colossal Forge\"] = \"巨人熔炉\",\n    [\"Ignis the Furnace Master\"] = \"掌炉者伊格尼斯\",\n    [\"Razorscale's Aerie\"] = \"锋鳞之巢\",\n    [\"Razorscale\"] = \"锋鳞\",\n    [\"The Scrapyard\"] = \"废料场\",\n    [\"XT-002 Deconstructor\"] = \"XT-002拆解者\",\n    [\"The Celestial Planetarium\"] = \"天文台\",\n    [\"Algalon the Observer\"] = \"观察者奥尔加隆\",\n    [\"The Observation Ring\"] = \"观测场\",\n    [\"Auriaya\"] = \"欧尔莉亚\",\n    [\"The Halls of Winter\"] = \"寒冬大厅\",\n    [\"Hodir\"] = \"霍迪尔\",\n    [\"The Clash of Thunder\"] = \"雷霆角斗场\",\n    [\"Thorim\"] = \"托里姆\",\n    [\"The Descent into Madness\"] = \"疯狂阶梯\",\n    [\"General Vezax\"] = \"维扎克斯将军\",\n    [\"The Prison of Yogg-Saron\"] = \"尤格-萨隆的监狱\",\n    [\"Yogg-Saron\"] = \"尤格-萨隆\",\n    [\"The Assembly of Iron\"] = \"钢铁议会\",\n    [\"Stormcaller Brundir\"] = \"唤雷者布隆迪尔\",\n    [\"Runemaster Molgeim\"] = \"符文大师莫尔基姆\",\n    [\"Steelbreaker\"] = \"断钢者\",\n    [\"The Shattered Walkway\"] = \"破碎通道\",\n    [\"Right Arm\"] = \"右臂\",\n    [\"Kologarn\"] = \"科隆加恩\",\n    [\"Left Arm\"] = \"左臂\",\n    [\"The Conservatory of Life\"] = \"生命温室\",\n    [\"Snaplasher\"] = \"迅疾鞭笞者\",\n    [\"Storm Lasher\"] = \"风暴鞭笞者\",\n    [\"Ancient Water Spirit\"] = \"古代水之精魂\",\n    [\"The Spark of Imagination\"] = \"思想火花\",\n    [\"Aerial Command Unit\"] = \"空中指挥单位\",\n    [\"VX-001\"] = nil,\n    [\"Leviathan Mk II\"] = \"巨兽二型\",\n    [\"Saronite Animus\"] = \"萨隆邪铁畸体\",\n    [\"Life Spark\"] = \"生命火花\",\n    [\"XM-024 Pummeller\"] = \"XM-024击打者\",\n    [\"Freya\"] = \"弗雷亚\",\n    [\"Assault Bot\"] = \"突击机器人\",\n    [\"Crusher Tentacle\"] = \"重压触须\",\n    [\"Corruptor Tentacle\"] = \"腐蚀触须\",\n    [\"Feral Defender\"] = \"野性防御者\",\n    -- TOC\n    [\"Trial of the Crusader\"] = \"十字军的试炼\",\n    [\"Gormok the Impaler\"] = \"穿刺者戈莫克\",\n    [\"Snobold Vassal\"] = nil,\n    [\"Acidmaw\"] = \"酸喉\",\n    [\"Dreadscale\"] = \"恐鳞\",\n    [\"Icehowl\"] = \"冰吼\",\n    [\"Lord Jaraxxus\"] = \"加拉克苏斯大王\",\n    [\"Nether Portal\"] = \"虚空传送门\",\n    [\"Infernal Volcano\"] = \"地狱火山\",\n    [\"Shaabad\"] = nil,\n    [\"Broln Stouthorn\"] = nil,\n    [\"Anthar Forgemender\"] = nil,\n    [\"Caiphus the Stern\"] = nil,\n    [\"Melador Valestrider\"] = nil,\n    [\"Erin Misthoof\"] = nil,    \n    [\"Saamul\"] = nil,\n    [\"Thrakgar\"] = nil,\n    [\"Irieth Shadowstep\"] = nil,\n    [\"Maz'dinah\"] = nil,\n    [\"Shocuul\"] = nil,\n    [\"Narrhok Steelbreaker\"] = nil, \n    [\"Alyssia Moonstalker\"] = nil,\n    [\"Ruj'kah\"] = nil,\n    [\"Tyrius Duskblade\"] = nil,\n    [\"Gorgrim Shadowcleave\"] = nil,\n    [\"Serissa Grimdabbler\"] = nil,\n    [\"Harkzog\"] = nil, \n    [\"Baelnor Lightbearer\"] = nil,\n    [\"Malithas Brightblade\"] = nil,\n    [\"Velanaa\"] = nil,\n    [\"Liandra Suncaller\"] = nil,\n    [\"Kavina Grovesong\"] = nil,\n    [\"Birana Stormhoof\"] = nil, \n    [\"Brienna Nightfell\"] = nil,\n    [\"Vivienne Blackwhisper\"] = nil,\n    [\"Noozle Whizzlestick\"] = nil,\n    [\"Ginselle Blightslinger\"] = nil,\n    [\"Fjola Lightbane\"] = \"光明邪使菲奥拉\",\n    [\"Eydis Darkbane\"] = \"黑暗邪使艾蒂丝\",\n    [\"The Icy Depths\"] = \"寒冰深渊\",\n    [\"Anub'arak\"] = \"阿努巴拉克\",\n    [\"Nerubian Burrower\"] = nil,\n    [\"Onyxia's Lair\"] = nil,\n    [\"Onyxia\"] = nil,\n    [\"Onyxian Lair Guard\"] = nil,\n    -- ICC\n    [\"Putricide's Laboratory of Alchemical Horrors and Fun\"] = nil,\n    [\"Volatile Ooze\"] = nil,\n    [\"Professor Putricide\"] = nil,\n    [\"Gas Cloud\"] = nil,\n    [\"The Crimson Hall\"] = nil,\n    [\"Prince Taldaram\"] = nil,\n    [\"Prince Keleseth\"] = nil,\n    [\"Prince Valanar\"] = nil,\n}\n\n\n\nlocal function LocalizeTable(tTableToLocalize)\n    if tTableToLocalize.bLocalized then return tTableToLocalize end\n    \n    local tLocalizedTable = {\n        bLocalized = GetLocale(),\n        \n    }\n    \n    local function LocalizeField(tIn, tOut, sKey)\n        local sLocalizedKey = sKey\n        if tLocData.tLocalizations[sKey] and tLocData.tLocalizations[sKey] then\n            sLocalizedKey = tLocData.tLocalizations[sKey]\n        end\n        \n        if type(tIn[sKey]) == \"table\" then\n            tOut[sLocalizedKey] = {}\n            \n            for k,_ in pairs(tIn[sKey]) do\n                LocalizeField(tIn[sKey], tOut[sLocalizedKey], k)\n            end\n        else\n            if tLocData.tLocalizations[tIn[sKey]] and tLocData.tLocalizations[tIn[sKey]] then\n                tOut[sLocalizedKey] = tLocData.tLocalizations[tIn[sKey]]\n            else\n                tOut[sLocalizedKey] = tIn[sKey]\n            end\n        end\n    end\n    \n    for k,_ in pairs(tTableToLocalize) do\n        LocalizeField(tTableToLocalize, tLocalizedTable, k)\n    end\n    \n    return tLocalizedTable\nend\ntLocData.fnLocalizeTable = LocalizeTable\n\nlocal function InitLoca()\n    if GetLocale() == aura_env.sLocale then\n        WeakAuras.ScanEvents(\"MultiDotFrame_Localize\", tLocData)\n    end\nend\naura_env.fnInitLoca = InitLoca\n\nInitLoca()",
