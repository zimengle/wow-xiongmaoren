		["提醒萨墓插风怒"] = {
			["iconSource"] = 0,
			["color"] = {
				1, -- [1]
				1, -- [2]
				1, -- [3]
				1, -- [4]
			},
			["preferToUpdate"] = false,
			["customText"] = "function()\n    return aura_env.shaname\nend\n\n\n",
			["yOffset"] = -16.466552734375,
			["anchorPoint"] = "CENTER",
			["cooldownSwipe"] = true,
			["url"] = "https://wago.io/CA9qsO79f/3",
			["icon"] = true,
			["triggers"] = {
				{
					["trigger"] = {
						["enchant"] = "40",
						["duration"] = "1",
						["unit"] = "player",
						["use_weapon"] = true,
						["debuffType"] = "HELPFUL",
						["custom_hide"] = "timed",
						["type"] = "custom",
						["names"] = {
						},
						["unevent"] = "auto",
						["use_showOn"] = true,
						["use_enchant"] = true,
						["event"] = "Weapon Enchant",
						["showOn"] = "showOnMissing",
						["subeventPrefix"] = "SPELL",
						["custom"] = "function()\n    if UnitAffectingCombat(\"player\") then\n        local _, _, _, mhEnchant = GetWeaponEnchantInfo()\n        if mhEnchant ~= 564 and mhEnchant ~= 563 and mhEnchant ~= 1783 then\n            local partyMembers = GetNumSubgroupMembers()\n            for i=1,partyMembers do\n                local unit = 'party'..i\n                if UnitClass(unit) == '萨满' and not UnitIsDead(unit) and UnitLevel(unit) >= 32 then\n                    for i = 1,16 do\n                        buff = UnitBuff(\"player\", i)\n                        if not buff then\n                            break\n                        elseif buff ~= '风之优雅图腾' and buff ~= '根基图腾' and buff ~= '自然抗性图腾' and buff ~= '宁静之风图腾' and buff ~= '风怒图腾' then\n                            aura_env.shaname = UnitName(unit)\n                            if aura_env.config['spamchat'] then\n                                local index = UnitInRaid(unit)\n                                if index then\n                                    local _, _, _, _, _, _, partyZone = GetRaidRosterInfo(index)\n                                    if GetSubZoneText(\"player\") == partyZone or GetZoneText(\"player\") == partyZone then\n                                        local now = GetTime()\n                                        if now - aura_env.wfTime > aura_env.config['spaminterval'] then\n                                            aura_env.wfTime = now\n                                            SendChatMessage(\"风怒图腾覆盖不到！\",\"PARTY\")\n                                        end\n                                    end\n                                end\n                            end\n                            return true\n                        end\n                    end    \n                end\n            end\n        end\n    end\n    return false\nend\n\n\n",
						["spellIds"] = {
