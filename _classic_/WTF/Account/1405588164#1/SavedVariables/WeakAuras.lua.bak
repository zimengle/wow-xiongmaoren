						["custom"] = "function(event)\n    local _, _, _, sourceGUID, _, _, _, _, _, _, _, spellId = CombatLogGetCurrentEventInfo()\n    return sourceGUID == WeakAuras.myGUID and spellId == aura_env.trinketBuffId\nend",
