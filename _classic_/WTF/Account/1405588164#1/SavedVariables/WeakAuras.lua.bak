			["parent"] = "Consumables: Group - Paladin // Retribution",
		},
		["MDF - Health Updater 2"] = {
			["outline"] = "OUTLINE",
			["wagoID"] = "5Pz4pCOF5",
			["authorOptions"] = {
				{
					["type"] = "description",
					["text"] = "|cFF6666FFJeyp's Boss Frames|r",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [1]
				{
					["type"] = "description",
					["text"] = "|cFFFF6666Important |r: Always update your options when having the top most group of the WA selected (Jeyp's Boss Frames) to avoid desyncing the values.",
					["fontSize"] = "medium",
					["width"] = 2,
				}, -- [2]
				{
					["type"] = "space",
					["variableWidth"] = true,
					["height"] = 1,
					["width"] = 2,
					["useHeight"] = false,
				}, -- [3]
				{
					["type"] = "number",
					["useDesc"] = true,
					["max"] = 5,
					["step"] = 0.05,
					["width"] = 1,
					["min"] = 0,
					["key"] = "fHealthUpdateInterval",
					["desc"] = "Scan the raid targets to update health of NPC that are not available as a namplate. Can be set to 0 to disable it.",
					["name"] = "RaidScan Health Update Interval",
					["default"] = 1,
				}, -- [4]
			},
			["displayText_format_p_time_dynamic_threshold"] = 60,
			["yOffset"] = 0,
			["anchorPoint"] = "CENTER",
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["url"] = "https://wago.io/5Pz4pCOF5/108",
			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "aura_env.tFramesNPCIDs = {}\naura_env.tNPCToFind = {}\naura_env.iNPCsToFind = 0\naura_env.iNPCsFound = 0\naura_env.tUnitCache = {}\n\nlocal function CheckUnitForMatch(sUnit)\n    local sUnitGUID = UnitGUID(sUnit)\n    if sUnitGUID then\n        local sUnitNPCID = select(6, strsplit(\"-\", sUnitGUID))\n        if sUnitNPCID then\n            if aura_env.tNPCToFind[sUnitNPCID] then\n                WeakAuras.ScanEvents(\"MultiDotFrame_UpdateHealth\", sUnitNPCID, sUnit)\n                aura_env.tUnitCache[aura_env.tNPCToFind[sUnitNPCID]] = sUnit\n                aura_env.tNPCToFind[sUnitNPCID] = nil\n                aura_env.iNPCsFound = aura_env.iNPCsFound + 1\n                return true\n            end\n        end\n    end\n    return false\nend\n\nlocal function UpdateHealthBars()\n    aura_env.iNPCsFound = 0\n    aura_env.tNPCToFind = {}\n    for k,v in pairs(aura_env.tFramesNPCIDs) do\n        aura_env.tNPCToFind[v] = k\n    end\n    \n    -- First check the cache for qui access to already found targets\n    for k,v in pairs(aura_env.tUnitCache) do\n        if not CheckUnitForMatch(v) then\n            aura_env.tUnitCache[k] = nil\n        end\n    end\n    \n    -- Then check the raid for missing NPCs\n    CheckUnitForMatch(\"target\")\n    CheckUnitForMatch(\"focus\")\n    CheckUnitForMatch(\"pettarget\")\n    for i = 0,40 do\n        CheckUnitForMatch(\"raid\" .. i .. \"target\")\n        CheckUnitForMatch(\"raid\" .. i .. \"pettarget\")\n        if aura_env.iNPCsFound >= aura_env.iNPCsToFind then break end\n    end\nend\naura_env.fnUpdateHealthBars = UpdateHealthBars\n\nlocal function SetupNPCIDs() \n    if aura_env.tZoneData == nil then return false end\n    \n    aura_env.tFramesNPCIDs = {}\n    aura_env.iNPCsToFind = 0\n    for k,v in pairs(aura_env.tZoneData) do\n        if type(v) == \"table\" then\n            aura_env.tFramesNPCIDs[k] = v.sNPCID\n            aura_env.iNPCsToFind = aura_env.iNPCsToFind + 1\n        end\n    end\nend\naura_env.fnSetupNPCIDs = SetupNPCIDs\n\n",
					["do_custom"] = true,
				},
				["finish"] = {
				},
			},
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["use_alwaystrue"] = true,
						["subeventSuffix"] = "_CAST_START",
						["unit"] = "player",
						["event"] = "Conditions",
						["use_unit"] = true,
						["subeventPrefix"] = "SPELL",
						["custom"] = "function(sEvent, ...)\n    if sEvent == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        if not aura_env.bActive then return false end\n        local fTime = GetTime()\n        if fTime < aura_env.fNextUpdate then return false end\n        aura_env.fnUpdateHealthBars()\n        aura_env.fNextUpdate = fTime + aura_env.config.fHealthUpdateInterval\n    elseif sEvent == \"MultiDotFrame_ChangeZone\" then\n        local tZoneData = select(2, ...)\n        aura_env.bActive = (tZoneData ~= nil and aura_env.config.fHealthUpdateInterval > 0)\n        aura_env.tZoneData = tZoneData\n        aura_env.fnSetupNPCIDs()\n        aura_env.fNextUpdate = 0\n    end \n    return true\nend\n\n\n\n",
