				["init"] = {
					["custom"] = "aura_env.sFrameID = \"A\"\naura_env.iSkinID = 2\naura_env.sFrameName = \"ConsumeButton_MDF_Unit\" .. aura_env.sFrameID .. \"_Alternative\"",
