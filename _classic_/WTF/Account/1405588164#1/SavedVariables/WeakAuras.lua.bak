		["四维四维-数据计算-图示-自定义函数"] = {
			["outline"] = "OUTLINE",
			["wagoID"] = "VMfNhd-Bp",
			["parent"] = "iTank生存输出评分 V2.2.3 WLKC",
			["preferToUpdate"] = false,
			["customText"] = "function ()\n    local function round(num, idp)\n        local mult = 10 ^ (idp or 0);\n        return math.floor(num * mult + 0.5) / mult;\n    end\n    local lowDmg, hiDmg, offlowDmg, offhiDmg, posBuff, negBuff, percentmod = UnitDamage(\"player\")\n    local wpspeed=UnitAttackSpeed('PLAYER')\n    local def = GetDodgeBlockParryChanceFromDefense()\n    local miss = def + 5--未命中\n    local dodge = GetDodgeChance()--闪躲\n    local parry = GetParryChance()--招架\n    local block = GetBlockChance()--格挡\n    local bv = GetShieldBlock()--格挡值\n    local avoidance =miss +dodge +parry\n    --defense skill check\n    local baseDefense, armorDefense = UnitDefense(\"player\");\n    local pdef = (baseDefense + armorDefense)--总防等\n    local defneed = 0--所需防等\n    --table data check\n    local total = (miss +GetDodgeChance() +GetParryChance() +GetBlockChance() )--1024\n    local resil = GetCombatRatingBonus(15)--韧性免爆百分比\n    local ct = round((total - 102.4), 2)--所需1024剩余差额\n    local ctcolor = \"|cffff0000\"..ct..\"%|r\"\n    local holy = GetSpellBonusDamage(2)--法伤\n    local baseArmor , effectiveArmor, armor, posBuff, negBuff = UnitArmor(\"player\")--获取护甲\n    local shear = (GetDodgeChance() +GetParryChance() +GetBlockChance() ) - 101.8--获取剪切三维\n    local shearcolor = \"|cffff0000\"..shear..\"%|r\"\n    local St = UnitStat(\"player\", 3)--耐力\n    local Agi = UnitStat(\"player\", 2)--敏捷\n    local Str = UnitStat(\"player\", 1)--力量\n    \n    local  maxh=UnitHealthMax(\"PLAYER\")--最大生命\n    local hitrating = GetCombatRatingBonus(6)--命中\n    --力量 2.43 敏捷14.73 耐力18.33 命中等级19.75 护甲1 防等19.75 招架等级15.53 躲闪19.44 格挡 7.78 格挡值4.86 生命值1.52 闪躲824分\n    -- local ITankPercent=(dodge * 18.9 * 1.13 + parry * 22.4 * 0.91 + pdef * 2.4 * 1.07 + bv * 0.38 + effectiveArmor * 0.049 + St * 1.1)--未加入格挡\n    local ITankPercent=0\n    ITankPercent= ( Str*2.43+Agi*14.73+St*18.33+effectiveArmor +avoidance*824+block*210+hitrating*32.7*19.75+pdef*19.75+bv*4.86+maxh*1.52)/20\n    \n    local expt, offhandExpertise = GetExpertise();--精准\n    local classFilename, classId = UnitClassBase('Player')\n    local resilneed = 0.0 --韧性所需\n    --local Cr=5+0.04*15-3-GetCombatRatingBonus(2)*0.04-GetCombatRatingBonus(15)--熊用免爆差值   \n    local Cr=0--熊天赋免爆\n    \n    if classId~=11 then        \n        Cr=(5+0.04*15-(pdef-400)*0.04-GetCombatRatingBonus(15))/100--其他职业被暴击，要求人物防御技能满350\n    end\n    if Cr>0 then\n        defneed=Cr/0.04,2---获得实际暴击所需防等\n        resilneed=round(Cr*39.4,0)---获得实际暴击所需R性\n    end\n    \n    --熊属性价值：耐力*1.1+护甲*0.12+闪避*0.92+防等*0.89+韧性*0.46+精准*0.11\n    --https://bbs.nga.cn/read.php?tid=27817439&rand=720\n    --并不是我们自己写的，是根据QS区ITANK帖子内某楼回帖做的数值\n    --不保证正确\n    \n    \n    --免伤计算--\n    local dr= 0\n    local ba,ar=UnitArmor(\"player\")\n    local level = UnitLevel(\"Player\")\n    if level==80 then level=83 end\n    dr= ar/(ar+467.5 *level - 22167.5)\n    --dr= ar/(ar+467.5 *73 - 22167.5)\n    if dr>0.75 then dr=0.75 end\n    ----------------------\n    \n    \n    ----有效生命---\n    local hopeh=0--有效生命\n    local crush=0--被碾压概率\n    local Natt=0--普攻概率\n    local dredDmg=0--固定减伤后值\n    local totalDmg=0--最终期望伤害\n    local finblock=block/100--圆桌格挡\n    local tmpCr=1.024-total/100\n    local classdr=0 --职业减免\n    if classId==1 then classdr=0.1 end--ZS\n    if classId==2 then classdr=0.116 end--FQ\n    if classId==6 then classdr=0.126 end--DK\n    if classId==11 then classdr=0.12 end--熊\n    --ZS 10% 熊12% FQ 11.6% DK 12.6%\n    \n    if tmpCr<Cr then Cr=tmpCr end        \n    Natt=1.024-Cr-crush-total/100\n    if Natt<0 then Natt=0 end\n    if (avoidance+block)>102.4 then finblock=(102.4-avoidance)/100 end\n    dredDmg=43000*(1-dr)*(1-classdr)\n    \n    totalDmg= dredDmg*(2*Cr+Natt)+(dredDmg-bv)*finblock\n    \n    --格挡最末档 格挡+物免超过1024时 超过格挡几率不计算--此时更不会有普攻\n    --  local base, posBuff, negBuff = UnitRangedAttackPower(\"player\");\n    local base, posBuff, negBuff = UnitAttackPower(\"player\")\n    local AP = base + posBuff + negBuff;--攻强\n    local crit=GetCritChance()--暴击率\n    if classId==11 then\n        \n        dredDmg=dredDmg-crit*AP*0.25--野蛮防御\n        totalDmg= dredDmg*(2*Cr+Natt)+(dredDmg-bv)*finblock\n    end\n    hopeh=round(maxh/(totalDmg/43000),2)\n    \n    --------------------\n    if( Cr>0) then ITankPercent=ITankPercent*0.8   \n    else       \n        ITankPercent=ITankPercent*1.1        \n    end           \n    ITankPercent=round( ITankPercent,0)     \n    \n    --return (string.format(\"%.2f\", avoidance)),  (string.format(\"%.0f\", bv)), (string.format(\"%.0f\", holy)), ITankPercent ,total ,\"test\", (string.format(\"%.0f\", Agi))\n    \n    ---包传递字符串组装----    \n    ---j技能信息---    \n    local jnctcolor=\"|cffff0000\"..ct..\"%|r\"\n    if defneed>0 then\n        jnctcolor = \"|cffff8000\"..ct..\"%|r\"\n    end\n    if ct >= 0 then\n        jnctcolor = \"|cff00ff00\"..ct..\"%|r\"\n    end\n    \n    local jnpdef=''\n    if defneed<=0 then\n        jnpdef = \"|cff00ff00\"..pdef..\"|r\"\n    else    \n        jnpdef = \"|cffff0000\"..pdef..\"|r\"\n    end  \n    local jndefneed=''\n    if defneed>0 then\n        jndefneed = \"缺: |cffff0000\"..math.ceil(defneed*100)..\"|r\"\n    else\n        jndefneed = \"达标|r\"\n    end\n    \n    if classId==11 then \n        if defneed<=0 then\n            jnpdef = \"|cff00ff00\"..pdef..\"|r\"\n        else    \n            jnpdef = \"|cffff0000\"..pdef..\"|r\"\n        end  \n        \n        jndefneed='----'\n    end\n    \n    local hitstr=\"|cffff0000\"..string.format(\"%.2f\", hitrating)..\"%|r\" --命中颜色 默认红色\n    \n    if hitrating>=8     then\n        hitstr=\"|cff00ff00\"..string.format(\"%.2f\", hitrating)..\"%|r\"\n    end\n    local Exptstr=\"|cffff0000\"..string.format(\"%.0f\",expt)..\"|r\" --精准颜色 默认红色\n    if expt>=26     then\n        Exptstr=\"|cff00ff00\"..string.format(\"%.0f\",expt)..\"|r\"\n    end\n    \n    local jnret='技能信息：'\n    \n    jnret=jnret..'\\n防等:'..jnpdef..'/'..jndefneed\n    jnret=jnret..'\\n命中:'..hitstr..\"/8%\"\n    jnret=jnret..'\\n免爆:'..jndefneed..'\\n(韧:'..(string.format(\"%.4f\", resil))..',防技:'..string.format(\"%.2f\",(pdef-400)*0.04)..')'--韧性免爆和防御技能免爆相加大于5.6即可\n    --jnret=jnret..'\\n免爆:'..jndefneed..'\\n(韧:'..(string.format(\"%.2f\", resil/0.394))..'%,防技缺:'..Cr..')'\n    jnret=jnret..'\\n护甲值:'..effectiveArmor\n    jnret=jnret..'\\n护甲免伤:'..round(dr*100,2)..'%'\n    \n    ---其他部分信息----\n    --输出评分计算--\n    local wplow=lowDmg-AP/14*wpspeed*1.13\n    local wphi=hiDmg-AP/14*wpspeed*1.13\n    local wpatt=(wplow+wphi)/wpspeed/2\n    local ITankattack=bv*0.27+holy*0.12+AP*0.31+crit*42.9*0.3+wpatt*2.29\n    if hitrating>=8 then ITankattack= ITankattack+8*32.7*0.6\n    else  ITankattack= ITankattack+hitrating *32.7*0.6 end\n    if expt>=26 then ITankattack= ITankattack+(expt-26)*8.3*0.36+26*8.3*0.71\n    else  ITankattack= ITankattack+expt*8.3*0.71 end\n    ITankattack=round(ITankattack,0) \n    --输出评分计算结束--\n    local ret=''\n    if (classId <6) then\n        ret = ret .. \"格挡值:\" .. (string.format(\"%.0f\", bv))..'/2400'\n        ret = ret .. \"\\n精准:\" ..  Exptstr..\"/26\"\n        ret = ret .. \"\\n物理免伤: \".. (string.format(\"%.2f\", avoidance))   \n        ret = ret .. \"\\niTank生存评分: \"..ITankPercent\n        ret = ret .. \"\\niTank输出评分: \"..ITankattack\n        ret = ret..\"\\n有效生命: \".. (string.format(\"%.0f\", hopeh))\n    end\n    \n    if classId ==6 then\n        --  ret = ret .. \"冰固减免:\" .. (string.format(\"%.0f\", bv))\n        ret = ret .. \"\"\n        ret = ret .. \"\\n精准:\" ..  Exptstr..\"/26\"\n        ret = ret .. \"\\n物理免伤: \".. (string.format(\"%.2f\", avoidance))   \n        ret = ret .. \"\\n韧性免爆: \"..(string.format(\"%.2f\", resil))..'%'\n        ret = ret .. \"\\n\\niTank评分: \"..ITankPercent\n        ret = ret..\"\\n有效生命: \".. (string.format(\"%.0f\", hopeh))\n    end\n    \n    if classId ==11 then\n        ret = ret .. \"免爆所需: \"        \n        if defneed>0 then                                \n            ret = ret .. \"\\n防等: \" ..  round(defneed,2)..\"(\"..string.format(\"%.1f\",defneed*2.36)..')'\n            ret = ret .. \"\\n韧性: \".. string.format(\"%.2f\",resilneed)\n        else            \n            ret = ret .. \"\\n防等:已达标\" \n            ret = ret .. \"\\n韧性:已达标\"            \n        end\n        ret = ret .. \"\\niTank评分: \"..ITankPercent\n        ret=ret..'\\n '\n        ret = ret..\"\\n有效生命: \"..hopeh\n    end\n    \n    local dataTB={}\n    dataTB.hopeh=hopeh\n    dataTB.ITankPercent=ITankPercent\n    dataTB.avoidance=avoidance\n    dataTB.pdef=pdef\n    dataTB.effectiveArmor=effectiveArmor\n    dataTB.Total=total\n    dataTB.dr=dr\n    dataTB.defneed=defneed\n    dataTB.ct=ct\n    dataTB.qitastr=ret\n    dataTB.jnstr=jnret\n    dataTB.tag=Cr\n    dataTB.holy=holy\n    dataTB.shear=shear\n    WeakAuras.ScanEvents(\"SCANEVENTS_TBTEST\",dataTB)\n    WeakAuras.ScanEvents(\"SCANEVENTS_TBTEST1\",dataTB)\n    WeakAuras.ScanEvents(\"SCANEVENTS_TBTEST2\",dataTB)\n    return  tonumber(string.format(\"%.2f\", round(miss, 2))), (string.format(\"%.2f\", round(dodge, 2))), (string.format(\"%.2f\", round(parry, 2))), (string.format(\"%.2f\", round(block, 2))), (string.format(\"%.2f\", round(total, 2))), shearcolor\n    \nend",
			["shadowYOffset"] = -1,
			["anchorPoint"] = "CENTER",
			["displayText_format_p_abbreviate_max"] = 8,
			["displayText_format_p_time_format"] = 0,
