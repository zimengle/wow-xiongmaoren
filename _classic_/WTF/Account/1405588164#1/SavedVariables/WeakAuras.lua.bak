		["Sniper Training // Still Timer Text"] = {
			["sparkWidth"] = 10,
			["iconSource"] = -1,
			["authorOptions"] = {
				{
					["type"] = "toggle",
					["default"] = true,
					["key"] = "useOffsets",
					["name"] = "Use Offsets",
					["useDesc"] = false,
					["width"] = 1,
				}, -- [1]
				{
					["type"] = "toggle",
					["default"] = true,
					["width"] = 1,
					["name"] = "Dynamic Offsets",
					["useDesc"] = true,
					["key"] = "dynamicOffsets",
					["desc"] = "Only works if \"Use Offsets\" is enabled -- Uses your last ticks remaining time from 6s to calculate the next tick",
				}, -- [2]
				{
					["type"] = "number",
					["useDesc"] = false,
					["max"] = 2,
					["step"] = 0.01,
					["width"] = 1,
