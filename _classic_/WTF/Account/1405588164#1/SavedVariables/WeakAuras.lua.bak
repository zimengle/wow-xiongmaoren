					["type"] = "custom",
					["easeType"] = "none",
					["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    if aura_env.tZoneData and aura_env.tZoneData.iIndex then \n        local fMultiplier = 1\n        if aura_env.config.bReverseGrowth then \n            fMultiplier = -1\n        end\n        return startX, startY - aura_env.tZoneData.iIndex * 105 * fMultiplier\n    end\n    return startX, startY\nend\n\n\n",
