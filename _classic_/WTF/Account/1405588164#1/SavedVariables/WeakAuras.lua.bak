				{
					["trigger"] = {
						["type"] = "custom",
						["custom"] = "function()\n    local t = GetTime()\n    if not aura_env.last or t - aura_env.last > 0.1 then\n        aura_env.last = t\n        local min, max = WeakAuras.GetRange(\"target\")\n        if not min then\n            return false\n        end\n        local tick = aura_env.region.subRegions[5]\n        \n        local projectileSpeed = 57  -- yards/second\n        local projectileETA = min / projectileSpeed  -- seconds\n        local barDuration = 2  -- seconds\n        tick:SetTickPlacement(projectileETA * barDuration)\n    end\n    return false\nend",
