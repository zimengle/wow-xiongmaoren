					["custom"] = "local tAuraData = {}\naura_env.sPlayerClass = \"SHAMAN\"\n\ntAuraData.tDotOrderIndices = {\n    [1] = \"None\", \n    [2] = \"Flame Shock\", \n}\n\ntAuraData.tDotAuras = {\n    [8050] = \"Flame Shock\",\n    [8052] = \"Flame Shock\",\n    [8053] = \"Flame Shock\",\n    [10447] = \"Flame Shock\",\n    [10448] = \"Flame Shock\",\n    [29228] = \"Flame Shock\",\n    [25457] = \"Flame Shock\",\n    [49232] = \"Flame Shock\",\n    [49233] = \"Flame Shock\",\n}\ntAuraData.tDamageTriggers = {\n}\n\ntAuraData.tDamageInfos = {\n}\n\ntAuraData.tSpellsInfos = {\n    [\"Flame Shock\"] = {\n        iDuration = 18,\n        sName = \"Flame Shock\",\n        iIcon = 135813,\n        iColorR = 1.000,\n        iColorG = 0.547,\n        iColorB = 0.247,\n    },  \n}\n\ntAuraData.tCastingModeBindings = aura_env.config.tCastingModeBindings.tShaman\ntAuraData.tBlacklist = aura_env.config.tBlacklist\ntAuraData.tForceDoTOrder = aura_env.config.tForceDoTOrder.tShaman\n\ntAuraData.fExecuteRange = 0\n\nlocal function SendAuraData()\n    WeakAuras.ScanEvents(\"MultiDotFrame_AuraData\", tAuraData, aura_env.sPlayerClass)\nend\n\naura_env.fnSendAuraData = SendAuraData\n\n",
