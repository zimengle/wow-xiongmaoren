		["Algalon - Stars Health - Nameplate Delta"] = {
			["outline"] = "OUTLINE",
			["wagoID"] = "F2PsfgKth",
			["color"] = {
				0.25098040699959, -- [1]
				1, -- [2]
				0.25098040699959, -- [3]
				1, -- [4]
			},
			["displayText"] = "%c1",
			["customText"] = "function()\n    local state = aura_env.state\n    if state and state.value then\n        return string.format(\"%+.1fk\", state.value / 1000)\n    end\nend",
			["yOffset"] = 10,
			["anchorPoint"] = "TOP",
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["automaticWidth"] = "Auto",
			["actions"] = {
				["start"] = {
				},
				["finish"] = {
				},
				["init"] = {
					["custom"] = "local npcName = \"坍缩星\"\nlocal healthDeltas = {}\n\nfunction aura_env.NAME_PLATE_UNIT_ADDED(allStates, unit)\n    DebugPrint(\"NAME_PLATE_UNIT_ADDED\", unit)\n    -- Bail if not Collapsing Star\n    if UnitName(unit) ~= npcName then\n        return false\n    end\n    -- Otherwise, create display for unit\n    local guid = UnitGUID(unit)\n    allStates[guid] = {\n        show = true,\n        changed = true,\n        progressType = \"static\",\n        value = healthDeltas[guid],\n        unit = unit,\n    }\n    return true\nend\n\nfunction aura_env.NAME_PLATE_UNIT_REMOVED(allStates, unit)\n    DebugPrint(\"NAME_PLATE_UNIT_REMOVED\", unit)\n    -- Bail if unit doesn't have a state\n    local guid = UnitGUID(unit)\n    local state = allStates[guid]\n    if not state then\n        return false\n    end\n    -- Otherwise, remove it\n    state.show = false\n    state.changed = false\n    return true\nend\n\nfunction aura_env.WA_ALGALON_STAR_HEALTH_DELTA(allStates, guid, healthDelta)\n    if not guid then\n        return false\n    end\n    DebugPrint(\"WA_ALGALON_STAR_HEALTH_DELTA\", guid, healthDelta)\n    -- Update healthDelta state for guid\n    healthDeltas[guid] = healthDelta\n    -- Bail if no state (nameplate) shown\n    local state = allStates[guid]\n    if not state then\n        return false\n    end\n    -- Otherwise, update state\n    state.value = healthDelta\n    state.changed = true\n    return true\nend\n\nfunction aura_env.OPTIONS(allStates)\n    return false\nend\n\nfunction aura_env.STATUS(allStates)\n    return false\nend",
					["do_custom"] = true,
				},
			},
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["custom_type"] = "stateupdate",
						["debuffType"] = "HELPFUL",
						["event"] = "Health",
						["unit"] = "player",
						["custom"] = "function(states, event, ...)\n  return aura_env[event](states, ...)\nend",
						["events"] = "NAME_PLATE_UNIT_ADDED NAME_PLATE_UNIT_REMOVED WA_ALGALON_STAR_HEALTH_DELTA",
						["spellIds"] = {
