		["General Options - Paladin"] = {
			["iconSource"] = 0,
			["wagoID"] = "Tvh1vQwF4",
			["xOffset"] = 0,
			["preferToUpdate"] = false,
			["yOffset"] = 0,
			["anchorPoint"] = "CENTER",
			["cooldownSwipe"] = true,
