			["actions"] = {
				["start"] = {
				},
				["init"] = {
					["custom"] = "-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"frFR\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] = \"La Grande Forge\",\n    [\"War Quarter\"] = \"Quartier de la guerre\",\n    [\"Heroic Training Dummy\"] = \"Mannequin d'entraînement héroïque\",\n    [\"Grandmaster's Training Dummy\"] = \"Mannequin d'entraînement de grand maître\",\n    [\"Expert's Training Dummy\"] = \"Mannequin d'entraînement d'expert\",\n    [\"Master's Training Dummy\"] = nil,\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = \"Le sanctum Obsidien\",\n    [\"Tenebron\"] = \"Ténébron\",\n    [\"Shadron\"] = \"Obscuron\",\n    [\"Vesperon\"] = \"Vespéron\",\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = \"Assemblée des cavaliers\",\n    [\"Baron Rivendare\"] = \"Baron Vaillefendre\",\n    [\"Thane Korth'azz\"] = \"Thane Korth'azz\",\n    [\"Lady Blaumeux\"] = \"Dame Blaumeux\",\n    -- Ulduar\n    [\"Formation Grounds\"] = \"Champ d'entraînement\",\n    [\"Flame Leviathan\"] = \"Léviathan des flammes\",\n    [\"The Colossal Forge\"] = \"La Forge colossale\",\n    [\"Ignis the Furnace Master\"] = \"Ignis le maître de la Fournaise\",\n    [\"Razorscale's Aerie\"] = \"Nichoir de Tranchécaille\",\n    [\"Razorscale\"] = \"Tranchécaille\",\n    [\"The Scrapyard\"] = \"La Ferraillerie\",\n    [\"XT-002 Deconstructor\"] = \"Déconstructeur XT-002\",\n    [\"The Celestial Planetarium\"] = \"Le planétarium céleste\",\n    [\"Algalon the Observer\"] = \"Algalon l'Observateur\",\n    [\"The Observation Ring\"] = \"le cercle d'observation\",\n    [\"Auriaya\"] = nil,\n    [\"The Halls of Winter\"] = \"Les salles de l'Hiver\",\n    [\"Hodir\"] = nil,\n    [\"The Clash of Thunder\"] = \"Le Fracas du tonnerre\",\n    [\"Thorim\"] = nil,\n    [\"The Descent into Madness\"] = nil,\n    [\"General Vezax\"] = nil,\n    [\"The Prison of Yogg-Saron\"] = nil,\n    [\"Yogg-Saron\"] = nil,\n    [\"The Assembly of Iron\"] = \"L'assemblée du Fer\",\n    [\"Stormcaller Brundir\"] = \"Mande-foudre Brundir\",\n    [\"Runemaster Molgeim\"] = \"Maître des runes Molgeim\",\n    [\"Steelbreaker\"] = \"Brise-acier\",\n    [\"The Shattered Walkway\"] = \"Le passage Brisé\",\n    [\"Right Arm\"] = \"Bras droit\",\n    [\"Kologarn\"] = nil,\n    [\"Left Arm\"] = \"Bras gauche\",\n    [\"The Conservatory of Life\"] = \"Le jardin de la Vie\",\n    [\"Snaplasher\"] = \"Flagellant mordant\",\n    [\"Storm Lasher\"] = \"Flagellant des tempêtes\",\n    [\"Ancient Water Spirit\"] = \"Esprit de l'eau ancien\",\n    [\"The Spark of Imagination\"] = \"L'Étincelle d'imagination\",\n    [\"Aerial Command Unit\"] = \"Unité de commandement aérien\",\n    [\"VX-001\"] = nil,\n    [\"Leviathan Mk II\"] = \"Léviathan Mod. II\",\n    [\"Saronite Animus\"] = nil,\n    [\"Life Spark\"] = nil,\n    [\"XM-024 Pummeller\"] = nil,\n    [\"Freya\"] = nil,\n    [\"Assault Bot\"] = nil,\n    [\"Crusher Tentacle\"] = nil,\n    [\"Corruptor Tentacle\"] = nil,\n    [\"Feral Defender\"] = nil,\n    -- TOC\n    [\"Trial of the Crusader\"] = \"L'épreuve du croisé\",\n    [\"Gormok the Impaler\"] = \"Gormok l'Empaleur\",\n    [\"Snobold Vassal\"] = \"Vassal frigbold\",\n    [\"Acidmaw\"] = \"Gueule-d'acide\",\n    [\"Dreadscale\"] = \"Ecaille-d'effroi\",\n    [\"Icehowl\"] = \"Glace-hurlante\",\n    [\"Lord Jaraxxus\"] = \"Seigneur Jaraxxus\",\n    [\"Nether Portal\"] = \"Portail du Néant\",\n    [\"Infernal Volcano\"] = \"Volcan infernal\",\n    [\"Shaabad\"] = nil,\n    [\"Broln Stouthorn\"] = nil,\n    [\"Anthar Forgemender\"] = nil,\n    [\"Caiphus the Stern\"] = nil,\n    [\"Melador Valestrider\"] = nil,\n    [\"Erin Misthoof\"] = nil,    \n    [\"Saamul\"] = nil,\n    [\"Thrakgar\"] = nil,\n    [\"Irieth Shadowstep\"] = nil,\n    [\"Maz'dinah\"] = nil,\n    [\"Shocuul\"] = nil,\n    [\"Narrhok Steelbreaker\"] = nil, \n    [\"Alyssia Moonstalker\"] = nil,\n    [\"Ruj'kah\"] = nil,\n    [\"Tyrius Duskblade\"] = nil,\n    [\"Gorgrim Shadowcleave\"] = nil,\n    [\"Serissa Grimdabbler\"] = nil,\n    [\"Harkzog\"] = nil, \n    [\"Baelnor Lightbearer\"] = nil,\n    [\"Malithas Brightblade\"] = nil,\n    [\"Velanaa\"] = nil,\n    [\"Liandra Suncaller\"] = nil,\n    [\"Kavina Grovesong\"] = nil,\n    [\"Birana Stormhoof\"] = nil, \n    [\"Brienna Nightfell\"] = nil,\n    [\"Vivienne Blackwhisper\"] = nil,\n    [\"Noozle Whizzlestick\"] = nil,\n    [\"Ginselle Blightslinger\"] = nil,\n    [\"Fjola Lightbane\"] = \"Fjola Plaie-lumineuse\",\n    [\"Eydis Darkbane\"] = \"Eydis Plaie-sombre\",\n    [\"The Icy Depths\"] = \"Les Profondeurs glacées\",\n    [\"Anub'arak\"] = \"Anub'arak\",\n    [\"Nerubian Burrower\"] = \"Fouisseur nérubien\",\n    [\"Onyxia's Lair\"] = nil,\n    [\"Onyxia\"] = nil,\n    [\"Onyxian Lair Guard\"] = nil,\n    -- ICC\n    [\"Putricide's Laboratory of Alchemical Horrors and Fun\"] = \"Laboratoire des désopilantes atrocités alchimiques de Putricide\",\n    [\"Volatile Ooze\"] = \"Limon volatil\",\n    [\"Professor Putricide\"] = \"Professeur Putricide\",\n    [\"Gas Cloud\"] = \"Nuage de gaz\",\n    [\"The Crimson Hall\"] = \"La salle Cramoisie\",\n    [\"Prince Taldaram\"] = nil,\n    [\"Prince Keleseth\"] = nil,\n    [\"Prince Valanar\"] = nil,\n}\n\nlocal function LocalizeTable(tTableToLocalize)\n    if tTableToLocalize.bLocalized then return tTableToLocalize end\n    \n    local tLocalizedTable = {\n        bLocalized = GetLocale(),\n        \n    }\n    \n    local function LocalizeField(tIn, tOut, sKey)\n        local sLocalizedKey = sKey\n        if tLocData.tLocalizations[sKey] and tLocData.tLocalizations[sKey] then\n            sLocalizedKey = tLocData.tLocalizations[sKey]\n        end\n        \n        if type(tIn[sKey]) == \"table\" then\n            tOut[sLocalizedKey] = {}\n            \n            for k,_ in pairs(tIn[sKey]) do\n                LocalizeField(tIn[sKey], tOut[sLocalizedKey], k)\n            end\n        else\n            if tLocData.tLocalizations[tIn[sKey]] and tLocData.tLocalizations[tIn[sKey]] then\n                tOut[sLocalizedKey] = tLocData.tLocalizations[tIn[sKey]]\n            else\n                tOut[sLocalizedKey] = tIn[sKey]\n            end\n        end\n    end\n    \n    for k,_ in pairs(tTableToLocalize) do\n        LocalizeField(tTableToLocalize, tLocalizedTable, k)\n    end\n    \n    return tLocalizedTable\nend\ntLocData.fnLocalizeTable = LocalizeTable\n\nlocal function InitLoca()\n    if GetLocale() == aura_env.sLocale then\n        WeakAuras.ScanEvents(\"MultiDotFrame_Localize\", tLocData)\n    end\nend\naura_env.fnInitLoca = InitLoca\n\nInitLoca()",
