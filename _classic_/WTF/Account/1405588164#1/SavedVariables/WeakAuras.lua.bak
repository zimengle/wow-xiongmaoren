			["actions"] = {
				["start"] = {
				},
				["finish"] = {
				},
				["init"] = {
					["custom"] = "aura_env.isMoving = false;\naura_env.pGUID = UnitGUID(\"player\");\naura_env.offset = nil;\n\naura_env.getDuration = function(applied)\n    if (aura_env.config.useOffsets) then\n        if (aura_env.config.dynamicOffsets and aura_env.offset ~= nil) then\n            return 6 - aura_env.offset;\n        end\n        \n        if (applied) then\n            return 6 - aura_env.config.standingOffset;\n        else\n            return 6 - aura_env.config.moveOffset;\n        end\n    end\n    return 6; -- Calc Lag Here Using https://wowpedia.fandom.com/wiki/API_GetNetStats\nend",
					["do_custom"] = true,
				},
			},
