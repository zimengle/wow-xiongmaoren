			["cooldownSwipe"] = true,
			["displayText_format_p_time_format"] = 0,
			["customTextUpdate"] = "event",
			["cooldownEdge"] = false,
			["actions"] = {
				["start"] = {
					["glow_frame_type"] = "UNITFRAME",
					["glow_type"] = "buttonOverlay",
					["do_glow"] = false,
					["glow_action"] = "show",
				},
				["finish"] = {
					["hide_all_glows"] = true,
				},
				["init"] = {
					["custom"] = "aura_env.lastUpdate = GetTime() - 10\naura_env.timerTable = {}\n\n\n\n",
					["do_custom"] = true,
				},
			},
			["triggers"] = {
				{
					["trigger"] = {
						["type"] = "custom",
						["custom_type"] = "stateupdate",
						["debuffType"] = "HELPFUL",
						["subeventSuffix"] = "_CAST_START",
						["event"] = "Health",
						["subeventPrefix"] = "SPELL",
						["names"] = {
						},
						["spellIds"] = {
						},
						["custom"] = "function(all, event,flag, subEvent,_, _, _, _, _, _,destName,_,_, spellId)\n    if not flag then return end\n    local checkDebuff = tonumber(aura_env.config.debuffid)\n    if event == \"START_SHOW_ICON\" then\n        local index = 1\n        local _,_,icon = GetSpellInfo(checkDebuff)\n        for raidUnit in WA_IterateGroupMembers() do\n            local _,_,_,_,_,expTime = WA_GetUnitDebuff(raidUnit,checkDebuff) \n            if raidUnit ~= \"player\" and expTime then\n                if all[raidUnit] and all[raidUnit].expirationTime < expTime or not all[raidUnit] then\n                    local glow = false\n                    if index == 1 and aura_env.config.glow1 then glow = true end\n                    if index == 2 and aura_env.config.glow2 then glow = true end\n                    if index == 3 and aura_env.config.glow3 then glow = true end\n                    if index == 4 and aura_env.config.glow4 then glow = true end\n                    if index == 5 and aura_env.config.glow5 then glow = true end\n                    all[raidUnit] = {\n                        show = true,\n                        changed = true,\n                        icon = icon,\n                        progressType = \"timed\",\n                        autoHide = true,\n                        duration = aura_env.config.duration,\n                        expirationTime = aura_env.config.duration + GetTime(),\n                        name = tostring(index),\n                        unit = raidUnit,\n                        glow = glow\n                    }\n                    index = index + 1\n                end\n            end\n        end\n        return true\n    end\n    \n    if event ==\"COMBAT_LOG_EVENT_UNFILTERED\" then\n        if subEvent == \"SPELL_AURA_APPLIED\"  and spellId and spellId == checkDebuff and destName then\n            if GetTime() - aura_env.lastUpdate > 10 then -- 新一轮点名，0.1秒后排序\n                aura_env.lastUpdate = GetTime()\n                for timer  in pairs(aura_env.timerTable) do\n                    if timer then\n                        timer:Cancel()\n                    end\n                end\n                aura_env.timerTable = {}\n                local timer = C_Timer.NewTimer(0.1, function()\n                        WeakAuras.ScanEvents(\"START_SHOW_ICON\",true)\n                end)\n                aura_env.timerTable[timer] = true\n            end\n            return\n        elseif subEvent == \"SPELL_AURA_REMOVED\"and spellId and spellId == checkDebuff and destName and all[destName] then\n            all[destName].show = false\n            all[destName].changed = true\n            return true\n        end\n    end\nend",
						["events"] = "CLEU:SPELL_AURA_APPLIED,CLEU:SPELL_AURA_REMOVED,START_SHOW_ICON",
						["check"] = "event",
						["unit"] = "player",
						["customVariables"] = "{\n    expirationTime = true,\n    glow = \"bool\"\n}",
						["custom_hide"] = "timed",
					},
					["untrigger"] = {
					},
				}, -- [1]
