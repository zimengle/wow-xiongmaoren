
EasyAuctionDB = {
["enableUndercut"] = true,
["updateNotes"] = {
{
["date"] = "2026-01-09",
["note"] = "- 新增常用物品清单的导入导出功能，支持多角色同步\n- 修复拍卖行扫描时的变量作用域问题\n- 优化单体搜索时自动填写逻辑\n- 在价格库列表中添加在售数列，显示当前拍卖行中该物品的数量\n",
["version"] = "2.5.3",
},
{
["date"] = "2026-01-09",
["note"] = "- 新增拍卖列表左键复制物品名称功能，可通过配置开关，设置入口：EasyAuctio设置--插件设置--在售列表左键复制\n- 修复自动填充上次拍卖价格的逻辑，默认关闭该功能\n- 调整部分UI元素位置和尺寸\n",
["version"] = "2.5.1",
},
{
["date"] = "2026-01-08",
["note"] = "- 新增自动填充上次拍卖价格功能，默认关闭，可在设置中开启。\n  注意：该功能开启后，自动压价功能将失效。\n- 移除待售列表左键点击复制功能。\n",
["version"] = "2.4.8",
},
{
["date"] = "2026-01-06",
["note"] = "- 添加窗口锁定/解锁功能，允许用户固定或移动拍卖行界面。\n- 修复鼠标提示变量刷新问题，确保在鼠标悬停时显示准确的物品信息。\n- 修复全服扫描时价格数据合并的问题。\n- 调整商机发现界面UI元素的层级，确保正常显示和操作。\n",
["version"] = "2.4.7",
},
{
["date"] = "2026-01-06",
["note"] = "- 优化全局扫描功能，重构拍卖扫描逻辑\n- 清理冗余代码\n",
["version"] = "2.4.6",
},
{
["date"] = "2026-01-05",
["note"] = "- 新增UI缩放控制功能，支持50%-200%的缩放调节，\n进入路径：设置--插件设置\n\n- 添加更新日志弹窗，显示版本变更信息，\n进入路径：设置--插件设置--更新日志\n\n- 添加“周边插件”按钮，\n进入路径：设置--插件设置--周边插件\n",
["version"] = "2.4.5",
},
{
["date"] = "2026-01-03",
["note"] = "- 优化价格走势界面，修复无数据连线错误\n- 优化价格库界面，增加走势按钮\n- 新增分类按钮高亮显示功能\n- 添加极简模式按钮，支持快速禁用/恢复其他插件\n- 优化分类页面逻辑，修复分页显示问题\n- 调整宝石分类数据，增加新宝石类型\n- 修复配置界面布局和文字对齐问题\n- 修复拍卖行可用状态更新错误\n",
["version"] = "2.4.4",
},
},
