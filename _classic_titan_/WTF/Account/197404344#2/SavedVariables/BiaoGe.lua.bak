["nameLink"] = "|Hplayer:沉老:46435:RAID:|h[|cffc41f3b沉老|r]|h",
},
{
["textColor"] = "FF4500",
["text"] = "救命！<茱茱>的金币大军开着 \"奥术飞弹\"来了，谁顶得住啊！",
