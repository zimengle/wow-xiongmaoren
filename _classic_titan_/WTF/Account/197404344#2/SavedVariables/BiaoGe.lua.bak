["nameLink"] = "|Hplayer:沉老:46461:RAID:|h[|cffc41f3b沉老|r]|h",
},
{
["textColor"] = "FF4500",
["text"] = "救命！<茱茱>的金币如 \"恶魔之怒\"般汹涌，直接把竞拍场炸翻！",
["time"] = 1775733720,
["nameLink"] = "|Hplayer:沉老:46474:RAID:|h[|cffc41f3b沉老|r]|h",
},
{
["textColor"] = "FF4500",
["text"] = "别人出价是 \"普通攻击\"，<游侠丶追猎者>出价是 \"暴击秒杀\"！太狠了！",
["time"] = 1775733728,
["nameLink"] = "|Hplayer:沉老:46569:RAID:|h[|cffc41f3b沉老|r]|h",
},
{
["textColor"] = "FF4500",
["text"] = "<游侠丶追猎者>一喊价，就像 \"死亡骑士冰链术\"，其他玩家的出价全被冻结！",
