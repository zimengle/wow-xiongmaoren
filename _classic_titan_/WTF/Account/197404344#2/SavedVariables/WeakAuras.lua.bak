},
["displayText"] = "%c",
["customText"] = "function()\n    \n    if not aura_env.last or aura_env.last < GetTime() - 0.2 then\n        aura_env.last = GetTime()\n        \n        if UnitExists(\"target\") then\n            if not IsItemInRange(16114, \"target\") then\n                aura_env.displayText = \"打不到\"\n            elseif IsCurrentSpell(6603) == false then\n                aura_env.displayText = \"没在打\"\n            else \n                aura_env.displayText = \"\"\n            end\n        end\n        \n    end\n    \n    return aura_env.displayText\n    \nend\n\n\n",
["yOffset"] = 10,
["anchorPoint"] = "CENTER",
["customTextUpdate"] = "update",
