["customText"] = "-- Author: 露露緹婭@Bilibili\nfunction()\n    local default_text = \"-护甲\"\n    local spellId = aura_env.state and aura_env.state.spellId\n    local RurutiaSpellName = (spellId and GetSpellInfo(spellId)) or default_text\n    \n    local RurutiaSpellIDs = {\n        -- 测试用\n        --[48066] = \"|cff00ff00护盾|r\", -- 真言术：盾\n        \n        -- 熔火之心\n        [15502] = \"-护甲\", -- 破甲攻击\n        \n        \n        -- BUFF\n    }\n    return spellId and RurutiaSpellIDs[spellId] or RurutiaSpellName\nend",
