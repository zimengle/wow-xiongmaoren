["actions"] = {
["start"] = {
["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\nlocal R = \"Interface\\\\AddOns\\\\Rurutia\\\\【露露】\"\n\nlocal triggerSounds = {\n    [1] = R..\"豪猪好了.ogg\",           -- 豪猪诱饵\n}\n\nlocal activeTriggers = WeakAuras.GetActiveTriggers(aura_env.id)\nif activeTriggers then\n    for triggerIndex, isActive in pairs(activeTriggers) do\n        if isActive and triggerSounds[triggerIndex] then\n            PlaySoundFile(triggerSounds[triggerIndex], \"Master\")\n            return\n        end\n    end\nend",
