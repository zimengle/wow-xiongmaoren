},
["sameTexture"] = true,
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local chatFrame = SELECTED_DOCK_FRAME\nlocal inputbox = chatFrame.editBox\nlocal e = aura_env\nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region) \n    e.btn:RegisterForClicks(\"AnyUp\",\"AnyDown\")\n    e.btn:SetScript(\"OnMouseUP\", function(self)\n            PVEFrame_ToggleFrame()\n            region:SetAlpha(1)\n    end)\n    e.btn:SetScript(\"OnMouseDown\", function(self)\n            region:SetAlpha(0.5)\n    end)\n    e.btn:SetScript(\"OnEnter\",function(self)\n            GameTooltip:SetOwner(self, 'ANCHOR_TOP', 0,1)\n            GameTooltip:AddLine(\"队伍查找器\")\n            GameTooltip:Show()\n            region:SetScale(1.05)\n    end)\n    e.btn:SetScript(\"OnLeave\",function(self)\n            GameTooltip:Hide()\n            region:SetScale(1)\n    end)\n    e.btn:SetAllPoints(region)\nend",
},
["finish"] = {
},
},
