["【露露】随机本一键退队（离开副本队伍）"] = {
["iconSource"] = -1,
["parent"] = "【露露】随机本快捷工具（一键退队、快速传送按钮）",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = -2,
["anchorPoint"] = "BOTTOM",
["cooldownSwipe"] = true,
["cooldownEdge"] = false,
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\nlocal e = aura_env\nlocal region = WeakAuras.GetRegion(e.id) \n\n-- 1. 创建按钮\n-- 创建一个继承自 SecureActionButtonTemplate 的按钮，允许执行受保护的动作（如施法、宏）\nif not _G[e.id..\"Button\"] then \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, \"SecureActionButtonTemplate\")\n    e.btn:RegisterForClicks(\"AnyUp\") \n    e.btn:SetAllPoints(region)\nend\nlocal btn = _G[e.id..\"Button\"]\n\n-- 2. 设置功能 (左键)\n-- 设置按钮类型为宏 (macro)\nbtn:SetAttribute(\"type1\", \"macro\")\n-- 设置宏文本：如果还在随机队伍(2)中，则调用退队函数；否则打印提示。\nbtn:SetAttribute(\"macrotext1\", \"/run if IsInGroup(2) then C_PartyInfo.ConfirmLeaveParty(2) else print('|cff00ff00<露露的副本助手>|r 当前不在随机副本队伍，无法退出。') end\")\n\n-- 3. 鼠标提示与交互 (视觉效果)\nbtn:SetScript(\"OnEnter\", function(self)\n        -- 视觉反馈：放大\n        region:SetScale(1.15)\n        \n        -- 设置 Tooltip\n        GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\")\n        \n        -- 标题\n        GameTooltip:SetText(\"|cffffffff露露的快捷按钮|r\") \n        \n        -- 内容\n        GameTooltip:AddLine(\"|cffffffff点击：|r|cff00ff00离开副本队伍|r\")\n        \n        GameTooltip:Show()\nend)\n\nbtn:SetScript(\"OnLeave\", function(self)\n        region:SetScale(1)\n        GameTooltip:Hide()\nend)\n\nbtn:SetScript(\"OnMouseDown\", function(self) region:SetAlpha(0.5) end)\nbtn:SetScript(\"OnMouseUp\", function(self) region:SetAlpha(1) end)",
},
["finish"] = {
},
},
