},
["init"] = {
["custom"] = "-- Loca Data zhTW Init\n-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"zhTW\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] = nil,\n    [\"War Quarter\"] = \"軍事區\",\n    [\"Valley of Honor\"] = nil,\n    [\"Heroic Training Dummy\"] = \"英雄訓練假人\",\n    [\"Grandmaster's Training Dummy\"] = \"宗師的訓練假人\",\n    [\"Expert's Training Dummy\"] = \"專家的訓練假人\",\n    [\"Master's Training Dummy\"] = \"大師的訓練假人\",\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = nil,\n    [\"Tenebron\"] = nil,\n    [\"Shadron\"] = nil,\n    [\"Vesperon\"] = nil,\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = nil,\n    [\"Baron Rivendare\"] = nil,\n    [\"Thane Korth'azz\"] = nil,\n    [\"Lady Blaumeux\"] = nil,\n    -- Ulduar\n    [\"Formation Grounds\"] = nil,\n    [\"Flame Leviathan\"] = nil,\n    [\"The Colossal Forge\"] = \"巨熔爐\",\n    [\"Ignis the Furnace Master\"] = \"『火爐之主』伊格尼司\",\n    [\"Razorscale's Aerie\"] = \"銳鱗之巢\",\n    [\"Razorscale\"] = \"銳鱗\",\n    [\"The Scrapyard\"] = \"廢料場\",\n    [\"XT-002 Deconstructor\"] = \"XT-002拆解者\",\n    [\"The Celestial Planetarium\"] = \"星穹渾天儀\",\n    [\"Algalon the Observer\"] = \"『觀察者』艾爾加隆\",\n    [\"The Observation Ring\"] = \"觀察之環\",\n    [\"Auriaya\"] = \"奧芮雅\",\n    [\"The Halls of Winter\"] = \"凜冬之廳\",\n    [\"Hodir\"] = \"霍迪爾\",\n    [\"The Clash of Thunder\"] = \"雷鳴之廳\",\n    [\"Thorim\"] = \"索林姆\",\n    [\"The Descent into Madness\"] = \"驟狂斜廊\",\n    [\"General Vezax\"] = \"威札斯將軍\",\n    [\"The Prison of Yogg-Saron\"] = \"尤格薩倫之獄\",\n    [\"Yogg-Saron\"] = \"尤格薩倫\",\n    [\"The Assembly of Iron\"] = \"鐵之集會所\",\n    [\"Stormcaller Brundir\"] = \"風暴召喚者布倫迪爾\",\n    [\"Runemaster Molgeim\"] = \"符文大師墨吉姆\",\n    [\"Steelbreaker\"] = \"破鋼者\",\n    [\"The Shattered Walkway\"] = \"破碎走道\",\n    [\"Right Arm\"] = \"右臂\",\n    [\"Kologarn\"] = \"柯洛剛恩\",\n    [\"Left Arm\"] = \"左臂\",\n    [\"The Conservatory of Life\"] = \"生命溫室\",\n    [\"Snaplasher\"] = \"猛攫鞭笞者\",\n    [\"Storm Lasher\"] = \"風暴鞭笞者\",\n    [\"Ancient Water Spirit\"] = \"上古水之靈\",\n    [\"The Spark of Imagination\"] = \"創思之廳\",\n    [\"Aerial Command Unit\"] = \"空中指揮裝置\",\n    [\"VX-001\"] = nil,\n    [\"Leviathan Mk II\"] = \"戰輪MK II\",\n    [\"Saronite Animus\"] = \"薩倫聚惡體\",\n    [\"Life Spark\"] = \"生命火光\",\n    [\"XM-024 Pummeller\"] = \"XM-024擊打者\",\n    [\"Freya\"] = \"芙蕾雅\",\n    [\"Assault Bot\"] = \"突襲機器人\",\n    [\"Crusher Tentacle\"] = \"粉碎觸手\",\n    [\"Corruptor Tentacle\"] = \"腐化觸手\",\n    [\"Feral Defender\"] = \"聖所哨衛\",\n    -- TOC\n    [\"Trial of the Crusader\"] = \"十字軍試煉\",\n    [\"Gormok the Impaler\"] = \"『穿刺者』戈莫克\",\n    [\"Snobold Vassal\"] = \"極地狗頭人奴僕\",\n    [\"Acidmaw\"] = \"酸喉\",\n    [\"Dreadscale\"] = \"懼鱗\",\n    [\"Icehowl\"] = \"冰嚎\",\n    [\"Lord Jaraxxus\"] = \"賈拉克瑟斯領主\",\n    [\"Nether Portal\"] = \"虛空傳送門\",\n    [\"Infernal Volcano\"] = \"煉獄火山\",\n    [\"Mistress of Pain\"] = nil,\n    [\"Shaabad\"] = nil,\n    [\"Broln Stouthorn\"] = nil,\n    [\"Anthar Forgemender\"] = nil,\n    [\"Caiphus the Stern\"] = nil,\n    [\"Melador Valestrider\"] = nil,\n    [\"Erin Misthoof\"] = nil,    \n    [\"Saamul\"] = nil,\n    [\"Thrakgar\"] = nil,\n    [\"Irieth Shadowstep\"] = nil,\n    [\"Maz'dinah\"] = nil,\n    [\"Shocuul\"] = nil,\n    [\"Narrhok Steelbreaker\"] = nil, \n    [\"Alyssia Moonstalker\"] = nil,\n    [\"Ruj'kah\"] = nil,\n    [\"Tyrius Duskblade\"] = nil,\n    [\"Gorgrim Shadowcleave\"] = nil,\n    [\"Serissa Grimdabbler\"] = nil,\n    [\"Harkzog\"] = nil, \n    [\"Baelnor Lightbearer\"] = nil,\n    [\"Malithas Brightblade\"] = nil,\n    [\"Velanaa\"] = nil,\n    [\"Liandra Suncaller\"] = nil,\n    [\"Kavina Grovesong\"] = nil,\n    [\"Birana Stormhoof\"] = nil, \n    [\"Brienna Nightfell\"] = nil,\n    [\"Vivienne Blackwhisper\"] = nil,\n    [\"Noozle Whizzlestick\"] = nil,\n    [\"Ginselle Blightslinger\"] = nil,\n    [\"Fjola Lightbane\"] = \"菲歐拉·光寂\",\n    [\"Eydis Darkbane\"] = \"艾狄絲·暗寂\",\n    [\"The Icy Depths\"] = \"冰結深淵\",\n    [\"Anub'arak\"] = \"阿努巴拉克\",\n    [\"Nerubian Burrower\"] = \"奈幽掘洞者\",\n    [\"Onyxia's Lair\"] = \"奧妮克希亞的巢穴\",\n    [\"Onyxia\"] = \"奧妮克希亞\",\n    [\"Onyxian Lair Guard\"] = \"奧妮克希亞守衛\",\n    -- ICC\n    [\"The Spire\"] = \"冰冠尖塔\",\n    [\"Lord Marrowgar\"] = \"瑪洛嘉領主\",\n    [\"Bone Spike\"] = \"骸骨尖刺\",\n    [\"Oratory of the Damned\"] = \"詛咒祈願室\",\n    [\"Lady Deathwhisper\"] = \"亡語女士\",\n    [\"Cult Adherent\"] = \"神教擁護者\",\n    [\"Cult Fanatic\"] = \"神教狂熱者\",\n    [\"Rampart of Skulls\"] = \"骸顱壁壘\",\n    [\"Muradin Bronzebeard\"] = \"穆拉丁·銅鬚\",\n    [\"High Overlord Saurfang\"] = \"薩魯法爾霸王\",\n    [\"Deathbringer's Rise\"] = \"死亡使者高崗\",\n    [\"Deathbringer Saurfang\"] = \"死亡使者薩魯法爾\",\n    [\"Blood Beast\"] = \"血獸\",\n    [\"The Plagueworks\"] = \"瘟疫工坊\",\n    [\"Festergut\"] = \"爛腸\",\n    [\"Rotface\"] = \"腐臉\",\n    [\"Little Ooze\"] = \"小軟泥怪\",\n    [\"Putricide's Laboratory of Alchemical Horrors and Fun\"] = \"普崔希德的恐懼與歡樂鍊金實驗室\",\n    [\"Volatile Ooze\"] = \"暴躁軟泥怪\",\n    [\"Professor Putricide\"] = \"普崔希德教授\",\n    [\"Gas Cloud\"] = \"毒氣雲\",\n    [\"The Crimson Hall\"] = \"赤紅大廳\",\n    [\"Prince Taldaram\"] = \"泰爾達朗親王\",\n    [\"Prince Keleseth\"] = \"凱雷希斯親王\", \n    [\"Prince Valanar\"] = \"瓦拉納爾親王\",\n    [\"The Sanctum of Blood\"] = \"血之聖所\",\n    [\"Blood-Queen Lana'thel\"] = \"血腥女王菈娜薩爾\",\n    [\"The Frostwing Halls\"] = \"霜翼大廳\",\n    [\"Valithria Dreamwalker\"] = \"瓦莉絲瑞雅·夢行者\",\n    [\"Gluttonous Abomination\"] = \"貪吃的憎惡體\",\n    [\"Risen Archmage\"] = \"復活的大法師\",\n    [\"Suppresser\"] = \"抑制者\",\n    [\"The Frost Queen's Lair\"] = \"霜翼之巢\",\n    [\"Sindragosa\"] = \"辛德拉苟莎\",\n    [\"The Frozen Throne\"] = \"冰封王座\",\n    [\"The Lich King\"] = \"巫妖王\",\n    [\"Shambling Horror\"] = \"蹣跚的恐獸\",\n    [\"Ice Sphere\"] = nil,\n    [\"Raging Spirit\"] = nil,\n    [\"Val'kyr Shadowguard\"] = nil,\n}\n\n\n\nlocal function LocalizeTable(tTableToLocalize)\n    if tTableToLocalize.bLocalized then return tTableToLocalize end\n    \n    local tLocalizedTable = {\n        bLocalized = GetLocale(),\n        \n    }\n    \n    local function LocalizeField(tIn, tOut, sKey)\n        local sLocalizedKey = sKey\n        if tLocData.tLocalizations[sKey] and tLocData.tLocalizations[sKey] then\n            sLocalizedKey = tLocData.tLocalizations[sKey]\n        end\n        \n        if type(tIn[sKey]) == \"table\" then\n            tOut[sLocalizedKey] = {}\n            \n            for k,_ in pairs(tIn[sKey]) do\n                LocalizeField(tIn[sKey], tOut[sLocalizedKey], k)\n            end\n        else\n            if tLocData.tLocalizations[tIn[sKey]] and tLocData.tLocalizations[tIn[sKey]] then\n                tOut[sLocalizedKey] = tLocData.tLocalizations[tIn[sKey]]\n            else\n                tOut[sLocalizedKey] = tIn[sKey]\n            end\n        end\n    end\n    \n    for k,_ in pairs(tTableToLocalize) do\n        LocalizeField(tTableToLocalize, tLocalizedTable, k)\n    end\n    \n    return tLocalizedTable\nend\ntLocData.fnLocalizeTable = LocalizeTable\n\nlocal function InitLoca()\n    if GetLocale() == aura_env.sLocale then\n        WeakAuras.ScanEvents(\"MultiDotFrame_Localize\", tLocData)\n    end\nend\naura_env.fnInitLoca = InitLoca\n\nInitLoca()",
["do_custom"] = true,
},
