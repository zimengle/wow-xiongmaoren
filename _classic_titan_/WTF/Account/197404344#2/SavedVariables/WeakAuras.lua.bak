["特效合集（其他）露露语音"] = {
["iconSource"] = -1,
["authorOptions"] = {
},
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["custom"] = "-- Author: 露露緹婭@Bilibili\n-- 获取当前触发的技能ID\nlocal spellId = aura_env.state and aura_env.state.spellId\nif not spellId or not aura_env.soundMap[tostring(spellId)] then\n    return\nend\n\nlocal spellIdStr = tostring(spellId)\nlocal currentTime = GetTime()\n\n-- 检查是否需要间隔播报\nif aura_env.cooldownConfig[spellIdStr] then\n    local cooldownTime = aura_env.cooldownConfig[spellIdStr]\n    local lastTime = aura_env.lastPlayTime[spellIdStr] or 0\n    \n    -- 如果还在冷却时间内，不播放音效\n    if currentTime - lastTime < cooldownTime then\n        return\n    end\n    \n    -- 更新上次播放时间\n    aura_env.lastPlayTime[spellIdStr] = currentTime\nend\n\n-- 播放音效\nlocal soundFile = aura_env.soundMap[spellIdStr]\nif soundFile then\n    if not soundFile:match(\"^Interface\\\\\\\\\") then\n        soundFile = aura_env.RurutiaVoice .. soundFile\n    end\n    PlaySoundFile(soundFile, \"Master\")\nend",
["do_sound"] = true,
["do_custom"] = true,
["sound_path"] = "Interface\\Addons\\Rurutia\\【露露】蓝龙.ogg",
["sound"] = "Interface\\Addons\\SharedMedia_MyMedia\\sound\\!Wind-OnePlusLight.ogg",
},
["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\n-- 更新国服美酒节特供版饰品（271装等）\naura_env.RurutiaVoice = \"Interface\\\\Addons\\\\Rurutia\\\\\"\n\naura_env.cooldownConfig = {\n    [\"60513\"] = 10, -- 技能减耗\n}\n\n-- 初始化上次播报时间记录表\nif not aura_env.lastPlayTime then\n    aura_env.lastPlayTime = {}\nend\n\n-- 音效映射表：只包含原 conditions 1-15 中已定义的音效\naura_env.soundMap = {\n    [\"60234\"] = \"【露露】伟大.ogg\", -- 条件1：智力\n    [\"60235\"] = \"【露露】伟大.ogg\", -- 条件2：精神\n    [\"60229\"] = \"【露露】伟大.ogg\", -- 条件3：力量\n    [\"60233\"] = \"【露露】伟大.ogg\", -- 条件4：敏捷\n    [\"57933\"] = \"【露露】嫁祸.ogg\", -- 条件5：增伤\n    [\"59628\"] = \"【露露】嫁祸.ogg\",\n    [\"49016\"] = \"【露露】狂热.ogg\", -- 条件5：增伤\n    [\"55975\"] = \"【露露】狂热.ogg\",\n    [\"55213\"] = \"【露露】狂热.ogg\",\n    [\"60513\"] = \"【露露】技能减耗.ogg\", -- 条件6：减耗\n    [\"59620\"] = \"【露露】狂暴.ogg\", -- 条件7：狂暴\n    [\"49623\"] = \"【露露】回蓝.ogg\", -- 条件8：回蓝\n    [\"64999\"] = \"【露露】回蓝.ogg\",\n    [\"1247618\"] = \"【露露】回蓝.ogg\",\n    [\"64739\"] = \"Interface\\\\Addons\\\\SharedMedia_MyMedia\\\\sound\\\\!IOS-竹子.ogg\", -- 条件8：回蓝（特殊路径）\n    [\"60437\"] = \"【露露】破甲.ogg\", -- 条件10：破甲\n    [\"60436\"] = \"【露露】破甲.ogg\",\n    [\"65020\"] = \"【露露】破甲.ogg\",\n    [\"65019\"] = \"【露露】破甲.ogg\",\n    [\"1265735\"] = \"【露露】破甲.ogg\",  -- 削骨之刃\n    [\"65024\"] = \"【露露】暴击.ogg\", -- 条件11：暴击\n    [\"398478\"] = \"【露露】躲闪.ogg\", -- 条件12：躲闪\n    [\"1259913\"] = \"【露露】躲闪.ogg\", -- 打斗者的纪念品，醉仙步，躲闪\n    [\"64763\"] = \"【露露】躲闪.ogg\",\n    [\"1247619\"] = \"【露露】躲闪.ogg\",\n    [\"64411\"] = \"【露露】Tararan.ogg\", -- 条件13：橙锤\n    [\"53365\"] = \"【露露】十字军.ogg\", -- 堕落十字军附魔\n    [\"28093\"] = \"【露露】猫鼬.ogg\", -- 猫鼬附魔\n}",
},
