["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local tZonesData = {}\ntZonesData.sName = \"T7\"\ntZonesData.tBlacklist = aura_env.config.tNPCBlackList.tT7\ntZonesData.tZones = {\n    [\"The Obsidian Sanctum\"] = {\n        [\"A\"] = {\n            sNPCID = \"30452\",\n            sTarName = \"Tenebron\",\n            iIcon = 236473,\n            tEnabledOptions = {\n                \"bSartharionFight\", \n                \"bTenebron\",\n            },\n        },\n        [\"B\"] = {     \n            sNPCID = \"30451\",\n            sTarName = \"Shadron\",\n            iIcon = 236470,\n            tEnabledOptions = {\n                \"bSartharionFight\", \n                \"bShadron\",\n            },\n        },\n        [\"C\"] = {     \n            sNPCID = \"30449\",\n            sTarName = \"Vesperon\",\n            iIcon = 236473,\n            tEnabledOptions = {\n                \"bSartharionFight\", \n                \"bVesperon\",\n            },\n        },\n    },\n    [\"The Horsemen's Assembly\"] = {\n        [\"A\"] = {\n            sNPCID = \"30549\",\n            sTarName = \"Baron Rivendare\",\n            iIcon = 132264,\n            tEnabledOptions = {\n                \"b4HMFight\", \n                \"bRivendare\",\n            },\n        },\n        [\"B\"] = {   \n            sNPCID = \"16064\",\n            sTarName = \"Thane Korth'azz\",\n            iIcon = 135821,  \n            tEnabledOptions = {\n                \"b4HMFight\", \n                \"bThane\",\n            },\n        },\n        [\"C\"] = {     \n            sNPCID = \"16065\",\n            sTarName = \"Lady Blaumeux\",\n            iIcon = 136192,\n            tEnabledOptions = {\n                \"b4HMFight\", \n                \"bBlaumeux\",\n            },\n        },\n        [\"D\"] = {     \n            sNPCID = \"16063\",\n            sTarName = \"Sir Zeliek\",\n            iIcon = 135972,\n            tEnabledOptions = {\n                \"b4HMFight\", \n                \"bZeliek\",\n            },\n        },\n    },\n}\n\nlocal function SendZonesData()\n    WeakAuras.ScanEvents(\"MultiDotFrame_ZonesData_Section\", tZonesData)\nend\n\naura_env.fnSendZonesData = SendZonesData\n\n",
["do_custom"] = true,
},
