["customText"] = "function()\n    local name, _, min, max, value = \n    if (max ~= 0) then\n        local currentMin = value - min;\n        local currentMax = max - min;\n        aura_env.text = name .. \" - \" .. currentMin.. \"/\" .. currentMax;\n        return true;\n    end\nend",
