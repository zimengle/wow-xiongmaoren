["customTriggerLogic"] = "function(t)\n    local _, class = UnitClass(\"player\")\n    -- 玩家是团长/助理，或者职业是法师/萨满/德鲁伊\n    local check =\n    UnitIsGroupLeader(\"player\")\n    or UnitIsGroupAssistant(\"player\")\n    or class == \"MAGE\"\n    or class == \"SHAMAN\"\n    or class == \"DRUID\"\n    \n    if check then\n        return t[1]\n    end\nend",
