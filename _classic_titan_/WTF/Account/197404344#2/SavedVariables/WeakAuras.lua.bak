["Fojji - Drain Soul Snapshot Helper"] = {
["sparkWidth"] = 10,
["sparkOffsetX"] = 0,
["wagoID"] = "DiSLra9PF",
["xOffset"] = 0,
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = -110,
["anchorPoint"] = "CENTER",
["anchorFrameType"] = "SCREEN",
["iconSource"] = -1,
["sparkRotation"] = 0,
["sparkRotationMode"] = "AUTO",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.ds = GetSpellInfo(47855)\naura_env.dsStart = 0\naura_env.delta = 0\naura_env.spProc = 0\n\naura_env.procTrinkets = {\n    [60494] = 765, -- Dying Curse\n    [60064] = 590, -- Sundial of the Exiled\n    [64713] = 959, -- Flare of the Heavens\n}\n\nlocal spellCoefficient = 0.429\nlocal coefficientTotal = 2.145\nlocal shadowMastery = 1.15\nlocal deathsEmbrace = 1.12\nlocal drainSoulModifier = 4\nlocal baseDS = 840\n\nfunction aura_env.getCurrentValues()\n    local spellPower = GetSpellBonusDamage(6)\n    local _,_,_,_,_,_,varmodapplied = UnitDamage(\"player\")\n    local mod = varmodapplied\n    local _,_,_,sbCastTime = GetSpellInfo(6215)\n    local dsChannel = (sbCastTime / 1000) * 10\n    \n    return spellPower, mod, dsChannel\nend\n\nfunction aura_env.calculateStore()\n    local spellPower, mod, dsChannel = aura_env.getCurrentValues()\n    aura_env.spellPowerStore = spellPower - aura_env.spProc\n    \n    local spellDamage = aura_env.spellPowerStore * coefficientTotal\n    local snappedDamage = (baseDS + spellDamage) * shadowMastery * deathsEmbrace * drainSoulModifier * mod\n    local total = snappedDamage / dsChannel\n    \n    return math.floor(total)\nend\n\nfunction aura_env.calculateLive()\n    local spellPower, mod, dsChannel = aura_env.getCurrentValues()\n    \n    local spellDamage = spellPower * coefficientTotal\n    local snappedDamage = (baseDS + spellDamage) * shadowMastery * deathsEmbrace * drainSoulModifier * mod\n    local total = snappedDamage / dsChannel\n    \n    return math.floor(total)\nend\n\nfunction aura_env.HauntCastTime()\n    local _,_,_,GCD = GetSpellInfo(6215)\n    if not GCD then GCD = 1.5 end\n    return GCD/1000\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["spellNames"] = {
47855,
},
["type"] = "unit",
["subeventSuffix"] = "_CAST_START",
["use_exact_spellId"] = false,
["use_spellNames"] = true,
["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
["event"] = "Cast",
["unit"] = "player",
["use_unit"] = true,
["names"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["duration"] = "",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(event)\n    aura_env.total = aura_env.calculateStore()\n    return true\nend",
["subeventPrefix"] = "SPELL",
["events"] = "DS_CAST",
["names"] = {
},
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["duration"] = "1",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "timed",
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(event, _, subevent, _, _, sourceName, _, _, destGUID, destName, _, _, spellId, spellName)\n    \n    if subevent == \"SPELL_AURA_APPLIED\" and destName == UnitName(\"player\") then\n        if aura_env.procTrinkets[spellId] then\n            aura_env.spProc = aura_env.procTrinkets[spellId]\n            return true\n        end\n        aura_env.total = aura_env.calculateStore()\n        return true\n    end\n    \n    if subevent == \"SPELL_AURA_REMOVED\" and destName == UnitName(\"player\") then\n        if aura_env.procTrinkets[spellId] then\n            aura_env.spProc = 0\n            return true\n        end\n        return true\n    end\nend",
["subeventPrefix"] = "SPELL",
["events"] = "PROC_CHECK CLEU:SPELL_AURA_APPLIED CLEU:SPELL_AURA_REMOVED",
["names"] = {
},
["spellIds"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "timed",
["custom"] = "function(event, _, subevent, _, _, sourceName, _, _, destGUID, destName, _, _, spellId, spellName)\n    if subevent == \"SPELL_CAST_SUCCESS\" and spellName == aura_env.ds and sourceName == UnitName(\"player\") then\n        WeakAuras.ScanEvents(\"PROC_CHECK\")\n        aura_env.spProc = 0\n        C_Timer.After(.2, function() \n                WeakAuras.ScanEvents(\"DS_CAST\")\n        end)\n        return true\n    end\nend",
["spellIds"] = {
},
