["custom"] = "-- Author: 露露緹婭@Bilibili\nfunction(allstates, event, _, subEvent, _, sourceGUID, sourceName, _, _, destGUID, destName, _, _, spellId, spellName)\n    if not aura_env.spell then return false end\n    \n    local isTargetSpell = false\n    for _, id in ipairs(aura_env.spell) do\n        if id == spellId then\n            isTargetSpell = true\n            break\n        end\n    end\n    \n    if not isTargetSpell then \n        for guid, state in pairs(allstates) do\n            if state.show and state.expirationTime and state.expirationTime <= GetTime() then\n                state.show = false\n                state.changed = true\n                return true\n            end\n        end\n        return false \n    end\n    \n    if destGUID == UnitGUID(\"player\") and not allstates[destGUID] then\n        if aura_env.soundFile then\n            PlaySoundFile(aura_env.soundFile, \"Master\")\n        end\n        if IsInGroup() and aura_env.chatMessage and aura_env.chatChannel then\n            SendChatMessage(string.format(aura_env.chatMessage, spellName, destName), aura_env.chatChannel)\n        end\n    end\n    \n    local unitId\n    if destGUID == UnitGUID(\"player\") then\n        unitId = \"player\"\n    else\n        for i = 1, 4 do\n            if UnitGUID(\"party\"..i) == destGUID then\n                unitId = \"party\"..i\n                break\n            end\n        end\n        if not unitId and IsInRaid() then\n            for i = 1, 40 do\n                if UnitGUID(\"raid\"..i) == destGUID then\n                    unitId = \"raid\"..i\n                    break\n                end\n            end\n        end\n    end\n    \n    if destName then\n        allstates[destGUID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = aura_env.duration,\n            expirationTime = GetTime() + aura_env.duration,\n            autoHide = true,\n            spellName = spellName,\n            unitName = destName,\n            icon = C_Spell.GetSpellTexture(spellId) or 136243,\n            unit = unitId\n        }\n        return true\n    end\n    \n    return false\nend",
