1,
},
["displayText_format_1.percenthealth_gcd_gcd"] = true,
["customText"] = "-- Author: 露露緹婭@Bilibili\nfunction()\n    local default_text = \"你被心控\"\n    local spellId = aura_env.state and aura_env.state.spellId\n    local RurutiaSpellName = (spellId and GetSpellInfo(spellId)) or default_text\n    \n    local RurutiaSpellIDs = {\n        -- 测试用\n        --[48066] = \"|cff00ff00护盾|r\", -- 真言术：盾\n        \n        -- 毒蛇神殿、风暴要塞\n        -- 小怪\n        [38945] = \"恐惧\", -- 破胆怒吼    \n        [38718] = \"快躲开\", -- 剧毒之池   \n        [39032] = \"毒Dot\", -- 初期感染    \n        [38591] = \"-50%护甲\", -- 碎裂护甲\n        [38626] = \"你被心控\", -- 支配\n        [37122] = \"你被心控\", -- 支配\n        [10308] = \"昏迷\", -- 制裁之锤\n        \n        -- 不稳定的海度斯\n        [38235] = \"水墓\", -- 水之墓\n        [38246] = \"-50%伤害/治疗\", -- 肮脏淤泥\n        \n        -- 盲眼者莱欧瑟拉斯\n        [37749] = \"你被心控\", -- 噬体\n        [37527] = \"你被放逐\", -- 放逐术\n        [37676] = \"击杀心魔\", -- 诱惑低语\n        \n        -- 深水领主卡拉瑟雷斯\n        [38358] = \"昏迷\", -- 海潮涌动\n        [39261] = \"-50%施法速度\", -- 尘风\n        [29436] = \"法力燃烧\", -- 吸血投掷\n        [38441] = \"昏迷\", -- 灾难之箭\n        \n        -- 莫洛格里·踏潮者\n        [38187] = \"-75%护甲\", -- 穿刺护甲\n        [37730] = \"-攻速\", -- 潮汐奔涌\n        [38023] = \"水墓\", -- 水之墓穴\n        [38024] = \"水墓\", -- 水之墓穴\n        [38025] = \"水墓\", -- 水之墓穴\n        \n        -- 瓦斯琪\n        [38511] = \"你被心控\", -- 说服\n        [38316] = \"定身\", -- 纠缠\n        [38258] = \"恐惧\", -- 恐慌\n        [38575] = \"快躲开\", -- 剧毒孢子\n        \n        -- 奥\n        [35383] = \"快躲开\", -- 烈焰之地\n        \n        -- 空灵机甲\n        [34190] = \"沉默\", -- 奥术宝珠\n        \n        -- 大星术师\n        [33390] = \"沉默\", -- 奥术洪流\n        [34322] = \"恐惧\", -- 心灵尖啸\n        \n        \n        -- 凯尔萨斯\n        [44863] = \"恐惧\", -- 咆哮\n        [36797] = \"你被心控\", -- 精神控制\n        [36731] = \"快躲开\", -- 烈焰风暴\n        [37027] = \"周期昏迷\", -- 遥控玩具\n    }\n    return spellId and RurutiaSpellIDs[spellId] or RurutiaSpellName\nend",
