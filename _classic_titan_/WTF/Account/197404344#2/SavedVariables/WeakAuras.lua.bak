},
["information"] = {
},
["useAdjustededMax"] = false,
["textureWrapMode"] = "CLAMPTOBLACKADDITIVE",
["cooldownEdge"] = false,
["desc"] = "by 露露緹婭@Bilibili。\n\n当你在5人随机本队伍中时，显示：\n1，一键退队按钮，点击按钮可以快速离开副本队伍。\n2，快速传送按钮，点击按钮可以快速传送出/传送进副本队伍。\n\n转载请保留出处，请勿二次修改后发布，商用禁止。",
["authorOptions"] = {
},
["uid"] = "FwvFZ)eFfOE",
["mirror"] = false,
["anchorFrameFrame"] = "Minimap",
["regionType"] = "texture",
["useAdjustededMin"] = false,
["blendMode"] = "BLEND",
["anchorFrameType"] = "SELECTFRAME",
["frameStrata"] = 9,
["anchorFrameParent"] = true,
["texture"] = "Interface\\AddOns\\WeakAuras\\Media\\Textures\\Square_White",
["cooldownTextDisabled"] = false,
["zoom"] = 0,
["parent"] = "【露露】随机本快捷工具（一键退队、快速传送按钮）",
["tocversion"] = 38000,
["id"] = "【露露】随机本快速传送（传送出/进地下城）",
["alpha"] = 1,
["useCooldownModRate"] = true,
["width"] = 30,
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\nlocal e = aura_env\nlocal region = WeakAuras.GetRegion(e.id) \n\n-- 1. 创建按钮\nif not _G[e.id..\"Button\"] then \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, \"SecureActionButtonTemplate\")\n    e.btn:RegisterForClicks(\"AnyUp\") \n    e.btn:SetAllPoints(region)\nend\nlocal btn = _G[e.id..\"Button\"]\n\n-- 2. 设置功能 (左键)\nbtn:SetAttribute(\"type1\", \"macro\")\n\n-- [核心功能]：调用 LFGTeleport\n-- IsInInstance() 返回 true/false (或相关数值)，LFGTeleport 接受布尔值来决定是传进还是传出。\n-- 这里的逻辑是：自动判断当前状态并进行反向传送。\nbtn:SetAttribute(\"macrotext1\", \"/run if IsInGroup(2) then local i=IsInInstance() LFGTeleport(i) else print('|cff00ffff<露露的副本助手>|r 当前不在随机副本队伍，无法传送。') end\")\n\n-- 3. 鼠标提示与交互\nbtn:SetScript(\"OnEnter\", function(self)\n        -- 视觉反馈\n        region:SetScale(1.15)\n        \n        -- 设置 Tooltip\n        GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\")\n        \n        -- 标题\n        GameTooltip:SetText(\"|cffffffff露露的快捷按钮|r\") \n        \n        -- 内容\n        GameTooltip:AddLine(\"|cffffffff点击：|r|cff00FFFF传送随机本|r\")\n        \n        GameTooltip:Show()\nend)\n\nbtn:SetScript(\"OnLeave\", function(self)\n        region:SetScale(1)\n        GameTooltip:Hide()\nend)\n\nbtn:SetScript(\"OnMouseDown\", function(self) region:SetAlpha(0.5) end)\nbtn:SetScript(\"OnMouseUp\", function(self) region:SetAlpha(1) end)",
},
},
