},
["disjunctive"] = "any",
["customTriggerLogic"] = "function(t)\nreturn (not t[3]) and (t[1] or t[2])\nend",
["activeTriggerMode"] = -10,
},
["preferToUpdate"] = true,
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local chatFrame = SELECTED_DOCK_FRAME\nlocal inputbox = chatFrame.editBox\nlocal e = aura_env\nlocal region = WeakAuras.GetRegion(e.id) \n\nif not _G[e.id..\"Button\"] then \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region) \n    e.btn:RegisterForClicks(\"AnyUp\")\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\n\nbtn:SetScript(\"OnClick\", function(self, button)\n        if ChatEdit_GetActiveWindow() and IsShiftKeyDown() then\n            ChatEdit_DeactivateChat(inputbox)\n        else\n            if button == \"LeftButton\" then\n                ChatFrame_OpenChat(\"/bg\" .. inputbox:GetText(), chatFrame)\n            else\n                ChatFrame_OpenChat(\"/bg \" .. inputbox:GetText(), chatFrame)\n            end \n        end\nend)\nbtn:SetScript(\"OnMouseUp\", function(self)\n        region:SetAlpha(1)\nend)\nbtn:SetScript(\"OnMouseDown\", function(self)\n        region:SetAlpha(0.5)\nend)\nbtn:SetScript(\"OnEnter\",function(self)\n        region:SetScale(1.25)\nend)\nbtn:SetScript(\"OnLeave\",function(self)\n        region:SetScale(1)\nend)\n\n\n\n",
},
},
