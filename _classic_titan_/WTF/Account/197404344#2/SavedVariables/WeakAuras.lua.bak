["cooldownTextDisabled"] = true,
["frameStrata"] = 1,
["anchorFrameType"] = "SCREEN",
["text1Font"] = "Friz Quadrata TT",
["desc"] = "自用改版，by 露露緹婭@Bilibili，https://space.bilibili.com/455259\n代码原版来自NGA，原名：ZB快捷聊天按钮，by：夜刃",
["inverse"] = false,
