},
["init"] = {
["custom"] = "-- Loca Data esES Init\n-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"esES\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] = \"La Gran Fundición\",\n    [\"War Quarter\"] = \"Barrio de la Guerra\",\n    [\"Valley of Honor\"] = \"Valle del Honor\",\n    [\"Heroic Training Dummy\"] = \"Muñeco de entrenamiento heroico\",\n    [\"Grandmaster's Training Dummy\"] = \"Muñeco de entrenamiento de maestro mayor\",\n    [\"Expert's Training Dummy\"] = \"Muñeco de entrenamiento para expertos\",\n    [\"Master's Training Dummy\"] = \"Muñeco de entrenamiento de maestro\",\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = \"El Sagrario Obsidiana\",\n    [\"Tenebron\"] = nil,\n    [\"Shadron\"] = nil,\n    [\"Vesperon\"] = nil,\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = \"La Asamblea de los Jinetes\",\n    [\"Baron Rivendare\"] = \"Barón Osahendido\",\n    [\"Thane Korth'azz\"] = \"Señor feudal Korth'azz\",\n    [\"Lady Blaumeux\"] = nil,\n    [\"Sir Zeliek\"] = nil,\n    -- Ulduar\n    [\"Formation Grounds\"] = \"Campo de Formación\",\n    [\"Flame Leviathan\"] = \"Leviatán de llamas\",\n    [\"The Colossal Forge\"] = \"La Forja Colosal\",\n    [\"Ignis the Furnace Master\"] = \"Ignis el Maestro de la Caldera\",\n    [\"Razorscale's Aerie\"] = \"Nidal de Tajoescama\",\n    [\"Razorscale\"] = \"Tajoescama\",\n    [\"The Scrapyard\"] = \"La Chatarreria\",\n    [\"XT-002 Deconstructor\"] = \"Desarmador XA-002\",\n    [\"The Celestial Planetarium\"] = \"El Planetario Celestial\",\n    [\"Algalon the Observer\"] = \"Algalon el Observador\",\n    [\"The Observation Ring\"] = \"El Círculo de Observación\",\n    [\"Auriaya\"] = nil,\n    [\"The Halls of Winter\"] = \"Las Cámaras del Invierno\",\n    [\"Hodir\"] = nil,\n    [\"The Clash of Thunder\"] = \"El Fragor del Trueno\",\n    [\"Thorim\"] = nil,\n    [\"The Descent into Madness\"] =