},
["displayIcon"] = "",
["cooldown"] = true,
["customText"] = "-- Author: 露露緹婭@Bilibili\n-- 更新国服美酒节特供版饰品（271装等）\nfunction()\n    -- 获取当前触发的法术ID\n    local spellId = aura_env.state and aura_env.state.spellId\n    \n    -- 如果没有法术ID，返回空字符串\n    if not spellId then\n        return \"\"\n    end\n    \n    -- 映射表\n    local RurutiaTexts = {\n        -- 暗月卡牌伟大\n        [60234] = \"智力\",\n        [60235] = \"精神\",\n        [60229] = \"力量\",\n        [60233] = \"敏捷\",\n        \n        -- 增伤类\n        [57933] = \"增伤\",\n        [59628] = \"增伤\",    \n        [49016] = \"增伤\",\n        [55975] = \"增伤\",    \n        [55213] = \"增伤\",    \n        \n        -- 技能效果\n        [60513] = \"减耗\",    \n        [59620] = \"狂暴\",    \n        \n        -- 资源回复\n        [49623] = \"回蓝\",    \n        [64999] = \"回蓝\",    \n        [1247618] = \"回蓝\",  \n        [64739] = \"回蓝\",    \n        \n        -- 战斗效果\n        [60437] = \"破甲\",    \n        [60436] = \"破甲\",    \n        [65020] = \"破甲\",    \n        [65019] = \"破甲\",    \n        [65024] = \"暴击\",    \n        \n        -- 防御类\n        [398478] = \"躲闪\",   \n        [64763] = \"躲闪\",    \n        [1247619] = \"躲闪\",  \n        [1259913] = \"躲闪\", -- 打斗者的纪念品，醉仙步，躲闪（271）\n        \n        -- 武器附魔\n        [53365] = \"十字军\",  \n        [28093] = \"猫鼬\",    \n        \n        -- 特殊装备\n        [64411] = \"橙锤\",    \n        [1249836] = \"黑心\",  \n        [1259888] = \"回血\", -- 光明汽酒咒符，美酒女郎的祝福，回血（271）\n    }\n    \n    -- 查找并返回对应的显示文本\n    return RurutiaTexts[spellId] or \"\"\nend",
},
["露露的问答-背景（反馈问题）"] = {
["parent"] = "【左上按钮】露露的问答（框架）",
["preferToUpdate"] = true,
["yOffset"] = -135,
["anchorPoint"] = "TOPLEFT",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["do_custom"] = true,
["custom"] = "local e = aura_env\nlocal Rurutia_FAQ = WeakAuras.GetRegion(\"露露的问答-近期问答\") \nlocal Rurutia_LOG = WeakAuras.GetRegion(\"露露的问答-更新日志\") \nlocal Rurutia_VIDEO = WeakAuras.GetRegion(\"露露的问答-视频教程\") \nlocal Rurutia_LINK = WeakAuras.GetRegion(\"露露的问答-反馈问题\") \nlocal Rurutia_CMD = WeakAuras.GetRegion(\"露露的问答-常用命令\") \nlocal Rurutia_MACRO = WeakAuras.GetRegion(\"露露的问答-宏分享\") \nlocal Rurutia_DMG = WeakAuras.GetRegion(\"露露的问答-伤害数字\") \nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, nil) \n    e.btn:RegisterForClicks(\"AnyUp\",\"AnyDown\")\n    e.btn:SetAttribute(\"type\", \"macro\")\n    e.btn:SetAttribute(\"macrotext\",str)\n    e.btn:SetText(e.id)\n    e.btn:SetAllPoints(region) \nend\nlocal btn = _G[e.id..\"Button\"]\n\nbtn:SetScript(\"OnMouseUp\", function(self)\n        if Rurutia_LINK:IsShown() then\n            Rurutia_FAQ:Hide()\n            Rurutia_LOG:Hide()\n            Rurutia_VIDEO:Hide()\n            Rurutia_CMD:Hide()\n            Rurutia_MACRO:Hide()\n            Rurutia_DMG:Hide()\n        else\n            Rurutia_LINK:Show()\n            Rurutia_FAQ:Hide()\n            Rurutia_LOG:Hide()\n            Rurutia_VIDEO:Hide()\n            Rurutia_CMD:Hide()\n            Rurutia_MACRO:Hide()\n            Rurutia_DMG:Hide()\n        end\nend)\n\nlocal function onEnter(self)\n    GameTooltip:SetOwner(self, \"ANCHOR_NONE\");\n    GameTooltip:SetPoint(\"LEFT\", self, \"RIGHT\");\n    GameTooltip:ClearLines();\nend\nlocal function onLeave(self)\n    GameTooltip:Hide();\nend\nbtn:SetScript(\"OnEnter\",onEnter)\nbtn:SetScript(\"OnLeave\",onLeave)",
},
