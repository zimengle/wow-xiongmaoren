},
["preferToUpdate"] = true,
["customText"] = "function()\n    \n    return aura_env.config.SVer1\n    \nend",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local e = aura_env\nif not e.id then return end\nlocal region = WeakAuras.GetRegion(e.id)\nif not region then return end\nif not _G[e.id..\"Button\"] then\n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region)\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\nbtn:SetScript(\"OnEnter\", function(self)\n        GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\")\n        GameTooltip:ClearLines()\n        GameTooltip:SetText(\"|cffffffff命中属性说明：|r\\n\"..\n            \"本WA的面板命中不含任何职业的天赋命中点数，\\n\"..\n            \"请根据你的职业、天赋点数自行调整配装命中。\\n\\n\"..\n            \"以下是各职业命中要求参考：\\n\"..\n            \"装备需要的百分比+天赋点数增加的百分比\\n\"..\n            \"（天赋中每少点1%，装备端则需补上1%）\\n\"..\n            \"|cffC79C6E战士：5%+3%（狂暴）|r\\n\"..\n            \"|cffF58CBA骑士：8%|r\\n\"..\n            \"|cffC41F3B死亡骑士：8%|r\\n\"..\n            \"|cffABD473猎人：5%+3%|r\\n\"..\n            \"|cff0070DE萨满：8%（增强）；11%+3%（元素）|r\\n\"..\n            \"|cffFFF569潜行者：8%|r\\n\"..\n            \"|cffFF7D0A德鲁伊：10%（鸟）；8%（猫）|r\\n\"..\n            \"|cff69CCF0法师：14%+3%|r\\n\"..\n            \"|cff9482C9术士：11/14%+3%|r\\n\"..\n            \"|cffFFFFFF牧师：11%+6%|r\\n\"..\n            \"|cff919191\\n\"..\n            \"本注释由\\\"死木头\\\"提供建议。\\n\"..\n        \"（https://space.bilibili.com/17129246）|r\")\nend)\n\nbtn:SetScript(\"OnLeave\", function(self)\n        GameTooltip:Hide()\nend)\n\nbtn:Show()",
},
},
