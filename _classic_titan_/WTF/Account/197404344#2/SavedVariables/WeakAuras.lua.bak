["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local chatFrame = SELECTED_DOCK_FRAME\nlocal inputbox = chatFrame.editBox\nlocal e = aura_env\nlocal region = WeakAuras.GetRegion(e.id) \n\nif not _G[e.id..\"Button\"] then \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region) \n    e.btn:RegisterForClicks(\"AnyUp\")\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\n\nbtn:SetScript(\"OnClick\", function(self)\n        if  IsShiftKeyDown()  then\n            RandomRoll(100, 100)\n        else\n            RandomRoll(1, 100)\n        end\nend)\nbtn:SetScript(\"OnMouseUp\", function(self)\n        region.texture:SetTexture('Interface\\\\Buttons\\\\UI-GroupLoot-Dice-Up')\n        --region:SetAlpha(1)\nend)\nbtn:SetScript(\"OnMouseDown\", function(self)\n        region.texture:SetTexture('Interface\\\\Buttons\\\\UI-GroupLoot-Dice-Down')\n    --    region:SetAlpha(0.5)\nend)\nbtn:SetScript(\"OnEnter\",function(self)\n        region:SetScale(1.15)\nend)\nbtn:SetScript(\"OnLeave\",function(self)\n        region:SetScale(1)\nend)\n\n\n",
},
