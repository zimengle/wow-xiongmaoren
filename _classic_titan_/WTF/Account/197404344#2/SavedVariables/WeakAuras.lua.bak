},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "function ()\n    local maxh, maxm = 0\n    local maxh = UnitHealthMax(\"PLAYER\")\n    local maxm = UnitPowerMax(\"PLAYER\")\n    local str = ''\n    local className, classFilename, classId = UnitClass('Player')\n    local realmName = GetRealmName()\n    local name = GetUnitName(\"PLAYER\")\n    local level = UnitLevel('PLAYER')\n    local _, raceName = UnitRace(\"PLAYER\")  -- 获取玩家种族\n    \n    -- 种族中文翻译表\n    local raceTranslations = {\n        Dwarf = \"矮人\",\n        Human = \"人类\",\n        NightElf = \"暗夜精灵\",\n        Orc = \"兽人\",\n        Undead = \"亡灵\",\n        Tauren = \"牛头人\",\n        Gnome = \"侏儒\",\n        Troll = \"巨魔\",\n        BloodElf = \"血精灵\",\n        Draenei = \"德莱尼\",\n    }\n    \n    -- 如果种族翻译表中有对应的中文名称，替换种族名称\n    if raceTranslations[raceName] then\n        raceName = raceTranslations[raceName]\n    end\n    \n    -- 根据职业ID设置颜色\n    if classId == 1 then str = \"|cffc79c6e\"   -- 战士\n    elseif classId == 2 then str = \"|cfff58cba\"   -- 圣骑士\n    elseif classId == 3 then str = \"|cffabd473\"   -- 猎人\n    elseif classId == 4 then str = \"|cfffff569\"   -- 盗贼\n    elseif classId == 5 then str = \"|cffffffff\"   -- 牧师\n    elseif classId == 6 then str = \"|cffc41f3b\"   -- 死亡骑士\n    elseif classId == 7 then str = \"|cff0070de\"   -- 萨满祭司\n    elseif classId == 8 then str = \"|cff69ccf0\"   -- 法师\n    elseif classId == 9 then str = \"|cff9482c9\"   -- 术士\n    elseif classId == 10 then str = \"|cff00ff96\"  -- 武僧\n    elseif classId == 11 then str = \"|cffff7d0a\"  -- 德鲁伊\n    end\n    ----天赋专精----\n    local preTalentPointSpent = 0\n    local talentName = \"\"\n    local curTalentPoints = {}\n    \n    -- 遍历3个天赋树\n    for i = 1, 3 do\n        local _, name,_,_,pointsSpent = GetTalentTabInfo(i)\n        \n        -- 确保 pointsSpent 是数字类型\n        pointsSpent = tonumber(pointsSpent) or 0\n        \n        curTalentPoints[i] = pointsSpent  -- 将点数存入表格\n        \n        -- 比较当前天赋树的点数，找到点数最多的天赋树\n        if pointsSpent > preTalentPointSpent then\n            preTalentPointSpent = pointsSpent\n            talentName = name\n        end\n    end\n    local talentPointsString=table.concat(curTalentPoints,\"/\")\n    \n    str = str .. 'iTank V2.5.2.1205 For Titan'..'      服务器：' .. realmName ..'\\n'--该版本号更新于2025-04-17\n    str = str .. '角色：' .. name .. '   职业：' .. className ..  '   天赋：'..talentName..' '..talentPointsString ..'\\n'\n    str = str .. '种族：' .. raceName .. '   等级：' .. level .. '   生命值：' .. maxh .. '   能量值：' .. maxm  ..'\\n'\n    str = str .. \"|r\"\n    return str\nend\n\n--Author and modifier information, please do not delete those comment.\n--Coder by: A打头的那个@NGA\n--UI designer：ahhz@NGA\n--DPS model designer：青酒醉红颜123@NGA\n--2022.11.17\n--2024.10.23 GPT Re-code.\n--2024.10.26 2.3.2\n--2024.11.06 2.3.3 去除德莱尼种族判定，改为光环（28878）判定。\n--2024.11.12 2.3.4 修改一处防御等级计算错误\n--2024.12.15 2.4.0 改为全职业防御信息+输出评分结构。\n--2025.03.20 临时修复版\n--2025.03.21 天赋代码修复",
