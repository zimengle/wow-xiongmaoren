["version"] = 25,
["subRegions"] = {
{
["type"] = "subbackground",
},
},
["height"] = 64,
["actions"] = {
["start"] = {
["message_format_missType_format"] = "none",
["message_custom"] = "function()\n    if aura_env.type == \"MISS\" then type_ = \"未命中了\"\n    elseif aura_env.type == \"PARRY\" then type_ = \"被招架了\"\n    elseif aura_env.type == \"DODGE\" then type_ = \"被躲闪了\"\n    elseif aura_env.type ==\"IMMUNE\" then type_ = \"被免疫了\"\n    elseif aura_env.type == \"RESIST\"  then type_ = \"被抵抗了\"\n    elseif aura_env.type == \"BLOCK\" then type_ = \"被格挡了\"\n    end\n    return  \"我的\"..aura_env.spell..type_\nend",
["message_format_spellName_format"] = "none",
