["check"] = "event",
["debuffType"] = "HELPFUL",
["custom"] = "-- Author: 露露緹婭@Bilibili\nfunction()\n    -- IsInGroup(2) 专门检测是否处于“副本/随机队伍”类别 (LE_PARTY_CATEGORY_INSTANCE)\n    -- 如果返回 true，说明你在随机本队伍里，WA 激活\n    return IsInGroup(2)\nend",
