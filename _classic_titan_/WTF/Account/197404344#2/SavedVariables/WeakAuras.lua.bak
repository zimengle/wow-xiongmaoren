},
["frameStrata"] = 1,
["width"] = 50,
["parent"] = "【露露】文字语音提醒组（时光服）",
["uid"] = "VJu24BkbDOA",
["inverse"] = false,
["authorOptions"] = {
},
["displayIcon"] = "",
["information"] = {
["forceEvents"] = true,
["ignoreOptionsEventErrors"] = true,
},
["actions"] = {
["start"] = {
["sound"] = " custom",
["sound_path"] = "",
["do_sound"] = false,
},
["finish"] = {
},
["init"] = {
["do_custom"] = false,
["custom"] = "local e = aura_env \nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, \"SecureActionButtonTemplate\") \n    e.btn:RegisterForClicks(\"LeftButtonUp\", \"RightButtonUp\", \"MiddleButtonUp\")\n    e.btn:SetAttribute(\"type1\",\"macro\")\n    e.btn:SetAttribute(\"type2\",\"macro\")\n    e.btn:SetAttribute(\"type3\",\"macro\")\n    e.btn:SetAllPoints(region) \nend \n\nlocal btn = _G[e.id..\"Button\"] \nbtn:SetAttribute(\"macrotext1\",\"/cancelaura 拯救祝福\\n/cancelaura 强效拯救祝福\")\nbtn:SetAttribute(\"macrotext2\",\"/cancelaura 拯救祝福\\n/cancelaura 强效拯救祝福\")\n--btn:SetAttribute(\"macrotext3\",\"/cast 魔甲术\")\nbtn:SetScript(\"OnEnter\", function(self)               \n        GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\") \n        GameTooltip:SetText(\n            \"|cffffffff左键：|r|cfff7a100\"..\"取消拯救\"..\"|r\\n\"\n            --\"|cffffffff右键：|r|cfff7a100\"..\"取消正义之怒\"..\"|r\\n\"\n            --\"|cffffffff中键：|r|cffff5e4d\"..\"魔甲术\"..\"|r\\n\"\n        , 0, 1, 0, 1, 1)\nend)\n\nbtn:SetScript(\"OnLeave\", function(self) GameTooltip:Hide() end)\nbtn:Show()\n\n--by 露露緹婭@Bilibili，转载请保留出处。",
},
},
},
["【术士】厄运诅咒抵抗语音（lipsen）"] = {
["outline"] = "THICKOUTLINE",
["parent"] = "【露露】文字语音提醒组（时光服）",
["preferToUpdate"] = true,
["customText"] = "function(n,s,t)\n    local type_ = \"\"\n    if aura_env.type == \"MISS\" then type_ = \"未命中\"\n    elseif aura_env.type == \"PARRY\" then type_ = \"招架\"\n    elseif aura_env.type == \"DODGE\" then type_ = \"躲闪\"\n    elseif aura_env.type ==\"IMMUNE\" then type_ = \"免疫\"\n    elseif aura_env.type == \"RESIST\"  then type_ = \"抵抗\"\n    elseif aura_env.type == \"BLOCK\" then type_ = \"格挡\"\n    end\n    local spell_ = \"\"\n    if aura_env.spell == \"厄运诅咒\" then spell_ = \"|T136122:0|t厄运\"\n        --    elseif aura_env.spell  == \"挑战怒吼\" then spell_ = \"|T132091:0|t挑战怒吼\"\n        --    elseif aura_env.spell  ==\"惩戒痛击\"  then spell_ = \"|T132350:0|t惩戒痛击\"\n        --    elseif aura_env.spell  == \"低吼\" then spell_ = \"|T132270:0|t低吼\"\n    end\n    if WeakAuras.IsOptionsOpen()  then\n        return \"|cff8787ed\"..UnitName(\"player\")..\"|r\",\"|T136122:0|t厄运\",\"|cffc41e3a\"..\"抵抗\"..\"|r\"\n    else\n        return  \"|cff8787ed\"..aura_env.name..\"|r\",spell_ ,\"|cffc41e3a\"..type_..\"|r\"\n    end\nend\n\n\n",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["cooldownTextDisabled"] = false,
["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["duration"] = "3",
["subeventPrefix"] = "SPELL",
["use_missType"] = false,
["custom_hide"] = "timed",
["type"] = "custom",
["debuffType"] = "HELPFUL",
["custom_type"] = "event",
["subeventSuffix"] = "_MISSED",
["names"] = {
},
["event"] = "Combat Log",
["unevent"] = "timed",
["events"] = "CLEU:SPELL_MISSED",
["spellIds"] = {
},
["custom"] = "function(_,_,arg3,_,_,arg6,_,_,_,_,_,_,_,arg14,_,arg16, ...)\n    if arg3 == \"SPELL_MISSED\" and arg6 == GetUnitName(\"player\") and aura_env.config[\"reg\"][arg14] then\n        aura_env.name = arg6\n        aura_env.spell = arg14\n        aura_env.type = arg16\n        return true\n    end\nend",
["use_sourceUnit"] = true,
["missType"] = "MISS",
["unit"] = "player",
["sourceUnit"] = "player",
["dynamicDuration"] = false,
},
["untrigger"] = {
