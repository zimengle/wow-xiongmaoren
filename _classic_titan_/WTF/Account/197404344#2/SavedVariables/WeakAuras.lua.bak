["custom"] = "function(allStates, sEvent, ...)\n    if aura_env.config.tDebug.bDebug and aura_env.config.tDebug.bFramesDoTsEvents then\n        print(\"DoTs\", aura_env.sFrameID, sEvent, ...)\n        local s3rdParam = select(3, ...)\n        if type(s3rdParam) == \"table\" then\n            print(dump(s3rdParam))\n        end\n    end\n    if sEvent == \"MultiDotFrame_InitSharedTrigger_DoTs\" then\n        aura_env.tTriggerData = select(1, ...)\n    else\n        if aura_env.tTriggerData then\n            return aura_env.tTriggerData.fnHandleTrigger(allStates, sEvent, ...)\n        end\n    end\n    \n    return false\nend",
