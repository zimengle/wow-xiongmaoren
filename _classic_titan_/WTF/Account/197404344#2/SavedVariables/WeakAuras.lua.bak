},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "function()\n    \n    return aura_env.config.SVer1\n    \nend",
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "local e = aura_env\nif not e.id then return end\nlocal region = WeakAuras.GetRegion(e.id)\nlocal VER1 = aura_env.config.SVer1\nlocal VER = aura_env.config.SVer2\nif not region then return end\nif not _G[e.id..\"Button\"] then\n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region)\n    e.btn:SetAllPoints(region)\nend\n\nlocal btn = _G[e.id..\"Button\"]\nbtn:SetScript(\"OnEnter\", function(self)\n        GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\")\n        GameTooltip:ClearLines()\n        GameTooltip:SetText(\"|cffffffff版本说明：|r\\n|cff919191本版本为\"..VER1..\"。\\n随\"..VER..\"插件包一并发行。\\n感谢您对插件包作者的支持！|r\")\nend)\n\nbtn:SetScript(\"OnLeave\", function(self)\n        GameTooltip:Hide()\nend)\n\nbtn:Show()",
},
},
