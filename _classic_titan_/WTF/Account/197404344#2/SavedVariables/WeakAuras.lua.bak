},
["activeTriggerMode"] = -10,
},
["displayText_format_p_time_mod_rate"] = true,
["displayText_format_p_time_legacy_floor"] = false,
["selfPoint"] = "BOTTOM",
["desc"] = "露露备注：\n生存猎自动切换追踪助手，点出天赋强化追踪生效，副本内加载，会根据目标怪物的类型切换对应的追踪，按照国服客户端重写代码。\n\n国服代码重写：黏土邦邦号-维希度斯\n汉化：露露緹婭@Bilibili\n\n英文原版：\nHunter Auto-track Target's Type\nby Heaviside\nhttps://wago.io/jsWAPs3a7/8\n\n转载请保留出处，请勿二次上传WAGO。",
