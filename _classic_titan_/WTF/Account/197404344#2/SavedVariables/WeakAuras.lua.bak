},
["cooldown"] = true,
["actions"] = {
["start"] = {
["custom"] = "local e = aura_env \nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, \"SecureActionButtonTemplate\") \n    e.btn:RegisterForClicks(\"LeftButtonUp\", \"RightButtonUp\")\n    e.btn:SetAttribute(\"type1\",\"macro\")\n    e.btn:SetAttribute(\"type2\",\"macro\")\n    e.btn:SetAllPoints(region) \nend \n\nlocal btn = _G[e.id..\"Button\"] \nbtn:SetAttribute(\"macrotext1\",\"/use \"..e.id)\nbtn:SetAttribute(\"macrotext2\",\"/use \"..e.id)\nbtn:SetScript(\"OnEnter\", function(self)               \n        GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\") \n        GameTooltip:SetText(\"|cffffffff露露的快捷按钮\\n左键：|r\"..e.id..\"\\n\"\n        , 0, 1, 0, 1, 1)\nend)\n\nbtn:SetScript(\"OnLeave\", function(self) GameTooltip:Hide() end)\nbtn:Show()",
["do_custom"] = true,
},
["init"] = {
["custom"] = "",
["do_custom"] = false,
},
["finish"] = {
["custom"] = "local e = aura_env \nif  _G[e.id..\"Button\"] then \n    local btn = _G[e.id..\"Button\"] \n    btn:Hide()\nend ",
["do_custom"] = true,
},
},
},
["Warlock - Corruption Snapshotter v1.0.9"] = {
["displayText_format_c5_decimal_precision"] = 2,
["iconSource"] = 1,
["authorOptions"] = {
},
["displayText_format_t_time_dynamic_threshold"] = 60,
["displayText_format_c4_format"] = "Number",
["yOffset"] = -146.57,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["custom"] = "if not aura_env.corTicker then\n    aura_env.corTicker = C_Timer.NewTicker(0.1, function()\n            WeakAuras.ScanEvents(\"WA_COR_TICKER\")\n    end)\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "if aura_env.corTicker then\n    aura_env.corTicker:Cancel()\n    aura_env.corTicker = nil\nend",
["do_custom"] = true,
},
["init"] = {
["custom"] = "aura_env.corruption = GetSpellInfo(172)\naura_env.ds = GetSpellInfo(47855)\naura_env.dl = GetSpellInfo(47857)\naura_env.haunt = GetSpellInfo(59164)\naura_env.sb = GetSpellInfo(47809)\naura_env.mutilators = {}\naura_env.total = {}\naura_env.spellPower = {}\naura_env.text = 1",
["do_custom"] = true,
},
},
["displayText_format_p_time_mod_rate"] = true,
["displayText_format_c3_decimal_precision"] = 2,
["displayText_format_c1_format"] = "Number",
["displayText_format_c5_format"] = "Number",
["desc"] = "Fojji - Snapshotter\nhttps://wago.io/5GWfkcgv3/1",
["font"] = "Numen",
["load"] = {
["use_class"] = true,
["use_never"] = false,
["talent"] = {
["multi"] = {
[24] = true,
},
},
["use_talent"] = false,
["class"] = {
["single"] = "WARLOCK",
["multi"] = {
},
},
["spec"] = {
["multi"] = {
},
},
["size"] = {
["multi"] = {
},
},
},
["shadowXOffset"] = 1,
["useAdjustededMin"] = false,
["regionType"] = "icon",
["cooldownTextDisabled"] = true,
["tocversion"] = 30401,
["alpha"] = 1,
["config"] = {
},
["displayText_format_t_time_mod_rate"] = true,
["fixedWidth"] = 200,
["displayText_format_c4_decimal_precision"] = 2,
["wagoID"] = "5GWfkcgv3",
["parent"] = "术士 职业分组（by 露露緹婭@Bilibili）0101更",
["customText"] = "function()\n    -- Check Target\n    local targetGuid = UnitGUID(\"target\")\n    \n    -- Check Spellpower\n    local spellpowercurrent = GetSpellBonusDamage(6)\n    if (aura_env.spellPower[targetGuid] or 1) > spellpowercurrent then\n        aura_env.text = string.format(\"\\124cffFF0000-SP\\124r\")\n        return aura_env.text\n    end\n    \n    -- Check Spell Crit%\n    local critcurrent = GetSpellCritChance(6)\n    \n    -- Check Target Debuffs\n    for i = 1, 255 do\n        local _,_, count,_,_,_,sourceUnit,_,_,spellId = UnitDebuff(\"target\", i)\n        if not spellId then break end\n        if spellId == 22959 or spellId == 17800 then -- Shadow Mastery/Improved Scorch\n            critcurrent = critcurrent + 5\n        end\n        if spellId == 54499 then -- Heart of the Crusader\n            critcurrent = critcurrent + 3\n        end\n        if spellId == 57970 then\n            if UnitInParty(sourceUnit) then\n                local sourceGuid = UnitGUID(sourceUnit)\n                if GetTime() < (aura_env.mutilators[sourceGuid] or 0) then\n                    critcurrent = critcurrent + 3\n                end\n            end\n        end\n    end\n    \n    \n    -- Check Damage Modifier%\n    local _, _,_,_,_,_,varmodcurrent = UnitDamage(\"player\")\n    local modcurrent = varmodcurrent\n    local maxHP = UnitHealthMax(\"target\")\n    local curHP = UnitHealth(\"target\")\n    local perHP = curHP * 100 / maxHP\n    if perHP <= 35 then\n        modcurrent = modcurrent + 0.12 -- Death's Embrace Talent\n    end\n    \n    -- Magic Formula\n    local totalcurrent = (((100* (modcurrent))*(100-critcurrent)/100)+((100* (modcurrent)*2)*(critcurrent)/100))\n    \n    aura_env.totaldifference = totalcurrent - (aura_env.total[targetGuid] or 1)\n    aura_env.text = \"\"\n    if aura_env.totaldifference ~= 0.0 then\n        aura_env.text = string.format(\"|cFF%s%s%.1f%%|r\", aura_env.totaldifference > 0 and '22ff43' or aura_env.totaldifference < 0 and 'ff2f2a' or '808080', aura_env.totaldifference > 0 and '+' or '', aura_env.totaldifference)\n    end\n    return aura_env.text\nend",
["shadowYOffset"] = -1,
["displayIcon"] = 136118,
["cooldownSwipe"] = true,
["cooldown"] = true,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["preferToUpdate"] = false,
["triggers"] = {
{
["trigger"] = {
["duration"] = "18",
["names"] = {
},
["debuffType"] = "HELPFUL",
["custom_hide"] = "custom",
["type"] = "custom",
["subeventSuffix"] = "_CAST_SUCCESS",
["custom_type"] = "event",
["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
["event"] = "Combat Log",
["use_spellName"] = true,
["custom"] = "function(event, _, subevent, _, _, sourceName, _, _, destGUID, destName, _, _, spellId, spellName)\n    \n    -- Store Values on Corruption Cast\n    if (subevent == \"SPELL_AURA_APPLIED\" or subevent == \"SPELL_AURA_REFRESH\") and spellName == aura_env.corruption and sourceName == UnitName(\"player\") then\n        local crit = GetSpellCritChance(6) -- Spell Crit of Shadow School\n        aura_env.spellPower[destGUID] = GetSpellBonusDamage(6) -- Spell Power at time of Application\n        \n        -- Check Debuffs on Target\n        for i = 1, 255 do\n            local _,_, count,_,_,_,sourceUnit,_,_,spellId = UnitDebuff(\"target\", i)\n            if not spellId then break end\n            if spellId == 22959 or spellId == 17800 then -- Shadow Mastery/Improved Scorch\n                crit = crit + 5\n            end\n            if spellId == 54499 then -- Heart of the Crusader\n                crit = crit + 3\n            end\n            \n            if spellId == 57970 then\n                if UnitInParty(sourceUnit) then\n                    local sourceGuid = UnitGUID(sourceUnit)\n                    if GetTime() < (aura_env.mutilators[sourceGuid] or 0) then\n                        crit = crit + 3\n                    end\n                end\n            end\n        end\n        \n        -- Check Players Damage Modifier\n        local _, _,_,_,_,_,varmodapplied = UnitDamage(\"player\")\n        local mod = varmodapplied\n        local maxHP = UnitHealthMax(\"target\")\n        local curHP = UnitHealth(\"target\")\n        local perHP = curHP * 100 / maxHP\n        if perHP <= 35 then mod = mod + 0.12 -- Death's Embrace Talent\n        end\n        \n        aura_env.total[destGUID] = (((100*(mod))*(100-crit)/100)+((100*(mod)*2)*(crit)/100))\n        return true\n    end\n    if subevent == \"SPELL_DAMAGE\" and spellName == aura_env.sb and sourceName == UnitName(\"player\") then\n        aura_env.spellPower[destGUID] = GetSpellBonusDamage(6) -- Spell Power at time of Application\n    end\n    if subevent == \"SPELL_CAST_SUCCESS\" and spellName == (aura_env.haunt or aura_env.ds or aura_env.dl) and sourceName == UnitName(\"player\") then\n        aura_env.spellPower[destGUID] = GetSpellBonusDamage(6)\n    end\nend",
["use_spellId"] = false,
