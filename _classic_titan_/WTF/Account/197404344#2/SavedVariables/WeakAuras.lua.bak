["init"] = {
["custom"] = "-- Loca Data koKR Init\n-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"koKR\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] = \"대용광로\",\n    [\"War Quarter\"] = \"군사 지구\",\n    [\"Valley of Honor\"] =\"명예의 골짜기\",\n    [\"Heroic Training Dummy\"] = \"영웅의 훈련용 허수아비\",\n    [\"Grandmaster's Training Dummy\"] = \"거장의 훈련용 허수아비\",\n    [\"Expert's Training Dummy\"] = \"전문가의 훈련용 허수아비\",\n    [\"Master's Training Dummy\"] = \"숙련자의 훈련용 허수아비\",\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = \"흑요석 성소\",\n    [\"Tenebron\"] = \"테네브론\",\n    [\"Shadron\"] = \"샤드론\",\n    [\"Vesperon\"] = \"베스페론\",\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = \"기사단 회합실\",\n    [\"Baron Rivendare\"] = \"남작 리븐데어\",\n    [\"Thane Korth'azz\"] = \"영주 코스아즈\",\n    [\"Lady Blaumeux\"] = \"여군주 블라미우스\",\n    [\"Sir Zeliek\"] = \"젤리에크 경\",\n    -- Ulduar\n    [\"Formation Grounds\"] = \"전투대형 훈련장\",\n    [\"Flame Leviathan\"] = \"거대 화염전차\",\n    [\"The Colossal Forge\"] = \"거대 제련실\",\n    [\"Ignis the Furnace Master\"] = \"용광로 군주 이그니스\",\n    [\"Razorscale's Aerie\"] = \"칼날비늘의 둥지\",\n    [\"Razorscale\"] = \"칼날비늘\",\n    [\"The Scrapyard\"] = \"고철 야적장\",\n    [\"XT-002 Deconstructor\"] = \"XT-002 해체자\",\n    [\"The Celestial Planetarium\"] = \"별자리 투영관\",\n    [\"Algalon the Observer\"] = \"관찰자 알갈론\",\n    [\"The Observation Ring\"] = \"관찰 지구\",\n    [\"Auriaya\"] = \"아우리아야\",\n    [\"The Halls of Winter\"] = \"겨울의 전당\",\n    [\"Hodir\"] = \"호디르\",\n    [\"The Clash of Thunder\"] = \"천둥의 울림\",\n    [\"Thorim\"] = \"토림\",\n    [\"The Descent into Madness\"] = \"광기의 내리막길\",\n    [\"General Vezax\"] = \"장군 베작스\",\n    [\"The Prison of Yogg-Saron\"] = \"요그사론의 감옥\",\n    [\"Yogg-Saron\"] = \"요그사론\",\n    [\"The Assembly of Iron\"] = \"무쇠 회합실\",\n    [\"Stormcaller Brundir\"] = \"폭풍소환사 브룬디르\",\n    [\"Runemaster Molgeim\"] = \"룬술사 몰가임\",\n    [\"Steelbreaker\"] = \"강철파괴자\",\n    [\"The Shattered Walkway\"] = \"부서진 산책로\",\n    [\"Right Arm\"] = \"오른팔\",\n    [\"Kologarn\"] = \"콜로간\",\n    [\"Left Arm\"] = \"왼팔\",\n    [\"The Conservatory of Life\"] = \"생명의 정원\",\n    [\"Snaplasher\"] = \"악어덩굴손\",\n    [\"Storm Lasher\"] = \"폭풍덩굴손\",\n    [\"Ancient Water Spirit\"] = \"고대 물의 정령\",\n    [\"The Spark of Imagination\"] = \"상상의 작업실\",\n    [\"Aerial Command Unit\"] = \"공중 지휘기\",\n    [\"VX-001\"] = \"VX-001\",\n    [\"Leviathan Mk II\"] = \"거대 전차 Mk II\",\n    [\"Saronite Animus\"] = \"사로나이트 원혼\",\n    [\"Life Spark\"] = \"생명의 불꽃\",\n    [\"XM-024 Pummeller\"] = \"XM-024 난타로봇\",\n    [\"Freya\"] = \"프레이야\",\n    [\"Assault Bot\"] = \"돌격로봇\",\n    [\"Crusher Tentacle\"] = \"분쇄의 촉수\",\n    [\"Corruptor Tentacle\"] = \"부패의 촉수\",\n    [\"Feral Defender\"] = \"수호 야수\",\n    -- TOC\n    [\"Trial of the Crusader\"] = \"십자군의 시험장\",\n    [\"Gormok the Impaler\"] = \"꿰뚫는 자 고르목\",\n    [\"Snobold Vassal\"] = \"스노볼트 부하\",\n    [\"Acidmaw\"] = \"산성아귀\",\n    [\"Dreadscale\"] = \"공포비늘\",\n    [\"Icehowl\"] = \"얼음울음\",\n    [\"Lord Jaraxxus\"] = \"군주 자락서스\",\n    [\"Nether Portal\"] = \"황천의 차원문\",\n    [\"Infernal Volcano\"] = \"지옥불 화산\",\n    [\"Mistress of Pain\"] = \"고통의 여군주\",\n    [\"Shaabad\"] = \"샤바드\",\n    [\"Broln Stouthorn\"] = \"브롤른 스타우트혼\",\n    [\"Anthar Forgemender\"] = \"안타르 포지멘더\",\n    [\"Caiphus the Stern\"] = \"준엄한 카이푸스\",\n    [\"Melador Valestrider\"] = \"멜라도르 베일스트라이더\",\n    [\"Erin Misthoof\"] = \"에린 미스트후프\",    \n    [\"Saamul\"] = \"사아물\",\n    [\"Thrakgar\"] = \"스락가르\",\n    [\"Irieth Shadowstep\"] = \"이리에스 섀도스텝\",\n    [\"Maz'dinah\"] = \"마즈디나\",\n    [\"Shocuul\"] = \"쇼쿨\",\n    [\"Narrhok Steelbreaker\"] = \"나르호크 스틸브레이커\", \n    [\"Alyssia Moonstalker\"] = \"알리시아 문스토커\",\n    [\"Ruj'kah\"] = \"루즈카\",\n    [\"Tyrius Duskblade\"] = \"티리우스 더스크블레이드\",\n    [\"Gorgrim Shadowcleave\"] = \"고르그림 섀도클리브\",\n    [\"Serissa Grimdabbler\"] = \"세리사 그림대블러\",\n    [\"Harkzog\"] = \"하크조그\", \n    [\"Baelnor Lightbearer\"] = \"밸노르 라이트베어러\",\n    [\"Malithas Brightblade\"] = \"말리타스 브라이트블레이드\",\n    [\"Velanaa\"] = \"벨라나\",\n    [\"Liandra Suncaller\"] = \"리안드라 선콜러\",\n    [\"Kavina Grovesong\"] = \"카비나 그로브송\",\n    [\"Birana Stormhoof\"] = \"비라나 스톰후프\", \n    [\"Brienna Nightfell\"] = \"브리에나 나이트펠\",\n    [\"Vivienne Blackwhisper\"] = \"비비안 블랙위스퍼\",\n    [\"Noozle Whizzlestick\"] = \"누즐 위즐스틱\",\n    [\"Ginselle Blightslinger\"] = \"진셀 브라이트슬링어\",\n    [\"Fjola Lightbane\"] = \"피욜라 라이트베인\",\n    [\"Eydis Darkbane\"] = \"아이디스 다크베인\",\n    [\"The Icy Depths\"] = \"얼어붙은 심연\", \n    [\"Anub'arak\"] = \"아눕아락\",\n    [\"Nerubian Burrower\"] = \"네루비안 땅무지\",\n    [\"Onyxia's Lair\"] = \"오닉시아의 둥지\",\n    [\"Onyxia\"] = \"오닉시아\",\n    [\"Onyxian Lair Guard\"] = \"오닉시아의 둥지 수호병\",\n    -- ICC\n    [\"The Spire\"] = \"첨탑\",\n    [\"Lord Marrowgar\"] = \"군주 매로우가르\",\n    [\"Bone Spike\"] = \"뼈 가시\",\n    [\"Oratory of the Damned\"] = \"저주받은 자들의 기도실\",\n    [\"Lady Deathwhisper\"] = \"여교주 데스위스퍼\",\n    [\"Cult Adherent\"] = \"교단 신봉자\",\n    [\"Cult Fanatic\"] = \"교단 광신자\",\n    [\"Rampart of Skulls\"] = \"해골 망루\",\n    [\"Muradin Bronzebeard\"] = \"무라딘 브론즈비어드\",\n    [\"High Overlord Saurfang\"] = \"대군주 사울팽\",\n    [\"Deathbringer's Rise\"] = \"죽음의 인도자 마루\",\n    [\"Deathbringer Saurfang\"] = \"죽음의 인도자 사울팽\",\n    [\"Blood Beast\"] = \"피의 괴물\",\n    [\"The Plagueworks\"] = \"역병작업장\",\n    [\"Festergut\"] = \"구린속\",\n    [\"Rotface\"] = \"썩은얼굴\",\n    [\"Little Ooze\"] = \"작은 수액괴물\",\n    [\"Putricide's Laboratory of Alchemical Horrors and Fun\"] = \"공포와 재미가 넘치는 퓨트리사이드의 연금술 실험실\",\n    [\"Volatile Ooze\"] = \"일촉즉발 수액괴물\",\n    [\"Professor Putricide\"] = \"교수 퓨트리사이드\",\n    [\"Gas Cloud\"] = \"가스 구름\",\n    [\"The Crimson Hall\"] = \"진홍빛 전당\",\n    [\"Prince Taldaram\"] = \"공작 탈다람\",\n    [\"Prince Keleseth\"] = \"공작 켈레세스\",\n    [\"Prince Valanar\"] = \"공작 발라나르\",\n    [\"The Sanctum of Blood\"] = \"피의 성소\",\n    [\"Blood-Queen Lana'thel\"] = \"피의 여왕 라나텔\",\n    [\"The Frostwing Halls\"] = \"서리날개 전당\",\n    [\"Valithria Dreamwalker\"] = \"발리스리아 드림워커\",\n    [\"Gluttonous Abomination\"] = \"걸신들린 누더기골렘\",\n    [\"Risen Archmage\"] = \"되살아난 대마법사\",\n    [\"Suppresser\"] = \"억제자\",\n    [\"Thep Frost Queen's Lair\"] = \"서리 여왕의 둥지\",\n    [\"Sindragosa\"] = \"신드라고사\",\n    [\"The Frozen Throne\"] = \"얼어붙은 왕좌\",\n    [\"The Lich King\"] = \"리치 왕\",\n    [\"Shambling Horror\"] = \"휘청거리는 괴물\",\n    [\"Ice Sphere\"] = \"얼음 구슬\",\n    [\"Raging Spirit\"] = \"분노의 영혼\",\n    [\"Val'kyr Shadowguard\"] = \"발키르 어둠수호병\"\n}\n\nlocal function LocalizeTable(tTableToLocalize)\n    if tTableToLocalize.bLocalized then return tTableToLocalize end\n    \n    local tLocalizedTable = {\n        bLocalized = GetLocale(),\n        \n    }\n    \n    local function LocalizeField(tIn, tOut, sKey)\n        local sLocalizedKey = sKey\n        if tLocData.tLocalizations[sKey] and tLocData.tLocalizations[sKey] then\n            sLocalizedKey = tLocData.tLocalizations[sKey]\n        end\n        \n        if type(tIn[sKey]) == \"table\" then\n            tOut[sLocalizedKey] = {}\n            \n            for k,_ in pairs(tIn[sKey]) do\n                LocalizeField(tIn[sKey], tOut[sLocalizedKey], k)\n            end\n        else\n            if tLocData.tLocalizations[tIn[sKey]] and tLocData.tLocalizations[tIn[sKey]] then\n                tOut[sLocalizedKey] = tLocData.tLocalizations[tIn[sKey]]\n            else\n                tOut[sLocalizedKey] = tIn[sKey]\n            end\n        end\n    end\n    \n    for k,_ in pairs(tTableToLocalize) do\n        LocalizeField(tTableToLocalize, tLocalizedTable, k)\n    end\n    \n    return tLocalizedTable\nend\ntLocData.fnLocalizeTable = LocalizeTable\n\nlocal function InitLoca()\n    if GetLocale() == aura_env.sLocale then\n        WeakAuras.ScanEvents(\"MultiDotFrame_Localize\", tLocData)\n    end\nend\naura_env.fnInitLoca = InitLoca\n\nInitLoca()",
["do_custom"] = true,
