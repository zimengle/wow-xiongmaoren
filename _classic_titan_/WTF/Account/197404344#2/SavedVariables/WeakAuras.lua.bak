["custom_hide"] = "timed",
["subeventPrefix"] = "SPELL",
["event"] = "Conditions",
["use_unit"] = true,
["unit"] = "player",
["custom"] = "function(sEvent, ...)\n    if sEvent == \"STATUS\" then\n        aura_env.fnInitLoca() \n    end \n    return true\nend",
