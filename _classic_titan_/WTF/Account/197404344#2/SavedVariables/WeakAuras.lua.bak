["露露的问答-背景（常用命令）"] = {
["authorOptions"] = {
},
["preferToUpdate"] = true,
["yOffset"] = -220,
["anchorPoint"] = "TOPLEFT",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
["do_custom"] = true,
["custom"] = "local e = aura_env\nlocal Rurutia_FAQ = WeakAuras.GetRegion(\"露露的问答-近期问答\") \nlocal Rurutia_LOG = WeakAuras.GetRegion(\"露露的问答-更新日志\") \nlocal Rurutia_VIDEO = WeakAuras.GetRegion(\"露露的问答-视频教程\") \nlocal Rurutia_LINK = WeakAuras.GetRegion(\"露露的问答-反馈问题\") \nlocal Rurutia_CMD = WeakAuras.GetRegion(\"露露的问答-常用命令\") \nlocal Rurutia_MACRO = WeakAuras.GetRegion(\"露露的问答-宏分享\") \nlocal Rurutia_DMG = WeakAuras.GetRegion(\"露露的问答-伤害数字\") \nRurutia_FAQ:Hide() \nif not _G[e.id..\"Button\"] then \n    local region = WeakAuras.GetRegion(e.id) \n    e.btn = CreateFrame(\"Button\", e.id..\"Button\", region, nil) \n    e.btn:RegisterForClicks(\"AnyUp\",\"AnyDown\")\n    e.btn:SetAttribute(\"type\", \"macro\")\n    e.btn:SetAttribute(\"macrotext\",str)\n    e.btn:SetText(e.id)\n    e.btn:SetAllPoints(region) \nend\nlocal btn = _G[e.id..\"Button\"]\n\nbtn:SetScript(\"OnMouseUp\", function(self)\n        if Rurutia_CMD:IsShown() then\n            Rurutia_FAQ:Hide()\n            Rurutia_LOG:Hide()\n            Rurutia_VIDEO:Hide()\n            Rurutia_LINK:Hide()\n            Rurutia_MACRO:Hide()\n            Rurutia_DMG:Hide()\n        else\n            Rurutia_CMD:Show()\n            Rurutia_FAQ:Hide()\n            Rurutia_LOG:Hide()\n            Rurutia_VIDEO:Hide()\n            Rurutia_LINK:Hide()\n            Rurutia_MACRO:Hide()\n            Rurutia_DMG:Hide()\n        end\nend)\n\nlocal function onEnter(self)\n    GameTooltip:SetOwner(self, \"ANCHOR_NONE\");\n    GameTooltip:SetPoint(\"LEFT\", self, \"RIGHT\");\n    GameTooltip:ClearLines();\nend\nlocal function onLeave(self)\n    GameTooltip:Hide();\nend\nbtn:SetScript(\"OnEnter\",onEnter)\nbtn:SetScript(\"OnLeave\",onLeave)",
},
["finish"] = {
},
["init"] = {
},
},
["triggers"] = {
