["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "-- Loca Data zhCN Init\n-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"zhCN\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] = nil,\n    [\"War Quarter\"] = \"军事区\",\n    [\"Valley of Honor\"] = nil,\n    [\"Heroic Training Dummy\"] = \"英雄训练假人\",\n    [\"Grandmaster's Training Dummy\"] = \"宗师的训练假人\",\n    [\"Expert's Training Dummy\"] = \"专家的训练假人\",\n    [\"Master's Training Dummy\"] = \"大师的训练假人\",\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = nil,\n    [\"Tenebron\"] = nil,\n    [\"Shadron\"] = nil,\n    [\"Vesperon\"] = nil,\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = nil,\n    [\"Baron Rivendare\"] = nil,\n    [\"Thane Korth'azz\"] = nil,\n    [\"Lady Blaumeux\"] = nil,\n    -- Ulduar\n    [\"Formation Grounds\"] = \"练兵场\",\n    [\"Flame Leviathan\"] = \"烈焰巨兽\",\n    [\"The Colossal Forge\"] = \"巨人熔炉\",\n    [\"Ignis the Furnace Master\"] = \"掌炉者伊格尼斯\",\n    [\"Razorscale's Aerie\"] = \"锋鳞之巢\",\n    [\"Razorscale\"] = \"锋鳞\",\n    [\"The Scrapyard\"] = \"废料场\",\n    [\"XT-002 Deconstructor\"] = \"XT-002拆解者\",\n    [\"The Celestial Planetarium\"] = \"天文台\",\n    [\"Algalon the Observer\"] = \"观察者奥尔加隆\",\n    [\"The Observation Ring\"] = \"观测场\",\n    [\"Auriaya\"] = \"欧尔莉亚\",\n    [\"The Halls of Winter\"] = \"寒冬大厅\",\n    [\"Hodir\"] = \"霍迪尔\",\n    [\"The Clash of Thunder\"] = \"雷霆角斗场\",\n    [\"Thorim\"] = \"托里姆\",\n    [\"The Descent into Madness\"] = \"疯狂阶梯\",\n    [\"General Vezax\"] = \"维扎克斯将军\",\n    [\"The Prison of Yogg-Saron\"] = \"尤格-萨隆的监狱\",\n    [\"Yogg-Saron\"] = \"尤格-萨隆\",\n    [\"The Assembly of Iron\"] = \"钢铁议会\",\n    [\"Stormcaller Brundir\"] = \"唤雷者布隆迪尔\",\n    [\"Runemaster Molgeim\"] = \"符文大师莫尔基姆\",\n    [\"Steelbreaker\"] = \"断钢者\",\n    [\"The Shattered Walkway\"] = \"破碎通道\",\n    [\"Right Arm\"] = \"右臂\",\n    [\"Kologarn\"] = \"科隆加恩\",\n    [\"Left Arm\"] = \"左臂\",\n    [\"The Conservatory of Life\"] = \"生命温室\",\n    [\"Snaplasher\"] = \"迅疾鞭笞者\",\n    [\"Storm Lasher\"] = \"风暴鞭笞者\",\n    [\"Ancient Water Spirit\"] = \"古代水之精魂\",\n    [\"The Spark of Imagination\"] = \"思想火花\",\n    [\"Aerial Command Unit\"] = \"空中指挥单位\",\n    [\"VX-001\"] = nil,\n    [\"Leviathan Mk II\"] = \"巨兽二型\",\n    [\"Saronite Animus\"] = \"萨隆邪铁畸体\",\n    [\"Life Spark\"] = \"生命火花\",\n    [\"XM-024 Pummeller\"] = \"XM-024击打者\",\n    [\"Freya\"] = \"弗雷亚\",\n    [\"Assault Bot\"] = \"突击机器人\",\n    [\"Crusher Tentacle\"] = \"重压触须\",\n    [\"Corruptor Tentacle\"] = \"腐蚀触须\",\n    [\"Feral Defender\"] = \"野性防御者\",\n    -- TOC\n    [\"Trial of the Crusader\"] = \"十字军的试炼\",\n    [\"Gormok the Impaler\"] = \"穿刺者戈莫克\",\n    [\"Snobold Vassal\"] = \"狗头人奴隶\",\n    [\"Acidmaw\"] = \"酸喉\",\n    [\"Dreadscale\"] = \"恐鳞\",\n    [\"Icehowl\"] = \"冰吼\",\n    [\"Lord Jaraxxus\"] = \"加拉克苏斯大王\",\n    [\"Nether Portal\"] = \"虚空传送门\",\n    [\"Infernal Volcano\"] = \"地狱火山\",\n    [\"Mistress of Pain\"] = \"痛苦女王\",\n    [\"Shaabad\"] = \"沙拜德\",\n    [\"Broln Stouthorn\"] = \"布罗恩·粗角\",\n    [\"Anthar Forgemender\"] = \"安塔尔·缮炉者\",\n    [\"Caiphus the Stern\"] = \"严肃的凯普斯\",\n    [\"Melador Valestrider\"] = \"麦拉多·深谷游者\",\n    [\"Erin Misthoof\"] = \"伊林·雾蹄\",    \n    [\"Saamul\"] = \"萨缪尔\",\n    [\"Thrakgar\"] = \"萨卡加尔\",\n    [\"Irieth Shadowstep\"] = \"伊锐丝·影踪\",\n    [\"Maz'dinah\"] = \"玛兹迪娜\",\n    [\"Shocuul\"] = \"索库尔\",\n    [\"Narrhok Steelbreaker\"] = \"断钢者纳霍克\", \n    [\"Alyssia Moonstalker\"] = \"阿莱希娅·月行者\",\n    [\"Ruj'kah\"] = \"鲁姬卡\",\n    [\"Tyrius Duskblade\"] = \"泰利乌斯·达斯布雷德\",\n    [\"Gorgrim Shadowcleave\"] = \"戈瑞姆·影斩\",\n    [\"Serissa Grimdabbler\"] = \"塞瑞莎·术轮\",\n    [\"Harkzog\"] = \"德拉克道格\", \n    [\"Baelnor Lightbearer\"] = \"圣光使者巴尔诺\",\n    [\"Malithas Brightblade\"] = \"玛里萨斯·辉刃\",\n    [\"Velanaa\"] = \"维兰纳\",\n    [\"Liandra Suncaller\"] = \"莉安德拉·唤日者\",\n    [\"Kavina Grovesong\"] = \"卡雯娜·林歌\",\n    [\"Birana Stormhoof\"] = \"比莱纳·雷蹄\", \n    [\"Brienna Nightfell\"] = \"布瑞娜·沉夜\",\n    [\"Vivienne Blackwhisper\"] = \"暗语者维维尼\",\n    [\"Noozle Whizzlestick\"] = \"努兹尔·啸钉\",\n    [\"Ginselle Blightslinger\"] = \"凋零者吉塞尔\",\n    [\"Fjola Lightbane\"] = \"光明邪使菲奥拉\",\n    [\"Eydis Darkbane\"] = \"黑暗邪使艾蒂丝\",\n    [\"The Icy Depths\"] = \"寒冰深渊\",\n    [\"Anub'arak\"] = \"阿努巴拉克\",\n    [\"Nerubian Burrower\"] = \"蛛魔掘地者\",\n    [\"Onyxia's Lair\"] = \"奥妮克希亚的巢穴\",\n    [\"Onyxia\"] = \"奥妮克希亚\",\n    [\"Onyxian Lair Guard\"] = \"奥妮克希亚巢穴守卫\",\n    -- ICC\n    [\"The Spire\"] = \"冰冠之塔\",\n    [\"Lord Marrowgar\"] = \"玛洛加尔领主\",\n    [\"Bone Spike\"] = \"骨针\",\n    [\"Oratory of the Damned\"] = \"诅咒祷堂\",\n    [\"Lady Deathwhisper\"] = \"亡语者女士\",\n    [\"Cult Adherent\"] = \"教派追随者\",\n    [\"Cult Fanatic\"] = \"教派狂热者\",\n    [\"Rampart of Skulls\"] = \"颅骨之墙\",\n    [\"Muradin Bronzebeard\"] = \"穆拉丁·铜须\",\n    [\"High Overlord Saurfang\"] = \"萨鲁法尔大王\",\n    [\"Deathbringer's Rise\"] = \"死亡使者的高台\",\n    [\"Deathbringer Saurfang\"] = \"死亡使者萨鲁法尔\",\n    [\"Blood Beast\"] = \"血兽\",\n    [\"The Plagueworks\"] = \"天灾工厂\",\n    [\"Festergut\"] = \"烂肠\",\n    [\"Rotface\"] = \"腐面\",\n    [\"Little Ooze\"] = \"小软泥怪\",\n    [\"Putricide's Laboratory of Alchemical Horrors and Fun\"] = \"普崔赛德的恐怖和娱乐化学实验室\",\n    [\"Volatile Ooze\"] = \"不稳定的软泥怪\",\n    [\"Professor Putricide\"] = \"普崔塞德教授\",\n    [\"Gas Cloud\"] = \"毒气之云\",\n    [\"The Crimson Hall\"] = \"血色厅堂\",\n    [\"Prince Taldaram\"] = \"塔达拉姆王子\",\n    [\"Prince Keleseth\"] = \"凯雷塞斯王子\",\n    [\"Prince Valanar\"] = \"瓦拉纳王子\",\n    [\"The Sanctum of Blood\"] = \"鲜血秘室\",\n    [\"Blood-Queen Lana'thel\"] = \"鲜血女王兰娜瑟尔\",\n    [\"The Frostwing Halls\"] = \"霜翼大厅\",\n    [\"Valithria Dreamwalker\"] = \"踏梦者瓦莉瑟瑞娅\",\n    [\"Gluttonous Abomination\"] = \"贪食的憎恶\",\n    [\"Risen Archmage\"] = \"复生的大法师\",\n    [\"Suppresser\"] = nil,\n    [\"The Frost Queen's Lair\"] = \"冰霜女王的巢穴\",\n    [\"Sindragosa\"] = \"辛达苟萨\",\n    [\"The Frozen Throne\"] = \"冰封王座\",\n    [\"The Lich King\"] = \"巫妖王\",\n    [\"Shambling Horror\"] = \"蹒跚的血僵尸\",\n    [\"Ice Sphere\"] = \"寒冰之球\",\n    [\"Raging Spirit\"] = nil,\n    [\"Val'kyr Shadowguard\"] = nil,\n}\n\n\n\nlocal function LocalizeTable(tTableToLocalize)\n    if tTableToLocalize.bLocalized then return tTableToLocalize end\n    \n    local tLocalizedTable = {\n        bLocalized = GetLocale(),\n        \n    }\n    \n    local function LocalizeField(tIn, tOut, sKey)\n        local sLocalizedKey = sKey\n        if tLocData.tLocalizations[sKey] and tLocData.tLocalizations[sKey] then\n            sLocalizedKey = tLocData.tLocalizations[sKey]\n        end\n        \n        if type(tIn[sKey]) == \"table\" then\n            tOut[sLocalizedKey] = {}\n            \n            for k,_ in pairs(tIn[sKey]) do\n                LocalizeField(tIn[sKey], tOut[sLocalizedKey], k)\n            end\n        else\n            if tLocData.tLocalizations[tIn[sKey]] and tLocData.tLocalizations[tIn[sKey]] then\n                tOut[sLocalizedKey] = tLocData.tLocalizations[tIn[sKey]]\n            else\n                tOut[sLocalizedKey] = tIn[sKey]\n            end\n        end\n    end\n    \n    for k,_ in pairs(tTableToLocalize) do\n        LocalizeField(tTableToLocalize, tLocalizedTable, k)\n    end\n    \n    return tLocalizedTable\nend\ntLocData.fnLocalizeTable = LocalizeTable\n\nlocal function InitLoca()\n    if GetLocale() == aura_env.sLocale then\n        WeakAuras.ScanEvents(\"MultiDotFrame_Localize\", tLocData)\n    end\nend\naura_env.fnInitLoca = InitLoca\n\nInitLoca()",
["do_custom"] = true,
},
["finish"] = {
