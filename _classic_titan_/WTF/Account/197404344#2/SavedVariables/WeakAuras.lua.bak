["【通用】自动职责切换 v1.4（by 爱萝莉）"] = {
["outline"] = "OUTLINE",
["color"] = {
1,
1,
1,
1,
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "function()\n    return aura_env.currentRole or \"检测中...\"\nend",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(event, ...)\n    if InCombatLockdown() then return end\n    \n    local _, classTag = UnitClass(\"player\")\n    local t1 = select(5, GetTalentTabInfo(1)) or 0\n    local t2 = select(5, GetTalentTabInfo(2)) or 0\n    local t3 = select(5, GetTalentTabInfo(3)) or 0\n    \n    local TANK, HEALER, MELEE, RANGE = \"TANK\", \"HEALER\", \"MELEE\", \"RANGE\"\n    local role = MELEE\n    \n    if classTag == \"DRUID\" then\n        if t3 > t1 and t3 > t2 then \n            role = HEALER\n        elseif t1 > t2 and t1 > t3 then \n            role = RANGE\n        else\n            -- 野性系判定：厚皮(1) 或 自然反射(29)\n            local thickHide = select(5, GetTalentInfo(2, 1)) or 0\n            local naturalReaction = select(5, GetTalentInfo(2, 29)) or 0\n            if thickHide > 0 or naturalReaction > 0 then\n                role = TANK\n            else\n                role = MELEE\n            end\n        end\n        \n    elseif classTag == \"DEATHKNIGHT\" then\n        local vampiricBlood = select(5, GetTalentInfo(1, 23)) or 0\n        role = vampiricBlood > 0 and TANK or MELEE\n        \n    elseif classTag == \"WARRIOR\" then\n        role = t3 > 30 and TANK or MELEE\n        \n    elseif classTag == \"PALADIN\" then\n        if t1 > t2 and t1 > t3 then role = HEALER\n        elseif t2 > t1 and t2 > t3 then role = TANK\n        else role = MELEE end\n        \n    elseif classTag == \"SHAMAN\" then\n        if t3 > 20 then role = HEALER\n        elseif t1 > t2 then role = RANGE\n        else role = MELEE end\n        \n    elseif classTag == \"PRIEST\" then\n        role = t3 > 20 and RANGE or HEALER\n        \n    elseif classTag == \"HUNTER\" or classTag == \"MAGE\" or classTag == \"WARLOCK\" then\n        role = RANGE\n        \n    elseif classTag == \"ROGUE\" then\n        role = MELEE\n    end\n    \n    aura_env.role = role\n    \n    local sysRole = role\n    if role == MELEE or role == RANGE then\n        sysRole = \"DAMAGER\"\n    end\n    \n    if UnitGroupRolesAssigned(\"player\") ~= sysRole then\n        UnitSetRole(\"player\", sysRole)\n    end\n    \n    return false\nend",
["spellIds"] = {
},
