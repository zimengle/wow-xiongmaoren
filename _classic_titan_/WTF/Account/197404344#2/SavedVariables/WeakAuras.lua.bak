},
["init"] = {
["custom"] = "-- Loca Data ruRU Init\n-- This WA is only used to localize some of the strings used in other WAs\naura_env.sLocale = \"ruRU\"\n\nlocal tLocData = {}\naura_env.tLocData = tLocData\ntLocData.tLocalizations = {\n    -- Testing\n    [\"The Great Forge\"] =  \"Великая Кузня\",\n    [\"War Quarter\"] = \"Квартал Воинов\",\n    [\"Valley of Honor\"] = nil,\n    [\"Heroic Training Dummy\"] = \"Героический тренировочный манекен\",\n    [\"Grandmaster's Training Dummy\"] = \"Тренировочный манекен великого мастера\",\n    [\"Expert's Training Dummy\"] = \"Тренировочный манекен для опытных бойцов\",\n    [\"Master's Training Dummy\"] = \"Тренировочный манекен для мастеров\",\n    -- Sartharion\n    [\"The Obsidian Sanctum\"] = \"Обсидиановое святилище\",\n    [\"Tenebron\"] = \"Тенеброн\",\n    [\"Shadron\"] = \"Шадрон\",\n    [\"Vesperon\"] = \"Весперон\",\n    -- Naxx\n    [\"The Horsemen's Assembly\"] = nil,\n    [\"Baron Rivendare\"] = \"Барон Ривендер\",\n    [\"Thane Korth'azz\"] = \"Тан Корт'азз\",\n    [\"Lady Blaumeux\"] = \"Леди Бломе\",\n    -- Ulduar\n    [\"Formation Grounds\"] = \"Плац\",\n    [\"Flame Leviathan\"] = \"Огненный Левиафан\",\n    [\"The Colossal Forge\"] = \"Гигантская кузня\",\n    [\"Ignis the Furnace Master\"] = \"Повелитель Горнов Игнис\",\n    [\"Razorscale's Aerie\"] = \"Гнездо Острокрылой\",\n    [\"Razorscale\"] = \"Острокрылая\",\n    [\"The Scrapyard\"] = \"Мусорная свалка\",\n    [\"XT-002 Deconstructor\"] = \"Разрушитель XT-002\",\n    [\"The Celestial Planetarium\"] = \"Священный планетарий\",\n    [\"Algalon the Observer\"] = \"Алгалон Наблюдатель\",\n    [\"The Observation Ring\"] = \"Круг Наблюдения\",\n    [\"Auriaya\"] = \"Ауриайя\",\n    [\"The Halls of Winter\"] = \"Залы Зимы\",\n    [\"Hodir\"] = \"Ходир\",\n    [\"The Clash of Thunder\"] = \"Раскаты Грома\",\n    [\"Thorim\"] = \"Торим\",\n    [\"The Descent into Madness\"] = \"Провал Безумия\",\n    [\"General Vezax\"] = \"Генерал Везакс\",\n    [\"The Prison of Yogg-Saron\"] = \"Темница Йогг-Сарона\",\n    [\"Yogg-Saron\"] = \"Йогг-Сарон\",\n    [\"The Assembly of Iron\"] = \"Железное Собрание\",\n    [\"Stormcaller Brundir\"] = \"Буревестник Брундир\",\n    [\"Runemaster Molgeim\"] = \"Мастер рун Молгейм\",\n    [\"Steelbreaker\"] = \"Сталелом\",\n    [\"The Shattered Walkway\"] = \"Обвалившаяся галерея\",\n    [\"Right Arm\"] = \"Правая рука\",\n    [\"Kologarn\"] = \"Кологарн\",\n    [\"Left Arm\"] = \"Левая рука\",\n    [\"The Conservatory of Life\"] = \"Оранжерея Жизни\",\n    [\"Snaplasher\"] = \"Хватоплет\",\n    [\"Storm Lasher\"] = \"Грозовой плеточник\",\n    [\"Ancient Water Spirit\"] = \"Древний дух воды\",\n    [\"The Spark of Imagination\"] = \"Искра Воображения\",\n    [\"Aerial Command Unit\"] = \"Воздушное судно\",\n    [\"VX-001\"] = nil,\n    [\"Leviathan Mk II\"] = \"Левиафан II\",\n    [\"Saronite Animus\"] = \"Саронитовый враг\",\n    [\"Life Spark\"] = \"Искра жизни\",\n    [\"XM-024 Pummeller\"] = \"Утрамбовщик XM-024\",\n    [\"Freya\"] = \"Фрейя\",\n    [\"Assault Bot\"] = \"Штурмовой робот\",\n    [\"Crusher Tentacle\"] = \"Тяжелое щупальце\",\n    [\"Corruptor Tentacle\"] = \"Разлагающее щупальце\",\n    [\"Feral Defender\"] = \"Дикий защитник\",\n    -- TOC\n    [\"Trial of the Crusader\"] = \"Испытание крестоносца\",\n    [\"Gormok the Impaler\"] = \"Гормок Пронзающий Бивень\",\n    [\"Snobold Vassal\"] = \"Снобольд-вассал\",\n    [\"Acidmaw\"] = \"Кислотная Утроба\",\n    [\"Dreadscale\"] = \"Жуткая Чешуя\",\n    [\"Icehowl\"] = \"Ледяной Рев\",\n    [\"Lord Jaraxxus\"] = \"Лорд Джараксус\",\n    [\"Nether Portal\"] = \"Врата Пустоты\",\n    [\"Infernal Volcano\"] = \"Вулкан инферналов\",\n    [\"Mistress of Pain\"] = \"Госпожа Боли\",\n    [\"Shaabad\"] = \"Шаабад\",\n    [\"Broln Stouthorn\"] = nil,\n    [\"Anthar Forgemender\"] = \"Антар Очистительный Горн\",\n    [\"Caiphus the Stern\"] = nil,\n    [\"Melador Valestrider\"] = \"Меладор Дальний Гонец\", \n    [\"Erin Misthoof\"] = nil,    \n    [\"Saamul\"] = \"Саамул\",\n    [\"Thrakgar\"] = nil,\n    [\"Irieth Shadowstep\"] = \"Ириэт Шаг Сквозь Тень\",\n    [\"Maz'dinah\"] = nil,\n    [\"Shocuul\"] = \"Шокул\",\n    [\"Narrhok Steelbreaker\"] = nil, \n    [\"Alyssia Moonstalker\"] = \"Алисса Лунопард\",\n    [\"Ruj'kah\"] = nil,\n    [\"Tyrius Duskblade\"] = \"Тирий Клинок Сумерек\",\n    [\"Gorgrim Shadowcleave\"] = nil,\n    [\"Serissa Grimdabbler\"] = \"Серисса Мрачная Кропильщица\",\n    [\"Harkzog\"] = nil, \n    [\"Baelnor Lightbearer\"] = \"Бельнор Светоносный\",\n    [\"Malithas Brightblade\"] = nil,\n    [\"Velanaa\"] = \"Веланаа\",\n    [\"Liandra Suncaller\"] = nil,\n    [\"Kavina Grovesong\"] = \"Кавина Песня Рощи\",\n    [\"Birana Stormhoof\"] = nil, \n    [\"Brienna Nightfell\"] = \"Бриенна Приход Ночи\",\n    [\"Vivienne Blackwhisper\"] = nil,\n    [\"Noozle Whizzlestick\"] = \"Нуззл Чудодей\",\n    [\"Ginselle Blightslinger\"] = nil,\n    [\"Fjola Lightbane\"] = \"Фьола Погибель Света\",\n    [\"Eydis Darkbane\"] = \"Эйдис Погибель Тьмы\",\n    [\"The Icy Depths\"] = \"Ледяные глубины\",\n    [\"Anub'arak\"] = \"Ануб'арак\",\n    [\"Nerubian Burrower\"] = \"Нерубский землеглот\",\n    [\"Onyxia's Lair\"] = \"Логово Ониксии\",\n    [\"Onyxia\"] = \"Ониксия\",\n    [\"Onyxian Lair Guard\"] = \"Страж логова Ониксии\",\n    -- ICC\n    [\"The Spire\"] = \"Шпиль\",\n    [\"Lord Marrowgar\"] = \"Лорд Ребрад\",\n    [\"Bone Spike\"] = \"Костяной шип\",\n    [\"Oratory of the Damned\"] = \"Молельня Проклятых\",\n    [\"Lady Deathwhisper\"] = \"Леди Смертный Шепот\",\n    [\"Cult Adherent\"] = \"Приверженец культа\",\n    [\"Cult Fanatic\"] = \"Фанатик культа\",\n    [\"Rampart of Skulls\"] = \"Черепной вал\",\n    [\"Muradin Bronzebeard\"] = \"Мурадин Бронзобород\",\n    [\"High Overlord Saurfang\"] = \"Варок Саурфанг\",\n    [\"Deathbringer's Rise\"] = \"Подъем Смертоносного\",\n    [\"Deathbringer Saurfang\"] = \"Саурфанг Смертоносный\",\n    [\"Blood Beast\"] = \"Кровавое чудовище\",\n    [\"The Plagueworks\"] = \"Чумодельня\",\n    [\"Festergut\"] = \"Тухлопуз\",\n    [\"Rotface\"] = \"Гниломорд\",\n    [\"Little Ooze\"] = \"Малый слизнюк\",\n    [\"Putricide's Laboratory of Alchemical Horrors and Fun\"] = \"Лаборатория алхимических ужасов и забав\",\n    [\"Volatile Ooze\"] = \"Неустойчивый слизнюк\",\n    [\"Professor Putricide\"] = \"Профессор Мерзоцид\",\n    [\"Gas Cloud\"] = \"Облако газа\",\n    [\"The Crimson Hall\"] = \"Багровый зал\",\n    [\"Prince Taldaram\"] = \"Принц Талдарам\",\n    [\"Prince Keleseth\"] = \"Принц Келесет\",\n    [\"Prince Valanar\"] = \"Принц Валанар\",\n    [\"The Sanctum of Blood\"] = \"Святилище Крови\",\n    [\"Blood-Queen Lana'thel\"] = \"Кровавая королева Лана'тель\",\n    [\"The Frostwing Halls\"] = \"Залы Ледокрылых\",\n    [\"Valithria Dreamwalker\"] = \"Валитрия Сноходица\",\n    [\"Gluttonous Abomination\"] = \"Прожорливое поганище\",\n    [\"Risen Archmage\"] = \"Воскрешенный верховный маг\",\n    [\"Suppresser\"] = \"Подавитель\",\n    [\"The Frost Queen's Lair\"] = \"Логово Королевы Льда\",\n    [\"Sindragosa\"] = \"Синдрагоса\",\n    [\"The Frozen Throne\"] = \"Ледяной трон\",\n    [\"The Lich King\"] = \"Король-лич\",\n    [\"Shambling Horror\"] = \"Шаркающий ужас\",\n    [\"Ice Sphere\"] = \"Ледяная сфера\",\n    [\"Raging Spirit\"] = \"Гневный дух\",\n    [\"Val'kyr Shadowguard\"] = \"Валь'кира - страж Тьмы\",\n}\n\n\nlocal function LocalizeTable(tTableToLocalize)\n    if tTableToLocalize.bLocalized then return tTableToLocalize end\n    \n    local tLocalizedTable = {\n        bLocalized = GetLocale(),\n        \n    }\n    \n    local function LocalizeField(tIn, tOut, sKey)\n        local sLocalizedKey = sKey\n        if tLocData.tLocalizations[sKey] and tLocData.tLocalizations[sKey] then\n            sLocalizedKey = tLocData.tLocalizations[sKey]\n        end\n        \n        if type(tIn[sKey]) == \"table\" then\n            tOut[sLocalizedKey] = {}\n            \n            for k,_ in pairs(tIn[sKey]) do\n                LocalizeField(tIn[sKey], tOut[sLocalizedKey], k)\n            end\n        else\n            if tLocData.tLocalizations[tIn[sKey]] and tLocData.tLocalizations[tIn[sKey]] then\n                tOut[sLocalizedKey] = tLocData.tLocalizations[tIn[sKey]]\n            else\n                tOut[sLocalizedKey] = tIn[sKey]\n            end\n        end\n    end\n    \n    for k,_ in pairs(tTableToLocalize) do\n        LocalizeField(tTableToLocalize, tLocalizedTable, k)\n    end\n    \n    return tLocalizedTable\nend\ntLocData.fnLocalizeTable = LocalizeTable\n\nlocal function InitLoca()\n    if GetLocale() == aura_env.sLocale then\n        WeakAuras.ScanEvents(\"MultiDotFrame_Localize\", tLocData)\n    end\nend\naura_env.fnInitLoca = InitLoca\n\nInitLoca()",
