["队伍查找器（露露修复）"] = {
["user_y"] = 0,
["compress"] = false,
["user_x"] = 0,
["parent"] = "【按钮】微型菜单整合（T10更新：露露緹婭@Bilibili）",
["preferToUpdate"] = true,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["desaturateBackground"] = false,
["color"] = {
0.98039215686275,
