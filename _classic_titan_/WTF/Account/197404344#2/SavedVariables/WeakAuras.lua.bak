["sparkMirror"] = true,
["desc"] = "2022/9/29 更新苦修分段。\n自制自用WA，by 露露緹婭@Bilibili，斗鱼9593311，转载请保留出处，请勿二次上传wago。\n露露自制，是会根据不同职业甚至专精切换不同渐变色的施法条WA，依赖于自改材质包SharedMedia_Rurutia和LibSharedMedia-3.0库文件，内有几十种富有设计感的自制渐变材质，不断更新中。\n备注：图示中可使用以下模型\n怀旧服TBC：166523、165571、165574\n正式服暗影国度：1006606",
["customText"] = "function()\n    if WeakAuras.IsOptionsOpen() then\n        return \"|cffff0000玩家姓名\"\n    end\n    \n    local Name = aura_env.state.destName\n    if Name then\n        if WA_ClassColorName(Name) ~= \"\" then\n            Name = WA_ClassColorName(Name)\n        end\n        return Name\n    end\nend",
