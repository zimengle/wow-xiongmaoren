["check"] = {
["value"] = "function()\n    local _, playerClass = UnitClass(\"player\")\n    return (playerClass == \"MAGE\" or playerClass == \"PRIEST\" or playerClass == \"HUNTER\" or playerClass == \"SHAMAN\")\n    or UnitIsGroupLeader(\"player\")\n    or UnitIsGroupAssistant(\"player\")\nend",
["variable"] = "customcheck",
["trigger"] = -1,
},
["changes"] = {
{
["value"] = {
["custom"] = "local currentTime = GetTime()\nlocal aura_env = aura_env\naura_env.lastSoundTime = aura_env.lastSoundTime or 0\n\nif currentTime - aura_env.lastSoundTime >= 6 then\n    PlaySoundFile(\"Interface\\\\AddOns\\\\Rurutia_Raids\\\\【露露】进攻驱散.ogg\", \"Master\")\n    aura_env.lastSoundTime = currentTime\nend",
},
