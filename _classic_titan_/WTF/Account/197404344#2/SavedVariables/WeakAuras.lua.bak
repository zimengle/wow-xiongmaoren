["yOffset"] = -38,
["regionType"] = "text",
["displayText_format_c3_format"] = "none",
["color"] = {
1,
0.75294125080109,
0.75294125080109,
1,
},
["xOffset"] = -330,
["url"] = "https://space.bilibili.com/455259",
["displayText_format_p_time_precision"] = 1,
["justify"] = "LEFT",
["selfPoint"] = "LEFT",
["displayText"] = "四维面板：\n未中: %c1%%\n闪避: %c2%%\n招架: %c3%%\n格挡: %c4%%\n圆桌: %c5%\n攻强: %3.attackpower\n",
["semver"] = "2.5.2",
["tocversion"] = 30404,
["id"] = "四维面板-主代码",
["customText"] = "-- 版权声明 / Copyright Notice\n-- 本代码由 [ahhz@NGA 以及 A打头的那个@NGA] 编写 / This code is authored by [ahhz@NGA 以及 A打头的那个@NGA].\n-- 本代码部分功能由“青酒醉红颜@NGA提供。”\n-- 转载或二次修改时，需要保留作者信息 / When redistributing or modifying, please retain the author's information.\nfunction ()\n    local function round(num, idp)\n        local mult = 10 ^ (idp or 0);\n        return math.floor(num * mult + 0.5) / mult;\n    end\n    \n    ----------------------------------------------------------------\n    -- 【1】基础属性获取区\n    ----------------------------------------------------------------\n    local lowDmg, hiDmg, offlowDmg, offhiDmg, posBuff, negBuff, percentmod = UnitDamage(\"player\")\n    local wpspeed=UnitAttackSpeed('PLAYER')\n    local def = GetDodgeBlockParryChanceFromDefense()\n    local miss = def + 5--未命中\n    local dodge = GetDodgeChance()--闪躲\n    local parry = GetParryChance()--招架\n    local block = GetBlockChance()--格挡\n    local bv = GetShieldBlock()--格挡值\n    local avoidance =miss +dodge +parry\n    local baseDefense, armorDefense = UnitDefense(\"player\");\n    local pdef = (baseDefense + armorDefense)--总防等\n    local defneed = 0--所需防等\n    local total = (miss +GetDodgeChance() +GetParryChance() +GetBlockChance() )--1024\n    local resil = GetCombatRatingBonus(15)--韧性免爆百分比\n    local ct = round((total - 102.4), 2)--所需1024剩余差额\n    local ctcolor = \"|cffff0000\"..ct..\"%|r\"\n    local holy = GetSpellBonusDamage(2)--法伤\n    local baseArmor , effectiveArmor, armor, posBuff, negBuff = UnitArmor(\"player\")--获取护甲\n    local St = UnitStat(\"player\", 3)--耐力\n    local Agi = UnitStat(\"player\", 2)--敏捷\n    local Str = UnitStat(\"player\", 1)--力量\n    local maxh=UnitHealthMax(\"PLAYER\")--最大生命\n    local hitrating = GetCombatRatingBonus(6)--命中\n    \n    ----------------------------------------------------------------\n    -- 【2】特殊Buff检测（鼓舞、战鼓等+1%命中）\n    ----------------------------------------------------------------\n    local buffCheck = false\n    for i = 1, 40 do\n        local name, _, _, _, _, _, _, _, _, spellID = UnitBuff(\"player\", i)\n        if spellID == 28878 or spellID == 6562 then\n            buffCheck = true\n            break\n        end\n    end\n    \n    ----------------------------------------------------------------\n    -- 【3】iTank生存评分计算（最新2024版公式）\n    ----------------------------------------------------------------\n    local ITankPercent=0\n    ITankPercent = ( Str*3.5 + Agi*10 + St*16 + effectiveArmor*0.15 + avoidance*250 + block*120 + hitrating*8 + pdef*28 + bv*5.5 + maxh*2.5 ) / 20\n    \n    ----------------------------------------------------------------\n    -- 【4】精准、职业ID、免暴计算\n    ----------------------------------------------------------------\n    local expt, offhandExpertise = GetExpertise();--精准\n    local classFilename, classId = UnitClassBase('Player')\n    local resilneed = 0.0 --韧性所需\n    local Cr=0--熊天赋免爆\n    \n    if classId~=11 then\n        Cr=(5+0.04*15-(pdef-400)*0.04)/100\n    end\n    if Cr>0 then\n        defneed=Cr/0.04,2---获得实际暴击所需防等\n        resilneed=round(Cr*39.4,0)---获得实际暴击所需R性\n    end\n    \n    ----------------------------------------------------------------\n    -- 【5】护甲减伤计算（80级转83级常数）\n    ----------------------------------------------------------------\n    local dr= 0\n    local ba,ar=UnitArmor(\"player\")\n    local level = UnitLevel(\"Player\")\n    if level==80 then level=83 end\n    dr= ar/(ar+467.5 *level - 22167.5)\n    if dr>0.75 then dr=0.75 end\n    \n    ----------------------------------------------------------------\n    -- 【6】有效生命与期望伤害计算（核心生存模型）\n    ----------------------------------------------------------------\n    local hopeh=0--有效生命\n    local crush=0--被碾压概率\n    local Natt=0--普攻概率\n    local dredDmg=0--固定减伤后值\n    local totalDmg=0--最终期望伤害\n    local finblock=block/100--圆桌格挡\n    local tmpCr=1.024-total/100\n    local classdr=0 --职业减免\n    if classId==1 then classdr=0.1 end--ZS\n    if classId==2 then classdr=0.116 end--FQ\n    if classId==6 then classdr=0.126 end--DK\n    if classId==11 then classdr=0.12 end--熊\n    \n    if tmpCr<Cr then Cr=tmpCr end\n    Natt=1.024-Cr-crush-total/100\n    if Natt<0 then Natt=0 end\n    if (avoidance+block)>102.4 then finblock=(102.4-avoidance)/100 end\n    dredDmg=43000*(1-dr)*(1-classdr)\n    totalDmg= dredDmg*(2*Cr+Natt)+(dredDmg-bv)*finblock\n    \n    if Cr<=0 then Cr = 0 end\n    \n    local base, posBuff, negBuff = UnitAttackPower(\"player\")\n    local AP = base + posBuff + negBuff;\n    local crit=GetCritChance()\n    if classId==11 then\n        dredDmg=dredDmg-crit/100*AP*0.25\n        totalDmg= dredDmg*(2*Cr+Natt)\n    end\n    hopeh=round(maxh/(totalDmg/43000),2)\n    \n    ----------------------------------------------------------------\n    -- 【7】评分最终修正（未免暴惩罚 / 已免暴加成）\n    ----------------------------------------------------------------\n    if( Cr>0) then ITankPercent=ITankPercent*0.8\n    else\n        ITankPercent=ITankPercent*1.1\n    end\n    ITankPercent=round( ITankPercent,0)\n    \n    ----------------------------------------------------------------\n    -- 【8】文字显示字符串组装\n    ----------------------------------------------------------------\n    local jnctcolor=\"|cffff0000\"..ct..\"%|r\"\n    if defneed>0 then\n        jnctcolor = \"|cffff8000\"..ct..\"%|r\"\n    end\n    if ct >= 0 then\n        jnctcolor = \"|cff00ff00\"..ct..\"%|r\"\n    end\n    \n    local jnpdef=''\n    if defneed<=0 then\n        jnpdef = \"|cff00ff00\"..pdef..\"|r\"\n    else\n        jnpdef = \"|cffff0000\"..pdef..\"|r\"\n    end\n    \n    local jndefneed=''\n    if defneed>0 then\n        jndefneed = \"缺: |cffff0000\"..math.ceil(defneed*100*4.9184)..\"等级|r\"\n    else\n        jndefneed = \"达标|r\"\n    end\n    \n    if classId==11 then\n        if defneed<=0 then\n            jnpdef = \"|cff00ff00\"..pdef..\"|r\"\n        else\n            jnpdef = \"|cffff0000\"..pdef..\"|r\"\n        end\n        jndefneed='----'\n    end\n    \n    -- buff加成后最终命中\n    if buffCheck then\n        hitrating = hitrating +1\n    end\n    \n    local hitstr=\"|cffff0000\"..string.format(\"%.3f\", hitrating)..\"%|r\"\n    if hitrating>=8 then\n        hitstr=\"|cff00ff00\"..string.format(\"%.3f\", hitrating)..\"%|r\"\n    end\n    \n    local Exptstr=\"|cffff0000\"..string.format(\"%.0f\",expt)..\"|r\"\n    if expt>=26 then\n        Exptstr=\"|cff00ff00\"..string.format(\"%.0f\",expt)..\"|r\"\n    end\n    \n    local missingHitLevel = math.floor((8 - hitrating) * 32.789) -- 缺多少命中等级评分\n    \n    -- 【重点修改】命中不足部分颜色：负数红色，已达标绿色\n    local missingHitColor\n    if missingHitLevel > 0 then\n        missingHitColor = \"|cffff0000\"..missingHitLevel..\"|r\"   -- 还缺，红色\n    else\n        missingHitColor = \"|cff00ff00达标|r\"                   -- 已达标，绿色\n    end\n    \n    local jnret='技能信息：'\n    jnret=jnret..'\\n防等:'..jnpdef..'/'.. jndefneed\n    \n    if hitrating >= 8 then\n        jnret = jnret .. '\\n命中:' .. hitstr .. \"/8%\"\n    else\n        jnret = jnret .. '\\n命中:' .. hitstr .. \"/8%/-\" .. missingHitColor\n    end\n    \n    jnret=jnret..'\\n免爆:'..jndefneed..'\\n(韧:'..(string.format(\"%.4f\", resil))..',防技:'..string.format(\"%.2f\",(pdef-400)*0.04)..')'\n    jnret=jnret..'\\n护甲值:'..effectiveArmor\n    jnret=jnret..'\\n护甲免伤:'..round(dr*100,2)..'%'\n    \n    ----------------------------------------------------------------\n    -- 【9】输出评分、精准等其余信息组装（保持原样）\n    ----------------------------------------------------------------\n    local wplow=lowDmg-AP/14*wpspeed*1.13\n    local wphi=hiDmg-AP/14*wpspeed*1.13\n    local wpatt=(wplow+wphi)/wpspeed/2\n    local ITankattack=bv*0.27+holy*0.12+AP*0.31+crit*42.9*0.3+wpatt*2.29\n    if hitrating>=8 then ITankattack= ITankattack+8*32.7*0.6\n    else ITankattack= ITankattack+hitrating *32.7*0.6 end\n    if expt>=26 then ITankattack= ITankattack+(expt-26)*8.3*0.36+26*8.3*0.71\n    else ITankattack= ITankattack+expt*8.3*0.71 end\n    ITankattack=round(ITankattack,0)\n    \n    local ret=''\n    local missExp = math.floor((26 - expt) * 8.1974)\n    \n    if (classId <6) then\n        ret = ret .. \"格挡值:\" .. (string.format(\"%.0f\", bv))..'/2400'\n        if expt > 26 then\n            ret = ret .. \"\\n精准:\" .. Exptstr .. \"/26\"\n        else\n            ret = ret .. \"\\n精准:\" .. Exptstr .. \"/26/-\" .. missExp\n        end\n        ret = ret .. \"\\n物理免伤: \".. (string.format(\"%.2f\", avoidance))\n        ret = ret .. \"\\niTank生存评分: \"..ITankPercent\n        ret = ret .. \"\\niTank输出评分: \"..ITankattack\n        ret = ret .. \"\\n有效生命: \".. (string.format(\"%.0f\", hopeh))\n    end\n    \n    if classId ==6 then\n        if expt > 26 then\n            ret = ret .. \"精准:\" .. Exptstr .. \"/26\"\n        else\n            ret = ret .. \"精准:\" .. Exptstr .. \"/26/-\" .. missExp\n        end\n        ret = ret .. \"\\n物理免伤: \".. (string.format(\"%.2f\", avoidance))\n        ret = ret .. \"\\n韧性免爆: \"..(string.format(\"%.2f\", resil))..'%'\n        ret = ret .. \"\\n\\niTank评分: \"..ITankPercent\n        ret = ret .. \"\\n有效生命: \".. (string.format(\"%.0f\", hopeh))\n    end\n    \n    if classId ==11 then\n        ret = ret .. \"免爆所需: \"\n        if defneed>0 then\n            ret = ret .. \"\\n防等: \" .. round(defneed,2)..\"(\"..string.format(\"%.1f\",defneed*2.36)..')'\n            ret = ret .. \"\\n韧性: \".. string.format(\"%.2f\",resilneed)\n        else\n            ret = ret .. \"\\n防等:已达标\"\n            ret = ret .. \"\\n韧性:已达标\"\n        end\n        ret = ret .. \"\\n 精准:\" ..Exptstr\n        ret = ret .. \"\\niTank评分: \"..ITankPercent\n        ret = ret .. \"\\n有效生命: \"..hopeh\n    end\n    \n    ----------------------------------------------------------------\n    -- 【10】数据传递给WeakAuras\n    ----------------------------------------------------------------\n    local dataTB={}\n    dataTB.hopeh=hopeh\n    dataTB.ITankPercent=ITankPercent\n    dataTB.avoidance=avoidance\n    dataTB.pdef=pdef\n    dataTB.effectiveArmor=effectiveArmor\n    dataTB.Total=total\n    dataTB.dr=dr\n    dataTB.defneed=defneed\n    dataTB.ct=ct\n    dataTB.qitastr=ret\n    dataTB.jnstr=jnret\n    dataTB.tag=Cr\n    dataTB.holy=holy\n    dataTB.shear=shear\n    WeakAuras.ScanEvents(\"SCANEVENTS_TBTEST\",dataTB)\n    WeakAuras.ScanEvents(\"SCANEVENTS_TBTEST1\",dataTB)\n    WeakAuras.ScanEvents(\"SCANEVENTS_TBTEST2\",dataTB)\n    return tonumber(string.format(\"%.2f\", round(miss, 2))), (string.format(\"%.2f\", round(dodge, 2))), (string.format(\"%.2f\", round(parry, 2))), (string.format(\"%.2f\", round(block, 2))), (string.format(\"%.2f\", round(total, 2))), shearcolor\nend",
