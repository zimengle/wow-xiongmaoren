["multi"] = {
},
},
},
["displayText_format_DpsPoint_format"] = "none",
["shadowXOffset"] = 0,
["regionType"] = "text",
["displayText_format_3.hastepercent_format"] = "Number",
["displayText_format_3.strength_format"] = "none",
["tocversion"] = 30404,
["displayText_format_dataTB.DpsPoint_format"] = "none",
["displayText_format_3.armorpenpercent_decimal_precision"] = 1,
["config"] = {
},
["fixedWidth"] = 200,
["outline"] = "OUTLINE",
["displayText_format_3.hastepercent_decimal_precision"] = 1,
["wagoID"] = "VMfNhd-Bp",
["parent"] = "iTank V2.5.2 & iDPS V1.7.4",
["customText"] = "--iDPS V1.7.4.1212\nfunction ()\n    local function round(num, idp)\n        local mult = 10 ^ (idp or 0);\n        return math.floor(num * mult + 0.5) / mult;\n    end\n    \n    -- 获取主要属性\n    local Strength = UnitStat(\"player\", 1) -- 力量\n    local Agility = UnitStat(\"player\", 2) -- 敏捷\n    local Stamina = UnitStat(\"player\", 3) -- 耐力\n    local Intellect = UnitStat(\"player\", 4) -- 智力\n    local Spirit = UnitStat(\"player\", 5) -- 精神\n    \n    -- 获取次要属性\n    local Hit = GetCombatRatingBonus(CR_HIT_MELEE) -- 命中\n    local HitRating = GetCombatRating(CR_HIT_MELEE) -- 命中等级    \n    local HitRating1 = GetCombatRating(CR_HIT_MELEE) -- 命中等级    \n    local Crit = GetCritChance() -- 暴击\n    local CritRating = GetCombatRating(CR_CRIT_MELEE)  -- 近战暴击等级\n    local Haste = GetCombatRatingBonus(CR_HASTE_MELEE) -- 急速\n    local HasteRating = GetCombatRating(CR_HASTE_MELEE)  -- 近战急速等级\n    local Expertise = GetExpertise() -- 精准\n    local ExpRating = GetCombatRating(CR_EXPERTISE)  -- 返回当前的精准等级（如 100）\n    local ArP = GetCombatRatingBonus(CR_ARMOR_PENETRATION) -- 护甲穿透\n    local base, posBuff, negBuff = UnitAttackPower(\"player\");\n    local AttackPower = base + posBuff + negBuff;\n    --local AttackPower = GetCombatRatingBonus(CR_HASTE_MELEE) --UnitAttackPower(\"player\") -- 攻击强度\n    \n    -- 获取法系、远程参数\n    local SpellPower = GetSpellBonusDamage(2) -- 法术强度-1、所有，2、伤害，3、治疗\n    local base, posBuff, negBuff = UnitRangedAttackPower(\"player\") -- 远程AP\n    local rangedAttackPower = base + posBuff - negBuff -- 计算增减益\n    local critRatingBonus = GetCombatRatingBonus(CR_CRIT_RANGED)\n    local critRating = GetCombatRating(CR_CRIT_RANGED)--远程暴击等级-2025-06-08\n    \n    -- 获取命中、精准、暴击、急速\n    local rangedHitRating = GetCombatRating(7)   -- 远程命中\n    local spellHitRating = GetCombatRating(CR_HIT_SPELL)   -- 法术命中等级\n    local spellHitPercent = GetCombatRatingBonus(CR_HIT_SPELL)   -- 法术命中百分比\n    local rangedCrit = GetRangedCritChance()  -- 远程暴击\n    local spellCrit = GetCombatRating(11)\n    local spellCritChance = GetSpellCritChance(2) --法术暴击率\n    --local spellHasteChance = GetCombatRatingBonus(CR_HASTE_SPELL)\n    local rangedHasteRating = GetCombatRating(19) -- 远程急速\n    local spellHasteRating = GetCombatRating(20)  -- 法术急速\n    \n    --百分比换算\n    --[[ratingHit = 32.79--近战命中等级换算系数\n    ratingCrit = 45.91--近战、法系、远程共享换算暴击等级系数\n    ratingExpertise = 8.1974--精准换算系数]]\n    local ratingCrit = 45.91--近战、法系、远程共享换算暴击等级系数\n    local ratingHaste = 25.21--近战\n    local ratingHasteRanged = 32.79--法系、远程\n    local ratingArP = 13.99--破甲换算系数\n    local ratingSpellHit = 26.23--法系，远程共享换算法系命中系数\n    -- 获取玩家职业\n    local class = UnitClass(\"player\")\n    \n    -- 如果命中等级大于 264，调整Hit并增加多余部分的分值（1225增加法系、远程命中得分修改）\n    --[[if HitRating > 264 then\n        HitRating = 264  -- 命中等级设置为 264\n    end\n    if spellHitPercent > 264 then\n        spellHitPercent = 264  -- 法术命中等级设置为 264\n    end\n    if rangedHitRating > 264 then\n        rangedHitRating = 264  -- 远程命中等级设置为 264\n    end]]--\n    \n    -- 初始DpsPoint变量（1225增加法系、远程命中得分修改）\n    local DpsPoint = 0\n    if HitRating > 264 then\n        local excessHit = HitRating - 264\n        DpsPoint = DpsPoint + excessHit * 0.1\n    end\n    if spellHitPercent > 264 then\n        local excessSpellHit = spellHitPercent - 264\n        DpsPoint = DpsPoint + excessSpellHit * 0.1\n    end\n    if rangedHitRating > 264 then\n        local excessRangedHit = rangedHitRating - 264\n        DpsPoint = DpsPoint + excessRangedHit * 0.1\n        local excessHit = Hit - 264  -- 计算超出部分\n        DpsPoint = DpsPoint + excessHit * 0.1  -- 超出部分按0.1分加到DpsPoint\n    end\n    -- str变量声明，命中、精准检查条件。\n    local str =''\n    \n    local spellHitPercent = spellHitPercent-- / ratingSpellHit\n    ----天赋专精----\n    local preTalentPointSpent = 0\n    local talentName = \"\"\n    local curTalentPoints = {}\n    \n    -- 遍历3个天赋树\n    for i = 1, 3 do\n        local _, name,_,_,pointsSpent = GetTalentTabInfo(i)\n        \n        -- 确保 pointsSpent 是数字类型\n        pointsSpent = tonumber(pointsSpent) or 0\n        \n        curTalentPoints[i] = pointsSpent  -- 将点数存入表格\n        \n        -- 比较当前天赋树的点数，找到点数最多的天赋树\n        if pointsSpent > preTalentPointSpent then\n            preTalentPointSpent = pointsSpent\n            talentName = name\n        end\n    end\n    \n    \n    -- 根据职业选择不同的公式\n    if class == \"圣骑士\" then\n        DpsPoint = (Strength * 2.53 + Agility * 1.13 + Intellect * 0.15 + Haste * 1.44 + Crit * 1.16 + ArP * 0.76 + Expertise * 1.80 + HitRating * 1.96 + SpellPower * 0.32 + AttackPower * 1) * 1\n    elseif class == \"战士\" then\n        DpsPoint = (Strength * 2.72 + Agility * 1.82 + Haste * 1.72 + Crit * 2.12 + ArP * 2.17 + Expertise * 2.55 + HitRating * 0.79 + SpellPower * 0.00 + AttackPower * 1) * 1\n    elseif class == \"死亡骑士\" then\n        local XDK = (Strength * 3.22 + Agility * 0.62 + Haste * 1.85 + Crit * 0.76 + ArP * 0.77 + Expertise * 1.5 + HitRating * 1.92 + SpellPower * 0.00 + AttackPower * 1) * 1\n        local BDK = (Strength * 3.22 + Agility * 0.62 + Haste * 0.77 + Crit * 0.76 + ArP * 1.85 + Expertise * 1.5 + HitRating * 1.92 + SpellPower * 0.00 + AttackPower * 1) * 1\n        if talentName==\"冰霜\" then DpsPoint=BDK else  DpsPoint=XDK end\n    elseif class == \"猎人\" then\n        DpsPoint = (Strength * 0.00 + Agility * 2.65 + Intellect * 1.10 + Haste * 1.39 + Crit * 1.50 + ArP * 1.32 + Expertise * 0.00 + HitRating * 0.00 + rangedAttackPower * 1.00 + rangedHitRating * 2 + rangedCrit * 1.5 + rangedHasteRating *1.39) * 1\n    elseif class == \"萨满祭司\" then\n        local ZQ=(Strength * 1.10 + Agility * 1.59 + Intellect * 1.48 + Haste * 1.61 + Crit * 0.81 + ArP * 0.48 + Expertise * 0.00 + HitRating * 1.38 + SpellPower * 1.13 + AttackPower * 1) * 1\n        local YS=(Intellect * 0.22 + Spirit * 0.0 + SpellPower * 1.00 + spellHitPercent*0.0 + spellCrit * 0.67 + spellHasteRating * 1.29) * 1\n        if talentName==\"增强\" then DpsPoint=ZQ else  DpsPoint=YS end\n    elseif class == \"潜行者\" then\n        DpsPoint = (Strength * 1.14 + Agility * 1.86 + Haste * 1.48 + Crit * 1.32 + ArP * 0.84 + Expertise * 0.98 + HitRating * 1.39 + AttackPower * 1) * 1\n    elseif class == \"德鲁伊\" then\n        local Feral =  (Strength * 2.40 + Agility * 2.39 + Intellect * 0.00 + Haste * 1.83 + Crit * 2.23 + ArP * 2.08 + Expertise * 2.44 + HitRating * 2.51 + AttackPower * 1) * 1\n        local Balance = (Intellect * 0.48 + Spirit * 0.42 + SpellPower * 1.00 + spellHitPercent*0.38 + spellCrit * 0.58 + spellHasteRating * 0.94) * 1\n        if talentName==\"平衡\" then DpsPoint=Balance else  DpsPoint=Feral end\n    elseif class == \"法师\" then\n        DpsPoint = (Intellect * 0.48 + Spirit * 0.42 + SpellPower * 1.00 + spellHitPercent*0.38 + spellCrit * 0.58 + spellHasteRating * 0.94) * 1\n    elseif class == \"术士\" then\n        DpsPoint = (Intellect * 0.18 + Spirit * 0.54 + SpellPower * 1.00 + spellHitPercent*0.93 + spellCrit * 0.53 + spellHasteRating * 0.81) * 1\n    elseif class == \"牧师\" then\n        DpsPoint = (Intellect * 0.11 + Spirit * 0.47 + SpellPower * 1.00 + spellHitPercent*0.87 + spellCrit * 0.74 + spellHasteRating * 1.65) * 1\n    else\n        DpsPoint = 5--你个战五渣！\n    end\n    DpsPoint=string.format(\"%.2f\", DpsPoint ) \n    -- 定义颜色变量\n    -- 颜色代码\n    local colorRed = \"|cFFFF0000\"      -- 红色，不合格\n    local colorGreen = \"|cFF00FF00\"    -- 绿色，合格\n    local colorOlive = \"|cFF6B8E23\"    -- 橄榄色，超标\n    local colorDarkgreen = \"|cFF006400\"-- 深绿色，严重超标\n    local colorOrange = \"|cFFFF4500\"   -- 橙色，不足\n    local colorBlue = \"|cFF87CEEB\"     -- 天蓝色\n    \n    local ExpertiseRating = GetCombatRating(CR_EXPERTISE)\n    --德莱尼光环判定，有则hit+1，无则Hit =Hit\n    --检查玩家是否有 ID 为 28878 或6562的增益光环（原一个物理一个法系，不同职业的ID不一致，所以需要判断两个）\n    local buffCheck = false\n    for i = 1, 40 do\n        local name, _, _, _, _, _, _, _, _, spellID = UnitBuff(\"player\", i)\n        if spellID == 28878 or spellID == 6562 then\n            buffCheck = true\n            break\n        end\n    end\n    if buffCheck then\n        Hit = Hit + 1\n        spellHitPercent = spellHitPercent + 1--20241225修改，增加法系和远程命中判定\n        rangedHitRating = rangedHitRating + 1--20241225修改，增加法系和远程命中判定\n    end\n    -- 结果字符串\n    \n    if class == \"术士\"  then\n        local hitRequest = 14\n        local hitColor = spellHitPercent < hitRequest and colorRed or colorGreen\n        local hitneed = (spellHitPercent - hitRequest) * ratingSpellHit\n        local hitneedColor = hitneed > 0 and colorGreen or colorRed  -- 根据 hitneed 的值设置颜色\n        str = string.format(\"%.0f\", DpsPoint)..\"\\n\"\n        .. \"智力: \"..Intellect..\"      精神: \"..Spirit.. \"      法伤: \"..SpellPower..\"\\n\"\n        .. \"命中: \"..hitColor..string.format(\"%.2f\", spellHitPercent)..\"%|r\"..\"/\"..spellHitRating..\"/\"..hitneedColor..string.format(\"%.0f\", hitneed)..\"|r\"..\"    \"\n        .. \"急速: \"..string.format(\"%.2f\", spellHasteRating / ratingHasteRanged)..\"%\"..\"/\"..string.format(\"%.0f\", spellHasteRating ) ..\"    \"\n        .. \"暴击: \"..string.format(\"%.2f\", spellCritChance)..\"%\"..\"/\"..string.format(\"%.0f\", spellCrit ) ..\"  \"\n        \n    elseif class == \"法师\"  then\n        local hitRequest = 14\n        local hitColor = spellHitPercent < hitRequest and colorRed or colorGreen\n        local hitneed = (spellHitPercent - hitRequest) * ratingSpellHit\n        local hitneedColor = hitneed > 0 and colorGreen or colorRed  -- 根据 hitneed 的值设置颜色\n        str = string.format(\"%.0f\", DpsPoint)..\"\\n\"\n        .. \"智力: \"..Intellect..\"      精神: \"..Spirit.. \"      法伤: \"..SpellPower..\"\\n\"\n        .. \"命中: \"..hitColor..string.format(\"%.2f\", spellHitPercent)..\"%|r\"..\"/\"..spellHitRating..\"/\"..hitneedColor..string.format(\"%.0f\", hitneed)..\"|r\"..\"    \"\n        .. \"急速: \"..string.format(\"%.2f\", spellHasteRating / ratingHasteRanged)..\"%\"..\"/\"..string.format(\"%.0f\", spellHasteRating ) ..\"    \"\n        .. \"暴击: \"..string.format(\"%.2f\", spellCritChance)..\"%\"..\"/\"..string.format(\"%.0f\", spellCrit ) ..\"  \"\n        \n    elseif class == \"牧师\" then\n        local hitRequest = 11\n        local hitColor = spellHitPercent < hitRequest and colorRed or colorGreen\n        local hitneed = (spellHitPercent - hitRequest) * ratingSpellHit\n        local hitneedColor = hitneed > 0 and colorGreen or colorRed  -- 根据 hitneed 的值设置颜色\n        str = string.format(\"%.0f\", DpsPoint)..\"\\n\"\n        .. \"智力: \"..Intellect..\"      精神: \"..Spirit.. \"      法伤: \"..SpellPower..\"\\n\"\n        .. \"命中: \"..hitColor..string.format(\"%.2f\", spellHitPercent)..\"%|r\"..\"/\"..spellHitRating..\"/\"..hitneedColor..string.format(\"%.0f\", hitneed)..\"|r\"..\"    \"\n        .. \"急速: \"..string.format(\"%.2f\", spellHasteRating / ratingHasteRanged)..\"%\"..\"/\"..string.format(\"%.0f\", spellHasteRating ) ..\"    \"\n        .. \"暴击: \"..string.format(\"%.2f\", spellCritChance)..\"%\"..\"/\"..string.format(\"%.0f\", spellCrit ) ..\"  \"\n        \n    elseif class == \"圣骑士\" then\n        local hitRequest = 8\n        local hitneed = (Hit - hitRequest) * 32.79\n        local hitneedColor = hitneed > 0 and colorGreen or colorRed  -- 根据 hitneed 的值设置颜色\n        local hitColor = Hit < hitRequest and colorOrange\n        or (Hit >= hitRequest and Hit < 8.5 and colorGreen)\n        or (Hit >= 8.5 and Hit < 10 and colorOlive)\n        or colorDarkgreen\n        local ExpRatingNeed = 26  -- 精准等级要求设置为 26\n        local expneed = Expertise - ExpRatingNeed   -- 用 ExpRating 与 ExpRatingNeed 计算盈亏\n        local expneedColor = expneed > 0 and colorGreen or colorRed  -- 根据 expneed 的值设置颜色\n        local ExpColor = Expertise < (ExpRatingNeed ) and colorRed\n        or (Expertise == (ExpRatingNeed ) and colorGreen)\n        or (Expertise > (ExpRatingNeed) and Expertise <= 30 and colorOlive)\n        or colorDarkgreen\n        str = DpsPoint..\"    力量: \"..Strength..\"  敏捷: \"..Agility..\"  \"..\"  攻强: \"..AttackPower..\"\\n\"\n        .. \"命中: \"..hitColor..string.format(\"%.2f\", Hit)..\"%|r\"..\"/\"..HitRating1..\"等级/\"..hitneedColor..string.format(\"%.0f\", hitneed )..\"|r\"..\"  \"\n        .. \"精准: \"..ExpColor..string.format(\"%.0f\", Expertise)..\"|r\"..\"/\"..string.format(\"%.0f\", ExpRating)..\"等级/\"..expneedColor..string.format(\"%.0f\", expneed * 8.1974)..\"|r\"..\"\\n\"\n        .. \"破甲: \"..string.format(\"%.2f\", ArP )..\"%\"..\"/\"..string.format(\"%.0f\", ArP * ratingArP ) ..\" \"\n        .. \"急速: \"..string.format(\"%.2f\", Haste)..\"%\"..\"/\"..HasteRating ..\"  \"\n        .. \"暴击: \"..string.format(\"%.2f\", Crit)..\"%/\"..string.format(\"%.0f\", CritRating)..\"  \"\n        \n    elseif class == \"战士\" then\n        local hitRequest = 5 -- 命中要求改为 5%\n        local hitneed = (Hit - hitRequest) * 32.79\n        local hitneedColor = hitneed > 0 and colorGreen or colorRed\n        local hitColor = Hit < hitRequest and colorOrange\n        or (Hit >= hitRequest and Hit < 5.5 and colorGreen)\n        or (Hit >= 5.5 and Hit < 7 and colorOlive)\n        or colorDarkgreen\n        local ExpRatingNeed = 26\n        local expneed = Expertise - ExpRatingNeed\n        local expneedColor = expneed > 0 and colorGreen or colorRed\n        local ExpColor = Expertise < (ExpRatingNeed ) and colorRed\n        or (Expertise == (ExpRatingNeed ) and colorGreen)\n        or (Expertise > (ExpRatingNeed) and Expertise <= 30 and colorOlive)\n        or colorDarkgreen\n        \n        -- 【按圣骑士回显格式修改】\n        str = DpsPoint..\" 力量: \"..Strength..\" 敏捷: \"..Agility..\" \"..\" 攻强: \"..AttackPower..\"\\n\"\n        .. \"命中: \"..hitColor..string.format(\"%.2f\", Hit)..\"%|r\"..\"/\"..HitRating1..\"等级/\"..hitneedColor..string.format(\"%.0f\", hitneed )..\"|r\"..\" \"\n        .. \"精准: \"..ExpColor..string.format(\"%.0f\", Expertise)..\"|r\"..\"/\"..string.format(\"%.0f\", ExpRating)..\"等级/\"..expneedColor..string.format(\"%.0f\", expneed * 8.1974)..\"|r\"..\"\\n\"\n        .. \"破甲: \"..string.format(\"%.2f\", ArP )..\"%\"..\"/\"..string.format(\"%.0f\", ArP * ratingArP ) ..\" \"\n        .. \"急速: \"..string.format(\"%.2f\", Haste)..\"%\"..\"/\"..HasteRating ..\" \"\n        .. \"暴击: \"..string.format(\"%.2f\", Crit)..\"%/\"..string.format(\"%.0f\", CritRating)..\" \"\n        \n        \n    elseif class == \"死亡骑士\" then\n        local hitRequest = 8\n        local hitneed = (Hit - hitRequest) * 32.79\n        local hitneedColor = hitneed > 0 and colorGreen or colorRed\n        local hitColor = Hit < hitRequest and colorOrange\n        or (Hit >= hitRequest and Hit < 8.5 and colorGreen)\n        or (Hit >= 8.5 and Hit < 10 and colorOlive)\n        or colorDarkgreen\n        local ExpRatingNeed = 26\n        local expneed = Expertise - ExpRatingNeed\n        local expneedColor = expneed > 0 and colorGreen or colorRed\n        local ExpColor = Expertise < (ExpRatingNeed ) and colorRed\n        or (Expertise == (ExpRatingNeed ) and colorGreen)\n        or (Expertise > (ExpRatingNeed) and Expertise <= 30 and colorOlive)\n        or colorDarkgreen\n        local CritRating = GetCombatRating(CR_CRIT_MELEE)\n        \n        -- 【按圣骑士回显格式修改】\n        str = DpsPoint..\" 力量: \"..Strength..\" 敏捷: \"..Agility..\" \"..\" 攻强: \"..AttackPower..\"\\n\"\n        .. \"命中: \"..hitColor..string.format(\"%.2f\", Hit)..\"%|r\"..\"/\"..HitRating1..\"等级/\"..hitneedColor..string.format(\"%.0f\", hitneed )..\"|r\"..\" \"\n        .. \"精准: \"..ExpColor..string.format(\"%.0f\", Expertise)..\"|r\"..\"/\"..string.format(\"%.0f\", ExpRating)..\"等级/\"..expneedColor..string.format(\"%.0f\", expneed * 8.1974)..\"|r\"..\"\\n\"\n        .. \"破甲: \"..string.format(\"%.2f\", ArP )..\"%\"..\"/\"..string.format(\"%.0f\", ArP * ratingArP ) ..\" \"\n        .. \"急速: \"..string.format(\"%.2f\", Haste)..\"%\"..\"/\"..HasteRating ..\" \"\n        .. \"暴击: \"..string.format(\"%.2f\", Crit)..\"%/\"..string.format(\"%.0f\", CritRating)..\" \"\n        \n    elseif class ==  \"萨满祭司\" then\n        if talentName==\"增强\" then\n            local hitRequest = 8\n            local hitColor = Hit < hitRequest and colorOrange\n            or (Hit >= hitRequest and Hit < 8.5 and colorGreen)\n            or (Hit >= 8.5 and Hit < 10 and colorOlive)\n            or colorDarkgreen\n            local ExpRequest = 26\n            local expneed = Expertise - ExpRequest   -- 用 ExpRating 与 ExpRatingNeed 计算盈亏\n            local expneedColor = expneed > 0 and colorGreen or colorRed  -- 根据 expneed 的值设置颜色\n            local ExpColor = Expertise < ExpRequest and colorRed\n            or (Expertise == ExpRequest and colorGreen)\n            or (Expertise > ExpRequest and Expertise <= 30 and colorOlive)\n            or colorDarkgreen\n            local CritCap = 100-(27-(Hit +5))-24+4.8-(Crit+3)\n            str = string.format(\"%.0f\", DpsPoint)..\"    敏捷: \"..Agility..\"  力量: \"..Strength..\"  \"..\"攻强: \"..rangedAttackPower..\"\\n\"\n            .. \"命中: \"..hitColor..string.format(\"%.2f\", Hit )..\"%|r\"..\"  \"\n            .. \"精准: \"..ExpColor..string.format(\"%.0f\", Expertise)..\"|r\"..\"/\"..string.format(\"%.0f\", ExpRating)..\"/\"..expneedColor..string.format(\"%.0f\", expneed)..\"|r\"..\"  \"\n            .. \"破甲: \"..string.format(\"%.2f\", ArP )..\"%\".. \"/\"..string.format(\"%.0f\", ArP * ratingArP ) ..\"\\n\"            \n            .. \"暴击: \"..string.format(\"%.2f\", Crit)..\"%/\"..string.format(\"%.0f\", CritRating)..\"  \"\n            .. \"急速: \"..string.format(\"%.2f\", Haste)..\"%\"..\"/\"..string.format(\"%.0f\", Haste * ratingHaste ) ..\"  \"   \n            \n            \n        else \n            local hitRequest = 11\n            local hitColor = spellHitPercent < hitRequest and colorRed or colorGreen\n            local hitneed = (spellHitPercent - hitRequest) * ratingSpellHit\n            local hitneedColor = hitneed > 0 and colorGreen or colorRed  -- 根据 hitneed 的值设置颜色\n            str = string.format(\"%.0f\", DpsPoint).. \"\\n\"\n            .. \"智力: \"..Intellect..\"   精神: \"..Spirit.. \"   法伤: \"..SpellPower..\"  \"..\"\\n\"\n            .. \"命中: \"..hitColor..string.format(\"%.2f\", spellHitPercent)..\"%|r\"..\"/\"..spellHitRating..\"/\"..hitneedColor..string.format(\"%.0f\", hitneed)..\"|r\"..\"    \"\n            .. \"暴击: \"..string.format(\"%.2f\", spellCritChance)..\"%\"..\"/\"..string.format(\"%.0f\", spellCrit ) ..\"  \"\n            .. \"急速: \"..string.format(\"%.2f\", spellHasteRating / ratingHasteRanged)..\"%\"..\"/\"..string.format(\"%.0f\", spellHasteRating ) ..\"  \"\n        end        \n        \n    elseif class == \"潜行者\" then\n        local hitRequest = 8\n        local hitneed = (Hit - hitRequest) * 32.79\n        local hitneedColor = hitneed > 0 and colorGreen or colorRed  -- 根据 hitneed 的值设置颜色\n        local hitColor = Hit < hitRequest and colorOrange\n        or (Hit >= hitRequest and Hit < 8.5 and colorGreen)\n        or (Hit >= 8.5 and Hit < 10 and colorOlive)\n        or colorDarkgreen\n        local ExpRatingNeed = 26 -- 精准等级要求设置为 214\n        local expneed = Expertise - ExpRatingNeed  -- 用 ExpRating 与 ExpRatingNeed 计算盈亏\n        local expneedColor = expneed > 0 and colorGreen or colorRed  -- 根据 expneed 的值设置颜色\n        local ExpColor = Expertise < (ExpRatingNeed ) and colorRed\n        or (Expertise == (ExpRatingNeed ) and colorGreen)\n        or (Expertise > (ExpRatingNeed) and Expertise <= 30 and colorOlive)\n        or colorDarkgreen\n        --local CritCap = 100-(27-(Hit +5))-24+4.8-(Crit+3) --备份：暴击上限计算公式1\n        str = string.format(\"%.0f\", DpsPoint)..\"    敏捷: \"..Agility..\"  力量: \"..Strength..\"  \"..\"攻强: \"..AttackPower..\"\\n\"\n        .. \"命中: \"..hitColor..string.format(\"%.2f\", Hit)..\"%|r\"..\"/\"..string.format(\"%.0f\",HitRating)..\"/\"..hitneedColor..string.format(\"%.0f\", hitneed)..\"|r\"..\"  \"\n        .. \"精准: \"..ExpColor..string.format(\"%.0f\", Expertise)..\"|r\"..\"/\"..string.format(\"%.0f\", ExpRating)..\"/\"..expneedColor..string.format(\"%.0f\", expneed)..\"|r\"..\"  \"\n        .. \"急速/等级: \"..string.format(\"%.2f\", Haste)..\"%\"..\"/\"..HasteRating ..\"\\n\"\n        .. \"破甲/等级: \"..string.format(\"%.2f\", ArP )..\"%\".. \"/\"..string.format(\"%.0f\", ArP * ratingArP ) ..\"  \"    \n        .. \"暴击/等级: \"..string.format(\"%.2f\", Crit)..\"%\"..\"/\"..CritRating..\"  \"            \n        \n        \n    elseif class == \"德鲁伊\" then\n        if talentName==\"野性战斗\" then            \n            local hitRequest = 8\n            local hitneed = (Hit - hitRequest) * 32.79\n            local hitneedColor = hitneed > 0 and colorGreen or colorRed  -- 根据 hitneed 的值设置颜色\n            local hitColor = Hit < hitRequest and colorOrange\n            or (Hit >= hitRequest and Hit < 8.5 and colorGreen)\n            or (Hit >= 8.5 and Hit < 10 and colorOlive)\n            or colorDarkgreen\n            local ExpRatingNeed = 26 -- 精准等级要求设置为 214\n            local expneed = Expertise - ExpRatingNeed  -- 用 ExpRating 与 ExpRatingNeed 计算盈亏\n            local expneedColor = expneed > 0 and colorGreen or colorRed  -- 根据 expneed 的值设置颜色\n            local ExpColor = Expertise < (ExpRatingNeed ) and colorRed\n            or (Expertise == (ExpRatingNeed ) and colorGreen)\n            or (Expertise > (ExpRatingNeed) and Expertise <= 30 and colorOlive)\n            or colorDarkgreen\n            --local Exrd = Expertise * 0.25 --每精准降低0.25\n            --local CritCap = 100 - (9 - Hit ) - max(6.5 - Exrd,0) + 4.8 --备份：暴击上限计算公式2\n            str = string.format(\"%.0f\", DpsPoint)..\"    敏捷: \"..Agility..\"  力量: \"..Strength..\"  \"..\"攻强: \"..AttackPower..\"\\n\"\n            .. \"命中: \"..hitColor..string.format(\"%.2f\", Hit)..\"%|r\"..\"/\"..string.format(\"%.0f\",HitRating)..\"/\"..hitneedColor..string.format(\"%.0f\", hitneed)..\"|r\"..\"  \"\n            .. \"精准: \"..ExpColor..string.format(\"%.0f\", Expertise)..\"|r\"..\"/\"..string.format(\"%.0f\", ExpRating)..\"/\"..expneedColor..string.format(\"%.0f\", expneed)..\"|r\"..\"  \"\n            .. \"急速/等级: \"..string.format(\"%.2f\", Haste)..\"%\"..\"/\"..HasteRating ..\"\\n\"\n            .. \"破甲/等级: \"..string.format(\"%.2f\", ArP )..\"%\".. \"/\"..string.format(\"%.0f\", ArP * ratingArP ) ..\"  \"    \n            .. \"暴击/等级: \"..string.format(\"%.2f\", Crit)..\"%\"..\"/\"..CritRating..\"  \"            \n            --.. \"暴击/上限: \"..string.format(\"%.2f\", Crit)..\"%\"..\"/\"..string.format(\"%.2f\", CritCap)..\"\"..\"%/\"..CritRating..\"  \"   --暴击上限数据格式备份\n        else\n            local hitRequest = 10\n            local hitColor = spellHitPercent < hitRequest and colorRed or colorGreen\n            str = string.format(\"%.0f\", DpsPoint).. \"    智力: \"..Intellect..\"   精神: \"..Spirit.. \"   法伤: \"..SpellPower..\"  \"..\"\\n\"\n            .. \"命中: \"..hitColor..string.format(\"%.2f\", spellHitPercent)..\"%|r\"..\"  \"\n            .. \"暴击: \"..string.format(\"%.2f\", spellCritChance)..\"%\"..\"/\"..string.format(\"%.0f\", spellCrit ) ..\"  \"\n            .. \"急速: \"..string.format(\"%.2f\", spellHasteRating / ratingHasteRanged)..\"%\"..\"/\"..string.format(\"%.0f\", spellHasteRating ) ..\"  \"\n            \n        end\n        \n    elseif class == \"猎人\" then\n        --待更新：天赋命中点数判别\n        local hitRequest = 5  -- 命中要求 5%（2025-12-12由死木头提供信息修改）\n        local hitneed = (Hit - hitRequest) * 32.79  -- 命中盈亏（等级）\n        local hitneedColor = hitneed > 0 and colorGreen or colorRed  -- 盈亏颜色：大于0绿色，小于0红色\n        local hitColor = Hit < hitRequest and colorRed or colorGreen\n        str = string.format(\"%.0f\", DpsPoint)..\"    敏捷: \"..Agility..\"  力量: \"..Strength..\"  \"..\"攻强: \"..rangedAttackPower..\"    智力: \"..Intellect.. \"\\n\"\n        .. \"命中: \"..hitColor..string.format(\"%.2f\", Hit)..\"%|r\"..\"/\"..string.format(\"%.0f\", rangedHitRating)..\"/\"..hitneedColor..string.format(\"%+.0f\", hitneed)..\"|r\"..\"  \"\n        .. \"暴击: \"..string.format(\"%.2f\", rangedCrit)..\"%\"..\"/\"..critRating..\"  \"\n        .. \"急速: \"..string.format(\"%.2f\", rangedHasteRating / ratingHasteRanged)..\"%\"..\"/\"..HasteRating ..\"  \\n\"\n        .. \"破甲: \"..string.format(\"%.2f\", ArP )..\"%\".. \"/\"..string.format(\"%.0f\", ArP * ratingArP ) ..\"  \"\n    end\n    return str\nend\n--iDPS V1.7.3 For WotLKC 3.4.4（& Titan  3.8.0）\n--ahhz；霜语\n--2025年6月30日更新\n--2025-12-12更新",
