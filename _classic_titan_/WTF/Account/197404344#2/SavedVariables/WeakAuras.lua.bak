["MDF - Classic Skin - Unit B - Backdrop"] = {
["wagoID"] = "5Pz4pCOF5",
["parent"] = "MDF - Classic Skin - Unit B - Group",
["preferToUpdate"] = true,
["yOffset"] = 0,
["anchorPoint"] = "TOPLEFT",
["url"] = "https://space.bilibili.com/455259",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.sFrameID = \"B\"\naura_env.iSkinID = 1\naura_env.sFrameName = \"ConsumeButton_MDF_Unit\" .. aura_env.sFrameID\n\n",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["debuffType"] = "HELPFUL",
["type"] = "custom",
["names"] = {
},
["custom_type"] = "event",
["unit"] = "player",
["events"] = "MultiDotFrame_ChangeZone MultiDotFrame_InitBackdrops MultiDotFrame_InitSharedTrigger_Backdrops",
["event"] = "Chat Message",
["customStacks"] = "",
["customDuration"] = "function()\n    return aura_env.bFailedToTarget   \nend",
["custom"] = "-- Secure Frame ! - Do not add anything that could change the frame - that could cause errors in combat\nfunction(sEvent, ...)    \n    if aura_env.config.tDebug.bDebug and aura_env.config.tDebug.bFramesBackdropEvents then\n        print(\"Backdrop\", aura_env.sFrameID, sEvent, ...)\n    end\n    if sEvent == \"MultiDotFrame_InitBackdrops\" then\n        aura_env.tData = select(1, ...)\n        aura_env.tData.fnInitDuplicateData()\n        \n        if aura_env.tZoneData then\n            aura_env.tData.fnSetupSecuredFrame()  \n        else\n            return false\n        end\n    elseif sEvent == \"MultiDotFrame_InitSharedTrigger_Backdrops\" then\n        aura_env.tTriggerData = select(1, ...)\n    else\n        if aura_env.tTriggerData then\n            return aura_env.tTriggerData.fnHandleTrigger(sEvent, ...)\n        end\n    end    \n    \n    return aura_env.bShown\nend",
["spellIds"] = {
},
["customIcon"] = "",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "custom",
},
["untrigger"] = {
["custom"] = "",
},
},
["activeTriggerMode"] = -10,
},
["internalVersion"] = 88,
["animation"] = {
["start"] = {
["type"] = "none",
["easeStrength"] = 3,
["duration_type"] = "seconds",
["easeType"] = "none",
},
["main"] = {
["colorR"] = 1,
["duration_type"] = "seconds",
["colorA"] = 1,
["colorG"] = 1,
["use_translate"] = false,
["type"] = "none",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    if aura_env.tZoneData and aura_env.tZoneData.iIndex then \n        local fMultiplier = 1\n        if aura_env.config.bReverseGrowth then \n            fMultiplier = -1\n        end\n        local fHeight = aura_env.config.fFrameHeight + 25 -- Classic Frames are a bit bigger\n        return startX, startY - aura_env.tZoneData.iIndex * fHeight * fMultiplier\n    end\n    return startX, startY\nend\n\n\n",
["scaley"] = 1,
["alpha"] = 0,
