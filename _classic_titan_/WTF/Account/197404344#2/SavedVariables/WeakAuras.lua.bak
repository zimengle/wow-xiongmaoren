["自定义宏模板"] = {
["text2Point"] = "CENTER",
["iconSource"] = -1,
["text1FontSize"] = 12,
["authorOptions"] = {
{
["type"] = "input",
["useDesc"] = false,
["width"] = 2,
["default"] = "",
["name"] = "自定义按钮功能宏",
["multiline"] = true,
["length"] = 10,
["key"] = "Macro",
["useLength"] = false,
},
},
["preferToUpdate"] = true,
