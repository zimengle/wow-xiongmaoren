["displayText_format_1.percenthealth_gcd_gcd"] = true,
["customText"] = "-- Author: 露露緹婭@Bilibili\nfunction()\n    local default_text = \"你被心控\"\n    local spellId = aura_env.state and aura_env.state.spellId\n    local RurutiaSpellName = (spellId and GetSpellInfo(spellId)) or default_text\n    \n    local RurutiaSpellIDs = {\n        -- 测试用\n        --[48066] = \"|cff00ff00护盾|r\", -- 真言术：盾\n        \n        -- 熔火之心\n        -- 小怪\n        [19641] = \"昏迷\", -- 火屑弹幕\n        \n        -- 鲁西弗隆\n        [20604] = \"你被心控\", -- 统御意志\n        [19702] = \"末日降临\", -- 末日降临\n        \n        -- 玛格曼达\n        [19408] = \"恐惧\", -- 恐慌\n        [19428] = \"火Dot\", -- 燃烧\n        [19450] = \"火Dot\", -- 熔岩喷吐\n        \n        -- 基赫纳斯\n        [19716] = \"75%致死\", -- 基赫纳斯的诅咒\n        [19717] = \"快躲开\", -- 火焰之雨\n        \n        -- 加尔\n        [15732] = \"火Dot\", -- 献祭\n        [19496] = \"-60%移速\", -- 熔岩镣铐\n        \n        -- 沙斯拉尔\n        [19713] = \"+100%\\n魔法承伤\", -- 沙斯拉尔的诅咒\n        \n        -- 迦顿男爵\n        [19659] = \"法力燃烧\", -- 点燃法力\n        \n        -- 萨弗隆先驱者\n        [19776] = \"暗言术：痛\", -- 暗言术：痛\n        [19778] = \"-攻强\", -- 挫志怒吼\n        [19780] = \"击退+昏迷\", -- 拉格纳罗斯之手\n        [20294] = \"火Dot\", -- 献祭\n        \n        -- 焚化者古雷曼格\n        [13880] = \"火Dot\", -- 熔岩喷溅\n        [19820] = \"流血+减速\", -- 裂伤\n        \n        -- 管理者埃克索图斯\n        [20229] = \"减速\", -- 冲击波\n    }\n    return spellId and RurutiaSpellIDs[spellId] or RurutiaSpellName\nend",
