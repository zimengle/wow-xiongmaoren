["[T5] 纯语音系统（分职责播报）"] = {
["outline"] = "OUTLINE",
["wagoID"] = "H5gs0vTam",
["xOffset"] = 0,
["displayText"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "-- Author: 露露緹婭@Bilibili\naura_env.RurutiaFileLocation = \"Interface\\\\AddOns\\\\Rurutia_Raids\"\naura_env.lastPlayed = aura_env.lastPlayed or {}\naura_env.RurutiaDefaultCD = 3 -- 默认冷却时间\nprint(\"露露的T5团本语音 v1.0.0 已加载。\")\n\naura_env.spellMap = {\n    -- ===== 毒蛇神殿 =====\n    -- 小怪\n    [38599] = {\"SAA\", \"【露露】法术反射.ogg\"}, -- 法术反射\n    \n    -- 不稳定的海度斯\n    [38215] = {\"SAAP\", \"【露露】注意分散.ogg\"}, -- 海度斯印记\n    [38219] = {\"SAAP\", \"【露露】注意群疗.ogg\"}, -- 腐蚀印记\n    \n    -- 盲眼\n    [37640] = {\"SAAP\", \"【露露】远离BOSS.ogg\"}, -- 旋风斩\n    \n    -- 瓦斯琪\n    [38112] = {\"SAA\", \"【露露】注意停手.ogg\"}, -- 魔法屏障\n    \n    -- ===== 风暴要塞 =====\n    -- 凯尔萨斯\n    \n}",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "-- Author: 露露緹婭@Bilibili\nfunction(_, event, _, subEvent, _, sourceGUID, _, sourceFlags, _, destGUID, _, _, _, spellID, _, _, auraType)\n    -- 基础检查\n    if not spellID or not aura_env or not aura_env.spellMap then\n        return\n    end\n    \n    -- 事件类型过滤\n    if subEvent ~= \"SPELL_CAST_START\" and subEvent ~= \"SPELL_CAST_SUCCESS\"\n    and subEvent ~= \"SPELL_AURA_APPLIED\" and subEvent ~= \"SPELL_AURA_REMOVED\" then\n        return\n    end\n    \n    local currentTime = GetTime()\n    local spellConfig = aura_env.spellMap[spellID]\n    if not spellConfig then return end\n    \n    -- 处理单配置和多配置\n    local configs = {}\n    if type(spellConfig[1]) == \"string\" then\n        configs = {spellConfig}\n    else\n        configs = spellConfig\n    end\n    \n    -- 处理所有匹配的配置\n    for _, config in ipairs(configs) do\n        local eventType = config[1]\n        local voiceConfig = config[2]\n        local customCD = config[3]\n        \n        -- 事件匹配检查\n        local matched = false\n        local needHostileCheck = false\n        \n        if eventType == \"SCS\" and subEvent == \"SPELL_CAST_START\" then\n            matched, needHostileCheck = true, true\n        elseif eventType == \"SCCP\" and subEvent == \"SPELL_CAST_SUCCESS\" and destGUID == UnitGUID(\"player\")  then\n            matched, needHostileCheck = true, true\n        elseif eventType == \"SCC\" and subEvent == \"SPELL_CAST_SUCCESS\" then\n            matched, needHostileCheck = true, true\n        elseif eventType == \"SAAP\" and subEvent == \"SPELL_AURA_APPLIED\" and destGUID == UnitGUID(\"player\") then\n            matched, needHostileCheck = true, false\n        elseif eventType == \"SAA\" and subEvent == \"SPELL_AURA_APPLIED\" then\n            matched, needHostileCheck = true, true\n        elseif eventType == \"SARP\" and subEvent == \"SPELL_AURA_REMOVED\" and destGUID == UnitGUID(\"player\") then\n            matched, needHostileCheck = true, false\n        elseif eventType == \"SAR\" and subEvent == \"SPELL_AURA_REMOVED\" then\n            matched, needHostileCheck = true, false\n        end\n        \n        if matched then\n            -- 敌对性检查\n            local shouldProcess = true\n            if needHostileCheck then\n                if not sourceGUID or not sourceFlags or bit.band(sourceFlags, 0x40) == 0 then\n                    shouldProcess = false\n                end\n            end\n            \n            if shouldProcess then\n                -- 解析语音配置\n                local voice, roleTag, configCD\n                if voiceConfig then\n                    -- 格式1：语音文件|职责|CD数字\n                    voice, roleTag, configCD = voiceConfig:match(\"^(.+)|([THD]+)|CD(%d+)$\")\n                    if voice and roleTag and configCD then\n                        configCD = tonumber(configCD)\n                    else\n                        -- 格式2：语音文件|CD数字\n                        voice, configCD = voiceConfig:match(\"^(.+)|CD(%d+)$\")\n                        if voice and configCD then\n                            configCD = tonumber(configCD)\n                            roleTag = nil\n                        else\n                            -- 格式3：语音文件|职责\n                            voice, roleTag = voiceConfig:match(\"^(.+)|([THD]+)$\")\n                            if voice and roleTag then\n                                configCD = nil\n                            else\n                                -- 格式4：纯语音文件\n                                voice = voiceConfig\n                                roleTag = nil\n                                configCD = nil\n                            end\n                        end\n                    end\n                end\n                \n                if voice then\n                    -- 职责检查\n                    local roleMatched = true\n                    if roleTag then\n                        local playerRole = UnitGroupRolesAssigned and UnitGroupRolesAssigned(\"player\") or \"DAMAGER\"\n                        playerRole = (playerRole == \"TANK\" and \"T\") or (playerRole == \"HEALER\" and \"H\") or \"D\"\n                        if not roleTag:find(playerRole) then\n                            roleMatched = false\n                        end\n                    end\n                    \n                    if roleMatched then\n                        -- 冷却检查\n                        local finalCD = configCD or customCD or (aura_env.RurutiaDefaultCD or 3)\n                        local cooldownKey = spellID .. \"_\" .. eventType .. \"_\" .. (roleTag or \"ALL\")\n                        local canPlay = true\n                        \n                        if aura_env.lastPlayed[cooldownKey] then\n                            local timeSinceLastPlay = currentTime - aura_env.lastPlayed[cooldownKey]\n                            -- 检查冷却间隔\n                            if timeSinceLastPlay < finalCD then\n                                canPlay = false\n                            end\n                        end\n                        \n                        if canPlay then\n                            -- 播放语音\n                            aura_env.lastPlayed[cooldownKey] = currentTime\n                            local soundPath = aura_env.RurutiaFileLocation .. \"\\\\\" .. voice\n                            PlaySoundFile(soundPath, \"Master\")\n                        end\n                    end\n                end\n            end\n        end\n    end\nend",
["check"] = "event",
["unit"] = "player",
["events"] = "CLEU:SPELL_CAST_START,CLEU:SPELL_CAST_SUCCESS,CLEU:SPELL_AURA_APPLIED,CLEU:SPELL_AURA_REMOVED",
["debuffType"] = "HELPFUL",
},
