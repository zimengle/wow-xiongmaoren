["do_custom"] = true,
["custom"] = "-- Author: 露露緹婭@Bilibili\naura_env.spell = {\n    39414, -- 奥术飞弹\n}\n\naura_env.soundFile = \"Interface\\\\AddOns\\\\Rurutia_Raids\\\\【露露】你被点名.ogg\"\naura_env.chatChannel = \"SAY\"\naura_env.chatMessage = \"{rt7} %s: %s {rt7}\"",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["spellIds"] = {
},
["custom"] = "-- Author: 露露緹婭@Bilibili\nfunction(allstates, event, unit)\n    if event == \"UNIT_SPELLCAST_CHANNEL_START\" and string.find(unit, \"nameplate\") then\n        local name, text, texture, startTime, endTime, isTradeSkill, notInterruptible, spellId = UnitChannelInfo(unit)\n        \n        if aura_env.spell and spellId then\n            for _, id in ipairs(aura_env.spell) do\n                if id == spellId then\n                    C_Timer.After(0.15, function() WeakAuras.ScanEvents(\"RURUTIA_DELAYED_SPELLCAST\", unit) end)\n                    if allstates[UnitGUID(unit)] then\n                        allstates[UnitGUID(unit)].show = false\n                        allstates[UnitGUID(unit)].changed = true\n                    end\n                    return true\n                end\n            end\n        end\n        \n    elseif event == \"RURUTIA_DELAYED_SPELLCAST\" and string.find(unit, \"nameplate\") then\n        local name, text, texture, startMS, endMS, isTradeSkill, notInterruptible, spellId = UnitChannelInfo(unit)\n        \n        if aura_env.spell and spellId then\n            for _, id in ipairs(aura_env.spell) do\n                if id == spellId then\n                    local targetUnit = unit..\"target\"\n                    if UnitExists(targetUnit) and UnitIsFriend(\"player\", targetUnit) then\n                        local guid = UnitGUID(targetUnit)\n                        local foundUnit\n                        \n                        if UnitExists(\"player\") and UnitGUID(\"player\") == guid then\n                            foundUnit = \"player\"\n                            if not allstates[guid] then\n                                if aura_env.soundFile then\n                                    PlaySoundFile(aura_env.soundFile, \"Master\")\n                                end\n                                if IsInGroup() and aura_env.chatMessage and aura_env.chatChannel then\n                                    local spellInfo = C_Spell.GetSpellInfo(spellId)\n                                    local sName = spellInfo and spellInfo.name or \"未知技能\"\n                                    local pName = UnitName(\"player\")\n                                    \n                                    local msg = string.format(aura_env.chatMessage, sName, pName) \n                                    SendChatMessage(msg, aura_env.chatChannel)\n                                end\n                            end\n                        else\n                            for i = 1, 4 do\n                                local partyUnit = \"party\"..i\n                                if UnitExists(partyUnit) and UnitGUID(partyUnit) == guid then\n                                    foundUnit = partyUnit\n                                    break\n                                end\n                            end\n                        end\n                        \n                        if foundUnit then\n                            local spellInfo = C_Spell.GetSpellInfo(spellId)\n                            allstates[guid] = {\n                                show = true,\n                                changed = true,\n                                progressType = \"timed\",\n                                duration = (endMS - GetTime() * 1000) / 1000,\n                                expirationTime = endMS / 1000,\n                                unit = foundUnit,\n                                autoHide = true,\n                                spellName = spellInfo and spellInfo.name or \"未知技能\",\n                                unitName = UnitName(foundUnit) or \"未知单位\",\n                                icon = spellInfo and spellInfo.iconID or 136243,\n                            }\n                            return true\n                        end\n                    end\n                    break\n                end\n            end\n        end\n        \n    elseif event == \"UNIT_SPELLCAST_CHANNEL_STOP\" then \n        if string.find(unit, \"nameplate\") then\n            local guid = UnitGUID(unit..\"target\")\n            if guid and allstates[guid] then\n                allstates[guid].show = false\n                allstates[guid].changed = true\n                return true\n            end\n        end\n    end\n    return false\nend",
["check"] = "event",
