["version"] = 31029,
},
["version"] = 31029,
["cache"] = {
["reputation"] = {
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "经典旧世",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = false,
["n"] = "联盟",
},
{
["i"] = false,
["r"] = false,
["d"] = "将德莱尼人带到艾泽拉斯世界来的纳鲁飞船，目前搁浅在秘蓝岛上。对于这个高贵的种族来说，埃索达是他们的主城。",
["w"] = false,
["n"] = "埃索达",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座人类势力的最后堡垒目前由流浪归来的国王瓦里安·乌瑞恩统治着。",
["w"] = false,
["n"] = "暴风城",
},
{
["i"] = false,
["r"] = false,
["d"] = "诺莫瑞根以前的居民，现在流亡到了铁炉堡并居住在此，联盟方的重要成员。",
["w"] = false,
["n"] = "诺莫瑞根流亡者",
},
{
["i"] = false,
["r"] = false,
["d"] = "坐落在泰达希尔岛上的联盟城市，暗夜精灵的首都，由月女祭司泰兰德·语风统治。",
["w"] = false,
["n"] = "达纳苏斯",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座联盟的大都市是丹莫罗矮人们的骄傲，也是麦格尼国王的家。",
["w"] = false,
["n"] = "铁炉堡",
},
{
["d"] = "",
["n"] = "隐藏",
},
{
["i"] = false,
["r"] = false,
["d"] = "联盟在诺森德的主力部队，由瓦里安·乌瑞恩国王统领，对抗天灾军团。",
["w"] = false,
["n"] = "无畏远征军",
},
{
["i"] = false,
["r"] = false,
["d"] = "这支高等精灵中的精锐部队拒绝让血精灵进入肯瑞托。他们联合在温蕾萨·风行者的旗帜下，与诺森德的联盟军队并肩作战。",
["w"] = false,
["n"] = "银色盟约",
},
{
["i"] = false,
["r"] = false,
["d"] = "这个神秘的冰霜矮人种族定居在风暴峭壁。他们最近与探险者协会成为了朋友，并且欢迎联盟的成员造访他们的家园。",
["w"] = false,
["n"] = "霜脉矮人",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "燃烧的远征",
},
{
["i"] = false,
["r"] = false,
["d"] = "塞纳里奥议会派往外域研究生态的探险队。在黑暗之门开启后，远征队迅速壮大，并获得了自治权。",
["w"] = false,
["n"] = "塞纳里奥远征队",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座前哨基地坐落在地狱火半岛上，由第一批深入德拉诺的联盟精英部队\"洛萨之子\"的残余力量坚守。现在他们得到了来自暴风城和铁炉堡的支援。",
["w"] = false,
["n"] = "荣耀堡",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "经典旧世",
},
{
["i"] = false,
["r"] = false,
["d"] = "这些元素生物定居于艾萨拉的东部的一座小岛上，是拉格纳罗斯及其军团的死敌。",
["w"] = true,
["n"] = "海达希亚水元素",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "热砂港",
},
{
["i"] = false,
["r"] = false,
["d"] = "热砂集团的首府，诸多优秀地精技师、炼金师和商人的家乡。",
["w"] = true,
["n"] = "加基森",
},
{
["i"] = false,
["r"] = false,
["d"] = "热砂集团的成员，这座城市给许多希望在贫瘠之地做生意的人提供了一个开放和中立的天堂。",
["w"] = true,
["n"] = "棘齿城",
},
{
["i"] = false,
["r"] = false,
["d"] = "热砂集团经营之下的一座贸易城市，坐落于冬泉谷的两条主要干道的交叉处。",
["w"] = true,
["n"] = "永望镇",
},
{
["i"] = false,
["r"] = false,
["d"] = "一个由黑水海盗的头目，大财主里维加兹经营的繁荣的海港城市。它也是热砂集团的一部分，主要仇敌是血帆海盗。",
["w"] = true,
["n"] = "藏宝海湾",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
