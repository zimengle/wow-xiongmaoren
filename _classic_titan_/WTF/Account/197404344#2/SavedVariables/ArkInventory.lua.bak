["reputation"] = {
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "经典旧世",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = false,
["n"] = "联盟",
},
{
["i"] = false,
["r"] = false,
["d"] = "将德莱尼人带到艾泽拉斯世界来的纳鲁飞船，目前搁浅在秘蓝岛上。对于这个高贵的种族来说，埃索达是他们的主城。",
["w"] = false,
["n"] = "埃索达",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座人类势力的最后堡垒目前由流浪归来的国王瓦里安·乌瑞恩统治着。",
["w"] = false,
["n"] = "暴风城",
},
{
["i"] = false,
["r"] = false,
["d"] = "诺莫瑞根以前的居民，现在流亡到了铁炉堡并居住在此，联盟方的重要成员。",
["w"] = false,
["n"] = "诺莫瑞根流亡者",
},
{
["i"] = false,
["r"] = false,
["d"] = "坐落在泰达希尔岛上的联盟城市，暗夜精灵的首都，由月女祭司泰兰德·语风统治。",
["w"] = false,
["n"] = "达纳苏斯",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座联盟的大都市是丹莫罗矮人们的骄傲，也是麦格尼国王的家。",
["w"] = false,
["n"] = "铁炉堡",
},
{
["d"] = "",
["n"] = "隐藏",
},
},
