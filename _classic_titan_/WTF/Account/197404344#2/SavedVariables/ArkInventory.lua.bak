["version"] = 31029,
["cache"] = {
["reputation"] = {
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "巫妖王之怒",
},
{
["i"] = false,
["r"] = false,
["d"] = "海象人是坚韧而和平的种族，通过捕鲸和捕鱼谋生。他们的家园最近正在遭受凶猛的攻击，急需来自外界的援手。",
["w"] = false,
["n"] = "卡鲁亚克",
},
{
["i"] = false,
["r"] = false,
["d"] = "统治达拉然的法师和大法师们。由于蓝龙军团和亡灵天灾造成的威胁，他们将整座城市传送到了诺森德的腹地。",
["w"] = false,
["n"] = "肯瑞托",
},
{
["i"] = false,
["r"] = false,
["d"] = "提里奥·弗丁领导的银色北伐军是由白银之手骑士团和银色黎明重组而成的，他们的目标是击溃巫妖王的军队。",
["w"] = false,
["n"] = "银色北伐军",
},
{
["i"] = false,
["r"] = false,
["d"] = "这支风暴峭壁的冰霜巨人部族非常好战，他们定居在丹尼芬雷。",
["w"] = true,
["n"] = "霍迪尔之子",
},
{
["i"] = false,
["r"] = false,
["d"] = "在脱离了巫妖王的控制之后，这些曾经效命于他的死亡骑士联合起来，在大领主达里安·莫格莱尼的领导下对抗巫妖王。",
["w"] = false,
["n"] = "黑锋骑士团",
},
{
["i"] = false,
["r"] = false,
["d"] = "由于蓝龙军团粗暴地干涉凡人种族使用魔法的权利，其余的龙族不得不联合在红龙军团旗下，与这些狂乱的同胞抗衡。",
["w"] = false,
["n"] = "龙眠联军",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "索拉查盆地",
},
{
["i"] = false,
["r"] = false,
["d"] = "这群凶猛的狼獾人被天灾军团追杀，偶然来到了索拉查盆地，遂决定在此安家。由于极富攻击性，他们与被称为神谕者的鳄鱼人部族成水火之势。",
["w"] = false,
["n"] = "狂心氏族",
},
{
["i"] = false,
["r"] = false,
["d"] = "索拉查盆地的鳄鱼人将自己视为该区域中存留的泰坦科技的守护者（虽然他们基本不了解这种科技）。目前他们正在与狼獾人进行着不断激化的领土战争。",
["w"] = false,
["n"] = "神谕者",
},
{
["i"] = false,
["r"] = true,
["d"] = "联盟派往诺森德的多支部队的统称，由无畏远征军领导。同时也包括一些非军事组织，如探险者协会。",
["w"] = true,
["n"] = "联盟先遣军",
},
{
["i"] = false,
["r"] = false,
["d"] = "这个组织致力于通过发掘泰坦遗留下来的古器追寻矮人种族的起源。最近他们来到诺森德的多处古迹进行研究。",
["w"] = false,
["n"] = "探险者协会",
},
{
["i"] = false,
["r"] = false,
["d"] = "联盟在诺森德的主力部队，由瓦里安·乌瑞恩国王统领，对抗天灾军团。",
["w"] = false,
["n"] = "无畏远征军",
},
{
["i"] = false,
["r"] = false,
["d"] = "这支高等精灵中的精锐部队拒绝让血精灵进入肯瑞托。他们联合在温蕾萨·风行者的旗帜下，与诺森德的联盟军队并肩作战。",
["w"] = false,
["n"] = "银色盟约",
},
{
["i"] = false,
["r"] = false,
["d"] = "这个神秘的冰霜矮人种族定居在风暴峭壁。他们最近与探险者协会成为了朋友，并且欢迎联盟的成员造访他们的家园。",
["w"] = false,
["n"] = "霜脉矮人",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "燃烧的远征",
},
{
["i"] = false,
["r"] = false,
["d"] = "塞纳里奥议会派往外域研究生态的探险队。在黑暗之门开启后，远征队迅速壮大，并获得了自治权。",
["w"] = false,
["n"] = "塞纳里奥远征队",
},
{
["i"] = false,
["r"] = false,
["d"] = "由星界巨商哈拉麦德领导的星界财团是一个结构松散的商业联盟，其成员都是从事走私、贸易或盗窃的虚灵。",
["w"] = false,
["n"] = "星界财团",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座前哨基地坐落在地狱火半岛上，由第一批深入德拉诺的联盟精英部队\"洛萨之子\"的残余力量坚守。现在他们得到了来自暴风城和铁炉堡的支援。",
["w"] = false,
["n"] = "荣耀堡",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = false,
["n"] = "沙塔斯城",
},
{
["i"] = false,
["r"] = false,
["d"] = "来自各个地方、各个种族的避难者在沙塔斯城的聚集地。在贫民窟中，善行善举总是会很快传遍所有人的耳朵。",
["w"] = false,
["n"] = "贫民窟",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "经典旧世",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "热砂港",
},
{
["i"] = false,
["r"] = false,
["d"] = "热砂集团的首府，诸多优秀地精技师、炼金师和商人的家乡。",
["w"] = true,
["n"] = "加基森",
},
{
["i"] = false,
["r"] = false,
["d"] = "热砂集团的成员，这座城市给许多希望在贫瘠之地做生意的人提供了一个开放和中立的天堂。",
["w"] = true,
["n"] = "棘齿城",
},
{
["i"] = false,
["r"] = false,
["d"] = "热砂集团经营之下的一座贸易城市，坐落于冬泉谷的两条主要干道的交叉处。",
["w"] = true,
["n"] = "永望镇",
},
{
["i"] = false,
["r"] = false,
["d"] = "一个由黑水海盗的头目，大财主里维加兹经营的繁荣的海港城市。它也是热砂集团的一部分，主要仇敌是血帆海盗。",
["w"] = true,
["n"] = "藏宝海湾",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = false,
["n"] = "联盟",
},
{
["i"] = false,
["r"] = false,
["d"] = "将德莱尼人带到艾泽拉斯世界来的纳鲁飞船，目前搁浅在秘蓝岛上。对于这个高贵的种族来说，埃索达是他们的主城。",
["w"] = false,
["n"] = "埃索达",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座人类势力的最后堡垒目前由流浪归来的国王瓦里安·乌瑞恩统治着。",
["w"] = false,
["n"] = "暴风城",
},
{
["i"] = false,
["r"] = false,
["d"] = "诺莫瑞根以前的居民，现在流亡到了铁炉堡并居住在此，联盟方的重要成员。",
["w"] = false,
["n"] = "诺莫瑞根流亡者",
},
{
["i"] = false,
["r"] = false,
["d"] = "坐落在泰达希尔岛上的联盟城市，暗夜精灵的首都，由月女祭司泰兰德·语风统治。",
["w"] = false,
["n"] = "达纳苏斯",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座联盟的大都市是丹莫罗矮人们的骄傲，也是麦格尼国王的家。",
["w"] = false,
["n"] = "铁炉堡",
},
{
["d"] = "",
["n"] = "隐藏",
},
},
