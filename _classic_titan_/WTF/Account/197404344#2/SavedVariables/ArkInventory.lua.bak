["reputation"] = {
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "经典旧世",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = false,
["n"] = "联盟",
},
{
["i"] = false,
["r"] = false,
["d"] = "将德莱尼人带到艾泽拉斯世界来的纳鲁飞船，目前搁浅在秘蓝岛上。对于这个高贵的种族来说，埃索达是他们的主城。",
["w"] = false,
["n"] = "埃索达",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座人类势力的最后堡垒目前由流浪归来的国王瓦里安·乌瑞恩统治着。",
["w"] = false,
["n"] = "暴风城",
},
{
["i"] = false,
["r"] = false,
["d"] = "诺莫瑞根以前的居民，现在流亡到了铁炉堡并居住在此，联盟方的重要成员。",
["w"] = false,
["n"] = "诺莫瑞根流亡者",
},
{
["i"] = false,
["r"] = false,
["d"] = "坐落在泰达希尔岛上的联盟城市，暗夜精灵的首都，由月女祭司泰兰德·语风统治。",
["w"] = false,
["n"] = "达纳苏斯",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座联盟的大都市是丹莫罗矮人们的骄傲，也是麦格尼国王的家。",
["w"] = false,
["n"] = "铁炉堡",
},
{
["d"] = "",
["n"] = "隐藏",
},
{
["i"] = false,
["r"] = false,
["d"] = "这群凶猛的狼獾人被天灾军团追杀，偶然来到了索拉查盆地，遂决定在此安家。由于极富攻击性，他们与被称为神谕者的鳄鱼人部族成水火之势。",
["w"] = false,
["n"] = "狂心氏族",
},
{
["i"] = false,
["r"] = false,
["d"] = "索拉查盆地的鳄鱼人将自己视为该区域中存留的泰坦科技的守护者（虽然他们基本不了解这种科技）。目前他们正在与狼獾人进行着不断激化的领土战争。",
["w"] = false,
["n"] = "神谕者",
},
{
["i"] = false,
["r"] = true,
["d"] = "联盟派往诺森德的多支部队的统称，由无畏远征军领导。同时也包括一些非军事组织，如探险者协会。",
["w"] = true,
["n"] = "联盟先遣军",
},
{
["i"] = false,
["r"] = false,
["d"] = "这个组织致力于通过发掘泰坦遗留下来的古器追寻矮人种族的起源。最近他们来到诺森德的多处古迹进行研究。",
["w"] = false,
["n"] = "探险者协会",
},
{
["i"] = false,
["r"] = false,
["d"] = "联盟在诺森德的主力部队，由瓦里安·乌瑞恩国王统领，对抗天灾军团。",
["w"] = false,
["n"] = "无畏远征军",
},
{
["i"] = false,
["r"] = false,
["d"] = "这支高等精灵中的精锐部队拒绝让血精灵进入肯瑞托。他们联合在温蕾萨·风行者的旗帜下，与诺森德的联盟军队并肩作战。",
["w"] = false,
["n"] = "银色盟约",
},
{
["i"] = false,
["r"] = false,
["d"] = "这个神秘的冰霜矮人种族定居在风暴峭壁。他们最近与探险者协会成为了朋友，并且欢迎联盟的成员造访他们的家园。",
["w"] = false,
["n"] = "霜脉矮人",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "燃烧的远征",
},
{
["i"] = false,
["r"] = false,
["d"] = "塞纳里奥议会派往外域研究生态的探险队。在黑暗之门开启后，远征队迅速壮大，并获得了自治权。",
["w"] = false,
["n"] = "塞纳里奥远征队",
},
{
["i"] = false,
["r"] = false,
["d"] = "生活在外域的孢子人是一个非常温和的种族。他们的家园就坐落在赞加沼泽南部的沼泽地中。",
["w"] = true,
["n"] = "孢子村",
},
{
["i"] = false,
["r"] = false,
["d"] = "由星界巨商哈拉麦德领导的星界财团是一个结构松散的商业联盟，其成员都是从事走私、贸易或盗窃的虚灵。",
["w"] = false,
["n"] = "星界财团",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座前哨基地坐落在地狱火半岛上，由第一批深入德拉诺的联盟精英部队\"洛萨之子\"的残余力量坚守。现在他们得到了来自暴风城和铁炉堡的支援。",
["w"] = false,
["n"] = "荣耀堡",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = false,
["n"] = "沙塔斯城",
},
{
["i"] = false,
["r"] = false,
["d"] = "来自各个地方、各个种族的避难者在沙塔斯城的聚集地。在贫民窟中，善行善举总是会很快传遍所有人的耳朵。",
["w"] = false,
["n"] = "贫民窟",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = true,
["n"] = "经典旧世",
},
{
["i"] = false,
["r"] = false,
["d"] = "这些元素生物定居于艾萨拉的东部的一座小岛上，是拉格纳罗斯及其军团的死敌。",
["w"] = true,
["n"] = "海达希亚水元素",
},
{
["i"] = false,
["r"] = false,
["d"] = "",
["w"] = false,
["n"] = "联盟",
},
{
["i"] = false,
["r"] = false,
["d"] = "将德莱尼人带到艾泽拉斯世界来的纳鲁飞船，目前搁浅在秘蓝岛上。对于这个高贵的种族来说，埃索达是他们的主城。",
["w"] = false,
["n"] = "埃索达",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座人类势力的最后堡垒目前由流浪归来的国王瓦里安·乌瑞恩统治着。",
["w"] = false,
["n"] = "暴风城",
},
{
["i"] = false,
["r"] = false,
["d"] = "诺莫瑞根以前的居民，现在流亡到了铁炉堡并居住在此，联盟方的重要成员。",
["w"] = false,
["n"] = "诺莫瑞根流亡者",
},
{
["i"] = false,
["r"] = false,
["d"] = "坐落在泰达希尔岛上的联盟城市，暗夜精灵的首都，由月女祭司泰兰德·语风统治。",
["w"] = false,
["n"] = "达纳苏斯",
},
{
["i"] = false,
["r"] = false,
["d"] = "这座联盟的大都市是丹莫罗矮人们的骄傲，也是麦格尼国王的家。",
["w"] = false,
["n"] = "铁炉堡",
},
{
["n"] = "隐藏",
["d"] = "",
},
{
["i"] = false,
["r"] = false,
["d"] = "诺莫瑞根以前的居民，现在流亡到了铁炉堡并居住在此，联盟方的重要成员。",
